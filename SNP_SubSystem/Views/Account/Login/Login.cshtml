@using Sub_Services.Execute
@inject SubSystemService SubSystemService
@{
    Layout = null; // Login page does not use the standard layout
    var sysSettings = await SubSystemService.GetSystemSettingsAsync();
    var sysTitle = sysSettings?.GetValueOrDefault("SystemTitle", "") ?? "";
    if (string.IsNullOrEmpty(sysTitle)) sysTitle = "SNP SubSystem";
    var sysLogo = sysSettings?.GetValueOrDefault("SystemLogo", "") ?? "";
    var loginBg = sysSettings?.GetValueOrDefault("LoginBackground", "") ?? "";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Đăng nhập - @Html.Raw(sysTitle)</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        :root {
            --primary: #1f3a67;
            --primary-light: #3a5fa8;
            --danger: #ef4444;
            --text-dark: #1e293b;
            --text-muted: #64748b;
            --bg-body: #f8fafc;
            --bg-surface: #ffffff;
            --border: #e2e8f0;
            --focus-ring: rgba(31, 58, 103, 0.15);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg-body);
            @if (!string.IsNullOrEmpty(loginBg))
            {
                <text>
                background-image: url('@loginBg');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
                </text>
            }
            else
            {
                <text>
                background-image: 
                    radial-gradient(at 0% 0%, rgba(58, 95, 168, 0.1) 0px, transparent 50%),
                    radial-gradient(at 100% 100%, rgba(31, 58, 103, 0.1) 0px, transparent 50%);
                </text>
            }
            color: var(--text-dark);
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
        }

        .login-wrapper {
            width: 100%;
            max-width: 420px;
            padding: 20px;
        }

        .login-card {
            background: rgba(255, 255, 255, 0.35);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border-radius: 24px;
            border: 1px solid rgba(255, 255, 255, 0.5);
            box-shadow: 0 20px 40px -15px rgba(0,0,0,0.1), 
                        inset 0 0 0 1px rgba(255, 255, 255, 0.2);
            padding: 40px;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, var(--primary) 0%, var(--primary-light) 100%);
        }

        .login-header {
            text-align: center;
            margin-bottom: 32px;
        }

        .login-icon {
            width: 56px;
            height: 56px;
            background: linear-gradient(135deg, var(--primary), var(--primary-light));
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 24px;
            margin: 0 auto 16px;
            box-shadow: 0 8px 16px rgba(31, 58, 103, 0.2);
        }

        .login-title {
            font-size: 24px;
            font-weight: 800;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .login-subtitle {
            font-size: 14px;
            color: var(--text-muted);
            font-weight: 500;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 13px;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 8px;
        }

        .form-control-wrap {
            position: relative;
        }

        .form-control-wrap i {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--text-muted);
            font-size: 14px;
        }

        .form-control {
            width: 100%;
            padding: 12px 14px 12px 40px;
            border: 1.5px solid var(--border);
            border-radius: 10px;
            font-size: 14px;
            font-family: inherit;
            color: var(--text-dark);
            transition: all 0.2s;
            background: var(--bg-body);
        }

        .form-control:focus {
            background: var(--bg-surface);
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--focus-ring);
            outline: none;
        }

        .error-alert {
            background: #fef2f2;
            border-left: 4px solid var(--danger);
            color: #b91c1c;
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            gap: 10px;
            animation: shake 0.4s ease-in-out;
        }

        @@keyframes shake {
            0%, 100% { transform: translateX(0); }
            25% { transform: translateX(-5px); }
            75% { transform: translateX(5px); }
        }

        .btn-submit {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, var(--primary) 0%, var(--primary-light) 100%);
            color: white;
            border: none;
            border-radius: 10px;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            box-shadow: 0 4px 12px rgba(31, 58, 103, 0.2);
        }

        .btn-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(31, 58, 103, 0.3);
        }

        .btn-submit:active {
            transform: translateY(0);
        }

        .footer-text {
            text-align: center;
            margin-top: 24px;
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 500;
        }
    </style>
</head>
<body>

<div class="login-wrapper">
    <div class="login-card">
        <div class="login-header">
            @if (!string.IsNullOrEmpty(sysLogo))
            {
                <div style="text-align: center; margin-bottom: 16px;">
                    <img src="@sysLogo" alt="Logo" style="max-height: 60px; border-radius: 8px;" />
                </div>
            }
            else
            {
                <div class="login-icon">
                    <i class="fa-solid fa-fingerprint"></i>
                </div>
            }
            <h1 class="login-title">Đăng Nhập</h1>
            <p class="login-subtitle">@Html.Raw(sysTitle)</p>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Error))
        {
            <div class="error-alert">
                <i class="fa-solid fa-triangle-exclamation"></i>
                @ViewBag.Error
            </div>
        }

        <form method="post" action="/Login">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            
            <div class="form-group">
                <label class="form-label" for="username">Tài khoản</label>
                <div class="form-control-wrap">
                    <i class="fa-solid fa-user"></i>
                    <input type="text" id="username" name="username" class="form-control" placeholder="Nhập tên đăng nhập..." required autofocus>
                </div>
            </div>

            <div class="form-group" style="margin-bottom: 28px;">
                <label class="form-label" for="password">Mật khẩu</label>
                <div class="form-control-wrap">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password" id="password" name="password" class="form-control" placeholder="Nhập mật khẩu..." required>
                </div>
            </div>

            <button type="submit" class="btn-submit">
                Đăng nhập ngay
                <i class="fa-solid fa-arrow-right-to-bracket"></i>
            </button>
        </form>

        <div class="footer-text">
            &copy; @DateTime.Now.Year @Html.Raw(sysTitle). Bằng việc đăng nhập, bạn đồng ý với các điều khoản bảo mật của hệ thống.
        </div>
    </div>
</div>

</body>
</html>
