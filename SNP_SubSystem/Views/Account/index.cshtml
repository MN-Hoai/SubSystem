@{
    ViewData["Title"] = "Quản lý tài khoản";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── PAGE LAYOUT ─────────────────────────────────────── */
    .acc-page { display:flex; flex-direction:column; gap:20px; padding:24px; }
    .acc-topbar { display:flex; align-items:center; justify-content:space-between; gap:14px; flex-wrap:wrap; }
    .acc-icon { width:44px; height:44px; border-radius:12px; background:linear-gradient(135deg,var(--accent-navy) 0%,#3a5fa8 100%);
        color:#fff; display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; box-shadow:0 4px 14px rgba(31,58,103,.28); }
    .acc-page-title { font-size:22px; font-weight:800; color:var(--ink-900); }
    .acc-page-sub { font-size:12.5px; color:var(--ink-400); margin-top:2px; }

    /* ── FILTER BAR ──────────────────────────────────────── */
    .acc-filter { display:flex; align-items:flex-end; gap:10px; background:var(--bg-surface);
        border:1px solid var(--border); border-radius:12px; padding:14px 18px; flex-wrap:wrap; }
    .acc-filter-grp { display:flex; flex-direction:column; gap:3px; }
    .acc-filter-lbl { font-size:10.5px; font-weight:700; color:var(--ink-400); text-transform:uppercase; letter-spacing:.4px; }
    .acc-inp { padding:8px 12px; border:1.5px solid var(--border); border-radius:8px; font-size:13px;
        color:var(--ink-900); background:var(--bg-surface); outline:none; transition:border-color .18s,box-shadow .18s; min-width:160px; }
    .acc-inp:focus { border-color:var(--accent-navy); box-shadow:0 0 0 3px var(--accent-navy-soft); }
    .acc-search-wrap { position:relative; }
    .acc-search-wrap i { position:absolute; left:10px; top:50%; transform:translateY(-50%); color:var(--ink-300); font-size:13px; pointer-events:none; }
    .acc-search-wrap .acc-inp { padding-left:32px; min-width:220px; }
    .acc-filter-actions { display:flex; gap:8px; margin-left:auto; }

    /* ── BUTTONS ─────────────────────────────────────────── */
    .btn { display:inline-flex; align-items:center; gap:7px; padding:9px 16px; border-radius:9px;
        font-size:13.5px; font-weight:700; cursor:pointer; border:none; transition:background .18s,opacity .18s,transform .15s; }
    .btn-primary { background:linear-gradient(135deg,var(--accent-navy) 0%,#3a5fa8 100%); color:#fff; box-shadow:0 4px 12px rgba(31,58,103,.22); }
    .btn-primary:hover { opacity:.9; transform:translateY(-1px); }
    .btn-ghost { background:var(--bg-canvas); color:var(--ink-700-solid); border:1.5px solid var(--border); }
    .btn-ghost:hover { background:var(--border-soft); }
    .btn-danger { background:var(--danger); color:#fff; }
    .btn-danger:hover { opacity:.88; }
    .btn-sm { padding:6px 12px; font-size:12.5px; border-radius:7px; }

    /* ── PANEL ───────────────────────────────────────────── */
    .acc-panel { background:var(--bg-surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; }
    .acc-panel-head { display:flex; align-items:center; justify-content:space-between; padding:16px 20px; border-bottom:1px solid var(--border-soft); }
    .acc-panel-title { font-size:15px; font-weight:700; color:var(--ink-900); }
    .acc-panel-sub { font-size:12px; color:var(--ink-400); margin-top:2px; }

    /* ── TABLE ───────────────────────────────────────────── */
    .acc-table-wrap { overflow-x:auto; }
    .acc-table { width:100%; border-collapse:collapse; font-size:13px; }
    .acc-table thead tr { background:#F8F9FC; position:sticky; top:0; z-index:2; }
    .acc-table thead th { padding:10px 16px; text-align:left; font-size:10.5px; font-weight:700;
        text-transform:uppercase; letter-spacing:.5px; color:var(--ink-400); white-space:nowrap; border-bottom:2px solid var(--border); }
    .acc-table tbody tr { border-bottom:1px solid var(--border-soft); transition:background .12s; user-select:none; cursor:pointer; }
    .acc-table tbody tr:hover { background:var(--accent-navy-soft); }
    .acc-table tbody td { padding:11px 16px; vertical-align:middle; color:var(--ink-700-solid); }
    .acc-table tbody tr:last-child td { border-bottom:none; }

    /* Row selection */
    .acc-table tbody tr.acc-sel td { background:var(--sel-row-bg, rgba(31,58,103,.10)) !important; }
    .acc-table tbody tr.acc-row-ctx td { background:var(--sel-ctx-bg, rgba(31,58,103,.18)) !important; }

    /* ── BADGES ──────────────────────────────────────────── */
    .acc-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 10px; border-radius:999px; font-size:11px; font-weight:800; white-space:nowrap; }
    .acc-badge.active  { background:#e0f7ef; color:var(--success); }
    .acc-badge.locked  { background:#fdecea; color:var(--danger); }
    .acc-badge.deleted { background:var(--border-soft); color:var(--ink-400); }

    /* ── EXPIRY ──────────────────────────────────────────── */
    .expiry-ok   { color:var(--success);   font-weight:700; }
    .expiry-warn { color:#d97706; font-weight:700; }
    .expiry-exp  { color:var(--danger);    font-weight:700; }
    .mono { font-family:'Courier New',monospace; font-size:12px; color:var(--accent-navy); background:var(--accent-navy-soft); padding:1px 7px; border-radius:5px; }

    /* ── PAGINATION ──────────────────────────────────────── */
    .acc-foot { display:flex; align-items:center; justify-content:space-between; gap:12px;
        padding:10px 20px; border-top:1px solid var(--border); background:var(--bg-canvas); flex-wrap:wrap; }
    .acc-page-info { font-size:12px; color:var(--ink-400); font-weight:600; }
    .acc-paging { display:flex; align-items:center; gap:5px; }
    .acc-paging-btn { padding:5px 11px; border-radius:7px; border:1.5px solid var(--border); background:var(--bg-canvas);
        font-size:12.5px; font-weight:700; color:var(--ink-700-solid); cursor:pointer; transition:background .14s,border-color .14s; }
    .acc-paging-btn:hover:not([disabled]) { background:var(--accent-navy-soft); border-color:var(--accent-navy); color:var(--accent-navy); }
    .acc-paging-btn[disabled] { opacity:.35; pointer-events:none; }
    .acc-paging-btn.active { background:var(--accent-navy); color:#fff; border-color:var(--accent-navy); }
    .acc-page-size { padding:5px 10px; border:1.5px solid var(--border); border-radius:7px; font-size:12.5px;
        color:var(--ink-700-solid); background:var(--bg-canvas); outline:none; cursor:pointer; }

    /* ── CONTEXT MENU ────────────────────────────────────── */
    .acc-ctx { position:fixed; background:var(--bg-surface); border:1.5px solid var(--border); border-radius:10px;
        box-shadow:0 8px 28px rgba(0,0,0,.18); z-index:9000; padding:5px; min-width:185px; display:none; }
    .acc-ctx.visible { display:block; animation:accIn .12s ease; }
    .acc-ctx-item { display:flex; align-items:center; gap:9px; padding:9px 13px; border-radius:7px;
        font-size:13px; font-weight:600; color:var(--ink-700-solid); cursor:pointer; transition:background .12s; border:none; background:none; width:100%; text-align:left; }
    .acc-ctx-item:hover { background:var(--surface-alt,#f4f6fb); }
    .acc-ctx-item.danger { color:var(--danger); }
    .acc-ctx-item.danger:hover { background:#fdecea; }
    .acc-ctx-sep { height:1px; background:var(--border-soft); margin:4px 5px; }

    /* ── MODAL ───────────────────────────────────────────── */
    .acc-modal-bd { display:none; position:fixed; inset:0; z-index:9100; background:rgba(10,14,26,.45);
        backdrop-filter:blur(3px); align-items:flex-start; justify-content:center; padding-top:60px; }
    .acc-modal-bd.open { display:flex !important; animation:accFadeIn .18s ease; }
    .acc-modal { background:var(--bg-canvas); border-radius:14px; box-shadow:0 20px 60px rgba(0,0,0,.22);
        width:520px; max-width:95vw; max-height:calc(100vh - 100px); overflow-y:auto; animation:accIn .22s cubic-bezier(.4,0,.2,1); }
    .acc-modal-head { display:flex; align-items:center; justify-content:space-between; padding:18px 22px 14px; border-bottom:1px solid var(--border); }
    .acc-modal-title { font-size:16px; font-weight:700; color:var(--ink-900); display:flex; align-items:center; gap:8px; margin:0; }
    .acc-modal-close { background:none; border:none; font-size:22px; cursor:pointer; color:var(--ink-400); border-radius:6px; padding:2px 7px; transition:background .15s; }
    .acc-modal-close:hover { background:var(--border-soft); color:var(--danger); }
    .acc-modal-body { padding:20px 22px; display:flex; flex-direction:column; gap:14px; }
    .acc-modal-foot { padding:14px 22px 18px; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid var(--border); }
    .acc-form-row { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    .acc-form-grp { display:flex; flex-direction:column; gap:4px; }
    .acc-form-lbl { font-size:12.5px; font-weight:600; color:var(--ink-700-solid); }
    .acc-form-lbl span { color:var(--danger); margin-left:2px; }
    .acc-form-inp { padding:8px 12px; border:1.5px solid var(--border); border-radius:8px; font-size:13.5px;
        color:var(--ink-900); background:var(--bg-surface); outline:none; transition:border-color .18s,box-shadow .18s; width:100%; box-sizing:border-box; }
    .acc-form-inp:focus { border-color:var(--accent-navy); box-shadow:0 0 0 3px var(--accent-navy-soft); }
    .acc-hint { font-size:11.5px; color:var(--ink-400); margin-top:2px; }

    /* ── CONFIRM MODAL ───────────────────────────────────── */
    .acc-cfm-bd { display:none; position:fixed; inset:0; z-index:9200; background:rgba(10,14,26,.45);
        backdrop-filter:blur(3px); align-items:flex-start; justify-content:center; padding-top:80px; }
    .acc-cfm-bd.open { display:flex !important; }
    .acc-cfm-box { background:var(--bg-canvas); border-radius:14px; box-shadow:0 20px 60px rgba(0,0,0,.22);
        width:400px; max-width:95vw; overflow:hidden; animation:accIn .22s cubic-bezier(.4,0,.2,1); }
    .acc-cfm-head { display:flex; align-items:center; justify-content:space-between; padding:18px 22px 14px;
        border-bottom:1px solid var(--border); border-top:4px solid var(--danger); }
    .acc-cfm-title { font-size:15px; font-weight:700; color:var(--danger); margin:0; display:flex; align-items:center; gap:8px; }
    .acc-cfm-body { padding:18px 22px; font-size:14px; color:var(--ink-700-solid); line-height:1.6; }
    .acc-cfm-foot { padding:14px 22px 18px; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid var(--border); }

    /* ── TOAST ───────────────────────────────────────────── */
    .acc-toast { position:fixed; bottom:28px; right:28px; z-index:9999; padding:12px 20px; border-radius:10px;
        font-size:13.5px; font-weight:700; color:#fff; box-shadow:0 6px 20px rgba(0,0,0,.18); animation:accIn .2s ease; }
    .acc-toast.success { background:var(--success); }
    .acc-toast.error   { background:var(--danger); }
    .acc-toast.warn    { background:#d97706; }

    /* ── EMPTY ───────────────────────────────────────────── */
    .acc-empty { text-align:center; padding:60px 20px; color:var(--ink-300); }
    .acc-empty i { font-size:42px; display:block; margin-bottom:14px; }
    .acc-empty p { font-size:14px; font-weight:600; color:var(--ink-400); }

    @@keyframes accIn      { from { opacity:0; transform:translateY(10px) scale(.97); } to { opacity:1; transform:none; } }
    @@keyframes accFadeIn  { from { opacity:0; } to { opacity:1; } }
</style>

<div class="acc-page">

    <!-- TOP BAR -->
    <div class="acc-topbar">
        <div style="display:flex;align-items:center;gap:14px;">
            <div class="acc-icon"><i class="fa-solid fa-users"></i></div>
            <div>
                <div class="acc-page-title">Quản lý tài khoản</div>
                <div class="acc-page-sub">Tạo, cập nhật và quản lý trạng thái người dùng trong hệ thống</div>
            </div>
        </div>
        <button class="btn btn-primary" id="btnNewAccount">
            <i class="fa-solid fa-user-plus"></i> Tạo tài khoản
        </button>
    </div>

    <!-- FILTER BAR -->
    <div class="acc-filter">
        <div class="acc-filter-grp">
            <span class="acc-filter-lbl">Tìm kiếm</span>
            <div class="acc-search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="acc-inp" id="fKeyword" placeholder="Username, họ tên, MSNV, email...">
            </div>
        </div>
        <div class="acc-filter-grp">
            <span class="acc-filter-lbl">Trạng thái</span>
            <select class="acc-inp" id="fStatus">
                <option value="">Tất cả</option>
                <option value="1" selected>Hoạt động</option>
                <option value="0">Tạm khoá</option>
                <option value="-1">Hết hạn</option>
                <option value="-2">Đã xoá</option>
            </select>
        </div>
        <div class="acc-filter-grp">
            <span class="acc-filter-lbl">Số dòng</span>
            <select class="acc-inp acc-page-size" id="fPageSize">
                <option value="10">10</option>
                <option value="20" selected>20</option>
                <option value="50">50</option>
            </select>
        </div>
        <div class="acc-filter-actions">
            <button class="btn btn-primary btn-sm" id="btnSearch"><i class="fa-solid fa-magnifying-glass"></i> Tìm</button>
            <button class="btn btn-ghost btn-sm" id="btnReset"><i class="fa-solid fa-arrow-rotate-left"></i> Đặt lại</button>
        </div>
    </div>

    <!-- DATA PANEL -->
    <div class="acc-panel">
        <div class="acc-panel-head">
            <div>
                <div class="acc-panel-title">Danh sách tài khoản</div>
                <div class="acc-panel-sub" id="panelSub">Đang tải...</div>
            </div>
            <button class="btn btn-ghost btn-sm" id="btnRefresh">
                <i class="fa-solid fa-rotate-right"></i> Làm mới
            </button>
        </div>

        <!-- Loading -->
        <div id="tblLoading" style="display:none;padding:40px;text-align:center;color:var(--ink-400);">
            <i class="fa-solid fa-circle-notch fa-spin" style="font-size:24px;display:block;margin-bottom:10px;"></i>
            Đang tải dữ liệu...
        </div>

        <!-- Table -->
        <div class="acc-table-wrap" id="tblWrap">
            <table class="acc-table">
                <thead>
                    <tr>
                        <th>Username</th>
                        <th>Họ tên</th>
                        <th>MSNV</th>
                        <th>Email</th>
                        <th>Hạn dùng</th>
                        <th>Ngày tạo</th>
                        <th>Trạng thái</th>
                    </tr>
                </thead>
                <tbody id="tblBody"></tbody>
            </table>
            <div class="acc-empty" id="tblEmpty" style="display:none;">
                <i class="fa-solid fa-user-slash"></i>
                <p>Không tìm thấy tài khoản nào</p>
            </div>
        </div>

        <!-- Footer / Pagination -->
        <div class="acc-foot" id="tblFoot" style="display:none;">
            <div class="acc-page-info" id="pageInfo">—</div>
            <div class="acc-paging" id="pagingCtrl"></div>
        </div>
    </div>

</div>

<!-- ── CONTEXT MENU ──────────────────────────────────────── -->
<div id="accCtxMenu" class="acc-ctx">
    <button class="acc-ctx-item" id="ctxEdit">
        <i class="fa-solid fa-pen-to-square" style="color:var(--accent-navy);width:18px;"></i> Cập nhật
    </button>
    <div class="acc-ctx-sep"></div>
    <button class="acc-ctx-item" id="ctxUnlock">
        <i class="fa-solid fa-lock-open" style="color:var(--success);width:18px;"></i> Mở khoá (Status 1)
    </button>
    <button class="acc-ctx-item" id="ctxRestore">
        <i class="fa-solid fa-trash-can-arrow-up" style="color:var(--success);width:18px;"></i> Khôi phục tài khoản
    </button>
    <button class="acc-ctx-item" id="ctxExtend">
        <i class="fa-solid fa-calendar-plus" style="color:var(--accent-navy);width:18px;"></i> Gia hạn nhanh 1 năm
    </button>
    <button class="acc-ctx-item" id="ctxLock">
        <i class="fa-solid fa-lock" style="color:#d97706;width:18px;"></i> Tạm khoá (Status 0)
    </button>
    <div class="acc-ctx-sep" id="ctxSepDanger"></div>
    <button class="acc-ctx-item danger" id="ctxDelete">
        <i class="fa-solid fa-trash" style="width:18px;"></i> Xoá tài khoản
    </button>
</div>

<!-- ── FORM MODAL (Tạo / Cập nhật) ─────────────────────── -->
<div id="accModalBd" class="acc-modal-bd">
    <div class="acc-modal">
        <div class="acc-modal-head">
            <h2 class="acc-modal-title" id="modalTitle">
                <i class="fa-solid fa-user-pen" style="color:var(--accent-navy);"></i>
                Tạo tài khoản mới
            </h2>
            <button class="acc-modal-close" id="modalClose">&times;</button>
        </div>
        <div class="acc-modal-body">
            <input type="hidden" id="fId">
            <div class="acc-form-row">
                <div class="acc-form-grp">
                    <label class="acc-form-lbl">Username <span>*</span></label>
                    <input type="text" class="acc-form-inp" id="fUsername" placeholder="tên đăng nhập">
                </div>
                <div class="acc-form-grp">
                    <label class="acc-form-lbl">MSNV</label>
                    <input type="text" class="acc-form-inp" id="fMsnv" placeholder="mã số nhân viên">
                </div>
            </div>
            <div class="acc-form-grp">
                <label class="acc-form-lbl">Họ và tên</label>
                <input type="text" class="acc-form-inp" id="fFullName" placeholder="Nguyễn Văn A">
            </div>
            <div class="acc-form-grp">
                <label class="acc-form-lbl">Email</label>
                <input type="email" class="acc-form-inp" id="fEmail" placeholder="example@@company.com">
            </div>
            <div class="acc-form-row">
                <div class="acc-form-grp">
                    <label class="acc-form-lbl">Mật khẩu <span id="pwdRequired">*</span></label>
                    <input type="password" class="acc-form-inp" id="fPassword" placeholder="••••••••">
                    <div class="acc-hint" id="pwdHint"></div>
                </div>
                <div class="acc-form-grp">
                    <label class="acc-form-lbl">Hạn sử dụng <span>*</span></label>
                    <input type="date" class="acc-form-inp" id="fExpiryDate">
                </div>
            </div>
            <div class="acc-form-grp">
                <label class="acc-form-lbl">Trạng thái</label>
                <select class="acc-form-inp" id="fStatusForm">
                    <option value="1">Hoạt động</option>
                    <option value="0">Tạm khoá</option>
                    <option value="-1">Hết hạn</option>
                </select>
            </div>
        </div>
        <div class="acc-modal-foot">
            <button class="btn btn-ghost btn-sm" id="modalCancel">Huỷ</button>
            <button class="btn btn-primary btn-sm" id="modalSave">
                <i class="fa-solid fa-floppy-disk"></i> Lưu
            </button>
        </div>
    </div>
</div>

<!-- ── CONFIRM MODAL ─────────────────────────────────────── -->
<div id="accCfmBd" class="acc-cfm-bd">
    <div class="acc-cfm-box">
        <div class="acc-cfm-head">
            <span class="acc-cfm-title"><i class="fa-solid fa-triangle-exclamation"></i> Xác nhận</span>
            <button class="acc-modal-close" id="cfmClose">&times;</button>
        </div>
        <div class="acc-cfm-body" id="cfmMsg"></div>
        <div class="acc-cfm-foot">
            <button class="btn btn-ghost btn-sm" id="cfmCancel">Huỷ</button>
            <button class="btn btn-danger btn-sm" id="cfmOk">
                <i class="fa-solid fa-check"></i> Xác nhận
            </button>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    // ── State ────────────────────────────────────────────────
    var currentPage = 1;
    var totalPages  = 1;
    var ctxIds      = [];   // IDs trong context menu / selection
    var lastRowIdx  = -1;
    var rowDrag     = false;
    var cfmCallback = null;

    // ── DOM refs ─────────────────────────────────────────────
    var tbody       = document.getElementById('tblBody');
    var tblLoading  = document.getElementById('tblLoading');
    var tblWrap     = document.getElementById('tblWrap');
    var tblEmpty    = document.getElementById('tblEmpty');
    var tblFoot     = document.getElementById('tblFoot');
    var panelSub    = document.getElementById('panelSub');
    var pageInfo    = document.getElementById('pageInfo');
    var pagingCtrl  = document.getElementById('pagingCtrl');
    var ctxMenu     = document.getElementById('accCtxMenu');
    var modalBd     = document.getElementById('accModalBd');
    var cfmBd       = document.getElementById('accCfmBd');

    // ── Helpers ───────────────────────────────────────────────
    function esc(s) {
        if (s == null) return '';
        return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }

    function fmtDate(iso) {
        if (!iso) return '—';
        var d = new Date(iso);
        return d.toLocaleDateString('vi-VN');
    }

    function expiryClass(iso) {
        if (!iso) return '';
        var d = new Date(iso), now = new Date();
        var diff = (d - now) / 86400000;
        if (diff < 0)  return 'expiry-exp';
        if (diff < 30) return 'expiry-warn';
        return 'expiry-ok';
    }

    function statusBadge(status) {
        if (status === 1)  return '<span class="acc-badge active"><i class="fa-solid fa-circle" style="font-size:7px;"></i> Hoạt động</span>';
        if (status === 0)  return '<span class="acc-badge locked"><i class="fa-solid fa-lock" style="font-size:9px;"></i> Tạm khoá</span>';
        if (status === -1) return '<span class="acc-badge" style="background:var(--border-soft);color:var(--ink-400);"><i class="fa-solid fa-clock" style="font-size:9px;"></i> Hết hạn</span>';
        return '<span class="acc-badge deleted">Đã xoá</span>';
    }

    function toast(type, msg) {
        const fn = { success: toastr.success, error: toastr.error, warn: toastr.warning, info: toastr.info };
        (fn[type] || toastr.info).call(toastr, msg);
    }

    // ── Confirm modal ─────────────────────────────────────────
    function showConfirm(html, cb) {
        document.getElementById('cfmMsg').innerHTML = html;
        cfmCallback = cb;
        cfmBd.classList.add('open');
    }
    function closeConfirm() { cfmBd.classList.remove('open'); cfmCallback = null; }
    document.getElementById('cfmClose').addEventListener('click', closeConfirm);
    document.getElementById('cfmCancel').addEventListener('click', closeConfirm);
    cfmBd.addEventListener('click', function(e){ if (e.target === cfmBd) closeConfirm(); });
    document.getElementById('cfmOk').addEventListener('click', function(){
        var cb = cfmCallback; closeConfirm(); if (cb) cb();
    });

    // ── Load list ─────────────────────────────────────────────
    function getFilters() {
        return {
            keyword:  document.getElementById('fKeyword').value.trim(),
            status:   document.getElementById('fStatus').value === '' ? null : parseInt(document.getElementById('fStatus').value),
            page:     currentPage,
            pageSize: parseInt(document.getElementById('fPageSize').value) || 20,
        };
    }

    function fetchList(page) {
        currentPage = page || currentPage;
        tblLoading.style.display = 'block';
        tblWrap.style.display    = 'none';
        tblFoot.style.display    = 'none';

        fetch('/Account/GetList', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(getFilters())
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            tblLoading.style.display = 'none';
            tblWrap.style.display    = '';
            if (!res.success) { toast('error', res.message || 'Lỗi tải dữ liệu'); return; }
            renderTable(res.data);
        })
        .catch(function(e){
            tblLoading.style.display = 'none';
            tblWrap.style.display    = '';
            toast('error', 'Lỗi kết nối: ' + e.message);
        });
    }

    function renderTable(data) {
        var items = data.items || [];
        totalPages = Math.max(1, Math.ceil(data.totalCount / data.pageSize));

        panelSub.textContent = 'Tổng cộng ' + data.totalCount + ' tài khoản';
        pageInfo.textContent = 'Hiển thị ' + items.length + ' / ' + data.totalCount + ' kết quả';

        tbody.innerHTML = '';

        if (!items.length) {
            tblEmpty.style.display = 'block';
            tblFoot.style.display  = 'none';
            return;
        }
        tblEmpty.style.display = 'none';
        tblFoot.style.display  = '';

        items.forEach(function(u){
            var cls = expiryClass(u.expiryDate);
            var tr = document.createElement('tr');
            tr.dataset.id   = u.id;
            tr.dataset.name = u.username || '';
            tr.dataset.status = u.status;
            tr.innerHTML =
                '<td><strong class="mono">' + esc(u.username) + '</strong></td>' +
                '<td>' + esc(u.fullName || '—') + '</td>' +
                '<td>' + esc(u.msnv    || '—') + '</td>' +
                '<td>' + esc(u.email   || '—') + '</td>' +
                '<td class="' + cls + '">' + fmtDate(u.expiryDate) + '</td>' +
                '<td style="color:var(--ink-400);font-size:12px;">' + fmtDate(u.createDate) + '</td>' +
                '<td>' + statusBadge(u.status) + '</td>';
            tbody.appendChild(tr);
        });

        renderPaging(data.page, totalPages);
    }

    function renderPaging(page, total) {
        pagingCtrl.innerHTML = '';
        function mkBtn(label, p, active, disabled) {
            var b = document.createElement('button');
            b.className = 'acc-paging-btn' + (active ? ' active' : '');
            b.textContent = label;
            b.disabled = disabled;
            b.addEventListener('click', function(){ if (!disabled) fetchList(p); });
            return b;
        }
        pagingCtrl.appendChild(mkBtn('‹', page - 1, false, page <= 1));
        var lo = Math.max(1, page - 2), hi = Math.min(total, page + 2);
        for (var i = lo; i <= hi; i++) pagingCtrl.appendChild(mkBtn(i, i, i === page, false));
        pagingCtrl.appendChild(mkBtn('›', page + 1, false, page >= total));
    }

    // ── Row selection (multi-select) ──────────────────────────
    function getRows()      { return Array.from(tbody.querySelectorAll('tr[data-id]')); }
    function selRows()      { return getRows().filter(function(r){ return r.classList.contains('acc-sel'); }); }
    function selIds()       { return selRows().map(function(r){ return r.dataset.id; }); }
    function clearSel()     { getRows().forEach(function(r){ r.classList.remove('acc-sel','acc-row-ctx'); }); }
    function selRange(a,b)  {
        var rows = getRows(), lo = Math.min(a,b), hi = Math.max(a,b);
        for (var i=lo;i<=hi;i++) if (rows[i]) rows[i].classList.add('acc-sel');
    }

    tbody.addEventListener('mousedown', function(e){
        if (e.button !== 0) return;
        var tr = e.target.closest('tr[data-id]');
        if (!tr) { clearSel(); return; }
        var rows = getRows(), idx = rows.indexOf(tr);
        if (e.shiftKey && lastRowIdx > -1) {
            e.preventDefault(); clearSel(); selRange(lastRowIdx, idx);
        } else if (e.ctrlKey) {
            tr.classList.contains('acc-sel') ? tr.classList.remove('acc-sel') : tr.classList.add('acc-sel');
            lastRowIdx = idx;
        } else {
            clearSel(); tr.classList.add('acc-sel'); lastRowIdx = idx; rowDrag = true;
        }
    });
    tbody.addEventListener('mouseover', function(e){
        if (!rowDrag) return;
        var tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        var idx = getRows().indexOf(tr);
        if (lastRowIdx > -1) { clearSel(); selRange(lastRowIdx, idx); }
    });
    document.addEventListener('mouseup', function(){ rowDrag = false; });
    tbody.addEventListener('selectstart', function(e){ if (rowDrag || e.shiftKey) e.preventDefault(); });

    // ── Context menu ──────────────────────────────────────────
    function hideCtx() {
        ctxMenu.classList.remove('visible');
        tbody.querySelectorAll('.acc-row-ctx').forEach(function(r){ r.classList.remove('acc-row-ctx'); });
    }

    tbody.addEventListener('contextmenu', function(e){
        e.preventDefault();
        var tr = e.target.closest('tr[data-id]');
        if (!tr) { hideCtx(); return; }

        var sel = selIds();
        if (!sel.includes(tr.dataset.id)) {
            clearSel(); tr.classList.add('acc-sel'); lastRowIdx = getRows().indexOf(tr);
        }
        tbody.querySelectorAll('.acc-row-ctx').forEach(function(r){ r.classList.remove('acc-row-ctx'); });
        tr.classList.add('acc-row-ctx');
        ctxIds = selIds();
        
        var statuses = selRows().map(function(r) { return parseInt(r.dataset.status); });
        var hasDeleted = statuses.includes(-2);
        var hasActive = statuses.includes(1);
        var hasLocked = statuses.includes(0);
        var hasExpired = statuses.includes(-1);

        // Hiển thị tuỳ chọn theo trạng thái
        document.getElementById('ctxEdit').style.display = ctxIds.length === 1 && !hasDeleted ? '' : 'none';
        document.getElementById('ctxRestore').style.display = hasDeleted ? '' : 'none';
        document.getElementById('ctxExtend').style.display = !hasDeleted ? '' : 'none';
        
        document.getElementById('ctxUnlock').style.display = (hasLocked || hasExpired) && !hasDeleted ? '' : 'none';
        document.getElementById('ctxLock').style.display = hasActive && !hasDeleted ? '' : 'none';
        
        document.getElementById('ctxDelete').style.display = !hasDeleted ? '' : 'none';
        document.getElementById('ctxSepDanger').style.display = !hasDeleted ? '' : 'none';

        var vw = window.innerWidth, vh = window.innerHeight;
        var x  = Math.min(e.clientX, vw - 210);
        var y  = Math.min(e.clientY, vh - 200);
        ctxMenu.style.left = x + 'px';
        ctxMenu.style.top  = y + 'px';
        ctxMenu.classList.add('visible');
    });

    document.addEventListener('click', function(e){
        if (!ctxMenu.contains(e.target)) hideCtx();
    });
    document.addEventListener('keydown', function(e){
        if (e.key === 'Escape') hideCtx();
    });

    // ── Context actions ───────────────────────────────────────
    document.getElementById('ctxEdit').addEventListener('click', function(){
        if (ctxIds.length !== 1) return;
        hideCtx();
        openEditModal(ctxIds[0]);
    });

    function doSetStatus(status, label) {
        hideCtx();
        if (!ctxIds.length) return;
        var txt = ctxIds.length === 1
            ? '<strong>' + label + '</strong> tài khoản này?'
            : '<strong>' + label + '</strong> <strong>' + ctxIds.length + '</strong> tài khoản đã chọn?';
        showConfirm(txt + '<br><span style="font-size:12px;color:var(--ink-400);">Thao tác này có thể hoàn tác bằng cách đổi trạng thái.</span>',
            function(){
                fetch('/Account/SetStatus', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids: ctxIds, targetStatus: status })
                })
                .then(function(r){ return r.json(); })
                .then(function(res){
                    if (res.success) { clearSel(); fetchList(currentPage); }
                    else toast('error', res.message || 'Lỗi');
                })
                .catch(function(e){ toast('error', e.message); });
            }
        );
    }

    document.getElementById('ctxUnlock').addEventListener('click', function(){ doSetStatus(1,  'Mở khoá'); });
    document.getElementById('ctxRestore').addEventListener('click', function(){ doSetStatus(1, 'Khôi phục'); });
    document.getElementById('ctxLock').addEventListener('click',   function(){ doSetStatus(0,  'Tạm khoá'); });
    document.getElementById('ctxDelete').addEventListener('click', function(){ doSetStatus(-2, 'Xoá mềm'); });

    document.getElementById('ctxExtend').addEventListener('click', function(){
        hideCtx();
        if (!ctxIds.length) return;
        var txt = ctxIds.length === 1
            ? '<strong>Gia hạn 1 năm</strong> cho tài khoản này?'
            : '<strong>Gia hạn 1 năm</strong> cho <strong>' + ctxIds.length + '</strong> tài khoản đã chọn?';
        showConfirm(txt + '<br><span style="font-size:12px;color:var(--ink-400);">Nếu tài khoản đã hết hạn, tài khoản sẽ tự động được Mở khoá.</span>',
            function(){
                fetch('/Account/ExtendExpiry', {
                    method: 'POST', headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ ids: ctxIds, years: 1 })
                })
                .then(function(r){ return r.json(); })
                .then(function(res){
                    if (res.success) { clearSel(); fetchList(currentPage); }
                    else toast('error', res.message || 'Lỗi');
                })
                .catch(function(e){ toast('error', e.message); });
            }
        );
    });

    // ── Form modal ────────────────────────────────────────────
    function openNewModal() {
        document.getElementById('modalTitle').innerHTML =
            '<i class="fa-solid fa-user-plus" style="color:var(--accent-navy);"></i> Tạo tài khoản mới';
        document.getElementById('fId').value        = '';
        document.getElementById('fUsername').value  = '';
        document.getElementById('fMsnv').value      = '';
        document.getElementById('fFullName').value  = '';
        document.getElementById('fEmail').value     = '';
        document.getElementById('fPassword').value  = '';
        document.getElementById('fStatusForm').value = '1';
        document.getElementById('pwdRequired').style.display = '';
        document.getElementById('pwdHint').textContent = '';
        // Mặc định hạn 1 năm
        var d = new Date(); d.setFullYear(d.getFullYear() + 1);
        document.getElementById('fExpiryDate').value = d.toISOString().split('T')[0];
        modalBd.classList.add('open');
        setTimeout(function(){ document.getElementById('fUsername').focus(); }, 150);
    }

    function openEditModal(id) {
        fetch('/Account/GetById?id=' + id)
        .then(function(r){ return r.json(); })
        .then(function(res){
            if (!res.success) { toast('error', res.message || 'Không lấy được dữ liệu'); return; }
            var u = res.data;
            document.getElementById('modalTitle').innerHTML =
                '<i class="fa-solid fa-user-pen" style="color:var(--accent-navy);"></i> Cập nhật tài khoản';
            document.getElementById('fId').value         = u.id;
            document.getElementById('fUsername').value   = u.username   || '';
            document.getElementById('fMsnv').value       = u.msnv       || '';
            document.getElementById('fFullName').value   = u.fullName   || '';
            document.getElementById('fEmail').value      = u.email      || '';
            document.getElementById('fPassword').value   = '';
            document.getElementById('fStatusForm').value = String(u.status);
            document.getElementById('pwdRequired').style.display = 'none';
            document.getElementById('pwdHint').textContent = 'Để trống nếu không đổi mật khẩu';
            var exp = u.expiryDate ? u.expiryDate.split('T')[0] : '';
            document.getElementById('fExpiryDate').value = exp;
            modalBd.classList.add('open');
            setTimeout(function(){ document.getElementById('fFullName').focus(); }, 150);
        })
        .catch(function(e){ toast('error', e.message); });
    }

    function closeModal() { modalBd.classList.remove('open'); }

    document.getElementById('btnNewAccount').addEventListener('click', openNewModal);
    document.getElementById('modalClose').addEventListener('click', closeModal);
    document.getElementById('modalCancel').addEventListener('click', closeModal);
    modalBd.addEventListener('click', function(e){ if (e.target === modalBd) closeModal(); });

    document.getElementById('modalSave').addEventListener('click', function(){
        var btn  = this;
        var orig = btn.innerHTML;
        var payload = {
            id:         document.getElementById('fId').value || null,
            username:   document.getElementById('fUsername').value.trim(),
            msnv:       document.getElementById('fMsnv').value.trim(),
            fullName:   document.getElementById('fFullName').value.trim(),
            email:      document.getElementById('fEmail').value.trim(),
            password:   document.getElementById('fPassword').value,
            expiryDate: document.getElementById('fExpiryDate').value,
            status:     parseInt(document.getElementById('fStatusForm').value),
        };
        if (!payload.username) { toast('warn', 'Vui lòng nhập Username'); return; }
        if (!payload.id && !payload.password) { toast('warn', 'Vui lòng nhập mật khẩu khi tạo mới'); return; }

        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang lưu...';

        fetch('/Account/Upsert', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        })
        .then(function(r){ return r.json(); })
        .then(function(res){
            btn.disabled = false; btn.innerHTML = orig;
            if (res.success) {
                toast('success', res.message || 'Thành công');
                closeModal();
                clearSel();
                fetchList(currentPage);
            } else {
                toast('error', res.message || 'Có lỗi xảy ra');
            }
        })
        .catch(function(e){ btn.disabled = false; btn.innerHTML = orig; toast('error', e.message); });
    });

    // ── Filter / controls ─────────────────────────────────────
    document.getElementById('btnSearch').addEventListener('click', function(){ fetchList(1); });
    document.getElementById('btnRefresh').addEventListener('click', function(){ fetchList(currentPage); });
    document.getElementById('btnReset').addEventListener('click', function(){
        document.getElementById('fKeyword').value = '';
        document.getElementById('fStatus').value  = '1';
        document.getElementById('fPageSize').value = '20';
        fetchList(1);
    });
    document.getElementById('fKeyword').addEventListener('keydown', function(e){
        if (e.key === 'Enter') fetchList(1);
    });

    // ── Init ──────────────────────────────────────────────────
    fetchList(1);

}());
</script>
