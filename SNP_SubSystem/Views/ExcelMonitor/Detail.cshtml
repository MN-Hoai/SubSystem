@model SNP_SubSystem.Controllers.ExcelMonitor.ExcelMonitorDetailVm
@{
    ViewData["Title"] = $"Chi tiết – {Model.File.FileName}";
    var isActive = Model.File.Status == 1;
    var ft       = Model.File.FileType?.ToLower() ?? "xlsx";
    var ftCls    = ft == "xlsb" ? "em-ft-xlsb" : ft == "xlsm" ? "em-ft-xlsm" : "em-ft-xlsx";
}

<div class="em-page">

    <!-- Breadcrumb -->
    <div class="em-breadcrumb">
        <a href="/excel-monitor"><i class="fa-solid fa-table-columns" style="font-size:11px"></i> Excel Monitor</a>
        <span class="em-breadcrumb-sep">&#8250;</span>
        <span class="em-breadcrumb-cur">@Model.File.FileName</span>
    </div>

    <!-- Page header -->
    <div class="em-page-header">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="em-file-icon @ftCls" style="width:44px;height:44px;font-size:12px">@(Model.File.FileType?.ToUpper() ?? "XLS")</div>
            <div>
                <h1 class="em-page-title">@Model.File.FileName</h1>
                <div style="font-size:12px;color:var(--em-muted);font-family:monospace;margin-top:2px">@Model.File.FilePath</div>
            </div>
        </div>
        <div class="em-page-actions">
            @if (isActive)
            {
                <span class="em-status em-status-active"><span class="em-status-dot"></span>Monitoring</span>
            }
            else
            {
                <span class="em-status em-status-paused"><span class="em-status-dot"></span>Paused</span>
            }
            <button id="btnForceRead" class="em-btn em-btn-success" onclick="forceRead()" title="Đọc file ngay, lưu lịch sử dù file đang mở">
                <i class="fa-solid fa-rotate" style="font-size:11px"></i> Cập nhật ngay
            </button>
            <a href="/excel-monitor/@Model.File.Id/history" class="em-btn em-btn-outline">
                <i class="fa-solid fa-clock-rotate-left" style="font-size:11px"></i> Lịch sử đầy đủ
            </a>
            <a href="/excel-monitor" class="em-btn em-btn-ghost">
                <i class="fa-solid fa-arrow-left" style="font-size:11px"></i>
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="em-kpi-row" style="margin-bottom:22px">
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-blue"><i class="fa-regular fa-clock"></i></div>
            <div>
                <div class="em-kpi-value" style="font-size:15px;letter-spacing:0;line-height:1.3">
                    @(Model.File.LastReadDate?.ToString("HH:mm:ss") ?? "––")
                </div>
                <div class="em-kpi-label">Lần đọc cuối</div>
                @if (Model.File.LastReadDate.HasValue)
                {
                    <div class="em-kpi-sub">@Model.File.LastReadDate.Value.ToString("dd/MM/yyyy")</div>
                }
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-yellow"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div>
                <div class="em-kpi-value">@Model.TotalChanges.ToString("N0")</div>
                <div class="em-kpi-label">Tổng thay đổi</div>
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon @(isActive ? "em-kpi-icon-green" : "em-kpi-icon-gray")">
                <i class="fa-solid fa-circle-dot"></i>
            </div>
            <div>
                <div class="em-kpi-value" style="font-size:15px;letter-spacing:0">
                    @(isActive ? "Đang Monitor" : "Đã tắt")
                </div>
                <div class="em-kpi-label">Trạng thái</div>
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon" style="background:#EDE9FE;color:#7C3AED;width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px">
                <i class="fa-regular fa-rectangle-list"></i>
            </div>
            <div>
                <div class="em-kpi-value">@Model.SheetGroups.Count</div>
                <div class="em-kpi-label">Sheet theo dõi</div>
            </div>
        </div>
    </div>

    <!-- Sheet data card -->
    @if (Model.SheetGroups.Any())
    {
        <div class="em-card">
            <div class="em-card-header">
                <h2 class="em-card-title"><i class="fa-regular fa-rectangle-list"></i> Dữ liệu Snapshot</h2>
                <div style="font-size:12px;color:var(--em-muted)">
                    @Model.SheetGroups.Sum(s => s.Groups.Sum(g => g.CurrentCount)).ToString("N0") dòng
                </div>
            </div>

            <!-- Sheet tabs -->
            <div class="em-sheet-tabs">
                @for (int i = 0; i < Model.SheetGroups.Count; i++)
                {
                    <button class="em-sheet-tab @(i == 0 ? "active" : "")"
                            onclick="switchTab(@i)" id="tab_@i">
                        @Model.SheetGroups[i].SheetName
                        <span style="font-size:11px;color:var(--em-muted);margin-left:4px">(@Model.SheetGroups[i].Groups.Count tổ)</span>
                    </button>
                }
            </div>

            <!-- Sheet panels -->
            @for (int i = 0; i < Model.SheetGroups.Count; i++)
            {
                var sheetVm = Model.SheetGroups[i];
                <div class="em-tab-content @(i == 0 ? "em-tab-content-active" : "")" id="tabContent_@i">

                    <div class="em-result-bar">
                        <i class="fa-solid fa-table" style="font-size:12px"></i>
                        Sheet <strong>@sheetVm.SheetName</strong>:
                        <span class="em-result-count">@sheetVm.Groups.Count</span> tổ &middot;
                        <span class="em-result-count">@sheetVm.Groups.Sum(g => g.CurrentCount).ToString("N0")</span> dòng snapshot
                    </div>

                    @if (sheetVm.Groups.Any())
                    {
                        <div class="em-table-wrap">
                            <table class="em-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px">#</th>
                                        <th>Tổ (Group)</th>
                                        <th class="text-center">Số dòng hiện tại</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int gNum = 0; }
                                    @foreach (var group in sheetVm.Groups.OrderBy(g => g.GroupName))
                                    {
                                        gNum++;
                                        <tr style="cursor:pointer" onclick="goToGroup('@Model.File.Id','@group.GroupName')">
                                            <td style="color:var(--em-muted-lt);font-size:12px">@gNum</td>
                                            <td>
                                                <div style="display:flex;align-items:center;gap:8px">
                                                    <span style="width:8px;height:8px;border-radius:50%;background:var(--em-accent);flex-shrink:0;display:inline-block"></span>
                                                    <span style="font-weight:600;color:var(--em-text)">@group.GroupName</span>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="em-badge em-badge-info">@group.CurrentCount dòng</span>
                                            </td>
                                            <td class="text-center">
                                                <a href="/excel-monitor/@Model.File.Id/history?groupName=@Uri.EscapeDataString(group.GroupName ?? "")"
                                                   class="em-btn em-btn-outline em-btn-sm"
                                                   onclick="event.stopPropagation()">
                                                    <i class="fa-solid fa-clock-rotate-left" style="font-size:10px"></i> Lịch sử
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" style="font-weight:700;color:var(--em-text);padding:10px 14px;background:var(--em-surface-2);border-top:2px solid var(--em-border)">Tổng cộng</td>
                                        <td class="text-center" style="padding:10px 14px;background:var(--em-surface-2);border-top:2px solid var(--em-border)">
                                            <strong>@sheetVm.Groups.Sum(g => g.CurrentCount).ToString("N0")</strong> dòng
                                        </td>
                                        <td style="background:var(--em-surface-2);border-top:2px solid var(--em-border)"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="em-empty">
                            <i class="fa-regular fa-folder-open"></i>
                            <div class="em-empty-title">Chưa có dữ liệu snapshot</div>
                            <div class="em-empty-sub">Sheet này chưa được đọc lần nào.</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="em-card">
            <div class="em-empty">
                <i class="fa-regular fa-folder-open"></i>
                <div class="em-empty-title">Chưa có Sheet nào được cấu hình</div>
                <div class="em-empty-sub">Thêm cấu hình sheet trong phần Thao tác.</div>
            </div>
        </div>
    }

</div>

<style>
.em-tab-content { display: none; }
.em-tab-content-active { display: block; }
.em-btn-success {
    background: #16A34A; color: #fff; border: none;
    padding: 8px 16px; border-radius: var(--em-radius-sm);
    font-size: 13px; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    transition: background 0.15s;
}
.em-btn-success:hover { background: #15803D; }
.em-btn-success:disabled { background: #86EFAC; cursor: not-allowed; }
</style>

@section Scripts {
<script>
    const FILE_ID = '@Model.File.Id';

    async function forceRead() {
        const btn = document.getElementById('btnForceRead');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-rotate fa-spin" style="font-size:11px"></i> Đang đọc...';

        try {
            const resp = await fetch(`/api/excel-file/${FILE_ID}/force-read`, { method: 'POST' });
            const data = await resp.json().catch(() => ({}));
            if (resp.ok) {
                toastr.success(data.message || 'Cập nhật thành công!', 'Force Read');
                setTimeout(() => location.reload(), 1000);
            } else {
                toastr.error(data.message || data || 'Lỗi cập nhật', 'Force Read');
                btn.disabled = false;
                btn.innerHTML = '<i class="fa-solid fa-rotate" style="font-size:11px"></i> Cập nhật ngay';
            }
        } catch(e) {
            toastr.error('Lỗi kết nối: ' + e.message);
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-rotate" style="font-size:11px"></i> Cập nhật ngay';
        }
    }

    function switchTab(idx) {
        document.querySelectorAll('.em-sheet-tab').forEach((t, i) => t.classList.toggle('active', i === idx));
        document.querySelectorAll('.em-tab-content').forEach((c, i) => { c.classList.toggle('em-tab-content-active', i === idx); c.style.display = i === idx ? 'block' : 'none'; });
    }
    function goToGroup(fileId, groupName) {
        window.location.href = `/excel-monitor/${fileId}/history?groupName=${encodeURIComponent(groupName)}`;
    }
    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.em-tab-content').forEach((c, i) => { c.style.display = i === 0 ? 'block' : 'none'; });
    });
</script>
}

