@model SNP_SubSystem.Controllers.ExcelMonitor.ExcelMonitorDetailVm
@{
    ViewData["Title"] = $"Chi tiết – {Model.File.FileName}";
    var isActive = Model.File.Status == 1;
    var ft       = Model.File.FileType?.ToLower() ?? "xlsx";
    var ftCls    = ft == "xlsb" ? "em-ft-xlsb" : ft == "xlsm" ? "em-ft-xlsm" : "em-ft-xlsx";
}

<div class="em-page">

    <!-- Breadcrumb -->
    <div class="em-breadcrumb">
        <a href="/excel-monitor"><i class="fa-solid fa-table-columns" style="font-size:11px"></i> Excel Monitor</a>
        <span class="em-breadcrumb-sep">&#8250;</span>
        <span class="em-breadcrumb-cur">@Model.File.FileName</span>
    </div>

    <!-- Page header -->
    <div class="em-page-header">
        <div style="display:flex;align-items:center;gap:14px">
            <div class="em-file-icon @ftCls" style="width:44px;height:44px;font-size:12px">@(Model.File.FileType?.ToUpper() ?? "XLS")</div>
            <div>
                <h1 class="em-page-title">@Model.File.FileName</h1>
                <div style="font-size:12px;color:var(--em-muted);font-family:monospace;margin-top:2px">@Model.File.FilePath</div>
            </div>
        </div>
        <div class="em-page-actions">
            @if (isActive)
            {
                <span class="em-status em-status-active"><span class="em-status-dot"></span>Monitoring</span>
            }
            else
            {
                <span class="em-status em-status-paused"><span class="em-status-dot"></span>Paused</span>
            }
            <button id="btnForceRead" class="em-btn em-btn-success" onclick="forceRead()" title="Đọc file ngay, lưu lịch sử dù file đang mở">
                <i class="fa-solid fa-rotate" style="font-size:11px"></i> Cập nhật ngay
            </button>
            <a href="/excel-monitor/@Model.File.Id/history" class="em-btn em-btn-outline">
                <i class="fa-solid fa-clock-rotate-left" style="font-size:11px"></i> Lịch sử đầy đủ
            </a>
            <a href="/excel-monitor" class="em-btn em-btn-ghost">
                <i class="fa-solid fa-arrow-left" style="font-size:11px"></i>
            </a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="em-kpi-row" style="margin-bottom:22px">
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-blue"><i class="fa-regular fa-clock"></i></div>
            <div>
                <div class="em-kpi-value" style="font-size:15px;letter-spacing:0;line-height:1.3">
                    @(Model.File.LastReadDate?.ToString("HH:mm:ss") ?? "––")
                </div>
                <div class="em-kpi-label">Lần đọc cuối</div>
                @if (Model.File.LastReadDate.HasValue)
                {
                    <div class="em-kpi-sub">@Model.File.LastReadDate.Value.ToString("dd/MM/yyyy")</div>
                }
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-yellow"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div>
                <div class="em-kpi-value">@Model.TotalChanges.ToString("N0")</div>
                <div class="em-kpi-label">Tổng thay đổi</div>
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon @(isActive ? "em-kpi-icon-green" : "em-kpi-icon-gray")">
                <i class="fa-solid fa-circle-dot"></i>
            </div>
            <div>
                <div class="em-kpi-value" style="font-size:15px;letter-spacing:0">
                    @(isActive ? "Đang Monitor" : "Đã tắt")
                </div>
                <div class="em-kpi-label">Trạng thái</div>
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon" style="background:#EDE9FE;color:#7C3AED;width:38px;height:38px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-size:16px">
                <i class="fa-regular fa-rectangle-list"></i>
            </div>
            <div>
                <div class="em-kpi-value">@Model.SheetGroups.Count</div>
                <div class="em-kpi-label">Sheet theo dõi</div>
            </div>
        </div>
    </div>

    <!-- Sheet data card -->
    @if (Model.SheetGroups.Any())
    {
        <div class="em-card">
            <div class="em-card-header">
                <h2 class="em-card-title"><i class="fa-regular fa-rectangle-list"></i> Dữ liệu Snapshot</h2>
                <div style="font-size:12px;color:var(--em-muted)">
                    @Model.SheetGroups.Sum(s => s.Groups.Sum(g => g.CurrentCount)).ToString("N0") dòng
                </div>
            </div>

            <!-- Sheet tabs -->
            <div class="em-sheet-tabs">
                @* Tab Đối chiếu — đầu tiên (chỉ khi ≥ 2 sheet) *@
                @if (Model.SheetGroups.Count >= 2)
                {
                    <button class="em-sheet-tab em-tab-cmp"
                            onclick="switchTab(-1)" id="tab_cmp"
                            style="border-left:3px solid #7C3AED;">
                        <i class="fa-solid fa-code-compare" style="font-size:11px;margin-right:4px"></i>Đối chiếu
                        <span style="font-size:11px;color:var(--em-muted);margin-left:4px">(@(Model.SheetGroups.Count) sheet)</span>
                    </button>
                }
                @for (int i = 0; i < Model.SheetGroups.Count; i++)
                {
                    <button class="em-sheet-tab @(i == 0 && Model.SheetGroups.Count < 2 ? "active" : "")"
                            onclick="switchTab(@i)" id="tab_@i">
                        @Model.SheetGroups[i].SheetName
                        <span style="font-size:11px;color:var(--em-muted);margin-left:4px">(@Model.SheetGroups[i].Groups.Count tổ)</span>
                    </button>
                }
            </div>

            <!-- Panel Đối chiếu -->
            @if (Model.SheetGroups.Count >= 2)
            {
                <div class="em-tab-content" id="tabContent_cmp">
                    <!-- Chọn sheet -->
                    <div style="display:flex;align-items:center;gap:16px;padding:16px 20px;background:var(--em-surface-2);border-bottom:1px solid var(--em-border);flex-wrap:wrap">
                        <div style="display:flex;align-items:center;gap:10px">
                            <span style="font-size:13px;font-weight:600;color:var(--em-text-md);white-space:nowrap">Sheet A:</span>
                            <select id="cmpSheetA" onchange="runCompare()" class="em-cmp-select">
                                @foreach (var s in Model.SheetGroups)
                                {
                                    <option value="@s.SheetName">@s.SheetName (@s.Groups.Count tổ)</option>
                                }
                            </select>
                        </div>
                        <div style="font-size:18px;color:var(--em-muted)"><i class="fa-solid fa-right-left"></i></div>
                        <div style="display:flex;align-items:center;gap:10px">
                            <span style="font-size:13px;font-weight:600;color:var(--em-text-md);white-space:nowrap">Sheet B:</span>
                            <select id="cmpSheetB" onchange="runCompare()" class="em-cmp-select">
                                @{ int cmpIdx = 0; }
                                @foreach (var s in Model.SheetGroups)
                                {
                                    cmpIdx++;
                                    if (cmpIdx == 2)
                                    {
                                        <option value="@s.SheetName" selected>@s.SheetName (@s.Groups.Count tổ)</option>
                                    }
                                    else
                                    {
                                        <option value="@s.SheetName">@s.SheetName (@s.Groups.Count tổ)</option>
                                    }
                                }
                            </select>
                        </div>
                        <span style="font-size:12px;color:var(--em-muted);margin-left:auto">Chỉ hiển thị các Tổ có sự khác biệt</span>
                    </div>
                    <!-- Kết quả -->
                    <div id="cmpResult" style="padding:16px 20px"></div>
                </div>
            }

            <!-- Sheet panels -->
            @for (int i = 0; i < Model.SheetGroups.Count; i++)
            {
                var sheetVm = Model.SheetGroups[i];
                <div class="em-tab-content @(i == 0 && Model.SheetGroups.Count < 2 ? "em-tab-content-active" : "")" id="tabContent_@i">

                    <div class="em-result-bar">
                        <i class="fa-solid fa-table" style="font-size:12px"></i>
                        Sheet <strong>@sheetVm.SheetName</strong>:
                        <span class="em-result-count">@sheetVm.Groups.Count</span> tổ &middot;
                        <span class="em-result-count">@sheetVm.Groups.Sum(g => g.CurrentCount).ToString("N0")</span> dòng snapshot
                    </div>

                    @if (sheetVm.Groups.Any())
                    {
                        <div class="em-table-wrap">
                            <table class="em-table">
                                <thead>
                                    <tr>
                                        <th style="width:40px">#</th>
                                        <th>Tổ (Group)</th>
                                        <th class="text-center">Số dòng hiện tại</th>
                                        <th class="text-center">Thao tác</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @{ int gNum = 0; }
                                    @foreach (var group in sheetVm.Groups.OrderBy(g => g.GroupName))
                                    {
                                        gNum++;
                                        <tr style="cursor:pointer" onclick="goToGroup('@Model.File.Id','@group.GroupName')">
                                            <td style="color:var(--em-muted-lt);font-size:12px">@gNum</td>
                                            <td>
                                                <div style="display:flex;align-items:center;gap:8px">
                                                    <span style="width:8px;height:8px;border-radius:50%;background:var(--em-accent);flex-shrink:0;display:inline-block"></span>
                                                    <span style="font-weight:600;color:var(--em-text)">@group.GroupName</span>
                                                </div>
                                            </td>
                                            <td class="text-center">
                                                <span class="em-badge em-badge-info">@group.CurrentCount dòng</span>
                                            </td>
                                            <td class="text-center">
                                                <a href="/excel-monitor/@Model.File.Id/history?groupName=@Uri.EscapeDataString(group.GroupName ?? "")"
                                                   class="em-btn em-btn-outline em-btn-sm"
                                                   onclick="event.stopPropagation()">
                                                    <i class="fa-solid fa-clock-rotate-left" style="font-size:10px"></i> Lịch sử
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td colspan="2" style="font-weight:700;color:var(--em-text);padding:10px 14px;background:var(--em-surface-2);border-top:2px solid var(--em-border)">Tổng cộng</td>
                                        <td class="text-center" style="padding:10px 14px;background:var(--em-surface-2);border-top:2px solid var(--em-border)">
                                            <strong>@sheetVm.Groups.Sum(g => g.CurrentCount).ToString("N0")</strong> dòng
                                        </td>
                                        <td style="background:var(--em-surface-2);border-top:2px solid var(--em-border)"></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="em-empty">
                            <i class="fa-regular fa-folder-open"></i>
                            <div class="em-empty-title">Chưa có dữ liệu snapshot</div>
                            <div class="em-empty-sub">Sheet này chưa được đọc lần nào.</div>
                        </div>
                    }
                </div>
            }
        </div>
    }
    else
    {
        <div class="em-card">
            <div class="em-empty">
                <i class="fa-regular fa-folder-open"></i>
                <div class="em-empty-title">Chưa có Sheet nào được cấu hình</div>
                <div class="em-empty-sub">Thêm cấu hình sheet trong phần Thao tác.</div>
            </div>
        </div>
    }

</div>

<style>
.em-tab-content { display: none; }
.em-tab-content-active { display: block; }
.em-btn-success {
    background: #16A34A; color: #fff; border: none;
    padding: 8px 16px; border-radius: var(--em-radius-sm);
    font-size: 13px; font-weight: 600; cursor: pointer;
    display: inline-flex; align-items: center; gap: 6px;
    transition: background 0.15s;
}
.em-btn-success:hover { background: #15803D; }
.em-btn-success:disabled { background: #86EFAC; cursor: not-allowed; }

/* Compare */
.em-cmp-select {
    padding: 6px 10px; border: 1px solid var(--em-border); border-radius: 6px;
    background: var(--em-surface); color: var(--em-text); font-size: 13px;
    min-width: 180px; cursor: pointer;
}
.em-cmp-table { width:100%; border-collapse:collapse; font-size:13px; }
.em-cmp-table th {
    padding: 8px 14px; background: var(--em-surface-2); color: var(--em-text-md);
    font-weight: 600; border-bottom: 2px solid var(--em-border); text-align:left;
}
.em-cmp-table td { padding: 8px 14px; border-bottom: 1px solid var(--em-border); }
.em-cmp-table tr:hover td { background: var(--em-surface-2); }
.em-cmp-only-a  { background: #FEF2F2 !important; }
.em-cmp-only-b  { background: #F0FDF4 !important; }
.em-cmp-diff    { background: #FFFBEB !important; }
.em-cmp-badge-a { display:inline-block;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:600;background:#FEE2E2;color:#DC2626; }
.em-cmp-badge-b { display:inline-block;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:600;background:#DCFCE7;color:#16A34A; }
.em-cmp-badge-n { display:inline-block;padding:2px 8px;border-radius:4px;font-size:12px;font-weight:600;background:#FEF3C7;color:#D97706; }
.em-cmp-summary { display:flex;gap:20px;margin-bottom:14px;padding:12px 0;flex-wrap:wrap; }
.em-cmp-sum-item { display:flex;align-items:center;gap:6px;font-size:13px; }
</style>

@section Scripts {
<script>
    const FILE_ID   = '@Model.File.Id';

    // Dữ liệu snapshot từ server (group name → count) cho từng sheet
    const SHEET_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
        Model.SheetGroups.ToDictionary(
            s => s.SheetName,
            s => s.Groups.ToDictionary(g => g.GroupName, g => g.CurrentCount)
        )
    ));

    async function forceRead() {
        Swal.fire({
            title: 'Đang cập nhật...',
            html: '<span style="font-size:13px;color:#6B7280">Vui lòng chờ trong giây lát.</span>',
            allowOutsideClick : false,
            allowEscapeKey    : false,
            allowEnterKey     : false,
            showConfirmButton : false,
            didOpen           : () => Swal.showLoading(),
        });
        try {
            const resp = await fetch(`/api/excel-file/${FILE_ID}/force-read`, { method: 'POST' });
            const data = await resp.json().catch(() => ({}));
            if (resp.ok) {
                await Swal.fire({
                    icon: 'success', title: 'Cập nhật thành công',
                    html: data.message || 'Dữ liệu đã được đọc lại.',
                    timer: 1500, showConfirmButton: false, allowOutsideClick: false,
                });
                location.reload();
            } else {
                Swal.fire({ icon: 'error', title: 'Lỗi cập nhật', text: data.message || 'Không thể đọc file.', confirmButtonColor: '#1E3A5F' });
            }
        } catch(e) {
            Swal.fire({ icon: 'error', title: 'Lỗi kết nối', text: e.message, confirmButtonColor: '#1E3A5F' });
        }
    }

    function switchTab(idx) {
        // -1 = tab đối chiếu, 0..n = tab sheet
        document.querySelectorAll('.em-sheet-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.em-tab-content').forEach(c => { c.classList.remove('em-tab-content-active'); c.style.display = 'none'; });

        if (idx === -1) {
            document.getElementById('tab_cmp')?.classList.add('active');
            const panel = document.getElementById('tabContent_cmp');
            if (panel) { panel.classList.add('em-tab-content-active'); panel.style.display = 'block'; }
        } else {
            document.getElementById(`tab_${idx}`)?.classList.add('active');
            const panel = document.getElementById(`tabContent_${idx}`);
            if (panel) { panel.classList.add('em-tab-content-active'); panel.style.display = 'block'; }
        }
    }
    function goToGroup(fileId, groupName) {
        window.location.href = `/excel-monitor/${fileId}/history?groupName=${encodeURIComponent(groupName)}`;
    }

    // ── So sánh Sheet ───────────────────────────────────────────
    function runCompare() {
        const selA = document.getElementById('cmpSheetA');
        const selB = document.getElementById('cmpSheetB');
        if (!selA || !selB) return;

        const nameA = selA.value, nameB = selB.value;
        const el    = document.getElementById('cmpResult');

        if (nameA === nameB) {
            el.innerHTML = '<div style="color:var(--em-muted);padding:20px 0;text-align:center"><i class="fa-solid fa-circle-info" style="margin-right:6px"></i>Vui lòng chọn 2 sheet khác nhau.</div>';
            return;
        }

        const mapA = SHEET_DATA[nameA] || {};
        const mapB = SHEET_DATA[nameB] || {};
        const allGroups = new Set([...Object.keys(mapA), ...Object.keys(mapB)]);

        // Phân loại
        const onlyA = [], onlyB = [], diff = [];
        allGroups.forEach(g => {
            const inA = g in mapA, inB = g in mapB;
            if (inA && !inB)  onlyA.push(g);
            else if (!inA && inB) onlyB.push(g);
            else if (mapA[g] !== mapB[g]) diff.push(g);
            // giống nhau hoàn toàn → bỏ qua
        });

        const total = onlyA.length + onlyB.length + diff.length;

        if (total === 0) {
            el.innerHTML = `
                <div style="text-align:center;padding:32px 0">
                    <div style="font-size:40px;margin-bottom:12px">🎉</div>
                    <div style="font-weight:700;font-size:15px;color:var(--em-text)">2 sheet giống nhau hoàn toàn!</div>
                    <div style="color:var(--em-muted);font-size:13px;margin-top:4px">Tất cả các Tổ có số dòng khớp nhau.</div>
                </div>`;
            return;
        }

        // Summary bar
        let html = `<div class="em-cmp-summary">
            <div class="em-cmp-sum-item"><span class="em-cmp-badge-a">− ${onlyA.length}</span> Chỉ có trong <strong>${nameA}</strong></div>
            <div class="em-cmp-sum-item"><span class="em-cmp-badge-b">+ ${onlyB.length}</span> Chỉ có trong <strong>${nameB}</strong></div>
            <div class="em-cmp-sum-item"><span class="em-cmp-badge-n">~ ${diff.length}</span> Số dòng khác nhau</div>
            <div class="em-cmp-sum-item" style="margin-left:auto;color:var(--em-muted)">Tổng: <strong>${total}</strong> khác biệt</div>
        </div>`;

        // Bảng
        html += `<div class="em-table-wrap"><table class="em-cmp-table">
            <thead><tr>
                <th style="width:40px">#</th>
                <th>Tổ (Group)</th>
                <th class="text-center">${nameA}</th>
                <th class="text-center">${nameB}</th>
                <th class="text-center">Đánh giá</th>
            </tr></thead><tbody>`;

        let idx = 0;
        const sorted = [
            ...onlyA.sort().map(g => ({ g, type: 'onlyA' })),
            ...onlyB.sort().map(g => ({ g, type: 'onlyB' })),
            ...diff.sort().map(g => ({ g, type: 'diff' })),
        ];

        sorted.forEach(({ g, type }) => {
            idx++;
            const cntA = g in mapA ? mapA[g] : null;
            const cntB = g in mapB ? mapB[g] : null;
            const rowCls = type === 'onlyA' ? 'em-cmp-only-a' : type === 'onlyB' ? 'em-cmp-only-b' : 'em-cmp-diff';
            const cellA  = cntA !== null ? `<span class="em-badge em-badge-info">${cntA} dòng</span>` : '<span style="color:var(--em-muted)">&#8211;</span>';
            const cellB  = cntB !== null ? `<span class="em-badge em-badge-info">${cntB} dòng</span>` : '<span style="color:var(--em-muted)">&#8211;</span>';
            let badge;
            if (type === 'onlyA')  badge = `<span class="em-cmp-badge-a">− Chỉ ${nameA}</span>`;
            else if (type === 'onlyB') badge = `<span class="em-cmp-badge-b">+ Chỉ ${nameB}</span>`;
            else {
                const delta = (cntB ?? 0) - (cntA ?? 0);
                badge = `<span class="em-cmp-badge-n">${delta > 0 ? '+' : ''}${delta} dòng</span>`;
            }
            html += `<tr class="${rowCls}">
                <td style="color:var(--em-muted-lt);font-size:12px">${idx}</td>
                <td><span style="font-weight:600">${g || '(trống)'}</span></td>
                <td class="text-center">${cellA}</td>
                <td class="text-center">${cellB}</td>
                <td class="text-center">${badge}</td>
            </tr>`;
        });

        html += '</tbody></table></div>';
        el.innerHTML = html;
    }

    document.addEventListener('DOMContentLoaded', () => {
        // Mặc định: hiện tab Đối chiếu nếu có ≥ 2 sheet, ngược lại hiện sheet đầu tiên
        if (document.getElementById('tab_cmp')) {
            switchTab(-1);
            runCompare();
        } else {
            switchTab(0);
        }
    });
</script>
}

