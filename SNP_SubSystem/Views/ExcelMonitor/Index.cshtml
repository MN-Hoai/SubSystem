@model List<SNP_SubSystem.Controllers.ExcelMonitor.ExcelMonitorIndexVm>
@{
    ViewData["Title"] = "Excel Monitor – Theo dõi file Excel";
    var activeCount  = Model.Count(f => f.Status == 1);
    var pausedCount  = Model.Count(f => f.Status == 0);
    var totalChanges = Model.Sum(f => f.TotalChanges);
    var lastChange   = Model.Where(f => f.LastChangeDate.HasValue)
                            .OrderByDescending(f => f.LastChangeDate)
                            .FirstOrDefault()?.LastChangeDate;
}

<div class="em-page">

    <!-- Page header -->
    <div class="em-page-header">
        <div>
            <h1 class="em-page-title">
                <i class="fa-solid fa-table-columns" style="font-size:17px;margin-right:8px;opacity:.7"></i>Excel Monitor
            </h1>
            <p class="em-page-subtitle">Theo dõi thay đổi file Excel theo thời gian thực</p>
        </div>
        <div class="em-page-actions">
            <span class="em-badge em-badge-success" style="padding:5px 12px">
                <span class="em-badge-dot" style="background:var(--em-success)"></span>
                Monitor đang chạy
            </span>
            <button class="em-btn em-btn-primary" onclick="showAddModal()">
                <i class="fa-solid fa-plus" style="font-size:11px"></i>
                Thêm file
            </button>
        </div>
    </div>

    <!-- KPI Row -->
    <div class="em-kpi-row">
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-blue"><i class="fa-solid fa-file-excel"></i></div>
            <div>
                <div class="em-kpi-value">@Model.Count</div>
                <div class="em-kpi-label">Tổng file</div>
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-green"><i class="fa-solid fa-circle-dot"></i></div>
            <div>
                <div class="em-kpi-value">@activeCount</div>
                <div class="em-kpi-label">Đang theo dõi</div>
                @if (pausedCount > 0)
                {
                    <div class="em-kpi-sub">@pausedCount tạm dừng</div>
                }
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-yellow"><i class="fa-solid fa-clock-rotate-left"></i></div>
            <div>
                <div class="em-kpi-value">@totalChanges.ToString("N0")</div>
                <div class="em-kpi-label">Tổng thay đổi</div>
            </div>
        </div>
        <div class="em-kpi-card">
            <div class="em-kpi-icon em-kpi-icon-gray"><i class="fa-regular fa-clock"></i></div>
            <div>
                <div class="em-kpi-value" style="font-size:18px;letter-spacing:0">
                    @(lastChange?.ToString("HH:mm") ?? "––")
                </div>
                <div class="em-kpi-label">Thay đổi gần nhất</div>
                @if (lastChange.HasValue)
                {
                    <div class="em-kpi-sub">@lastChange.Value.ToString("dd/MM/yyyy")</div>
                }
            </div>
        </div>
    </div>

    <!-- Main table card -->
    <div class="em-card">
        <div class="em-card-header">
            <h2 class="em-card-title">
                <i class="fa-solid fa-list"></i>
                Danh sách file Excel
            </h2>
            <div class="em-search-box">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="em-search-input" id="tableSearch"
                       placeholder="Tìm kiếm file..." oninput="filterTable(this.value)">
            </div>
        </div>

        @if (!Model.Any())
        {
            <div class="em-empty">
                <i class="fa-regular fa-folder-open"></i>
                <div class="em-empty-title">Chưa có file nào được monitor</div>
                <div class="em-empty-sub">Thêm file Excel để bắt đầu theo dõi thay đổi tự động.</div>
                <button class="em-btn em-btn-primary" onclick="showAddModal()">
                    <i class="fa-solid fa-plus" style="font-size:11px"></i> Thêm file đầu tiên
                </button>
            </div>
        }
        else
        {
            <div class="em-table-wrap">
                <table class="em-table" id="filesTable">
                    <thead>
                        <tr>
                            <th style="width:36px">#</th>
                            <th>File</th>
                            <th class="text-center">Trạng thái</th>
                            <th class="text-right">Thay đổi</th>
                            <th>Lần đọc cuối</th>
                            <th>Thay đổi cuối</th>
                            <th class="text-right" style="width:134px">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 0; }
                        @foreach (var file in Model)
                        {
                            rowNum++;
                            var isActive  = file.Status == 1;
                            var ft        = file.FileType?.ToLower() ?? "xlsx";
                            var ftCls     = ft == "xlsb" ? "em-ft-xlsb" : ft == "xlsm" ? "em-ft-xlsm" : "em-ft-xlsx";
                            var rowCls    = rowNum % 2 == 0 ? "em-table-row-odd" : "em-table-row-even";
                            var safeSearch= (file.FileName + " " + file.FilePath).ToLower();

                            <tr class="@rowCls" data-search="@safeSearch" oncontextmenu="showFileContextMenu(event, '@file.Id', '@file.FileName.Replace("'","\\'")')">
                                <td style="color:var(--em-muted-lt);font-size:12px">@rowNum</td>
                                <td>
                                    <div class="em-file-cell">
                                        <div class="em-file-icon @ftCls">@(file.FileType?.ToUpper() ?? "XLS")</div>
                                        <div>
                                            <div class="em-file-name-txt">@file.FileName</div>
                                            <div class="em-file-path-txt" title="@file.FilePath">@file.FilePath</div>
                                        </div>
                                    </div>
                                </td>

                                <td class="text-center">
                                    @if (isActive)
                                    {
                                        <span class="em-status em-status-active">
                                            <span class="em-status-dot"></span>Monitoring
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="em-status em-status-paused">
                                            <span class="em-status-dot"></span>Paused
                                        </span>
                                    }
                                </td>
                                <td class="text-right">
                                    <span style="font-size:14px;font-weight:700;color:var(--em-text)">@file.TotalChanges.ToString("N0")</span>
                                </td>
                                <td>
                                    @if (file.LastReadDate.HasValue)
                                    {
                                        <div style="font-size:13px;font-weight:600;color:var(--em-text-md)">@file.LastReadDate.Value.ToString("dd/MM/yyyy")</div>
                                        <div style="font-size:11px;color:var(--em-muted);font-family:monospace">@file.LastReadDate.Value.ToString("HH:mm:ss")</div>
                                    }
                                    else { <span style="color:var(--em-muted)">&#8211;</span> }
                                </td>
                                <td>
                                    @if (file.LastChangeDate.HasValue)
                                    {
                                        <div style="font-size:13px;font-weight:600;color:var(--em-text-md)">@file.LastChangeDate.Value.ToString("dd/MM/yyyy")</div>
                                        <div style="font-size:11px;color:var(--em-muted);font-family:monospace">@file.LastChangeDate.Value.ToString("HH:mm:ss")</div>
                                    }
                                    else { <span style="color:var(--em-muted)">&#8211;</span> }
                                </td>
                                <td>
                                    <div class="em-tbl-actions">
                                        <a href="/excel-monitor/@file.Id" class="em-tbl-btn" title="Chi tiết"><i class="fa-solid fa-eye"></i></a>
                                        <a href="/excel-monitor/@file.Id/history" class="em-tbl-btn" title="Lịch sử"><i class="fa-solid fa-clock-rotate-left"></i></a>
                                        <button class="em-tbl-btn em-tbl-btn-success" title="Cập nhật ngay"
                                                onclick="forceReadFile('@file.Id','@file.FileName.Replace("'","\\'")')"><i class="fa-solid fa-rotate"></i></button>
                                        <button class="em-tbl-btn" title="Cấu hình"
                                                onclick="showEditModal('@file.Id','@file.FileName.Replace("'","\\'"))')"><i class="fa-solid fa-gear"></i></button>
                                        <button class="em-tbl-btn em-tbl-btn-warn" title="Tạm ngưng"
                                                onclick="pauseFile('@file.Id','@file.FileName.Replace("'","\\'"))')"><i class="fa-solid fa-pause"></i></button>
                                        <button class="em-tbl-btn em-tbl-btn-danger" title="Xóa cứng"
                                                onclick="hardDeleteFile('@file.Id','@file.FileName.Replace("'","\\'"))')"><i class="fa-solid fa-trash"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Context Menu -->
<div id="fileContextMenu" style="display:none; position:fixed; z-index:2147483647; background:white; border:1px solid var(--em-border); border-radius:8px; box-shadow:0 4px 15px rgba(0,0,0,0.15); min-width:180px; padding:8px 0; font-size:13px; font-weight:600;">
    <div style="padding:4px 16px; font-size:11px; color:var(--em-muted); text-transform:uppercase; letter-spacing:0.5px; border-bottom:1px solid var(--em-border); margin-bottom:4px;">5 Sheet có thay đổi gần nhất</div>
    <div id="cmSheetList"></div>
</div>

<!-- ══ Modal Thêm File ══════════════════════════════════════════ -->
<div class="em-modal-overlay" id="addModal" style="display:none">
    <div class="em-modal">
        <div class="em-modal-header">
            <h3 class="em-modal-title">
                <i class="fa-solid fa-plus" style="margin-right:6px;color:var(--em-accent)"></i>Thêm file Excel
            </h3>
            <button class="em-modal-close" onclick="closeAddModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="em-modal-body">
            <div class="em-form-group">
                <label class="em-form-label">Đường dẫn file *</label>
                <input type="text" id="filePath" class="em-form-control"
                       placeholder="D:\Production\SNP Production.xlsb" />
                <div class="em-form-hint">Đường dẫn vật lý tới file Excel trên máy chủ</div>
            </div>
            <hr class="em-form-divider">
            <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                <label class="em-form-label" style="margin:0">Cấu hình Sheet</label>
                <button type="button" class="em-btn em-btn-outline em-btn-sm" onclick="addSheetConfig()">
                    <i class="fa-solid fa-plus" style="font-size:10px"></i> Thêm sheet
                </button>
            </div>
            <div class="em-sheet-row-hdr">
                <span>Tên Sheet</span><span>Cột Tổ</span><span>RowKey (phân cách phẩy)</span><span></span>
            </div>
            <div class="em-sheet-rows" id="sheetConfigs"></div>
        </div>
        <div class="em-modal-footer">
            <button class="em-btn em-btn-ghost" onclick="closeAddModal()">Hủy</button>
            <button class="em-btn em-btn-primary" onclick="submitAddFile()" id="submitBtn">
                <span id="submitText"><i class="fa-solid fa-circle-play" style="font-size:11px"></i> Thêm &amp; bắt đầu Monitor</span>
                <span id="submitSpinner" style="display:none;align-items:center;gap:6px"><span class="em-spinner" style="width:14px;height:14px;border-width:2px"></span> Đang xử lý...</span>
            </button>
        </div>
    </div>
</div>

<!-- ══ Modal Chỉnh sửa cấu hình ════════════════════════════════ -->
<div class="em-modal-overlay" id="editModal" style="display:none">
    <div class="em-modal" style="max-width:700px">
        <div class="em-modal-header">
            <div>
                <h3 class="em-modal-title" id="editModalTitle">Cấu hình file</h3>
                <div id="editModalPath" style="font-size:11.5px;color:var(--em-muted);margin-top:3px;font-family:monospace"></div>
            </div>
            <button class="em-modal-close" onclick="closeEditModal()"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <div class="em-modal-body">
            <div id="editLoading" style="text-align:center;padding:32px">
                <span class="em-spinner"></span>
                <div style="margin-top:10px;font-size:13px;color:var(--em-muted)">Đang tải cấu hình...</div>
            </div>
            <div id="editFormContent" style="display:none">
                <div class="em-toggle-row">
                    <label class="em-toggle">
                        <input type="checkbox" id="editStatusToggle" onchange="onStatusToggle(this)">
                        <span class="em-toggle-slider"></span>
                    </label>
                    <span class="em-toggle-label" id="editStatusLabel">Đang Monitor</span>
                </div>
                <hr class="em-form-divider">
                <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:8px">
                    <label class="em-form-label" style="margin:0">Cấu hình Sheet</label>
                    <button type="button" class="em-btn em-btn-outline em-btn-sm" onclick="addEditSheetRow()">
                        <i class="fa-solid fa-plus" style="font-size:10px"></i> Thêm sheet
                    </button>
                </div>
                <div class="em-sheet-row-hdr" style="grid-template-columns:1fr 80px 1fr 28px 40px">
                    <span>Tên Sheet</span><span>Cột Tổ</span><span>RowKey</span><span>Bật</span><span></span>
                </div>
                <div class="em-sheet-rows" id="editSheetList"></div>
            </div>
        </div>
        <div class="em-modal-footer">
            <button class="em-btn em-btn-ghost" onclick="closeEditModal()">Hủy</button>
            <button class="em-btn em-btn-primary" onclick="submitEditFile()" id="editSubmitBtn">
                <span id="editSubmitText"><i class="fa-solid fa-floppy-disk" style="font-size:11px"></i> Lưu cấu hình</span>
                <span id="editSubmitSpinner" style="display:none;align-items:center;gap:6px"><span class="em-spinner" style="width:14px;height:14px;border-width:2px"></span> Đang lưu...</span>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // ── Force read ────────────────────────────────────────────
    async function forceReadFile(id, name) {
        const btn = document.querySelector(`button[onclick*="forceReadFile('${id}"]`);
        if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fa-solid fa-rotate fa-spin"></i>'; }

        try {
            const resp = await fetch(`/api/excel-file/${id}/force-read`, { method: 'POST' });
            const data = await resp.json().catch(() => ({}));
            if (resp.ok) {
                toastr.success(`Đã cập nhật: ${name}`, 'Cập nhật thành công');
                setTimeout(() => location.reload(), 800);
            } else {
                toastr.error(data.message || data || 'Lỗi cập nhật', name);
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate"></i>'; }
            }
        } catch (e) {
            toastr.error('Lỗi kết nối: ' + e.message);
            if (btn) { btn.disabled = false; btn.innerHTML = '<i class="fa-solid fa-rotate"></i>'; }
        }
    }

    // ── Table search ─────────────────────────────────────────────
    function filterTable(q) {
        const rows = document.querySelectorAll('#filesTable tbody tr');
        q = q.toLowerCase();
        rows.forEach(r => { r.style.display = r.dataset.search.includes(q) ? '' : 'none'; });
    }

    // ── Add modal ─────────────────────────────────────────────────
    let sheetConfigCount = 0;
    function showAddModal() {
        document.getElementById('addModal').style.display = 'flex';
        sheetConfigCount = 0;
        document.getElementById('sheetConfigs').innerHTML = '';
        document.getElementById('filePath').value = '';
        addSheetConfig();
    }
    function closeAddModal() { document.getElementById('addModal').style.display = 'none'; }
    function addSheetConfig() {
        const idx = sheetConfigCount++;
        document.getElementById('sheetConfigs').insertAdjacentHTML('beforeend', `
            <div class="em-sheet-row" id="sc_${idx}">
                <input type="text" class="em-form-control" id="sc_sheet_${idx}" placeholder="09.09" />
                <input type="text" class="em-form-control" id="sc_group_${idx}" placeholder="TỔ" value="TỔ" />
                <input type="text" class="em-form-control" id="sc_rowkey_${idx}" placeholder="STYLE,SP,COLOR" value="STYLE,SP,COLOR" />
                <button type="button" class="em-sheet-remove" onclick="removeSheet(${idx})"><i class="fa-solid fa-xmark"></i></button>
            </div>`);
    }
    function removeSheet(idx) { document.getElementById('sc_' + idx)?.remove(); }

    async function submitAddFile() {
        const filePath = document.getElementById('filePath').value.trim();
        if (!filePath) { toastr.warning('Vui lòng nhập đường dẫn file'); return; }
        const sheetConfigs = [];
        for (let i = 0; i < sheetConfigCount; i++) {
            const el = document.getElementById('sc_' + i);
            if (!el) continue;
            const sheetName = document.getElementById('sc_sheet_' + i)?.value?.trim();
            if (!sheetName) continue;
            const groupCol  = document.getElementById('sc_group_' + i)?.value?.trim() || 'TỔ';
            const rowKeyRaw = document.getElementById('sc_rowkey_' + i)?.value?.trim() || '';
            const rowKeys   = rowKeyRaw.split(',').map(s => s.trim()).filter(Boolean);
            sheetConfigs.push({ sheetName, groupColumn: groupCol, rowKeyColumns: rowKeys });
        }
        const btn = document.getElementById('submitBtn');
        const txt = document.getElementById('submitText');
        const spn = document.getElementById('submitSpinner');
        btn.disabled = true; txt.style.display = 'none'; spn.style.display = 'inline-flex';
        try {
            const resp = await fetch('/api/excel-file', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ filePath, sheetConfigs })
            });
            if (resp.ok) { closeAddModal(); location.reload(); }
            else { const err = await resp.text(); toastr.error('Lỗi: ' + err); }
        } catch (e) { toastr.error('Lỗi kết nối: ' + e.message); }
        finally { btn.disabled = false; txt.style.display = 'inline'; spn.style.display = 'none'; }
    }

    // ── Pause ────────────────────────────────────────────────────
    async function pauseFile(id, name) {
        const r = await Swal.fire({
            title: 'Tạm ngừng monitor?',
            html: `File <strong>${name}</strong> sẽ bị tạm dừng.<br><span style="font-size:12px;color:#6B7280">Lịch sử thay đổi vẫn được giữ lại.</span>`,
            icon: 'warning', iconColor: '#F59E0B', showCancelButton: true, reverseButtons: true,
            confirmButtonText: 'Tạm ngừng', cancelButtonText: 'Hủy',
            confirmButtonColor: '#F59E0B', cancelButtonColor: '#9CA3AF',
        });
        if (!r.isConfirmed) return;
        const resp = await fetch(`/api/excel-file/${id}`, { method: 'DELETE' });
        if (resp.ok) { Swal.fire({ title: 'Đã tạm ngừng', icon: 'success', timer: 1500, showConfirmButton: false }); setTimeout(() => location.reload(), 1500); }
        else { Swal.fire('Lỗi', 'Không thể tạm ngừng', 'error'); }
    }
    async function deleteFile(id, name) { await pauseFile(id, name); }

    // ── Hard delete ───────────────────────────────────────────────
    async function hardDeleteFile(id, name) {
        const s1 = await Swal.fire({
            title: '<span style="color:#DC2626">⚠️ Xóa cứng file</span>',
            html: `<p style="margin:0 0 12px">Thao tác này sẽ <strong>xóa vĩnh viễn</strong> toàn bộ:</p>
                   <ul style="text-align:left;font-size:13px;color:#374151;margin:0 0 14px;padding-left:20px">
                       <li>File monitor: <strong>${name}</strong></li>
                       <li>Toàn bộ lịch sử thay đổi (ChangeLog)</li>
                       <li>Snapshot dữ liệu hiện tại</li><li>Cấu hình Sheet</li>
                   </ul>
                   <p style="color:#DC2626;font-size:13px;font-weight:700;margin:0">Dữ liệu KHÔNG thể khôi phục!</p>`,
            icon: 'warning', iconColor: '#DC2626', showCancelButton: true, reverseButtons: true,
            confirmButtonText: 'Tiếp tục →', cancelButtonText: 'Hủy',
            confirmButtonColor: '#DC2626', cancelButtonColor: '#9CA3AF',
        });
        if (!s1.isConfirmed) return;
        const s2 = await Swal.fire({
            title: 'Nhập mật khẩu xác nhận',
            html: `<p style="font-size:13px;color:#6B7280;margin:0 0 12px">Nhập mật khẩu để xác nhận xóa cứng:</p>
                   <input id="swal-pwd" type="password" class="swal2-input" placeholder="Mật khẩu xác nhận" style="font-size:15px;letter-spacing:2px" autofocus>`,
            icon: 'warning', iconColor: '#DC2626', showCancelButton: true, reverseButtons: true,
            confirmButtonText: 'Xác nhận xóa', cancelButtonText: 'Hủy',
            confirmButtonColor: '#DC2626', cancelButtonColor: '#9CA3AF',
            focusConfirm: false,
            preConfirm: () => {
                const pwd = document.getElementById('swal-pwd').value;
                if (pwd !== 'Snp-753951') { Swal.showValidationMessage('Mật khẩu không đúng!'); return false; }
                return true;
            },
            didOpen: () => { document.getElementById('swal-pwd').addEventListener('keydown', e => { if (e.key === 'Enter') Swal.clickConfirm(); }); }
        });
        if (!s2.isConfirmed) return;
        Swal.fire({ title: 'Đang xóa dữ liệu...', allowOutsideClick: false, didOpen: () => Swal.showLoading() });
        const resp = await fetch(`/api/excel-file/${id}/hard-delete`, { method: 'DELETE' });
        if (resp.ok) {
            await Swal.fire({ title: 'Đã xóa thành công', text: `File "${name}" và toàn bộ dữ liệu liên quan đã bị xóa.`, icon: 'success', confirmButtonColor: '#1E3A5F' });
            location.reload();
        } else {
            const err = await resp.text(); Swal.fire('Lỗi', `Không thể xóa: ${err}`, 'error');
        }
    }

    // ── Close overlay on click ────────────────────────────────────
    document.getElementById('addModal').addEventListener('click', function(e) { if (e.target === this) closeAddModal(); });
    document.getElementById('editModal').addEventListener('click', function(e) { if (e.target === this) closeEditModal(); });

    // ── Edit modal ────────────────────────────────────────────────
    let currentEditId = null, editSheetCount = 0;
    async function showEditModal(fileId, fileName) {
        currentEditId = fileId; editSheetCount = 0;
        document.getElementById('editModalTitle').textContent = fileName;
        document.getElementById('editModalPath').textContent  = '';
        document.getElementById('editLoading').style.display     = 'block';
        document.getElementById('editFormContent').style.display = 'none';
        document.getElementById('editSheetList').innerHTML = '';
        document.getElementById('editModal').style.display = 'flex';
        try {
            const resp = await fetch(`/api/excel-file/${fileId}`);
            if (!resp.ok) { toastr.error('Không thể tải cấu hình file'); closeEditModal(); return; }
            const data = await resp.json();
            document.getElementById('editModalPath').textContent = data.filePath || '';
            const toggle = document.getElementById('editStatusToggle');
            toggle.checked = data.status === 1;
            updateStatusLabel(toggle.checked);
            (data.sheetConfigs || []).forEach(sc => addEditSheetRow(sc.sheetName, sc.groupColumn, parseRowKeys(sc.rowKeyColumns), sc.status));
            document.getElementById('editLoading').style.display     = 'none';
            document.getElementById('editFormContent').style.display = 'block';
        } catch (e) { toastr.error('Lỗi tải cấu hình: ' + e.message); closeEditModal(); }
    }
    function closeEditModal() { document.getElementById('editModal').style.display = 'none'; currentEditId = null; }
    function onStatusToggle(el) { updateStatusLabel(el.checked); }
    function updateStatusLabel(isActive) {
        const lbl = document.getElementById('editStatusLabel');
        lbl.textContent = isActive ? 'Đang Monitor' : 'Tạm dừng';
        lbl.style.color = isActive ? 'var(--em-success)' : 'var(--em-muted)';
    }
    function addEditSheetRow(sheetName = '', groupCol = 'TỔ', rowKeys = 'STYLE,SP,COLOR', status = 1) {
        const idx = editSheetCount++;
        document.getElementById('editSheetList').insertAdjacentHTML('beforeend', `
            <div class="em-sheet-row" id="esr_${idx}" style="grid-template-columns:1fr 80px 1fr 28px 40px">
                <input type="text" class="em-form-control" id="esr_sheet_${idx}" value="${escHtml(sheetName)}" placeholder="09.09" />
                <input type="text" class="em-form-control" id="esr_group_${idx}" value="${escHtml(groupCol)}" placeholder="TỔ" />
                <input type="text" class="em-form-control" id="esr_rowkey_${idx}" value="${escHtml(rowKeys)}" placeholder="STYLE,SP,COLOR" />
                <label style="display:flex;align-items:center;justify-content:center;cursor:pointer">
                    <input type="checkbox" id="esr_active_${idx}" ${status===1?'checked':''} style="width:14px;height:14px;accent-color:var(--em-success)">
                </label>
                <button type="button" class="em-sheet-remove" onclick="removeEditSheetRow(${idx})"><i class="fa-solid fa-xmark"></i></button>
            </div>`);
    }
    function removeEditSheetRow(idx) { document.getElementById('esr_' + idx)?.remove(); }
    function parseRowKeys(val) {
        if (!val) return '';
        if (Array.isArray(val)) return val.join(',');
        try { const a = JSON.parse(val); return Array.isArray(a) ? a.join(',') : val; } catch { return val; }
    }
    function escHtml(str) {
        return (str||'').replace(/&/g,'&amp;').replace(/"/g,'&quot;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    async function submitEditFile() {
        if (!currentEditId) return;
        const status = document.getElementById('editStatusToggle').checked ? 1 : 0;
        const sheetConfigs = [];
        for (let i = 0; i < editSheetCount; i++) {
            const el = document.getElementById('esr_' + i);
            if (!el) continue;
            const sheetName = document.getElementById('esr_sheet_' + i)?.value?.trim();
            if (!sheetName) continue;
            const groupCol  = document.getElementById('esr_group_' + i)?.value?.trim()  || 'TỔ';
            const rowKeyRaw = document.getElementById('esr_rowkey_' + i)?.value?.trim() || '';
            const rowKeys   = rowKeyRaw.split(',').map(s => s.trim()).filter(Boolean);
            const isActive  = document.getElementById('esr_active_' + i)?.checked ? 1 : 0;
            sheetConfigs.push({ sheetName, groupColumn: groupCol, rowKeyColumns: rowKeys, status: isActive });
        }
        const btn = document.getElementById('editSubmitBtn');
        const txt = document.getElementById('editSubmitText');
        const spn = document.getElementById('editSubmitSpinner');
        btn.disabled = true; txt.style.display = 'none'; spn.style.display = 'inline-flex';
        try {
            const resp = await fetch(`/api/excel-file/${currentEditId}`, {
                method: 'PUT', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ status, sheetConfigs })
            });
            if (resp.ok) { closeEditModal(); location.reload(); }
            else { const err = await resp.text(); toastr.error('Lỗi: ' + err); }
        } catch (e) { toastr.error('Lỗi kết nối: ' + e.message); }
        finally { btn.disabled = false; txt.style.display = 'inline'; spn.style.display = 'none'; }
    }

    // ── Context Menu ────────────────────────────────────────────────
    let currentCtxFileId = null;
    async function showFileContextMenu(e, fileId, fileName) {
        e.preventDefault();
        currentCtxFileId = fileId;
        const menu = document.getElementById('fileContextMenu');
        const list = document.getElementById('cmSheetList');
        
        list.innerHTML = '<div style="padding:8px 16px; color:var(--em-muted); font-size:12px;"><i class="fa-solid fa-spinner fa-spin" style="margin-right:6px"></i>Đang tải...</div>';
        
        // Position menu
        menu.style.display = 'block';
        let x = e.clientX;
        let y = e.clientY;
        
        // Adjust if it goes out of window
        if (x + menu.offsetWidth > window.innerWidth) x = window.innerWidth - menu.offsetWidth - 10;
        if (y + menu.offsetHeight > window.innerHeight) y = window.innerHeight - menu.offsetHeight - 10;
        
        menu.style.left = x + 'px';
        menu.style.top = y + 'px';

        try {
            const resp = await fetch(`/excel-monitor/${fileId}/recent-sheets`);
            const data = await resp.json();
            
            if (data.success && data.sheets && data.sheets.length > 0) {
                let html = '';
                data.sheets.forEach(sheet => {
                    html += `<div style="padding:8px 16px; cursor:pointer; color:var(--em-text-md); transition:background 0.2s;" onmouseover="this.style.background='var(--em-bg-secondary)'" onmouseout="this.style.background=''" onclick="openQuickInfoFromMenu('${fileId}', '${sheet.replace(/'/g,"\\'")}')"><i class="fa-regular fa-file-excel" style="color:var(--em-accent); margin-right:8px;"></i>${sheet}</div>`;
                });
                list.innerHTML = html;
            } else {
                list.innerHTML = '<div style="padding:8px 16px; color:var(--em-muted); font-size:12px; font-style:italic;">Chưa có lịch sử thay đổi</div>';
            }
        } catch (err) {
            list.innerHTML = '<div style="padding:8px 16px; color:red; font-size:12px;">Lỗi tải dữ liệu</div>';
        }
    }

    function openQuickInfoFromMenu(fileId, sheetName) {
        document.getElementById('fileContextMenu').style.display = 'none';
        window.location.href = `/excel-monitor/${fileId}/history?sheetName=${encodeURIComponent(sheetName)}&quickInfo=1`;
    }

    // Hide context menu when clicking outside
    document.addEventListener('click', function(e) {
        if (!e.target.closest('#fileContextMenu')) {
            document.getElementById('fileContextMenu').style.display = 'none';
        }
    });
</script>
}