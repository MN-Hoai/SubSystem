@{
    ViewData["Title"] = "Trang chủ";
}

<div class="content-area">

    <div class="home-header">
        <div>
            <h1 class="home-title">Bảng điều khiển</h1>
            <p class="home-sub">Chọn phân hệ để bắt đầu làm việc</p>
        </div>
        <div class="home-meta">
            <span><i class="fa-solid fa-circle" style="font-size:8px;color:var(--success);"></i> Hệ thống hoạt động bình thường</span>
        </div>
    </div>

    <!-- === TỔNG QUAN === -->
    <div class="home-group-label">
        <i class="fa-solid fa-chart-line"></i> Tổng quan
    </div>
    <div class="home-grid">

        <a asp-controller="ProductionProgress" asp-action="LineProgress" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#1F3A67,#2d5299);">
                <i class="fa-solid fa-chart-line"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Tiến độ sản xuất</div>
                <div class="hc-desc">Theo dõi sản lượng, tiến độ các chuyền may theo thời gian thực</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a asp-controller="ProductionDepartment" asp-action="ATDepartment" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#0e7490,#0891b2);">
                <i class="fa-solid fa-display"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Tiến độ bộ phận</div>
                <div class="hc-desc">Xem sản lượng, tiến độ và thông tin máy của từng bộ phận</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

    </div>

    <!-- === SẢN XUẤT === -->
    <div class="home-group-label">
        <i class="fa-solid fa-industry"></i> Sản xuất
    </div>
    <div class="home-grid">

        <a asp-controller="ProductionProgress" asp-action="ATProgress" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#1F3A67,#3a5fa8);">
                <i class="fa-solid fa-industry"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Thông tin mã hàng</div>
                <div class="hc-desc">Danh sách mã hàng đang sản xuất, lọc theo Line, bộ phận, trạng thái</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a asp-controller="ProductionProgress" asp-action="ProductionInfoForm" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#0d7c5b,#14a870);">
                <i class="fa-solid fa-circle-plus"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Thêm mã hàng</div>
                <div class="hc-desc">Tạo mới hoặc nhập hàng loạt từ file Excel</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a asp-controller="StyleInfo" asp-action="Index" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#7c3aed,#9f5ef7);">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Chi tiết mã hàng</div>
                <div class="hc-desc">Quản lý StyleInfo và danh sách công đoạn của từng mã hàng</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a asp-controller="ProductionDepartment" asp-action="RecordOutput" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#be185d,#ec4899);">
                <i class="fa-solid fa-pen-to-square"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Ghi sản lượng</div>
                <div class="hc-desc">Nhập số liệu sản lượng theo ca, theo máy cho từng mã hàng</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

    </div>

    <!-- === QUẢN LÝ === -->
    <div class="home-group-label">
        <i class="fa-solid fa-gears"></i> Quản lý
    </div>
    <div class="home-grid">

        <a asp-controller="ProductionDepartment" asp-action="DepartmentList" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#b45309,#d97706);">
                <i class="fa-solid fa-building-user"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Quản lý bộ phận</div>
                <div class="hc-desc">Tạo, xem, chỉnh sửa, tạm khoá các bộ phận sản xuất</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a asp-controller="MachineLayoutDesigner" asp-action="Index" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#065f46,#10b981);">
                <i class="fa-solid fa-border-all"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Thiết kế layout</div>
                <div class="hc-desc">Thiết kế sơ đồ vị trí máy móc trong từng bộ phận sản xuất</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-arrow-right"></i></div>
        </a>

    </div>

    <!-- === QUẢN TRỊ === -->
    <div class="home-group-label">
        <i class="fa-solid fa-shield-halved"></i> Quản trị
    </div>
    <div class="home-grid">

        <a asp-controller="Account" asp-action="Index" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#374151,#6b7280);">
                <i class="fa-solid fa-user-shield"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Quản lý tài khoản <span class="hc-soon"></span></div>
                <div class="hc-desc">Quản lý người dùng, thông tin tài khoản đăng nhập hệ thống</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-lock"></i></div>
        </a>

        <a asp-controller="Role" asp-action="Index" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#374151,#6b7280);">
                <i class="fa-solid fa-key"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Phân quyền <span class="hc-soon"></span></div>
                <div class="hc-desc">Thiết lập vai trò và quyền truy cập cho từng tài khoản</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-lock"></i></div>
        </a>

        <a asp-controller="Settings" asp-action="Index" class="home-card">
            <div class="hc-icon" style="background:linear-gradient(135deg,#374151,#6b7280);">
                <i class="fa-solid fa-gear"></i>
            </div>
            <div class="hc-body">
                <div class="hc-name">Cài đặt hệ thống <span class="hc-soon"></span></div>
                <div class="hc-desc">Cấu hình thông số chung, backup dữ liệu và bảo trì hệ thống</div>
            </div>
            <div class="hc-arrow"><i class="fa-solid fa-lock"></i></div>
        </a>

    </div>
<footer style="text-align: center; padding: 16px 24px; font-size: 13px; color: var(--ink-400);">
    <p>@DateTime.Now.ToString("dd/MM/yyyy HH:mm") | Copy by Mai_Nhat_Hoai_N20226 </p>
</footer>

</div>

<style>
.home-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 10px;
}
.home-title {
    font-size: 26px;
    font-weight: 800;
    color: var(--ink-900);
    margin: 0 0 4px;
    letter-spacing: -.3px;
}
.home-sub {
    font-size: 14px;
    color: var(--ink-500);
    margin: 0;
}
.home-meta {
    font-size: 12.5px;
    color: var(--ink-500);
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    background: var(--bg-surface);
    border-radius: 20px;
    border: 1px solid var(--border);
}
.home-group-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: .8px;
    text-transform: uppercase;
    color: var(--ink-500);
    margin: 24px 0 12px;
    padding-left: 2px;
}
.home-group-label i { color: var(--ink-400); font-size: 12px; }
.home-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(130px, 1fr));
    gap: 20px;
    margin-bottom: 16px;
}

/* ── Card ──────────────────────────────────────────────────────── */
.home-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: 0;
    padding: 24px 12px 16px;
    background: rgba(255, 255, 255, 0.25);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 20px;
    text-decoration: none;
    color: var(--ink-900);
    transition: all 0.3s cubic-bezier(.34,1.56,.64,1);
    box-shadow: 0 8px 32px rgba(31, 38, 135, 0.05);
}

.home-card:hover {
    transform: translateY(-5px);
    background: rgba(255, 255, 255, 0.45);
    box-shadow: 0 12px 40px rgba(31, 38, 135, 0.1);
    border-color: rgba(255, 255, 255, 0.6);
}

/* ── Icon ───────────────────────────────────────────────────────── */
.hc-icon {
    width: 60px;
    height: 60px;
    flex-shrink: 0;
    border-radius: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 26px;
    color: #fff;
    margin-bottom: 16px;
    transition: transform .3s cubic-bezier(.34,1.56,.64,1);
    box-shadow: 0 6px 16px rgba(0,0,0,0.15);
}
.home-card:hover .hc-icon {
    transform: rotate(-6deg) scale(1.1);
}

/* ── Body ───────────────────────────────────────────────────────── */
.hc-body {
    width: 100%;
    text-align: center;
}
.hc-name {
    font-size: 13.5px;
    font-weight: 700;
    color: var(--ink-900);
    line-height: 1.3;
    white-space: normal;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
}
.hc-desc {
    display: none; /* Ẩn mô tả để hiển thị dạng icon */
}

/* ── Arrow ──────────────────────────────────────────────────────── */
.hc-arrow {
    display: none; /* Ẩn mũi tên */
}

/* ── Locked card (không có quyền) ──────────────────────────────── */
.hc-locked {
    opacity: 0.6;
    pointer-events: auto;
}
.hc-soon {
    display: none;
}
</style>

@if (User.Identity != null && User.Identity.IsAuthenticated)
{
<script>
(function() {
    fetch('/Role/MyPermissions')
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.isAdmin) return; // admin — không khóa gì

            var allowedPaths = data.paths || [];

            function isAllowed(href) {
                if (!href || href === '#' || href === '/') return true;
                return allowedPaths.some(function(p) {
                    return href.startsWith(p) || p.startsWith(href);
                });
            }

            function showNoAccess() {
                Swal.fire({
                    icon: 'warning',
                    title: 'Không có quyền truy cập',
                    text: 'Tài khoản của bạn chưa được cấp quyền vào trang này. Vui lòng liên hệ quản trị viên.',
                    confirmButtonText: 'Đã hiểu',
                    confirmButtonColor: '#3a5fa8',
                });
                return false;
            }

            // Home cards
            document.querySelectorAll('.home-card[href]').forEach(function(card) {
                var href = card.getAttribute('href');
                if (!isAllowed(href)) {
                    card.classList.add('hc-locked');
                    card.addEventListener('click', function(e) {
                        e.preventDefault();
                        showNoAccess();
                    });
                }
            });
        })
        .catch(function() { /* giữ nguyên nếu lỗi */ });
})();
</script>
}

