<!-- ================================================================
     BULK ACTION BAR
================================================================ -->
<div id="mdBulkBar" style="display:none;position:fixed;bottom:28px;left:50%;transform:translateX(-50%);z-index:9998;background:var(--accent-navy);color:#fff;border-radius:12px;padding:12px 20px;box-shadow:0 8px 28px rgba(31,58,103,.35);display:none;align-items:center;gap:16px;">
    <span id="mdBulkLabel" style="font-size:13.5px;font-weight:700;"></span>
    <button id="mdBulkRemove" style="padding:7px 16px;border-radius:8px;background:rgba(255,255,255,.18);color:#fff;border:1.5px solid rgba(255,255,255,.35);font-size:13px;font-weight:700;cursor:pointer;font-family:inherit;transition:background .18s;">
        <i class="fa-solid fa-circle-stop"></i> Tách khỏi máy
    </button>
    <button id="mdBulkClear" style="padding:7px 12px;border-radius:8px;background:transparent;color:rgba(255,255,255,.7);border:none;font-size:13px;cursor:pointer;font-family:inherit;transition:color .18s;">
        <i class="fa-solid fa-xmark"></i>
    </button>
</div>

<script>
(function () {
    /* =====================================================
       CONFIG từ Razor
       ===================================================== */
    var MACHINE_ID   = '@machineId';
    var MACHINE_NAME = '@Html.Raw(machineName.Replace("'", "\\'"))';
    var DEPT_ID    = '@deptId';
    var DEPT_NAME  = '@Html.Raw(dept.Replace("'", "\\'"))';

    /* =====================================================
       STATE
       ===================================================== */
    var allInfos       = [];
    var currentSearch  = '';
    var currentStatus  = '1';
    var currentDateFrom = '';
    var currentDateTo   = '';
    var addActiveTab   = 'pick';
    var addPickerItems = [];
    var pickedInfo     = null;

    // Modal detail state
    var currentDetailInfo = null;

    /* =====================================================
       HELPERS
       ===================================================== */
    function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function fmt(n) { return n == null ? '—' : Number(n).toLocaleString('vi-VN'); }

    function fmtDate(d) {
        if (!d) return '—';
        var dt = new Date(d);
        if (isNaN(dt)) return d;
        return dt.getDate().toString().padStart(2,'0') + '/' + (dt.getMonth()+1).toString().padStart(2,'0') + '/' + dt.getFullYear();
    }

    function toast(msg, ok) {
        if (ok) { toastr.success(msg); }
        else    { toastr.error(msg); }
    }

    function statusBadge(s) {
        if (s === 1) return '<span class="td-badge active">Đang SX</span>';
        if (s === 2) return '<span class="td-badge done">Hoàn thành</span>';
        return '<span class="td-badge inactive">Tạm dừng</span>';
    }

    function progressColor(pct) {
        if (pct >= 80) return 'var(--success)';
        if (pct >= 50) return 'var(--accent-gold)';
        return 'var(--danger)';
    }

    /* =====================================================
       MULTI-SELECT: Drag, Shift+Click, Ctrl+Click
       ===================================================== */
    var mdTbody     = document.getElementById('mdTableBody');
    var bulkBar     = document.getElementById('mdBulkBar');
    var bulkLabel   = document.getElementById('mdBulkLabel');
    var bulkRemove  = document.getElementById('mdBulkRemove');
    var bulkClear   = document.getElementById('mdBulkClear');
    var ms_dragging = false;
    var ms_lastIdx  = -1;

    function ms_getRows()  { return Array.from(mdTbody.querySelectorAll('tr[data-id]')); }
    function ms_setRow(tr, on) { on ? tr.classList.add('md-ms-sel') : tr.classList.remove('md-ms-sel'); }
    function ms_clearAll() { ms_getRows().forEach(function(r) { r.classList.remove('md-ms-sel','md-ctx-active'); }); updateBulkBar(); }
    function ms_getSelected() { return ms_getRows().filter(function(r) { return r.classList.contains('md-ms-sel'); }); }

    function ms_selectRange(a, b) {
        var rows = ms_getRows();
        var lo = Math.min(a, b), hi = Math.max(a, b);
        for (var i = lo; i <= hi; i++) if (rows[i]) ms_setRow(rows[i], true);
    }

    function updateBulkBar() {
        var sel = ms_getSelected();
        if (sel.length > 0) {
            bulkLabel.textContent = 'Đang chọn ' + sel.length + ' mã hàng';
            bulkBar.style.display = 'flex';
        } else {
            bulkBar.style.display = 'none';
        }
    }

    mdTbody.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        var tr = e.target.closest('tr[data-id]');
        if (!tr) { ms_clearAll(); return; }
        var rows = ms_getRows();
        var idx  = rows.indexOf(tr);
        if (e.shiftKey && ms_lastIdx > -1) {
            e.preventDefault();
            ms_clearAll();
            ms_selectRange(ms_lastIdx, idx);
        } else if (e.ctrlKey) {
            ms_setRow(tr, !tr.classList.contains('md-ms-sel'));
            ms_lastIdx = idx;
        } else {
            ms_clearAll();
            ms_setRow(tr, true);
            ms_lastIdx  = idx;
            ms_dragging = true;
        }
        updateBulkBar();
    });

    mdTbody.addEventListener('mouseover', function(e) {
        if (!ms_dragging) return;
        var tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        var idx = ms_getRows().indexOf(tr);
        if (ms_lastIdx > -1) { ms_clearAll(); ms_selectRange(ms_lastIdx, idx); }
        updateBulkBar();
    });

    document.addEventListener('mouseup', function() { ms_dragging = false; });
    mdTbody.addEventListener('selectstart', function(e) { if (ms_dragging || e.shiftKey) e.preventDefault(); });

    bulkClear.addEventListener('click', ms_clearAll);

    /* =====================================================
       CONTEXT MENU
       ===================================================== */
    var mdCtxMenu     = document.getElementById('mdCtxMenu');
    var mdCtxSelInfo  = document.getElementById('mdCtxSelInfo');
    var mdCtxSelCount = document.getElementById('mdCtxSelCount');
    var mdCtxView     = document.getElementById('mdCtxView');
    var mdCtxRemove   = document.getElementById('mdCtxRemove');
    var ctx_targetIds  = [];
    var ctx_targetRows = [];
    var ctx_singleInfo = null;

    mdTbody.addEventListener('contextmenu', function(e) {
        var tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        e.preventDefault();
        if (!tr.classList.contains('md-ms-sel')) {
            ms_clearAll();
            ms_setRow(tr, true);
        }
        ctx_targetRows = ms_getSelected();
        ctx_targetIds  = ctx_targetRows.map(function(r) { return r.dataset.id; });
        ctx_singleInfo = ctx_targetIds.length === 1
            ? allInfos.find(function(p) { return p.id === ctx_targetIds[0]; })
            : null;

        var multi = ctx_targetIds.length > 1;
        mdCtxSelInfo.style.display = multi ? 'block' : 'none';
        if (multi) mdCtxSelCount.textContent = ctx_targetIds.length;
        mdCtxView.style.display = multi ? 'none' : 'block';

        var x = e.clientX, y = e.clientY;
        var mW = 220, mH = 140;
        mdCtxMenu.style.left = (x + mW > window.innerWidth  ? x - mW : x) + 'px';
        mdCtxMenu.style.top  = (y + mH > window.innerHeight ? y - mH : y) + 'px';
        mdCtxMenu.style.display = 'block';
        ctx_targetRows.forEach(function(r) { r.classList.add('md-ctx-active'); });
        updateBulkBar();
    });

    document.addEventListener('click', function(e) {
        if (!e.target.closest('#mdCtxMenu')) hideCtx();
    });
    document.addEventListener('keydown', function(e) { if (e.key === 'Escape') { hideCtx(); ms_clearAll(); } });

    function hideCtx() {
        mdCtxMenu.style.display = 'none';
        ctx_targetRows.forEach(function(r) { r.classList.remove('md-ctx-active'); });
    }

    mdCtxView.addEventListener('click', function() {
        hideCtx();
        if (ctx_singleInfo) navigateToDetail(ctx_singleInfo);
    });

    function navigateToDetail(info) {
        var url = '/ProductionDepartment/ProductionInfoDetail'
            + '?productionInfoId=' + encodeURIComponent(info.id)
            + '&machineId='        + encodeURIComponent(MACHINE_ID)
            + '&machineName='      + encodeURIComponent(MACHINE_NAME)
            + '&dept='             + encodeURIComponent(DEPT_NAME);
        window.location.href = url;
    }

    function doRemoveFromMachine(infoIds) {
        if (!infoIds || !infoIds.length) return;
        fetch('/ProductionDepartment/RemoveFromMachine', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ productionInfoIds: infoIds, machineId: MACHINE_ID })
        })
        .then(function(r) { return r.json().then(function(d) { return { ok: r.ok, data: d }; }); })
        .then(function(res) {
            if (res.ok && res.data.success) {
                toast(res.data.message || 'Đã tách mã khỏi máy', true);
                ms_clearAll();
                loadProductionInfos();
            } else {
                toast(res.data.message || 'Lỗi khi tách mã', false);
            }
        })
        .catch(function(e) { toast('Lỗi kết nối: ' + e.message, false); });
    }

    mdCtxRemove.addEventListener('click', function() {
        hideCtx();
        doRemoveFromMachine(ctx_targetIds);
    });

    bulkRemove.addEventListener('click', function() {
        var ids = ms_getSelected().map(function(r) { return r.dataset.id; });
        doRemoveFromMachine(ids);
    });

    /* =====================================================
       LOAD: Danh sách mã sản xuất theo máy
       ===================================================== */
    function loadProductionInfos() {
        if (!MACHINE_ID) {
            renderTable([]);
            return;
        }
        var url = '/ProductionDepartment/GetProductionInfos?machineId=' + encodeURIComponent(MACHINE_ID);
        if (currentSearch)    url += '&keyword=' + encodeURIComponent(currentSearch);
        if (currentDateFrom)  url += '&from='    + encodeURIComponent(currentDateFrom);
        if (currentDateTo)    url += '&to='      + encodeURIComponent(currentDateTo);

        document.getElementById('mdTableBody').innerHTML =
            '<tr><td colspan="9" class="md-empty"><i class="fa-solid fa-circle-notch fa-spin"></i><p>Đang tải...</p></td></tr>';

        // Cập nhật tiêu đề cột
        var hdr = document.getElementById('mdTodayHeader');
        if (hdr) {
            if (currentDateFrom || currentDateTo) {
                var label = (currentDateFrom || '?') + (currentDateTo && currentDateTo !== currentDateFrom ? ' – ' + currentDateTo : '');
                hdr.textContent = label + ' / Target';
            } else {
                hdr.textContent = 'Hôm nay / Target';
            }
        }

        fetch(url)
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (list) {
                allInfos = list;
                renderAll();
            })
            .catch(function (e) {
                document.getElementById('mdTableBody').innerHTML =
                    '<tr><td colspan="9" class="md-empty"><i class="fa-solid fa-triangle-exclamation"></i><p>Lỗi: ' + esc(e.message) + '</p></td></tr>';
            });
    }

    function renderAll() {
        var filtered = allInfos.filter(function (p) {
            if (currentStatus && p.status !== parseInt(currentStatus)) return false;
            return true;
        });
        renderSummary(filtered);
        renderTable(filtered);
    }

    function renderSummary(list) {
        var totalOutput = list.reduce(function (s, p) { return s + (p.totalOutputNumber || 0); }, 0);
        var filteredOutput = list.reduce(function (s, p) { return s + (p.todayOutput || 0); }, 0);
        var totalTarget = list.reduce(function (s, p) { return s + (p.target || 0); }, 0);
        var active = list.filter(function (p) { return p.status === 1; }).length;
        document.getElementById('sumTotal').textContent  = fmt(list.length);
        document.getElementById('sumOutput').textContent = fmt(filteredOutput);
        document.getElementById('sumTarget').textContent = fmt(totalTarget);
        document.getElementById('sumActive').textContent = fmt(active);

        // Cập nhật sub-text của card sản lượng
        var subEl = document.querySelector('#mdSummaryRow .md-sum-card.accent-green .md-sum-sub');
        if (subEl) {
            if (currentDateFrom || currentDateTo) {
                var rangeLabel = (currentDateFrom || '?');
                if (currentDateTo && currentDateTo !== currentDateFrom) rangeLabel += ' – ' + currentDateTo;
                subEl.textContent = 'trong khoảng: ' + rangeLabel;
            } else {
                subEl.textContent = 'hôm nay';
            }
        }

        document.getElementById('mdRecordCount').textContent = list.length + ' bản ghi';
    }

    function renderTable(list) {
        var tbody = document.getElementById('mdTableBody');
        if (!list.length) {
            tbody.innerHTML = '<tr><td colspan="9" class="md-empty"><i class="fa-solid fa-inbox"></i><p>Không có mã sản xuất nào</p></td></tr>';
            return;
        }
        tbody.innerHTML = '';
        list.forEach(function (p) {
            var qty     = p.totalQty || 0;
            var output  = p.totalOutputNumber || 0;
            var pctQty  = qty > 0 ? Math.min(100, Math.round(output / qty * 100)) : 0;
            var colorQty= progressColor(pctQty);

            var target  = p.target || 0;
            var today   = p.todayOutput || 0;
            var pctTarget = target > 0 ? Math.min(100, Math.round(today / target * 100)) : 0;
            var colorTarget = progressColor(pctTarget);

            var tr = document.createElement('tr');
            tr.dataset.id    = p.id;
            tr.dataset.line  = p.line  || '';
            tr.dataset.style = p.style || '';
            tr.dataset.sp    = p.spmain || '';
            tr.dataset.color = p.color || '';
            tr.innerHTML =
                '<td><div style="font-size:13px;font-weight:600;">' + esc(p.line || '—') + '</div></td>' +
                '<td><div class="td-style-name">' + esc(p.style || '—') + '</div>' +
                    (p.remark ? '<div class="td-meta">' + esc(p.remark) + '</div>' : '') + '</td>' +
                '<td><span class="td-sp">' + esc(p.spmain || '—') + '</span></td>' +
                '<td>' + esc(p.color || '—') + '</td>' +
                '<td><div class="td-progress-wrap">' +
                    '<div style="font-size:14px;font-weight:800;color:var(--accent-navy);">' + fmt(output) + ' / ' + fmt(qty) + '</div>' +
                    '<div class="td-progress-bar-bg"><div class="td-progress-bar-fill" style="width:' + pctQty + '%;background:' + colorQty + ';"></div></div>' +
                    '<div class="td-pct">' + pctQty + '%</div>' +
                '</div></td>' +
                '<td><div class="td-progress-wrap">' +
                    '<div style="font-size:14px;font-weight:800;color:var(--accent-navy);">' + fmt(today) + ' / ' + fmt(target) + '</div>' +
                    '<div class="td-progress-bar-bg"><div class="td-progress-bar-fill" style="width:' + pctTarget + '%;background:' + colorTarget + ';"></div></div>' +
                    '<div class="td-pct">' + pctTarget + '%</div>' +
                '</div></td>' +
                '<td>' + statusBadge(p.status) + '</td>';

            tbody.appendChild(tr);
        });
    }

    /* =====================================================
       MODAL: Chi tiết sản lượng
       ===================================================== */
    var detailBackdrop = document.getElementById('detailBackdrop');

    function openDetailModal(info) {
        currentDetailInfo = info;
        document.getElementById('detailModalTitle').textContent = info.spmain || '—';
        document.getElementById('detailModalSub').textContent   = info.style || '';
        document.getElementById('detailModalChips').innerHTML   =
            '<span class="md-modal-chip hl"><i class="fa-solid fa-shirt"></i>' + esc(info.spmain || '—') + '</span>' +
            (info.line  ? '<span class="md-modal-chip"><i class="fa-solid fa-users"></i>' + esc(info.line)  + '</span>' : '') +
            (info.color ? '<span class="md-modal-chip"><i class="fa-solid fa-palette"></i>' + esc(info.color) + '</span>' : '');

        // Mặc định chọn ngày hiện tại
        var today = new Date();
        today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
        var todayStr = today.toISOString().split('T')[0];
        document.getElementById('detailFromDate').value = todayStr;
        document.getElementById('detailToDate').value   = todayStr;
        document.getElementById('detailDateCount').textContent = '';

        detailBackdrop.classList.add('open');
        loadDailyOutputs(info.id);
    }

    function closeDetailModal() {
        detailBackdrop.classList.remove('open');
        currentDetailInfo = null;
    }

    document.getElementById('detailModalClose').addEventListener('click', closeDetailModal);
    detailBackdrop.addEventListener('click', function (e) { if (e.target === detailBackdrop) closeDetailModal(); });

    document.getElementById('detailDateApply').addEventListener('click', function () {
        if (!currentDetailInfo) return;
        loadDailyOutputs(currentDetailInfo.id);
    });

    function loadDailyOutputs(productionInfoId) {
        var body = document.getElementById('detailModalBody');
        body.innerHTML = '<div style="display:flex;align-items:center;gap:10px;padding:24px;color:var(--ink-300);"><i class="fa-solid fa-circle-notch fa-spin"></i> Đang tải...</div>';

        var url = '/ProductionDepartment/GetDailyOutputs'
            + '?productionInfoId=' + encodeURIComponent(productionInfoId)
            + '&machineId='        + encodeURIComponent(MACHINE_ID);

        var from = document.getElementById('detailFromDate').value;
        var to   = document.getElementById('detailToDate').value;
        if (from) url += '&from=' + encodeURIComponent(from);
        if (to)   url += '&to='   + encodeURIComponent(to);

        fetch(url)
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (list) {
                document.getElementById('detailDateCount').textContent = list.length + ' ngày';
                renderDailyOutputs(list);
            })
            .catch(function (e) {
                body.innerHTML = '<div class="md-empty"><i class="fa-solid fa-triangle-exclamation"></i><p>' + esc(e.message) + '</p></div>';
            });
    }

    function renderDailyOutputs(list) {
        var body = document.getElementById('detailModalBody');

        var info = currentDetailInfo || {};
        var qty = info.totalQty || 0;
        var target = info.target || 0;

        // Pass 1: tính _dayTotal = min(tổng từng công đoạn) cho mỗi ngày
        list.forEach(function(d) {
            var detailById = {};
            (d.details || []).forEach(function(dt) {
                var key = dt.styleDetailId || dt.detailName || 'x';
                if (!detailById[key]) detailById[key] = 0;
                detailById[key] += (dt.outputNumber || 0);
            });
            var vals = Object.values(detailById);
            d._dayTotal = vals.length > 0
                ? vals.reduce(function(m, v) { return Math.min(m, v); }, vals[0])
                : (d.totalOutputNumber || 0);
        });

        var totalOutput = 0;
        list.forEach(function(d) { totalOutput += d._dayTotal; });

        var pctQty = qty > 0 ? Math.min(100, Math.round(totalOutput / qty * 100)) : 0;
        document.getElementById('detailTotalOutput').textContent = fmt(totalOutput) + ' / ' + fmt(qty);
        document.getElementById('detailTotalSub').textContent = pctQty + '% Qty';

        var pctTarget = target > 0 ? Math.min(100, Math.round(totalOutput / target * 100)) : 0;
        document.getElementById('detailTargetPercent').textContent = pctTarget + '%';
        document.getElementById('detailTargetSub').textContent = fmt(totalOutput) + ' / ' + fmt(target) + ' mục tiêu';

        if (!list.length) {
            body.innerHTML = '<div class="md-empty"><i class="fa-solid fa-calendar-xmark"></i><p>Chưa có sản lượng nào trong khoảng thời gian này</p></div>';
            return;
        }
        body.innerHTML = '';
        list.forEach(function (d) {
            var card = document.createElement('div');
            card.className = 'md-day-card';

            // Gom nhóm theo từng công đoạn để hiển thị summary
            var detailMap  = {};   // detailName → tổng sản lượng
            (d.details || []).forEach(function(dt) {
                var name = dt.detailName || 'Khác';
                if (!detailMap[name])  detailMap[name]  = 0;
                detailMap[name] += (dt.outputNumber || 0);
            });

            // _dayTotal đã được tính ở Pass 1
            var dayTotal = d._dayTotal;

            var summaryArr = [];
            for (var k in detailMap) summaryArr.push(k + ': ' + fmt(detailMap[k]));
            var summaryText = summaryArr.length ? '<div style="padding: 10px 16px; font-size: 12px; color: var(--ink-500); background: var(--bg-canvas); border-bottom: 1px solid var(--border-soft);">Tổng: ' + esc(summaryArr.join(', ')) + '</div>' : '';

            var detailRows = (d.details || []).map(function (dt) {
                return '<tr>' +
                    '<td>' + esc(dt.detailName) + '</td>' +
                    '<td style="color:var(--ink-500);">' + (dt.inputTime || '—') + '</td>' +
                    '<td><span class="md-output-num">' + fmt(dt.outputNumber) + '</span></td>' +
                '</tr>';
            }).join('');

            var isFirst = (list.indexOf(d) === 0);
            var initDisplay = isFirst ? 'block' : 'none';
            var initRot = isFirst ? 'rotate(180deg)' : 'rotate(0deg)';

            card.innerHTML =
                '<div class="md-day-card-head" style="cursor:pointer; user-select:none;">' +
                    '<div class="md-day-date"><i class="fa-regular fa-calendar"></i>' + fmtDate(d.createDate) + (d.styleCode ? ' &nbsp;·&nbsp; <span style="font-family:Courier New;font-size:11.5px;color:var(--ink-400);">' + esc(d.styleCode) + '</span>' : '') + '</div>' +
                    '<div class="md-day-total"><i class="fa-solid fa-box"></i> ' + fmt(dayTotal) + ' thành phẩm <i class="fa-solid fa-chevron-down" style="font-size:11px; margin-left:6px; transition:transform 0.2s; transform:' + initRot + '"></i></div>' +
                '</div>' +
                '<div class="md-day-card-content" style="display:' + initDisplay + ';">' +
                summaryText +
                (detailRows ?
                    '<table class="md-detail-table">' +
                        '<thead><tr><th>Công đoạn</th><th>Giờ vào</th><th>Lần nhập</th></tr></thead>' +
                        '<tbody>' + detailRows + '</tbody>' +
                    '</table>'
                : '<div style="padding:12px 16px;font-size:12.5px;color:var(--ink-300);">Chưa có chi tiết công đoạn</div>') +
                '</div>';
                
            var head = card.querySelector('.md-day-card-head');
            var content = card.querySelector('.md-day-card-content');
            var icon = card.querySelector('.fa-chevron-down');
            head.addEventListener('click', function() {
                if (content.style.display === 'none') {
                    content.style.display = 'block';
                    icon.style.transform = 'rotate(180deg)';
                } else {
                    content.style.display = 'none';
                    icon.style.transform = 'rotate(0deg)';
                }
            });
            body.appendChild(card);
        });
    }

    /* =====================================================
       MODAL: Thêm mã sản xuất
       ===================================================== */
    var addBackdrop = document.getElementById('addBackdrop');

    // Tab switching
    document.getElementById('addTabBtnPick').addEventListener('click', function () { switchAddTab('pick'); });
    document.getElementById('addTabBtnNew').addEventListener('click',  function () { switchAddTab('new');  });

    function switchAddTab(tab) {
        addActiveTab = tab;
        document.getElementById('addTabBtnPick').classList.toggle('active', tab === 'pick');
        document.getElementById('addTabBtnNew').classList.toggle('active', tab === 'new');
        document.getElementById('addTabPanePick').classList.toggle('active', tab === 'pick');
        document.getElementById('addTabPaneNew').classList.toggle('active', tab === 'new');
    }

    // Open modal
    document.getElementById('mdAddBtn').addEventListener('click', function () {
        pickedInfo = null;
        document.getElementById('addPickerSelected').style.display = 'none';
        document.getElementById('addPickerSearch').value = '';
        switchAddTab('pick');
        resetNewForm();
        addBackdrop.classList.add('open');
        loadAddPickerItems('');
    });

    function closeAddModal() { addBackdrop.classList.remove('open'); }
    document.getElementById('addModalClose').addEventListener('click', closeAddModal);
    document.getElementById('addModalCancel').addEventListener('click', closeAddModal);
    addBackdrop.addEventListener('click', function (e) { if (e.target === addBackdrop) closeAddModal(); });

    // Picker search
    document.getElementById('addPickerSearch').addEventListener('input', function () {
        renderAddPickerList(this.value);
    });

    document.getElementById('addPickerClearBtn').addEventListener('click', function () {
        pickedInfo = null;
        document.getElementById('addPickerSelected').style.display = 'none';
        renderAddPickerList(document.getElementById('addPickerSearch').value);
    });

    function loadAddPickerItems(keyword) {
        var list_el = document.getElementById('addPickerList');
        list_el.innerHTML = '<div class="add-picker-empty"><i class="fa-solid fa-circle-notch fa-spin"></i><span>Đang tải...</span></div>';
        addPickerItems = [];

        if (!DEPT_ID) {
            list_el.innerHTML = '<div class="add-picker-empty"><i class="fa-solid fa-triangle-exclamation" style="color:var(--danger);"></i><span>Không xác định được bộ phận. Vui lòng quay lại và thử lại.</span></div>';
            return;
        }

        var url = '/ProductionDepartment/GetProductionInfosByDept?deptId=' + encodeURIComponent(DEPT_ID);
        if (keyword) url += '&keyword=' + encodeURIComponent(keyword);

        fetch(url)
            .then(function (r) {
                if (!r.ok) throw new Error('HTTP ' + r.status);
                return r.json();
            })
            .then(function (list) {
                addPickerItems = list;
                renderAddPickerList(document.getElementById('addPickerSearch').value);
            })
            .catch(function (e) {
                list_el.innerHTML = '<div class="add-picker-empty"><i class="fa-solid fa-triangle-exclamation"></i><span>Lỗi tải danh sách: ' + e.message + '</span></div>';
            });
    }

    function renderAddPickerList(keyword) {
        var kw = (keyword || '').toLowerCase().trim();
        var filtered = addPickerItems.filter(function (p) {
            if (!kw) return true;
            return (p.spmain||'').toLowerCase().includes(kw) ||
                   (p.style||'').toLowerCase().includes(kw) ||
                   (p.keyword||'').toLowerCase().includes(kw);
        });

        var list_el = document.getElementById('addPickerList');
        list_el.innerHTML = '';

        if (!filtered.length) {
            list_el.innerHTML = '<div class="add-picker-empty"><i class="fa-solid fa-inbox"></i><span>' +
                (addPickerItems.length ? 'Không tìm thấy mã phù hợp' : 'Chưa có mã sản xuất nào trong bộ phận') +
                '</span></div>';
            return;
        }

        filtered.forEach(function (p) {
            var isSelected = pickedInfo && pickedInfo.id === p.id;
            var item = document.createElement('div');
            item.className = 'add-picker-item' + (isSelected ? ' selected' : '');
            item.innerHTML =
                '<div class="add-picker-item-icon"><i class="fa-solid fa-shirt"></i></div>' +
                '<div class="add-picker-item-info">' +
                    '<div class="add-picker-item-sp">' + esc(p.spmain || '—') + '</div>' +
                    '<div class="add-picker-item-style">' + esc(p.style || '—') + '</div>' +
                    '<div class="add-picker-item-meta">' +
                        (p.line  ? esc(p.line)  : '') +
                        (p.line && p.color ? ' · ' : '') +
                        (p.color ? esc(p.color) : '') +
                        (p.line || p.color ? ' &nbsp;·&nbsp; ' : '') +
                        (p.status === 1 ? '<span style="color:var(--success);font-size:10px;font-weight:700;">● Đang SX</span>' :
                         p.status === 0 ? '<span style="color:var(--accent-gold,#d97706);font-size:10px;font-weight:700;">● Chờ SX</span>' :
                         p.status === 2 ? '<span style="color:var(--ink-400);font-size:10px;font-weight:700;">● Hoàn thành</span>' : '') +
                    '</div>' +
                '</div>' +
                (isSelected ? '<i class="fa-solid fa-circle-check add-picker-item-check"></i>' : '');

            item.addEventListener('click', function () {
                pickedInfo = p;
                document.getElementById('addPickerSelectedSp').textContent = (p.spmain || '—') + ' — ' + (p.style || '');
                document.getElementById('addPickerSelected').style.display = 'flex';
                renderAddPickerList(document.getElementById('addPickerSearch').value);
            });
            list_el.appendChild(item);
        });
    }

    function resetNewForm() {
        ['fSpmain','fStyle','fLine','fColor','fRemark'].forEach(function (id) {
            document.getElementById(id).value = '';
        });
        ['fTarget','fTotalQty'].forEach(function (id) { document.getElementById(id).value = ''; });
        ['fInlineLine','fInlineDept'].forEach(function (id) { document.getElementById(id).value = ''; });
    }

    // Save — gọi API thực
    document.getElementById('addModalSave').addEventListener('click', function () {
        var saveBtn = this;
        var origHtml = saveBtn.innerHTML;

        if (addActiveTab === 'pick') {
            // ── Tab "Chọn có sẵn": gán ProductionInfo đã có vào máy ──────────
            if (!pickedInfo) {
                toast('Vui lòng chọn một mã sản xuất', false);
                return;
            }
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang lưu...';

            fetch('/ProductionDepartment/AssignProductionInfo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    productionInfoId: pickedInfo.id,
                    machineId: MACHINE_ID
                })
            })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                if (!res.ok || !res.data.success) {
                    toast(res.data.message || 'Lỗi khi gán mã vào máy', false);
                    return;
                }
                toast(res.data.message || 'Đã gán mã sản xuất vào máy', true);
                closeAddModal();
                loadProductionInfos();
            })
            .catch(function (e) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                toast('Lỗi kết nối: ' + e.message, false);
            });

        } else {
            // ── Tab "Tạo mới": tạo ProductionInfo mới rồi gán vào máy ────────
            var sp = document.getElementById('fSpmain').value.trim();
            var st = document.getElementById('fStyle').value.trim();
            if (!sp || !st) {
                toast('Vui lòng nhập Mã SP và Tên Style', false);
                return;
            }
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang tạo...';

            fetch('/ProductionDepartment/CreateProductionInfo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    spmain:    sp,
                    style:     st,
                    line:      document.getElementById('fLine').value.trim() || null,
                    color:     document.getElementById('fColor').value.trim() || null,
                    target:    parseInt(document.getElementById('fTarget').value)   || null,
                    totalQty:  parseInt(document.getElementById('fTotalQty').value) || null,
                    inlineLine: document.getElementById('fInlineLine').value || null,
                    inlineDept: document.getElementById('fInlineDept').value || null,
                    remark:    document.getElementById('fRemark').value.trim() || null,
                    machineId: MACHINE_ID,
                    deptId:    DEPT_ID
                })
            })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                if (!res.ok || !res.data.success) {
                    toast(res.data.message || 'Lỗi khi tạo mã sản xuất', false);
                    return;
                }
                toast(res.data.message || 'Đã tạo và gán mã sản xuất vào máy', true);
                closeAddModal();
                loadProductionInfos();
            })
            .catch(function (e) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                toast('Lỗi kết nối: ' + e.message, false);
            });
        }
    });


    /* =====================================================
       FILTER EVENTS
       ===================================================== */
    document.getElementById('mdFilterApply').addEventListener('click', function () {
        currentSearch   = document.getElementById('mdSearch').value.trim().toLowerCase();
        currentStatus   = document.getElementById('mdStatusFilter').value;
        currentDateFrom = document.getElementById('mdDateFrom').value;
        currentDateTo   = document.getElementById('mdDateTo').value;
        loadProductionInfos();
    });

    document.getElementById('mdFilterReset').addEventListener('click', function () {
        var today = new Date().toISOString().slice(0, 10);
        document.getElementById('mdSearch').value       = '';
        document.getElementById('mdStatusFilter').value = '1';
        document.getElementById('mdDateFrom').value     = today;
        document.getElementById('mdDateTo').value       = today;
        currentSearch   = '';
        currentStatus   = '1';
        currentDateFrom = today;
        currentDateTo   = today;
        loadProductionInfos();
    });

    document.getElementById('mdSearch').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') document.getElementById('mdFilterApply').click();
    });

    document.getElementById('mdRefreshBtn').addEventListener('click', function () {
        loadProductionInfos();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeDetailModal(); closeAddModal(); }
    });

    /* =====================================================
       INIT — Gọi trực tiếp vì partial view inject sau DOM ready
       (DOMContentLoaded đã fired trước khi partial được load)
       ===================================================== */
    // Mặc định ngày hôm nay
    (function () {
        var today = new Date().toISOString().slice(0, 10);
        var fi = document.getElementById('mdDateFrom');
        var ti = document.getElementById('mdDateTo');
        if (fi && !fi.value) { fi.value = today; currentDateFrom = today; }
        if (ti && !ti.value) { ti.value = today; currentDateTo   = today; }
    })();

    loadProductionInfos();

}());
</script>

<style>
    /* ---- Copy toast cho MachineDetail ---- */
    #mdCopyToast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 99999;
        background: #1a2744;
        color: #e2e8f0;
        font-size: 12px;
        font-weight: 600;
        font-family: Manrope, sans-serif;
        padding: 6px 14px;
        border-radius: 8px;
        box-shadow: 0 4px 18px rgba(0,0,0,.28);
        pointer-events: none;
        white-space: nowrap;
        display: none;
        align-items: center;
        gap: 6px;
        animation: mdCopyToastIn .14s cubic-bezier(.4,0,.2,1);
    }
    @@keyframes mdCopyToastIn {
        from { opacity:0; transform:translateY(8px) scale(.95); }
        to   { opacity:1; transform:none; }
    }
    #mdTableBody td.md-td-copied {
        background: rgba(59,130,246,.13) !important;
        outline: 2px solid rgba(59,130,246,.45);
        border-radius: 3px;
        transition: background .25s, outline .25s;
    }
</style>

<div id="mdCopyToast" style="display:none;">
    <i class="fa-solid fa-copy" style="opacity:.75;"></i>
    <span id="mdCopyToastText"></span>
</div>

<script>
(function () {
    'use strict';

    var mdToast     = document.getElementById('mdCopyToast');
    var mdToastText = document.getElementById('mdCopyToastText');
    var mdToastTmr  = null;

    function showMdCopyToast(val) {
        mdToastText.textContent = val.length > 40 ? val.slice(0, 40) + '\u2026' : val;
        mdToast.style.display = 'flex';
        clearTimeout(mdToastTmr);
        mdToastTmr = setTimeout(function () { mdToast.style.display = 'none'; }, 1600);
    }

    // Map col index -> data attribute trên <tr>
    var COL_DATA_MAP = { 0:'line', 1:'style', 2:'sp', 3:'color' };

    function getMdCellText(td) {
        var colIdx = td.cellIndex;
        var tr     = td.closest('tr');
        if (COL_DATA_MAP[colIdx] !== undefined && tr) {
            var v = tr.dataset[COL_DATA_MAP[colIdx]];
            if (v) return v;
        }
        return (td.innerText || td.textContent || '').trim();
    }

    function fallbackCopy(text) {
        var el = document.createElement('textarea');
        el.value = text;
        el.style.cssText = 'position:fixed;top:-9999px;left:-9999px;opacity:0;';
        document.body.appendChild(el);
        el.select();
        try { document.execCommand('copy'); } catch (_) {}
        document.body.removeChild(el);
    }

    var tbody = document.getElementById('mdTableBody');
    if (tbody) {
        tbody.addEventListener('dblclick', function (e) {
            var td = e.target.closest('td');
            if (!td) return;

            var text = getMdCellText(td);
            if (!text || text === '\u2014') return;

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).catch(function () { fallbackCopy(text); });
            } else {
                fallbackCopy(text);
            }

            td.classList.add('md-td-copied');
            setTimeout(function () { td.classList.remove('md-td-copied'); }, 500);

            showMdCopyToast(text);
            e.preventDefault();
        });
    }
}());
</script>
