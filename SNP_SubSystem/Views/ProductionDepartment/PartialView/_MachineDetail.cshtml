    <div id="mdCtxSelInfo" style="display:none;padding:5px 16px 9px;font-size:12px;color:var(--ink-500);font-weight:600;border-bottom:1px solid var(--border);margin-bottom:4px;">
        Đã chọn: <span id="mdCtxSelCount" style="color:var(--accent-navy);font-size:13px;"></span> mã hàng
    </div>
    <button id="mdCtxView" style="display:block;width:100%;text-align:left;padding:9px 16px;background:none;border:none;cursor:pointer;font-size:13.5px;color:var(--ink-900);font-family:inherit;">
        <i class="fa-solid fa-eye" style="color:var(--accent-navy);width:18px;"></i> Xem chi tiết
    </button>
    <div style="height:1px;background:var(--border);margin:4px 0;"></div>
    <button id="mdCtxRemove" style="display:block;width:100%;text-align:left;padding:9px 16px;background:none;border:none;cursor:pointer;font-size:13.5px;color:var(--danger);font-family:inherit;">
        <i class="fa-solid fa-circle-stop" style="width:18px;"></i> Tách khỏi máy
