    ViewData["Title"] = "Chi tiết sản xuất";

    var machineId   = ViewData["MachineId"]?.ToString()   ?? "";
    var machineName = ViewData["MachineName"]?.ToString() ?? "Máy";
    var machineCode = ViewData["MachineCode"]?.ToString() ?? "";
    var dept        = ViewData["Dept"]?.ToString()         ?? "";

    /*
     * =====================================================================
     * DATA FLOW (khi kết nối DB):
     *
     *   1) ProductionInfo  — mã sản xuất (SP#, Style, Line, Color, Target...)
     *                        → liên kết với máy qua ProductionMachineId &
     *                          ProductionDepartmentId
     *
     *   2) DailyOutput     — sản lượng hàng ngày của một ProductionInfo
     *                        trên một máy (ProductionMachineId)
     *                        → gắn với StyleInfo (StyleInfoId)
     *
     *   3) DailyOutputDetail — chi tiết từng công đoạn (StyleDetail)
     *                          trong một DailyOutput
     *                        → OutputNumber, InputTime, StyleDetailId
     *
     *   4) StyleInfo       — định nghĩa Style (StyleCode, Keyword)
     *   5) StyleDetail     — chi tiết từng công đoạn of a Style (DetailName)
     *
     * API gợi ý (TODO):
     *   GET /ProductionDepartment/GetProductionInfos?machineId={id}
     *       → List<ProductionInfoDto> { Id, Style, Spmain, Line, Color,
     *           TotalQty, FinishQty, Target, InlineLine, InlineDepartment,
     *           Machine, Remark, Status, CreateDate }
     *
     *   GET /ProductionDepartment/GetDailyOutputDetails?productionInfoId={id}
     *       → List<DailyOutputDetailDto> { DailyOutputId, StyleDetailId,
     *           DetailName, OutputNumber, InputTime, TotalOutputNumber,
     *           StyleCode, CreateDate }
     * =====================================================================
     */
}

