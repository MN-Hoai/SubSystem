@{
    ViewData["Title"] = "Chi tiết sản xuất";

    var machineId   = ViewData["MachineId"]?.ToString()   ?? "";
    var machineName = ViewData["MachineName"]?.ToString() ?? "Máy";
    var machineCode = ViewData["MachineCode"]?.ToString() ?? "";
    var dept        = ViewData["Dept"]?.ToString()         ?? "";
    var deptId      = ViewData["DeptId"]?.ToString()       ?? "";
}

<style>
    /* ============================================================
       Machine Detail — _MachineDetail.cshtml
       ============================================================ */
    .md-page { display:flex; flex-direction:column; height:calc(100vh - var(--header-h,60px)); overflow:hidden; }

    /* ---- Top bar ---- */
    .md-topbar { display:flex; align-items:center; justify-content:space-between; padding:14px 28px 12px; background:var(--bg-surface); border-bottom:1px solid var(--border); gap:14px; flex-wrap:wrap; flex-shrink:0; }
    .md-back-btn { display:flex; align-items:center; gap:8px; font-size:13px; font-weight:700; color:var(--ink-500); cursor:pointer; border:none; background:none; font-family:inherit; padding:6px 10px; border-radius:8px; transition:background .18s,color .18s; }
    .md-back-btn:hover { background:var(--bg-canvas); color:var(--ink-900); }
    .md-machine-info { display:flex; align-items:center; gap:14px; flex:1; }
    .md-machine-badge { width:44px; height:44px; border-radius:12px; background:linear-gradient(135deg,var(--accent-navy) 0%,var(--accent-navy-700) 100%); display:flex; align-items:center; justify-content:center; color:#fff; font-size:17px; box-shadow:0 4px 14px rgba(31,58,103,.25); flex-shrink:0; }
    .md-machine-title { font-size:18px; font-weight:800; color:var(--ink-900); letter-spacing:-.2px; }
    .md-machine-meta { display:flex; align-items:center; gap:8px; margin-top:3px; flex-wrap:wrap; }
    .md-meta-chip { display:inline-flex; align-items:center; gap:5px; font-size:11px; font-weight:600; color:var(--ink-500); background:var(--bg-canvas); border:1.5px solid var(--border); border-radius:999px; padding:2px 9px; }
    .md-topbar-actions { display:flex; gap:10px; flex-shrink:0; }

    /* ---- Filter ---- */
    .md-filter { display:flex; align-items:flex-end; gap:12px; padding:10px 28px; background:var(--bg-surface); border-bottom:1px solid var(--border); flex-wrap:wrap; flex-shrink:0; }
    .md-filter-group { display:flex; flex-direction:column; gap:4px; }
    .md-filter-label { font-size:11px; font-weight:700; color:var(--ink-500); text-transform:uppercase; letter-spacing:.5px; }
    .md-filter input[type="text"], .md-filter input[type="date"], .md-filter select { padding:7px 11px; border:1.5px solid var(--border); border-radius:9px; font-family:inherit; font-size:13px; color:var(--ink-900); background:var(--bg-canvas); outline:none; min-width:145px; transition:border-color .2s,box-shadow .2s; appearance:none; }
    .md-filter input:focus, .md-filter select:focus { border-color:var(--accent-navy); box-shadow:0 0 0 3px var(--accent-navy-soft); }
    .md-search-wrap { position:relative; }
    .md-search-wrap i { position:absolute; left:11px; top:50%; transform:translateY(-50%); color:var(--ink-300); font-size:12px; }
    .md-search-wrap input { padding-left:32px !important; }

    /* ---- Body ---- */
    .md-body { flex:1; overflow-y:auto; padding:20px 28px 32px; display:flex; flex-direction:column; gap:12px; }

    /* ---- Summary ---- */
    .md-summary-row { display:grid; grid-template-columns:repeat(4,1fr); gap:12px; }
    .md-sum-card { background:var(--bg-surface); border:1px solid var(--border); border-radius:13px; padding:14px 18px; display:flex; flex-direction:column; gap:4px; box-shadow:var(--shadow-sm); transition:box-shadow .2s,transform .2s; }
    .md-sum-card:hover { box-shadow:var(--shadow-md); transform:translateY(-1px); }
    .md-sum-label { font-size:11px; font-weight:700; color:var(--ink-300); text-transform:uppercase; letter-spacing:.6px; }
    .md-sum-value { font-size:24px; font-weight:800; color:var(--ink-900); letter-spacing:-.5px; line-height:1.1; }
    .md-sum-sub { font-size:12px; font-weight:500; color:var(--ink-500); margin-top:2px; }
    .md-sum-card.accent-green { border-left:3px solid var(--success); }
    .md-sum-card.accent-navy  { border-left:3px solid var(--accent-navy); }
    .md-sum-card.accent-gold  { border-left:3px solid var(--accent-gold); }
    .md-sum-card.accent-red   { border-left:3px solid var(--danger); }

    /* ---- Table ---- */
    .md-section-head { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px; }
    .md-section-title { font-size:15px; font-weight:800; color:var(--ink-900); }
    .md-table-wrap { background:var(--bg-surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; box-shadow:var(--shadow-sm); }
    .md-table { width:100%; border-collapse:collapse; font-size:13.5px; }
    .md-table thead tr { background:var(--bg-canvas); border-bottom:1.5px solid var(--border); position:sticky; top:0; z-index:2; }
    .md-table thead th { padding:10px 16px; text-align:left; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.6px; color:var(--ink-500); white-space:nowrap; }
    .md-table tbody tr { border-bottom:1px solid var(--border-soft); transition:background .15s; cursor:pointer; }
    .md-table tbody tr:last-child { border-bottom:none; }
    .md-table tbody tr:hover { background:var(--accent-navy-soft); }
    .md-table tbody td { padding:12px 16px; vertical-align:middle; }
    .td-sp { font-family:'Courier New',monospace; font-size:12.5px; font-weight:700; color:var(--accent-navy); background:var(--accent-navy-soft); padding:2px 8px; border-radius:5px; white-space:nowrap; }
    .td-style-name { font-weight:700; color:var(--ink-900); }
    .td-meta { font-size:12px; color:var(--ink-500); }
    .td-progress-wrap { display:flex; flex-direction:column; gap:3px; min-width:110px; }
    .td-progress-bar-bg { height:5px; border-radius:999px; background:var(--border); overflow:hidden; }
    .td-progress-bar-fill { height:100%; border-radius:999px; transition:width .4s ease; }
    .td-pct { font-size:11px; font-weight:700; color:var(--ink-500); }
    .td-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:999px; font-size:11px; font-weight:700; white-space:nowrap; }
    .td-badge.active   { background:#E6F4EF; color:var(--success); }
    .td-badge.inactive { background:#FEF3F2; color:var(--danger); }
    .td-badge.done     { background:var(--accent-navy-soft); color:var(--accent-navy); }
    .td-view-btn { display:inline-flex; align-items:center; gap:5px; padding:5px 11px; border-radius:7px; font-size:12px; font-weight:700; color:var(--accent-navy); background:var(--accent-navy-soft); border:none; cursor:pointer; font-family:inherit; transition:background .18s,transform .15s; }
    .td-view-btn:hover { background:#d5dfef; transform:translateY(-1px); }
    .md-empty { text-align:center; padding:48px 24px; color:var(--ink-300); }
    .md-empty i { font-size:32px; display:block; margin-bottom:12px; }
    .md-empty p { font-size:14px; font-weight:600; color:var(--ink-500); }

    /* ---- Utility buttons ---- */
    .btn { display:inline-flex; align-items:center; gap:7px; padding:9px 16px; border-radius:9px; font-size:13.5px; font-weight:700; cursor:pointer; border:none; font-family:inherit; transition:background .18s,opacity .18s,transform .15s; }
    .btn-primary { background:linear-gradient(135deg,var(--accent-navy) 0%,var(--accent-navy-700) 100%); color:#fff; box-shadow:0 4px 12px rgba(31,58,103,.22); }
    .btn-primary:hover { opacity:.9; transform:translateY(-1px); }
    .btn-ghost { background:var(--bg-canvas); color:var(--ink-700-solid); border:1.5px solid var(--border); }
    .btn-ghost:hover { background:var(--border-soft); }
    .btn-sm { padding:6px 13px; font-size:12.5px; border-radius:8px; }
    .btn-danger { background:linear-gradient(135deg,var(--danger) 0%,#c0392b 100%); color:#fff; }

    /* ================================================================
       MODAL: Chi tiết sản lượng (DailyOutput)
    ================================================================ */
    .md-modal-backdrop { position:fixed; inset:0; background:rgba(22,33,62,.45); backdrop-filter:blur(5px); z-index:1000; display:flex; align-items:center; justify-content:center; opacity:0; pointer-events:none; transition:opacity .25s ease; }
    .md-modal-backdrop.open { opacity:1; pointer-events:all; }
    .md-modal { background:#fff; border-radius:20px; width:100%; max-width:700px; max-height:88vh; display:flex; flex-direction:column; box-shadow:var(--shadow-lg); transform:translateY(24px) scale(.97); opacity:0; transition:transform .3s cubic-bezier(.34,1.56,.64,1),opacity .25s ease; overflow:hidden; margin:16px; }
    .md-modal-backdrop.open .md-modal { transform:translateY(0) scale(1); opacity:1; }
    .md-modal-head { padding:18px 22px 14px; border-bottom:1px solid var(--border); flex-shrink:0; }
    .md-modal-head-top { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; margin-bottom:12px; }
    .md-modal-title-group { display:flex; align-items:center; gap:12px; }
    .md-modal-icon { width:42px; height:42px; border-radius:11px; background:var(--accent-navy-soft); display:flex; align-items:center; justify-content:center; color:var(--accent-navy); font-size:17px; flex-shrink:0; }
    .md-modal-title { font-size:17px; font-weight:800; color:var(--ink-900); letter-spacing:-.2px; }
    .md-modal-sub { font-size:12px; color:var(--ink-500); margin-top:2px; font-weight:500; }
    .md-modal-close { width:32px; height:32px; border-radius:8px; border:none; background:var(--bg-canvas); display:flex; align-items:center; justify-content:center; color:var(--ink-500); font-size:13px; cursor:pointer; transition:background .18s,color .18s; flex-shrink:0; }
    .md-modal-close:hover { background:var(--border-soft); color:var(--ink-900); }
    .md-modal-chips { display:flex; gap:8px; flex-wrap:wrap; }
    .md-modal-chip { display:inline-flex; align-items:center; gap:5px; padding:4px 11px; border-radius:999px; font-size:12px; font-weight:700; background:var(--bg-canvas); border:1.5px solid var(--border); color:var(--ink-700-solid); }
    .md-modal-chip.hl { background:var(--accent-navy-soft); border-color:#c0cfe8; color:var(--accent-navy); }
    .md-modal-date-filter { display:flex; align-items:center; gap:10px; padding:9px 22px 11px; background:var(--bg-canvas); border-bottom:1px solid var(--border); flex-shrink:0; flex-wrap:wrap; }
    .md-modal-date-filter label { font-size:11px; font-weight:700; color:var(--ink-500); text-transform:uppercase; letter-spacing:.5px; white-space:nowrap; }
    .md-modal-date-filter input[type="date"] { padding:5px 10px; border:1.5px solid var(--border); border-radius:8px; font-family:inherit; font-size:13px; color:var(--ink-900); background:var(--bg-surface); outline:none; }
    .md-modal-date-filter input:focus { border-color:var(--accent-navy); box-shadow:0 0 0 3px var(--accent-navy-soft); }
    .md-date-sep { font-size:12px; color:var(--ink-300); font-weight:600; }
    .md-date-count { font-size:12px; font-weight:700; color:var(--ink-500); margin-left:auto; }
    .md-modal-body { flex:1; overflow-y:auto; min-height:0; padding:16px 22px 20px; display:flex; flex-direction:column; gap:14px; }
    /* Detail summary cards inside modal — must not grow/shrink so body gets scroll space */
    #detailCards { flex-shrink:0 !important; }
    /* Scroll container cho bảng danh sách mã sản xuất */
    .md-table-wrap { background:var(--bg-surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; box-shadow:var(--shadow-sm); }
    .md-table-scroll { max-height:calc(100vh - 320px); overflow-y:auto; }
    .md-day-card { background:var(--bg-canvas); border:1.5px solid var(--border); border-radius:12px; overflow:hidden; }
    .md-day-card-content { /* không giới hạn chiều cao — cuộn toàn bộ qua md-modal-body */ }
    .md-day-card-head { display:flex; align-items:center; justify-content:space-between; padding:10px 16px; background:var(--bg-surface); border-bottom:1px solid var(--border-soft); }
    .md-day-date { font-size:13px; font-weight:700; color:var(--ink-900); display:flex; align-items:center; gap:7px; }
    .md-day-date i { color:var(--ink-300); font-size:12px; }
    .md-day-total { font-size:13px; font-weight:800; color:var(--accent-navy); background:var(--accent-navy-soft); padding:3px 10px; border-radius:7px; }
    .md-detail-table { width:100%; border-collapse:collapse; font-size:13px; }
    .md-detail-table thead th { padding:7px 14px; text-align:left; font-size:10.5px; font-weight:700; text-transform:uppercase; letter-spacing:.5px; color:var(--ink-300); border-bottom:1px solid var(--border-soft); white-space:nowrap; }
    .md-detail-table tbody td { padding:9px 14px; border-bottom:1px solid var(--border-soft); vertical-align:middle; }
    .md-detail-table tbody tr:last-child td { border-bottom:none; }
    .md-detail-table tbody tr:hover { background:var(--accent-navy-soft); }
    .md-output-num { font-size:15px; font-weight:800; color:var(--accent-navy); }

    /* ================================================================
       MODAL: Thêm mã sản xuất (2 tab: Chọn có sẵn / Tạo mới)
    ================================================================ */
    .add-modal-wide { max-width:560px !important; }
    .add-modal-tabs { display:flex; border-bottom:2px solid var(--border); background:var(--bg-canvas); padding:0 20px; gap:4px; flex-shrink:0; }
    .add-tab-btn { display:flex; align-items:center; gap:7px; padding:11px 16px; font-size:13px; font-weight:600; color:var(--ink-400); background:transparent; border:none; border-bottom:2.5px solid transparent; cursor:pointer; transition:color .18s,border-color .18s; margin-bottom:-2px; }
    .add-tab-btn:hover { color:var(--ink-700-solid); }
    .add-tab-btn.active { color:var(--accent-navy); border-bottom-color:var(--accent-navy); }
    .add-tab-pane { display:none; padding:16px 20px; overflow-y:auto; max-height:420px; flex-direction:column; gap:12px; }
    .add-tab-pane.active { display:flex; }

    /* Picker list for existing infos */
    .add-picker-search-wrap { display:flex; align-items:center; gap:10px; background:var(--bg-canvas); border:1.5px solid var(--border); border-radius:9px; padding:8px 12px; }
    .add-picker-search-wrap i { color:var(--ink-300); font-size:13px; }
    .add-picker-search { flex:1; border:none; background:transparent; font-size:13.5px; color:var(--ink-900); outline:none; }
    .add-picker-list { display:flex; flex-direction:column; gap:5px; max-height:220px; overflow-y:auto; border:1.5px solid var(--border); border-radius:10px; padding:8px; background:var(--bg-canvas); }
    .add-picker-item { display:flex; align-items:center; gap:10px; padding:9px 12px; border-radius:8px; cursor:pointer; border:1.5px solid transparent; transition:background .15s; }
    .add-picker-item:hover { background:var(--bg-surface); border-color:var(--border); }
    .add-picker-item.selected { background:rgba(31,58,103,.07); border-color:var(--accent-navy); }
    .add-picker-item-icon { width:30px; height:30px; border-radius:7px; background:var(--accent-navy-soft); color:var(--accent-navy); display:flex; align-items:center; justify-content:center; font-size:12px; flex-shrink:0; }
    .add-picker-item-info { flex:1; min-width:0; }
    .add-picker-item-sp { font-size:12px; font-weight:700; color:var(--accent-navy); font-family:'Courier New',monospace; }
    .add-picker-item-style { font-size:12.5px; font-weight:700; color:var(--ink-900); white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
    .add-picker-item-meta { font-size:11px; color:var(--ink-400); }
    .add-picker-item-check { color:var(--accent-navy); font-size:14px; }
    .add-picker-empty { display:flex; align-items:center; gap:8px; justify-content:center; padding:20px; color:var(--ink-300); font-size:13px; }
    .add-picker-selected { display:flex; align-items:center; gap:8px; padding:9px 14px; background:rgba(31,58,103,.07); border:1.5px solid var(--accent-navy); border-radius:9px; font-size:13px; font-weight:600; color:var(--ink-900); }
    .add-picker-selected > span { flex:1; font-family:'Courier New',monospace; }
    .picker-clear-btn { background:transparent; border:none; cursor:pointer; color:var(--ink-400); font-size:14px; padding:2px 4px; border-radius:4px; transition:color .15s; }
    .picker-clear-btn:hover { color:var(--danger); }

    /* Form fields */
    .form-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
    .form-group { display:flex; flex-direction:column; gap:5px; }
    .form-group.full { grid-column:1/-1; }
    .form-label { font-size:11.5px; font-weight:700; color:var(--ink-500); text-transform:uppercase; letter-spacing:.5px; }
    .form-input { padding:9px 12px; border:1.5px solid var(--border); border-radius:9px; font-family:inherit; font-size:13.5px; color:var(--ink-900); background:var(--bg-canvas); outline:none; width:100%; box-sizing:border-box; transition:border-color .2s,box-shadow .2s; }
    .form-input:focus { border-color:var(--accent-navy); box-shadow:0 0 0 3px var(--accent-navy-soft); }
    .md-modal-footer { display:flex; align-items:center; justify-content:flex-end; gap:10px; padding:14px 22px 16px; border-top:1px solid var(--border); flex-shrink:0; background:var(--bg-canvas); }
    .md-modal-wide .md-modal-body { padding:0; }
</style>

<div class="md-page">

    <!-- TOP BAR -->
    <div class="md-topbar">
        <div class="md-machine-info">
            <button class="md-back-btn" onclick="history.back()">
                <i class="fa-solid fa-arrow-left"></i> Quay lại
            </button>
            <div class="md-machine-badge"><i class="fa-solid fa-gear"></i></div>
            <div>
                <div class="md-machine-title" id="mdMachineName">@machineName</div>
                <div class="md-machine-meta">
                    @if (!string.IsNullOrEmpty(machineCode))
                    {
                        <span class="md-meta-chip"><i class="fa-solid fa-hashtag"></i>@machineCode</span>
                    }
                    @if (!string.IsNullOrEmpty(dept))
                    {
                        <span class="md-meta-chip"><i class="fa-solid fa-building"></i>@dept</span>
                    }
                </div>
            </div>
        </div>
        <div class="md-topbar-actions">
            <button class="btn btn-ghost btn-sm" id="mdRefreshBtn">
                <i class="fa-solid fa-rotate-right"></i> Làm mới
            </button>
            <button class="btn btn-primary btn-sm" id="mdAddBtn">
                <i class="fa-solid fa-plus"></i> Thêm mã sản xuất
            </button>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="md-filter">
        <div class="md-filter-group">
            <label class="md-filter-label">Tìm kiếm</label>
            <div class="md-search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="mdSearch" placeholder="Mã SP, tên style, từ khóa..." style="min-width:220px;">
            </div>
        </div>
        <div class="md-filter-group">
            <label class="md-filter-label">Trạng thái</label>
            <select id="mdStatusFilter">
                <option value="">Tất cả</option>
                <option value="1">Đang sản xuất</option>
                <option value="2">Hoàn thành</option>
                <option value="3">Tạm dừng</option>
            </select>
        </div>
        <div class="md-filter-group" style="align-self:flex-end;">
            <button class="btn btn-primary btn-sm" id="mdFilterApply">
                <i class="fa-solid fa-magnifying-glass"></i> Lọc
            </button>
        </div>
        <div class="md-filter-group" style="align-self:flex-end;">
            <button class="btn btn-ghost btn-sm" id="mdFilterReset">
                <i class="fa-solid fa-arrow-rotate-left"></i> Đặt lại
            </button>
        </div>
    </div>

    <!-- BODY -->
    <div class="md-body">

        <!-- Summary cards -->
        <div class="md-summary-row" id="mdSummaryRow">
            <div class="md-sum-card accent-navy">
                <div class="md-sum-label">Tổng mã SP</div>
                <div class="md-sum-value" id="sumTotal">—</div>
                <div class="md-sum-sub">mã đang gắn máy</div>
            </div>
            <div class="md-sum-card accent-green">
                <div class="md-sum-label">Tổng sản lượng</div>
                <div class="md-sum-value" id="sumOutput">—</div>
                <div class="md-sum-sub">sản phẩm đã ra</div>
            </div>
            <div class="md-sum-card accent-gold">
                <div class="md-sum-label">Tổng kế hoạch</div>
                <div class="md-sum-value" id="sumTarget">—</div>
                <div class="md-sum-sub">sản phẩm mục tiêu</div>
            </div>
            <div class="md-sum-card accent-red">
                <div class="md-sum-label">Đang sản xuất</div>
                <div class="md-sum-value" id="sumActive">—</div>
                <div class="md-sum-sub">mã đang chạy</div>
            </div>
        </div>

        <!-- Production info table -->
        <div class="md-section-head">
            <div class="md-section-title">Danh sách mã sản xuất</div>
            <span id="mdRecordCount" style="font-size:12px;color:var(--ink-400);font-weight:600;"></span>
        </div>
        <div class="md-table-wrap">
            <div class="md-table-scroll">
            <table class="md-table">
                <thead>
                    <tr>
                        <th>Tổ</th>
                        <th>Style</th>
                        <th>Mã SP</th>
                        <th>Màu</th>
                        <th>Output / Qty</th>
                        <th>Hôm nay / Target</th>
                        <th>Trạng thái</th>
                        <th style="text-align:center;">Chi tiết</th>
                    </tr>
                </thead>
                <tbody id="mdTableBody">
                    <tr><td colspan="8" class="md-empty"><i class="fa-solid fa-circle-notch fa-spin"></i><p>Đang tải dữ liệu...</p></td></tr>
                </tbody>
            </table>
            </div>
        </div>

    </div><!-- end body -->

</div><!-- end page -->

<!-- ================================================================
     MODAL: Chi tiết sản lượng hàng ngày (DailyOutput)
================================================================ -->
<div class="md-modal-backdrop" id="detailBackdrop">
    <div class="md-modal">
        <div class="md-modal-head">
            <div class="md-modal-head-top">
                <div class="md-modal-title-group">
                    <div class="md-modal-icon"><i class="fa-solid fa-chart-gantt"></i></div>
                    <div>
                        <div class="md-modal-title" id="detailModalTitle">Sản lượng chi tiết</div>
                        <div class="md-modal-sub" id="detailModalSub"></div>
                    </div>
                </div>
                <button class="md-modal-close" id="detailModalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="md-modal-chips" id="detailModalChips"></div>
        </div>

        <!-- Date filter -->
        <div class="md-modal-date-filter">
            <label>Từ ngày:</label>
            <input type="date" id="detailFromDate">
            <span class="md-date-sep">→</span>
            <label>Đến:</label>
            <input type="date" id="detailToDate">
            <button class="btn btn-primary btn-sm" id="detailDateApply">
                <i class="fa-solid fa-filter"></i> Lọc
            </button>
            <span class="md-date-count" id="detailDateCount"></span>
        </div>

        <div class="md-summary-row" style="padding: 16px 22px 12px; grid-template-columns: 1fr 1fr; flex-shrink: 0;" id="detailCards">
            <div class="md-sum-card accent-navy">
                <div class="md-sum-label">Tổng sản lượng</div>
                <div class="md-sum-value" id="detailTotalOutput">—</div>
                <div class="md-sum-sub" id="detailTotalSub"></div>
            </div>
            <div class="md-sum-card accent-gold">
                <div class="md-sum-label">Đạt kế hoạch (Hôm nay / Chọn)</div>
                <div class="md-sum-value" id="detailTargetPercent">—</div>
                <div class="md-sum-sub" id="detailTargetSub"></div>
            </div>
        </div>

        <div class="md-modal-body" id="detailModalBody">
            <!-- DailyOutput cards rendered by JS -->
        </div>
    </div>
</div>

<!-- ================================================================
     MODAL: Thêm mã sản xuất (2 tab: Chọn có sẵn / Tạo mới)
================================================================ -->
<div class="md-modal-backdrop" id="addBackdrop">
    <div class="md-modal add-modal-wide">
        <div class="md-modal-head">
            <div class="md-modal-head-top">
                <div class="md-modal-title-group">
                    <div class="md-modal-icon" style="background:linear-gradient(135deg,var(--accent-navy) 0%,var(--accent-navy-700) 100%);color:#fff;">
                        <i class="fa-solid fa-plus"></i>
                    </div>
                    <div>
                        <div class="md-modal-title">Thêm mã sản xuất</div>
                        <div class="md-modal-sub">Chọn mã có sẵn hoặc tạo mã mới</div>
                    </div>
                </div>
                <button class="md-modal-close" id="addModalClose"><i class="fa-solid fa-xmark"></i></button>
            </div>
        </div>

        <!-- 2 tabs -->
        <div class="add-modal-tabs">
            <button class="add-tab-btn active" id="addTabBtnPick">
                <i class="fa-solid fa-list-check"></i> Chọn có sẵn
            </button>
            <button class="add-tab-btn" id="addTabBtnNew">
                <i class="fa-solid fa-plus-circle"></i> Tạo mã mới
            </button>
        </div>

        <!-- Tab Pick -->
        <div class="add-tab-pane active" id="addTabPanePick">
            <div class="add-picker-search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" class="add-picker-search" id="addPickerSearch" placeholder="Tìm mã SP, tên style...">
            </div>
            <div class="add-picker-list" id="addPickerList">
                <div class="add-picker-empty"><i class="fa-solid fa-circle-notch fa-spin"></i><span>Đang tải...</span></div>
            </div>
            <!-- Selected preview -->
            <div class="add-picker-selected" id="addPickerSelected" style="display:none;">
                <i class="fa-solid fa-circle-check" style="color:var(--accent-navy);"></i>
                <span id="addPickerSelectedSp">—</span>
                <button class="picker-clear-btn" id="addPickerClearBtn"><i class="fa-solid fa-xmark"></i></button>
            </div>
        </div>

        <!-- Tab New -->
        <div class="add-tab-pane" id="addTabPaneNew">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Mã SP <span style="color:var(--danger)">*</span></label>
                    <input type="text" class="form-input" id="fSpmain" placeholder="SP-2026-xxxx">
                </div>
                <div class="form-group">
                    <label class="form-label">Tên Style <span style="color:var(--danger)">*</span></label>
                    <input type="text" class="form-input" id="fStyle" placeholder="Tên sản phẩm">
                </div>
                <div class="form-group">
                    <label class="form-label">Tổ / Line</label>
                    <input type="text" class="form-input" id="fLine" placeholder="Tổ 1">
                </div>
                <div class="form-group">
                    <label class="form-label">Màu sắc</label>
                    <input type="text" class="form-input" id="fColor" placeholder="Trắng, Xanh...">
                </div>
                <div class="form-group">
                    <label class="form-label">Kế hoạch (chiếc)</label>
                    <input type="number" class="form-input" id="fTarget" placeholder="1500" min="0">
                </div>
                <div class="form-group">
                    <label class="form-label">Tổng SL</label>
                    <input type="number" class="form-input" id="fTotalQty" placeholder="1500" min="0">
                </div>
                <div class="form-group">
                    <label class="form-label">Inline Line</label>
                    <input type="date" class="form-input" id="fInlineLine">
                </div>
                <div class="form-group">
                    <label class="form-label">Inline Dept</label>
                    <input type="date" class="form-input" id="fInlineDept">
                </div>
                <div class="form-group full">
                    <label class="form-label">Ghi chú</label>
                    <input type="text" class="form-input" id="fRemark" placeholder="Ghi chú...">
                </div>
            </div>
        </div>

        <div class="md-modal-footer">
            <button class="btn btn-ghost btn-sm" id="addModalCancel">Hủy</button>
            <button class="btn btn-primary btn-sm" id="addModalSave">
                <i class="fa-solid fa-floppy-disk"></i> Lưu
            </button>
        </div>
    </div>
</div>

<script>
(function () {
    /* =====================================================
       CONFIG từ Razor
       ===================================================== */
    var MACHINE_ID = '@machineId';
    var DEPT_ID    = '@deptId';
    var DEPT_NAME  = '@Html.Raw(dept.Replace("'", "\\'"))';

    /* =====================================================
       STATE
       ===================================================== */
    var allInfos       = [];
    var currentSearch  = '';
    var currentStatus  = '';
    var addActiveTab   = 'pick';
    var addPickerItems = [];
    var pickedInfo     = null;

    // Modal detail state
    var currentDetailInfo = null;

    /* =====================================================
       HELPERS
       ===================================================== */
    function esc(s) { return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }

    function fmt(n) { return n == null ? '—' : Number(n).toLocaleString('vi-VN'); }

    function fmtDate(d) {
        if (!d) return '—';
        var dt = new Date(d);
        if (isNaN(dt)) return d;
        return dt.getDate().toString().padStart(2,'0') + '/' + (dt.getMonth()+1).toString().padStart(2,'0') + '/' + dt.getFullYear();
    }

    function toast(msg, ok) {
        var t = document.createElement('div');
        t.style.cssText = 'position:fixed;bottom:28px;right:28px;z-index:9999;padding:12px 20px;border-radius:10px;font-size:13.5px;font-weight:700;color:#fff;box-shadow:0 6px 20px rgba(0,0,0,.18);background:' + (ok ? 'var(--success)' : 'var(--danger)') + ';';
        t.textContent = msg;
        document.body.appendChild(t);
        setTimeout(function () { t.remove(); }, 3000);
    }

    function statusBadge(s) {
        if (s === 1) return '<span class="td-badge active">Đang SX</span>';
        if (s === 2) return '<span class="td-badge done">Hoàn thành</span>';
        return '<span class="td-badge inactive">Tạm dừng</span>';
    }

    function progressColor(pct) {
        if (pct >= 80) return 'var(--success)';
        if (pct >= 50) return 'var(--accent-gold)';
        return 'var(--danger)';
    }

    /* =====================================================
       LOAD: Danh sách mã sản xuất theo máy
       ===================================================== */
    function loadProductionInfos() {
        if (!MACHINE_ID) {
            renderTable([]);
            return;
        }
        var url = '/ProductionDepartment/GetProductionInfos?machineId=' + encodeURIComponent(MACHINE_ID);
        if (currentSearch) url += '&keyword=' + encodeURIComponent(currentSearch);

        document.getElementById('mdTableBody').innerHTML =
            '<tr><td colspan="8" class="md-empty"><i class="fa-solid fa-circle-notch fa-spin"></i><p>Đang tải...</p></td></tr>';

        fetch(url)
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (list) {
                allInfos = list;
                renderAll();
            })
            .catch(function (e) {
                document.getElementById('mdTableBody').innerHTML =
                    '<tr><td colspan="8" class="md-empty"><i class="fa-solid fa-triangle-exclamation"></i><p>Lỗi: ' + esc(e.message) + '</p></td></tr>';
            });
    }

    function renderAll() {
        var filtered = allInfos.filter(function (p) {
            if (currentStatus && p.status !== parseInt(currentStatus)) return false;
            return true;
        });
        renderSummary(filtered);
        renderTable(filtered);
    }

    function renderSummary(list) {
        var totalOutput = list.reduce(function (s, p) { return s + (p.totalOutputNumber || 0); }, 0);
        var totalTarget = list.reduce(function (s, p) { return s + (p.target || 0); }, 0);
        var active = list.filter(function (p) { return p.status === 1; }).length;
        document.getElementById('sumTotal').textContent  = fmt(list.length);
        document.getElementById('sumOutput').textContent = fmt(totalOutput);
        document.getElementById('sumTarget').textContent = fmt(totalTarget);
        document.getElementById('sumActive').textContent = fmt(active);
        document.getElementById('mdRecordCount').textContent = list.length + ' bản ghi';
    }

    function renderTable(list) {
        var tbody = document.getElementById('mdTableBody');
        if (!list.length) {
            tbody.innerHTML = '<tr><td colspan="8" class="md-empty"><i class="fa-solid fa-inbox"></i><p>Không có mã sản xuất nào</p></td></tr>';
            return;
        }
        tbody.innerHTML = '';
        list.forEach(function (p) {
            var qty     = p.totalQty || 0;
            var output  = p.totalOutputNumber || 0;
            var pctQty  = qty > 0 ? Math.min(100, Math.round(output / qty * 100)) : 0;
            var colorQty= progressColor(pctQty);

            var target  = p.target || 0;
            var today   = p.todayOutput || 0;
            var pctTarget = target > 0 ? Math.min(100, Math.round(today / target * 100)) : 0;
            var colorTarget = progressColor(pctTarget);

            var tr = document.createElement('tr');
            tr.dataset.id = p.id;
            tr.innerHTML =
                '<td><div style="font-size:13px;font-weight:600;">' + esc(p.line || '—') + '</div></td>' +
                '<td><div class="td-style-name">' + esc(p.style || '—') + '</div>' +
                    (p.remark ? '<div class="td-meta">' + esc(p.remark) + '</div>' : '') + '</td>' +
                '<td><span class="td-sp">' + esc(p.spmain || '—') + '</span></td>' +
                '<td>' + esc(p.color || '—') + '</td>' +
                '<td><div class="td-progress-wrap">' +
                    '<div style="font-size:14px;font-weight:800;color:var(--accent-navy);">' + fmt(output) + ' / ' + fmt(qty) + '</div>' +
                    '<div class="td-progress-bar-bg"><div class="td-progress-bar-fill" style="width:' + pctQty + '%;background:' + colorQty + ';"></div></div>' +
                    '<div class="td-pct">' + pctQty + '%</div>' +
                '</div></td>' +
                '<td><div class="td-progress-wrap">' +
                    '<div style="font-size:14px;font-weight:800;color:var(--accent-navy);">' + fmt(today) + ' / ' + fmt(target) + '</div>' +
                    '<div class="td-progress-bar-bg"><div class="td-progress-bar-fill" style="width:' + pctTarget + '%;background:' + colorTarget + ';"></div></div>' +
                    '<div class="td-pct">' + pctTarget + '%</div>' +
                '</div></td>' +
                '<td>' + statusBadge(p.status) + '</td>' +
                '<td style="text-align:center;"><button class="td-view-btn" data-id="' + p.id + '"><i class="fa-solid fa-eye"></i> Xem</button></td>';

            tr.querySelector('.td-view-btn').addEventListener('click', function (e) {
                e.stopPropagation();
                openDetailModal(p);
            });
            tr.addEventListener('click', function () { openDetailModal(p); });
            tbody.appendChild(tr);
        });
    }

    /* =====================================================
       MODAL: Chi tiết sản lượng
       ===================================================== */
    var detailBackdrop = document.getElementById('detailBackdrop');

    function openDetailModal(info) {
        currentDetailInfo = info;
        document.getElementById('detailModalTitle').textContent = info.spmain || '—';
        document.getElementById('detailModalSub').textContent   = info.style || '';
        document.getElementById('detailModalChips').innerHTML   =
            '<span class="md-modal-chip hl"><i class="fa-solid fa-shirt"></i>' + esc(info.spmain || '—') + '</span>' +
            (info.line  ? '<span class="md-modal-chip"><i class="fa-solid fa-users"></i>' + esc(info.line)  + '</span>' : '') +
            (info.color ? '<span class="md-modal-chip"><i class="fa-solid fa-palette"></i>' + esc(info.color) + '</span>' : '');

        // Mặc định chọn ngày hiện tại
        var today = new Date();
        today.setMinutes(today.getMinutes() - today.getTimezoneOffset());
        var todayStr = today.toISOString().split('T')[0];
        document.getElementById('detailFromDate').value = todayStr;
        document.getElementById('detailToDate').value   = todayStr;
        document.getElementById('detailDateCount').textContent = '';

        detailBackdrop.classList.add('open');
        loadDailyOutputs(info.id);
    }

    function closeDetailModal() {
        detailBackdrop.classList.remove('open');
        currentDetailInfo = null;
    }

    document.getElementById('detailModalClose').addEventListener('click', closeDetailModal);
    detailBackdrop.addEventListener('click', function (e) { if (e.target === detailBackdrop) closeDetailModal(); });

    document.getElementById('detailDateApply').addEventListener('click', function () {
        if (!currentDetailInfo) return;
        loadDailyOutputs(currentDetailInfo.id);
    });

    function loadDailyOutputs(productionInfoId) {
        var body = document.getElementById('detailModalBody');
        body.innerHTML = '<div style="display:flex;align-items:center;gap:10px;padding:24px;color:var(--ink-300);"><i class="fa-solid fa-circle-notch fa-spin"></i> Đang tải...</div>';

        var url = '/ProductionDepartment/GetDailyOutputs'
            + '?productionInfoId=' + encodeURIComponent(productionInfoId)
            + '&machineId='        + encodeURIComponent(MACHINE_ID);

        var from = document.getElementById('detailFromDate').value;
        var to   = document.getElementById('detailToDate').value;
        if (from) url += '&from=' + encodeURIComponent(from);
        if (to)   url += '&to='   + encodeURIComponent(to);

        fetch(url)
            .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
            .then(function (list) {
                document.getElementById('detailDateCount').textContent = list.length + ' ngày';
                renderDailyOutputs(list);
            })
            .catch(function (e) {
                body.innerHTML = '<div class="md-empty"><i class="fa-solid fa-triangle-exclamation"></i><p>' + esc(e.message) + '</p></div>';
            });
    }

    function renderDailyOutputs(list) {
        var body = document.getElementById('detailModalBody');

        var info = currentDetailInfo || {};
        var qty = info.totalQty || 0;
        var target = info.target || 0;

        var totalOutput = 0;
        list.forEach(function(d) { totalOutput += (d.totalOutputNumber || 0); });

        var pctQty = qty > 0 ? Math.min(100, Math.round(totalOutput / qty * 100)) : 0;
        document.getElementById('detailTotalOutput').textContent = fmt(totalOutput) + ' / ' + fmt(qty);
        document.getElementById('detailTotalSub').textContent = pctQty + '% Qty';

        var pctTarget = target > 0 ? Math.min(100, Math.round(totalOutput / target * 100)) : 0;
        document.getElementById('detailTargetPercent').textContent = pctTarget + '%';
        document.getElementById('detailTargetSub').textContent = fmt(totalOutput) + ' / ' + fmt(target) + ' mục tiêu';

        if (!list.length) {
            body.innerHTML = '<div class="md-empty"><i class="fa-solid fa-calendar-xmark"></i><p>Chưa có sản lượng nào trong khoảng thời gian này</p></div>';
            return;
        }
        body.innerHTML = '';
        list.forEach(function (d) {
            var card = document.createElement('div');
            card.className = 'md-day-card';

            var detailMap = {};
            (d.details || []).forEach(function(dt) {
                var name = dt.detailName || 'Khác';
                if (!detailMap[name]) detailMap[name] = 0;
                detailMap[name] += (dt.outputNumber || 0);
            });
            var summaryArr = [];
            for (var k in detailMap) summaryArr.push(k + ': ' + fmt(detailMap[k]));
            var summaryText = summaryArr.length ? '<div style="padding: 10px 16px; font-size: 12px; color: var(--ink-500); background: var(--bg-canvas); border-bottom: 1px solid var(--border-soft);">Tổng: ' + esc(summaryArr.join(', ')) + '</div>' : '';

            var detailRows = (d.details || []).map(function (dt) {
                return '<tr>' +
                    '<td>' + esc(dt.detailName) + '</td>' +
                    '<td style="color:var(--ink-500);">' + (dt.inputTime || '—') + '</td>' +
                    '<td><span class="md-output-num">' + fmt(dt.outputNumber) + '</span></td>' +
                '</tr>';
            }).join('');

            var isFirst = (list.indexOf(d) === 0);
            var initDisplay = isFirst ? 'block' : 'none';
            var initRot = isFirst ? 'rotate(180deg)' : 'rotate(0deg)';

            card.innerHTML =
                '<div class="md-day-card-head" style="cursor:pointer; user-select:none;">' +
                    '<div class="md-day-date"><i class="fa-regular fa-calendar"></i>' + fmtDate(d.createDate) + (d.styleCode ? ' &nbsp;·&nbsp; <span style="font-family:Courier New;font-size:11.5px;color:var(--ink-400);">' + esc(d.styleCode) + '</span>' : '') + '</div>' +
                    '<div class="md-day-total"><i class="fa-solid fa-box"></i> ' + fmt(d.totalOutputNumber) + ' thành phẩm <i class="fa-solid fa-chevron-down" style="font-size:11px; margin-left:6px; transition:transform 0.2s; transform:' + initRot + '"></i></div>' +
                '</div>' +
                '<div class="md-day-card-content" style="display:' + initDisplay + ';">' +
                summaryText +
                (detailRows ?
                    '<table class="md-detail-table">' +
                        '<thead><tr><th>Công đoạn</th><th>Giờ vào</th><th>Lần nhập</th></tr></thead>' +
                        '<tbody>' + detailRows + '</tbody>' +
                    '</table>'
                : '<div style="padding:12px 16px;font-size:12.5px;color:var(--ink-300);">Chưa có chi tiết công đoạn</div>') +
                '</div>';
                
            var head = card.querySelector('.md-day-card-head');
            var content = card.querySelector('.md-day-card-content');
            var icon = card.querySelector('.fa-chevron-down');
            head.addEventListener('click', function() {
                if (content.style.display === 'none') {
                    content.style.display = 'block';
                    icon.style.transform = 'rotate(180deg)';
                } else {
                    content.style.display = 'none';
                    icon.style.transform = 'rotate(0deg)';
                }
            });
            body.appendChild(card);
        });
    }

    /* =====================================================
       MODAL: Thêm mã sản xuất
       ===================================================== */
    var addBackdrop = document.getElementById('addBackdrop');

    // Tab switching
    document.getElementById('addTabBtnPick').addEventListener('click', function () { switchAddTab('pick'); });
    document.getElementById('addTabBtnNew').addEventListener('click',  function () { switchAddTab('new');  });

    function switchAddTab(tab) {
        addActiveTab = tab;
        document.getElementById('addTabBtnPick').classList.toggle('active', tab === 'pick');
        document.getElementById('addTabBtnNew').classList.toggle('active', tab === 'new');
        document.getElementById('addTabPanePick').classList.toggle('active', tab === 'pick');
        document.getElementById('addTabPaneNew').classList.toggle('active', tab === 'new');
    }

    // Open modal
    document.getElementById('mdAddBtn').addEventListener('click', function () {
        pickedInfo = null;
        document.getElementById('addPickerSelected').style.display = 'none';
        document.getElementById('addPickerSearch').value = '';
        switchAddTab('pick');
        resetNewForm();
        addBackdrop.classList.add('open');
        loadAddPickerItems('');
    });

    function closeAddModal() { addBackdrop.classList.remove('open'); }
    document.getElementById('addModalClose').addEventListener('click', closeAddModal);
    document.getElementById('addModalCancel').addEventListener('click', closeAddModal);
    addBackdrop.addEventListener('click', function (e) { if (e.target === addBackdrop) closeAddModal(); });

    // Picker search
    document.getElementById('addPickerSearch').addEventListener('input', function () {
        renderAddPickerList(this.value);
    });

    document.getElementById('addPickerClearBtn').addEventListener('click', function () {
        pickedInfo = null;
        document.getElementById('addPickerSelected').style.display = 'none';
        renderAddPickerList(document.getElementById('addPickerSearch').value);
    });

    function loadAddPickerItems(keyword) {
        var list_el = document.getElementById('addPickerList');
        list_el.innerHTML = '<div class="add-picker-empty"><i class="fa-solid fa-circle-notch fa-spin"></i><span>Đang tải...</span></div>';
        addPickerItems = [];

        if (!DEPT_ID) { renderAddPickerList(''); return; }

        fetch('/ProductionDepartment/GetProductionInfosByDept?deptId=' + encodeURIComponent(DEPT_ID))
            .then(function (r) { return r.json(); })
            .then(function (list) {
                addPickerItems = list;
                renderAddPickerList(document.getElementById('addPickerSearch').value);
            })
            .catch(function () {
                list_el.innerHTML = '<div class="add-picker-empty"><i class="fa-solid fa-triangle-exclamation"></i><span>Lỗi tải danh sách</span></div>';
            });
    }

    function renderAddPickerList(keyword) {
        var kw = (keyword || '').toLowerCase().trim();
        var filtered = addPickerItems.filter(function (p) {
            if (!kw) return true;
            return (p.spmain||'').toLowerCase().includes(kw) ||
                   (p.style||'').toLowerCase().includes(kw) ||
                   (p.keyword||'').toLowerCase().includes(kw);
        });

        var list_el = document.getElementById('addPickerList');
        list_el.innerHTML = '';

        if (!filtered.length) {
            list_el.innerHTML = '<div class="add-picker-empty"><i class="fa-solid fa-inbox"></i><span>' +
                (addPickerItems.length ? 'Không tìm thấy mã phù hợp' : 'Chưa có mã sản xuất nào trong bộ phận') +
                '</span></div>';
            return;
        }

        filtered.forEach(function (p) {
            var isSelected = pickedInfo && pickedInfo.id === p.id;
            var item = document.createElement('div');
            item.className = 'add-picker-item' + (isSelected ? ' selected' : '');
            item.innerHTML =
                '<div class="add-picker-item-icon"><i class="fa-solid fa-shirt"></i></div>' +
                '<div class="add-picker-item-info">' +
                    '<div class="add-picker-item-sp">' + esc(p.spmain || '—') + '</div>' +
                    '<div class="add-picker-item-style">' + esc(p.style || '—') + '</div>' +
                    (p.line || p.color ? '<div class="add-picker-item-meta">' + esc(p.line||'') + (p.color ? ' · ' + esc(p.color) : '') + '</div>' : '') +
                '</div>' +
                (isSelected ? '<i class="fa-solid fa-circle-check add-picker-item-check"></i>' : '');

            item.addEventListener('click', function () {
                pickedInfo = p;
                document.getElementById('addPickerSelectedSp').textContent = (p.spmain || '—') + ' — ' + (p.style || '');
                document.getElementById('addPickerSelected').style.display = 'flex';
                renderAddPickerList(document.getElementById('addPickerSearch').value);
            });
            list_el.appendChild(item);
        });
    }

    function resetNewForm() {
        ['fSpmain','fStyle','fLine','fColor','fRemark'].forEach(function (id) {
            document.getElementById(id).value = '';
        });
        ['fTarget','fTotalQty'].forEach(function (id) { document.getElementById(id).value = ''; });
        ['fInlineLine','fInlineDept'].forEach(function (id) { document.getElementById(id).value = ''; });
    }

    // Save — gọi API thực
    document.getElementById('addModalSave').addEventListener('click', function () {
        var saveBtn = this;
        var origHtml = saveBtn.innerHTML;

        if (addActiveTab === 'pick') {
            // ── Tab "Chọn có sẵn": gán ProductionInfo đã có vào máy ──────────
            if (!pickedInfo) {
                toast('Vui lòng chọn một mã sản xuất', false);
                return;
            }
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang lưu...';

            fetch('/ProductionDepartment/AssignProductionInfo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    productionInfoId: pickedInfo.id,
                    machineId: MACHINE_ID
                })
            })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                if (!res.ok || !res.data.success) {
                    toast(res.data.message || 'Lỗi khi gán mã vào máy', false);
                    return;
                }
                toast(res.data.message || 'Đã gán mã sản xuất vào máy', true);
                closeAddModal();
                loadProductionInfos();
            })
            .catch(function (e) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                toast('Lỗi kết nối: ' + e.message, false);
            });

        } else {
            // ── Tab "Tạo mới": tạo ProductionInfo mới rồi gán vào máy ────────
            var sp = document.getElementById('fSpmain').value.trim();
            var st = document.getElementById('fStyle').value.trim();
            if (!sp || !st) {
                toast('Vui lòng nhập Mã SP và Tên Style', false);
                return;
            }
            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang tạo...';

            fetch('/ProductionDepartment/CreateProductionInfo', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    spmain:    sp,
                    style:     st,
                    line:      document.getElementById('fLine').value.trim() || null,
                    color:     document.getElementById('fColor').value.trim() || null,
                    target:    parseInt(document.getElementById('fTarget').value)   || null,
                    totalQty:  parseInt(document.getElementById('fTotalQty').value) || null,
                    inlineLine: document.getElementById('fInlineLine').value || null,
                    inlineDept: document.getElementById('fInlineDept').value || null,
                    remark:    document.getElementById('fRemark').value.trim() || null,
                    machineId: MACHINE_ID,
                    deptId:    DEPT_ID
                })
            })
            .then(function (r) { return r.json().then(function (d) { return { ok: r.ok, data: d }; }); })
            .then(function (res) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                if (!res.ok || !res.data.success) {
                    toast(res.data.message || 'Lỗi khi tạo mã sản xuất', false);
                    return;
                }
                toast(res.data.message || 'Đã tạo và gán mã sản xuất vào máy', true);
                closeAddModal();
                loadProductionInfos();
            })
            .catch(function (e) {
                saveBtn.disabled = false;
                saveBtn.innerHTML = origHtml;
                toast('Lỗi kết nối: ' + e.message, false);
            });
        }
    });


    /* =====================================================
       FILTER EVENTS
       ===================================================== */
    document.getElementById('mdFilterApply').addEventListener('click', function () {
        currentSearch = document.getElementById('mdSearch').value.trim().toLowerCase();
        currentStatus = document.getElementById('mdStatusFilter').value;
        loadProductionInfos();
    });

    document.getElementById('mdFilterReset').addEventListener('click', function () {
        document.getElementById('mdSearch').value = '';
        document.getElementById('mdStatusFilter').value = '';
        currentSearch = currentStatus = '';
        loadProductionInfos();
    });

    document.getElementById('mdSearch').addEventListener('keydown', function (e) {
        if (e.key === 'Enter') document.getElementById('mdFilterApply').click();
    });

    document.getElementById('mdRefreshBtn').addEventListener('click', function () {
        loadProductionInfos();
    });

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') { closeDetailModal(); closeAddModal(); }
    });

    /* =====================================================
       INIT
       ===================================================== */
    document.addEventListener('DOMContentLoaded', function () {
        loadProductionInfos();
    });

}());
</script>
