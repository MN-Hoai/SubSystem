<script>
(function () {
    /* =====================================================
       HELPERS
       ===================================================== */
    function fmt(n) { return Number(n || 0).toLocaleString('vi-VN'); }
    function fmtDate(d) { if (!d) return '—'; var p = d.split('-'); return p[2]+'/'+p[1]+'/'+p[0]; }
    function pct(a, b) { return b > 0 ? Math.min(100, Math.round(a / b * 100)) : 0; }
    function pctColor(p) { return p >= 100 ? 'var(--accent-navy)' : p >= 70 ? 'var(--success)' : p >= 40 ? 'var(--accent-gold)' : 'var(--danger)'; }
    function statusInfo(s) {
        return s === 1 ? { cls:'active',   lbl:'Đang SX'     }
             : s === 2 ? { cls:'done',     lbl:'Hoàn thành'  }
             : { cls:'inactive', lbl:'Ngừng' };
    }

    /* =====================================================
       LOAD DATA
       TODO: Thay loadData() bằng:
         fetch('/ProductionDepartment/GetProductionInfos?machineId=' + MACHINE_ID)
           .then(r => r.json())
           .then(data => { allData = data; applyFilters(); });
       ===================================================== */
    var allData = [];
    try {
        var el = document.getElementById('mockProductionInfos');
        allData = el ? JSON.parse(el.textContent) : [];
    } catch(e) {}

    /* =====================================================
       POPULATE LINE FILTER
       ===================================================== */
    var lineFilter = document.getElementById('mdLineFilter');
    var lines = [...new Set(allData.map(function(d){ return d.line; }).filter(Boolean))];
    lines.forEach(function(l) {
        var o = document.createElement('option');
        o.value = l;
        o.textContent = l;
        lineFilter.appendChild(o);
    });

    /* =====================================================
       SUMMARY CARDS
       ===================================================== */
    function renderSummary(data) {
        var totalFinish = data.reduce(function(a,d){ return a + (d.finishQty||0); }, 0);
        var totalTarget = data.reduce(function(a,d){ return a + (d.totalQty||0);  }, 0);
        var rate = pct(totalFinish, totalTarget);
        document.getElementById('sTotal').textContent  = data.length;
        document.getElementById('sFinish').textContent = fmt(totalFinish);
        document.getElementById('sTarget').textContent = fmt(totalTarget);
        document.getElementById('sRate').textContent   = rate + '%';
        document.getElementById('mdRecordCount').textContent = data.length;
        document.getElementById('mdTotalRecords').style.display = '';
    }

    /* =====================================================
       RENDER TABLE
       ===================================================== */
    function renderTable(data) {
        var tbody = document.getElementById('mdTableBody');
        tbody.innerHTML = '';

        document.getElementById('mdCountLabel').textContent =
            data.length + ' / ' + allData.length + ' bản ghi';

        if (data.length === 0) {
            tbody.innerHTML =
                '<tr><td colspan="8">' +
                    '<div class="md-empty"><i class="fa-regular fa-folder-open"></i><p>Không có dữ liệu</p></div>' +
                '</td></tr>';
            return;
        }

        data.forEach(function(item, idx) {
            var p = pct(item.finishQty || 0, item.totalQty || 0);
            var st = statusInfo(item.status);

            var tr = document.createElement('tr');
            tr.innerHTML =
                '<td style="color:var(--ink-300);font-weight:700;font-size:12px;">' + (idx+1) + '</td>' +
                '<td>' +
                    '<div class="td-style-name">' + esc(item.style) + '</div>' +
                    '<div style="margin-top:4px;"><span class="td-sp">' + esc(item.spmain) + '</span></div>' +
                '</td>' +
                '<td class="td-meta">' + esc(item.line || '—') + '</td>' +
                '<td class="td-meta">' + esc(item.color || '—') + '</td>' +
                '<td>' +
                    '<div class="td-progress-wrap">' +
                        '<div style="display:flex;justify-content:space-between;align-items:baseline;margin-bottom:4px;">' +
                            '<span style="font-size:12px;color:var(--ink-500);">' + fmt(item.finishQty) + ' / ' + fmt(item.totalQty) + '</span>' +
                            '<span class="td-pct">' + p + '%</span>' +
                        '</div>' +
                        '<div class="td-progress-bar-bg">' +
                            '<div class="td-progress-bar-fill" style="width:' + p + '%;background:' + pctColor(p) + ';"></div>' +
                        '</div>' +
                    '</div>' +
                '</td>' +
                '<td class="td-meta">' + fmtDate(item.inlineLine) + '</td>' +
                '<td><span class="td-badge ' + st.cls + '">' + st.lbl + '</span></td>' +
                '<td>' +
                    '<button class="td-view-btn" data-idx="' + idx + '">' +
                        '<i class="fa-solid fa-table-list"></i> Chi tiết' +
                    '</button>' +
                '</td>';

            tbody.appendChild(tr);
        });

        // Attach row click → open detail modal
        tbody.querySelectorAll('.td-view-btn').forEach(function(btn) {
            btn.addEventListener('click', function(e) {
                e.stopPropagation();
                openDetailModal(data[parseInt(this.dataset.idx)]);
            });
        });

        tbody.querySelectorAll('tr').forEach(function(tr) {
            tr.addEventListener('click', function() {
                var btn = this.querySelector('.td-view-btn');
                if (btn) btn.click();
            });
        });
    }

    function esc(s) {
        return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    /* =====================================================
       FILTER & SEARCH
       ===================================================== */
    var currentSearch = '', currentStatus = '', currentLine = '';

    function applyFilters() {
        var q = currentSearch.toLowerCase();
        var filtered = allData.filter(function(d) {
            if (currentStatus && String(d.status) !== currentStatus) return false;
            if (currentLine   && d.line !== currentLine)               return false;
            if (q && !(
                (d.style  ||'').toLowerCase().includes(q) ||
                (d.spmain ||'').toLowerCase().includes(q) ||
                (d.color  ||'').toLowerCase().includes(q) ||
                (d.keyword||'').toLowerCase().includes(q)
            )) return false;
            return true;
        });
        renderSummary(filtered);
        renderTable(filtered);
    }

    document.getElementById('mdFilterApply').addEventListener('click', function () {
        currentSearch = document.getElementById('mdSearch').value.trim();
        currentStatus = document.getElementById('mdStatusFilter').value;
        currentLine   = document.getElementById('mdLineFilter').value;
        applyFilters();
    });

    document.getElementById('mdFilterReset').addEventListener('click', function () {
        document.getElementById('mdSearch').value = '';
        document.getElementById('mdStatusFilter').value = '';
        document.getElementById('mdLineFilter').value   = '';
        currentSearch = currentStatus = currentLine = '';
        applyFilters();
    });

    document.getElementById('mdSearch').addEventListener('input', function () {
        currentSearch = this.value.trim();
        applyFilters();
    });

    document.getElementById('mdRefreshBtn').addEventListener('click', function () {
        /*
         * TODO: reload từ API:
         * fetch('/ProductionDepartment/GetProductionInfos?machineId=...')
         *   .then(r=>r.json()).then(d=>{ allData=d; applyFilters(); });
         */
        applyFilters();
        var btn = this;
        btn.innerHTML = '<i class="fa-solid fa-check"></i> Đã làm mới';
        setTimeout(function(){ btn.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Làm mới'; }, 1500);
    });

    /* =====================================================
       DETAIL MODAL: DailyOutput + DailyOutputDetail
       =====================================================
       TODO: Khi kết nối DB, load data từ:
         GET /ProductionDepartment/GetDailyOutputDetails?productionInfoId={id}
         → List<DailyOutputDto> { id, totalOutputNumber, createDate, styleCode,
             details: [{ detailName, outputNumber, inputTime }] }
       ===================================================== */
    var detailBackdrop = document.getElementById('mdDetailBackdrop');
    var currentDetailItem = null; // keep ref for re-render on date filter

    /* ---- Date filter helpers ---- */
    function parseISODate(s) { return s ? new Date(s + 'T00:00:00') : null; }
    function dateInRange(dateStr, from, to) {
        var d = parseISODate(dateStr);
        if (!d) return true;
        if (from && d < from) return false;
        if (to   && d > to)   return false;
        return true;
    }

    function renderDetailBody(item, fromDate, toDate) {
        var body = document.getElementById('mdModalBody');
        body.innerHTML = '';

        var allOutputs = item.dailyOutputs || [];
        var outputs = allOutputs.filter(function(o) {
            return dateInRange(o.createDate, fromDate, toDate);
        });

        // Update count label
        var countEl = document.getElementById('mdDateCount');
        if (fromDate || toDate) {
            countEl.textContent = outputs.length + ' / ' + allOutputs.length + ' ngày';
        } else {
            countEl.textContent = allOutputs.length + ' ngày ghi nhận';
        }

        if (allOutputs.length === 0) {
            body.innerHTML =
                '<div class="md-no-output">' +
                    '<i class="fa-regular fa-folder-open" style="font-size:28px;color:var(--ink-300);display:block;margin-bottom:10px;"></i>' +
                    'Chưa có sản lượng hàng ngày nào được ghi nhận.' +
                '</div>';
            return;
        }

        if (outputs.length === 0 && (fromDate || toDate)) {
            body.innerHTML =
                '<div class="md-no-output">' +
                    '<i class="fa-solid fa-filter-circle-xmark" style="font-size:26px;color:var(--ink-300);display:block;margin-bottom:10px;"></i>' +
                    'Không có dữ liệu trong khoảng ngày đã chọn.' +
                '</div>';
            return;
        }

        /* ---- Summary cards (tính theo dữ liệu đã lọc) ---- */
        var grandTotal = outputs.reduce(function(a,o){ return a + (o.totalOutputNumber||0); }, 0);
        var grandAllTotal = allOutputs.reduce(function(a,o){ return a + (o.totalOutputNumber||0); }, 0);

        // Find max outputNumber across all details for progress bar scale
        var maxOutput = 0;
        outputs.forEach(function(o) {
            (o.details||[]).forEach(function(d) { if ((d.outputNumber||0) > maxOutput) maxOutput = d.outputNumber; });
        });

        var summaryCard = document.createElement('div');
        summaryCard.style.cssText = 'display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-bottom:4px;';
        var pctVal = pct(item.finishQty, item.totalQty);
        summaryCard.innerHTML =
            '<div style="background:var(--accent-navy-soft);border:1.5px solid #c0cfe8;border-radius:11px;padding:12px 14px;">' +
                '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--accent-navy);margin-bottom:4px;">SL đã may (lọc)</div>' +
                '<div style="font-size:22px;font-weight:800;color:var(--accent-navy);">' + fmt(grandTotal) + '</div>' +
                '<div style="font-size:11px;color:var(--ink-500);margin-top:2px;">' + outputs.length + ' ngày ghi nhận</div>' +
            '</div>' +
            '<div style="background:#E6F4EF;border:1.5px solid #B8DDD2;border-radius:11px;padding:12px 14px;">' +
                '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--success);margin-bottom:4px;">Tiến độ tổng</div>' +
                '<div style="font-size:22px;font-weight:800;color:' + pctColor(pctVal) + ';">' + pctVal + '%</div>' +
                '<div style="font-size:11px;color:var(--ink-500);margin-top:2px;">' + fmt(item.finishQty) + ' / ' + fmt(item.totalQty) + '</div>' +
            '</div>' +
            '<div style="background:var(--bg-canvas);border:1.5px solid var(--border);border-radius:11px;padding:12px 14px;">' +
                '<div style="font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--ink-300);margin-bottom:4px;">Tổng tất cả ngày</div>' +
                '<div style="font-size:22px;font-weight:800;color:var(--ink-900);">' + fmt(grandAllTotal) + '</div>' +
                '<div style="font-size:11px;color:var(--ink-500);margin-top:2px;">' + allOutputs.length + ' ngày ghi nhận</div>' +
            '</div>';
        body.appendChild(summaryCard);

        /* ---- DailyOutput cards ---- */
        outputs.forEach(function(output) {
            var details = output.details || [];
            var dayMax = details.reduce(function(a,d){ return Math.max(a, d.outputNumber||0); }, 0);

            var detailRows = details.map(function(det) {
                var p = dayMax > 0 ? Math.round((det.outputNumber||0) / dayMax * 100) : 0;
                return '<tr>' +
                    '<td>' + esc(det.detailName) + '</td>' +
                    '<td><i class="fa-regular fa-clock" style="margin-right:4px;color:var(--ink-300);"></i>' + esc(det.inputTime) + '</td>' +
                    '<td>' +
                        '<div class="md-sl-cell">' +
                            '<span class="md-sl-num">' + fmt(det.outputNumber) + ' <span style="font-size:11px;font-weight:500;color:var(--ink-500);">sp</span></span>' +
                            '<div class="md-sl-bar-bg"><div class="md-sl-bar-fill" style="width:' + p + '%;background:' + pctColor(p) + ';"></div></div>' +
                        '</div>' +
                    '</td>' +
                '</tr>';
            }).join('');

            var card = document.createElement('div');
            card.className = 'md-day-card';
            card.innerHTML =
                '<div class="md-day-card-head">' +
                    '<span class="md-day-date"><i class="fa-regular fa-calendar"></i>' + fmtDate(output.createDate) + '</span>' +
                    '<div style="display:flex;align-items:center;gap:8px;">' +
                        (output.styleCode ? '<span style="font-size:11px;color:var(--ink-500);font-weight:600;background:var(--bg-canvas);padding:2px 8px;border-radius:4px;border:1px solid var(--border);">' + esc(output.styleCode) + '</span>' : '') +
                        '<span class="md-day-total"><i class="fa-solid fa-sigma" style="font-size:10px;margin-right:4px;"></i>' + fmt(output.totalOutputNumber) + ' sp</span>' +
                    '</div>' +
                '</div>' +
                (details.length > 0
                    ? '<table class="md-detail-table">' +
                          '<colgroup><col><col><col></colgroup>' +
                          '<thead><tr>' +
                              '<th>Công đoạn</th>' +
                              '<th>Giờ nhập</th>' +
                              '<th>SL (OutputNumber)</th>' +
                          '</tr></thead>' +
                          '<tbody>' + detailRows + '</tbody>' +
                      '</table>'
                    : '<div class="md-no-output" style="padding:16px;">Chưa có chi tiết công đoạn.</div>');

            body.appendChild(card);
        });
    }

    function openDetailModal(item) {
        currentDetailItem = item;

        document.getElementById('mdModalTitle').textContent = item.style || '—';
        document.getElementById('mdModalSub').textContent   = item.spmain || '—';

        // Chips
        var chips = document.getElementById('mdModalChips');
        chips.innerHTML =
            '<span class="md-modal-chip hl"><i class="fa-solid fa-hashtag"></i>' + esc(item.spmain) + '</span>' +
            '<span class="md-modal-chip"><i class="fa-solid fa-users"></i>' + esc(item.line||'—') + '</span>' +
            '<span class="md-modal-chip"><i class="fa-solid fa-palette"></i>' + esc(item.color||'—') + '</span>' +
            '<span class="md-modal-chip"><i class="fa-solid fa-bullseye"></i>Target: ' + fmt(item.target) + '</span>' +
            (item.remark ? '<span class="md-modal-chip"><i class="fa-solid fa-note-sticky"></i>' + esc(item.remark) + '</span>' : '');

        // Reset date filter
        document.getElementById('mdDateFrom').value = '';
        document.getElementById('mdDateTo').value   = '';
        document.getElementById('mdDateCount').textContent = '';

        renderDetailBody(item, null, null);
        detailBackdrop.classList.add('open');
    }

    // Date filter events
    document.getElementById('mdDateApply').addEventListener('click', function () {
        var fromVal = document.getElementById('mdDateFrom').value;
        var toVal   = document.getElementById('mdDateTo').value;
        var from = fromVal ? parseISODate(fromVal) : null;
        var to   = toVal   ? parseISODate(toVal)   : null;
        if (currentDetailItem) renderDetailBody(currentDetailItem, from, to);
    });

    document.getElementById('mdDateReset').addEventListener('click', function () {
        document.getElementById('mdDateFrom').value = '';
        document.getElementById('mdDateTo').value   = '';
        document.getElementById('mdDateCount').textContent = '';
        if (currentDetailItem) renderDetailBody(currentDetailItem, null, null);
    });

    // Close detail modal
    function closeDetailModal() { detailBackdrop.classList.remove('open'); currentDetailItem = null; }
    document.getElementById('mdDetailClose').addEventListener('click', closeDetailModal);
    document.getElementById('mdDetailCloseBtn').addEventListener('click', closeDetailModal);
    detailBackdrop.addEventListener('click', function(e){ if(e.target===this) closeDetailModal(); });

    /* =====================================================
       ADD MODAL: Thêm ProductionInfo
       ===================================================== */
    var addBackdrop = document.getElementById('mdAddBackdrop');

    document.getElementById('mdAddBtn').addEventListener('click', function () {
        // Reset form
        ['fStyle','fSpmain','fLine','fColor','fKeyword','fRemark'].forEach(function(id){
            document.getElementById(id).value = '';
        });
        ['fTotalQty','fTarget'].forEach(function(id){ document.getElementById(id).value = ''; });
        ['fInlineLine','fInlineDept'].forEach(function(id){ document.getElementById(id).value = ''; });
        addBackdrop.classList.add('open');
        setTimeout(function(){ document.getElementById('fStyle').focus(); }, 280);
    });

    function closeAddModal() { addBackdrop.classList.remove('open'); }
    document.getElementById('mdAddClose').addEventListener('click', closeAddModal);
    document.getElementById('mdAddCancelBtn').addEventListener('click', closeAddModal);
    addBackdrop.addEventListener('click', function(e){ if(e.target===this) closeAddModal(); });

    document.getElementById('mdAddSaveBtn').addEventListener('click', function () {
        var style  = document.getElementById('fStyle').value.trim();
        var spmain = document.getElementById('fSpmain').value.trim();
        if (!style || !spmain) {
            if (!style)  { document.getElementById('fStyle').focus();  shake(document.getElementById('fStyle')); }
            else         { document.getElementById('fSpmain').focus(); shake(document.getElementById('fSpmain')); }
            return;
        }

        /*
         * TODO: Thay bằng POST request:
         * fetch('/ProductionDepartment/AddProductionInfo', {
         *   method: 'POST',
         *   headers: { 'Content-Type': 'application/json' },
         *   body: JSON.stringify({ machineId, style, spmain, line, color,
         *     totalQty, target, inlineLine, inlineDepartment, keyword, remark })
         * }).then(r=>r.json()).then(newItem=>{ allData.unshift(newItem); applyFilters(); });
         */
        var newItem = {
            id: 'pi-new-' + Date.now(),
            style:    style,
            spmain:   spmain,
            line:     document.getElementById('fLine').value.trim()     || '',
            color:    document.getElementById('fColor').value.trim()    || '',
            totalQty: parseInt(document.getElementById('fTotalQty').value) || 0,
            finishQty: 0,
            target:   parseInt(document.getElementById('fTarget').value) || 0,
            inlineLine:  document.getElementById('fInlineLine').value || null,
            inlineDept:  document.getElementById('fInlineDept').value || null,
            keyword:  document.getElementById('fKeyword').value.trim() || '',
            remark:   document.getElementById('fRemark').value.trim()  || '',
            status: 1,
            createDate: new Date().toISOString().slice(0,10),
            dailyOutputs: []
        };

        allData.unshift(newItem);

        // Refresh line options
        if (newItem.line && !lines.includes(newItem.line)) {
            lines.push(newItem.line);
            var opt = document.createElement('option');
            opt.value = newItem.line; opt.textContent = newItem.line;
            lineFilter.appendChild(opt);
        }

        applyFilters();
        closeAddModal();
    });

    /* =====================================================
       ESCAPE KEY
       ===================================================== */
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') { closeDetailModal(); closeAddModal(); }
    });

    /* =====================================================
       SHAKE VALIDATION
       ===================================================== */
    var shakeStyle = document.createElement('style');
    shakeStyle.textContent = '@@keyframes mdShake{0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-5px)}40%,80%{transform:translateX(5px)}}.md-shake{animation:mdShake .4s ease;}';
    document.head.appendChild(shakeStyle);

    function shake(el) {
        el.classList.remove('md-shake');
        void el.offsetWidth;
        el.classList.add('md-shake');
        setTimeout(function(){ el.classList.remove('md-shake'); }, 420);
        el.style.borderColor = 'var(--danger)';
        el.style.boxShadow = '0 0 0 3px rgba(210,89,79,.15)';
        setTimeout(function(){ el.style.borderColor=''; el.style.boxShadow=''; }, 1500);
    }

    /* =====================================================
       INIT
       ===================================================== */
    renderSummary(allData);
    renderTable(allData);

})();
</script>
