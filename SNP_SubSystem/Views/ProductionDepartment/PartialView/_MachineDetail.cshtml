        border-color: var(--accent-navy);
        box-shadow: 0 0 0 3px var(--accent-navy-soft);
    }
    .md-modal-date-filter .md-date-sep {
        font-size: 12px;
        color: var(--ink-300);
        font-weight: 600;
    }
    .md-date-count {
        font-size: 12px;
        font-weight: 700;
        color: var(--ink-500);
        margin-left: auto;
    }

    /* No output state */
    .md-no-output {
        padding: 28px;
        text-align: center;
        color: var(--ink-300);
        font-size: 13px;
        font-weight: 600;
    }

    /* Modal footer */
    .md-modal-foot {
        padding: 14px 24px 20px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-shrink: 0;
    }

    /* ---- Add Production Info Modal ---- */
    .md-add-modal-body {
        flex: 1;
        overflow-y: auto;
        padding: 20px 24px;
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .md-add-field { display: flex; flex-direction: column; gap: 6px; }

    .md-add-label {
        font-size: 12.5px;
        font-weight: 700;
        color: var(--ink-700-solid);
    }

    .md-add-label .req { color: var(--danger); margin-left: 2px; }

    .md-add-input,
    .md-add-select,
    .md-add-textarea {
        width: 100%;
        padding: 10px 13px;
        border: 1.5px solid var(--border);
        border-radius: 10px;
        font-family: inherit;
        font-size: 13.5px;
        color: var(--ink-900);
        background: var(--bg-canvas);
        outline: none;
        transition: border-color .2s, box-shadow .2s, background .2s;
        appearance: none;
    }

    .md-add-input:focus,
    .md-add-select:focus,
    .md-add-textarea:focus {
        border-color: var(--accent-navy);
        box-shadow: 0 0 0 3px var(--accent-navy-soft);
        background: #fff;
    }

    .md-add-textarea { min-height: 68px; resize: vertical; line-height: 1.5; }

    .md-add-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    /* ---- Animations ---- */
    @@keyframes fadeIn { from { opacity:0; transform:translateY(6px); } to { opacity:1; transform:translateY(0); } }

    @@media (max-width: 768px) {
        .md-topbar, .md-filter, .md-body { padding-left: 16px; padding-right: 16px; }
        .md-summary-row { grid-template-columns: 1fr 1fr; }
        .md-modal { max-width: 100%; margin: 8px; border-radius: 14px; }
        .md-add-row { grid-template-columns: 1fr; }
    }
</style>

