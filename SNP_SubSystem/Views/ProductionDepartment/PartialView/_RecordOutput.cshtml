    /* Table */
    .xl-table-wrap { flex:1; overflow-y:auto; padding:8px 14px; }
    .xl-table-empty {
        display:flex; align-items:center; gap:8px;
        padding:20px 0; font-size:12.5px; color:var(--ink-400); justify-content:center;
    }
