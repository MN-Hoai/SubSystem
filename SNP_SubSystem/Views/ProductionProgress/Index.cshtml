        <i class="fa-solid fa-lock" style="color:var(--ink-500);width:18px;"></i> Tạm khóa
    </button>
    <button id="ctxUnlock" style="display:none;width:100%;text-align:left;padding:9px 16px;background:none;border:none;cursor:pointer;font-size:13.5px;color:var(--ink-900);font-family:inherit;">
        <i class="fa-solid fa-lock-open" style="color:var(--success);width:18px;"></i> Mở khóa
    </button>
    <button id="ctxRestore" style="display:none;width:100%;text-align:left;padding:9px 16px;background:none;border:none;cursor:pointer;font-size:13.5px;color:var(--primary);font-family:inherit;">
        <i class="fa-solid fa-rotate-left" style="width:18px;"></i> Khôi phục
    </button>
    <div id="ctxDivider" style="height:1px;background:var(--border);margin:4px 0;"></div>
    <button id="ctxDelete" style="display:block;width:100%;text-align:left;padding:9px 16px;background:none;border:none;cursor:pointer;font-size:13.5px;color:var(--danger);font-family:inherit;">
        <i class="fa-solid fa-trash" style="width:18px;"></i> Xóa mã hàng
    </button>
</div>

<!-- Modal xác nhận xóa -->
<div id="modalConfirmDelete" class="modal-backdrop" style="display:none;" role="dialog" aria-modal="true">
    <div class="modal-box" style="max-width:420px;">
        <div class="modal-header">
            <h2 class="modal-title" style="color:var(--danger);"><i class="fa-solid fa-triangle-exclamation"></i> Xác nhận xóa</h2>
            <button class="modal-close" id="btnCloseDel">&times;</button>
        </div>
        <div class="modal-body">
            <p style="font-size:14px;color:var(--ink-700-solid);">Bạn có chắc muốn xóa mã hàng này không? Hành động này sẽ đổi trạng thái thành "Đã xóa" và không hiển thị trong danh sách.</p>
            <div id="delInfoBox" style="background:var(--surface-alt,#f4f6fb);border:1px solid var(--border);border-radius:6px;padding:10px 14px;margin-top:12px;font-size:13px;"></div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="btnCancelDel">Hủy</button>
            <button class="btn" style="background:var(--danger);color:#fff;" id="btnConfirmDel"><i class="fa-solid fa-trash"></i> Xóa</button>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';
    // ── Toast system (dùng toastr thống nhất) ──────────────────────────
    function toast(type, msg) {
        const fn = { success: toastr.success, error: toastr.error, warn: toastr.warning, info: toastr.info };
        (fn[type] || toastr.info).call(toastr, msg);
    }

    // =================================================================
    // MULTI-SELECT: Drag, Shift+Click, Ctrl+Click
    // =================================================================
    const progressTbody = document.getElementById('progressTableBody');
    let ms_isDragging      = false;
    let ms_lastIdx         = -1;

    function ms_getRows()  { return Array.from(progressTbody.querySelectorAll('tr[data-id]')); }
    function ms_setRow(tr, on) { on ? tr.classList.add('ms-selected') : tr.classList.remove('ms-selected'); }
    function ms_clearAll() { ms_getRows().forEach(r => r.classList.remove('ms-selected', 'ctx-active')); }
    function ms_getSelected() { return ms_getRows().filter(r => r.classList.contains('ms-selected')); }

    function ms_selectRange(a, b) {
        const rows = ms_getRows();
        const lo = Math.min(a, b), hi = Math.max(a, b);
        for (let i = lo; i <= hi; i++) if (rows[i]) ms_setRow(rows[i], true);
    }

    progressTbody.addEventListener('mousedown', e => {
        if (e.button !== 0) return;
        const tr = e.target.closest('tr[data-id]');
        if (!tr) { ms_clearAll(); ms_lastIdx = -1; ms_updateSummary(); return; }
        const rows = ms_getRows();
        const idx  = rows.indexOf(tr);
        if (e.shiftKey && ms_lastIdx > -1) {
            e.preventDefault();    // Ngăn bôi đen text
            ms_clearAll();
            ms_selectRange(ms_lastIdx, idx);
        } else if (e.ctrlKey) {
            tr.classList.toggle('ms-selected');
            ms_lastIdx = idx;
        } else {
            ms_clearAll();
            ms_setRow(tr, true);
            ms_lastIdx  = idx;
            ms_isDragging = true;
        }
        ms_updateSummary();
    });

    // Drag-select: bắt sự kiện qua mouseenter trên các thẻ con
    progressTbody.addEventListener('mouseover', e => {
        if (!ms_isDragging) return;
        const tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        const idx = ms_getRows().indexOf(tr);
        if (ms_lastIdx > -1) { ms_clearAll(); ms_selectRange(ms_lastIdx, idx); }
        ms_updateSummary();
    });

    document.addEventListener('mouseup', () => { ms_isDragging = false; ms_updateSummary(); });
    progressTbody.addEventListener('selectstart', e => { if (ms_isDragging || e.shiftKey) e.preventDefault(); });

    // ── Summary bar khi chọn nhiều dòng ───────────────────────────────
    function fmtN(n) { return Number(n||0).toLocaleString('vi-VN'); }

    function ms_updateSummary() {
        // Lấy element ở đây (sau khi DOM đã ready) thay vì lúc khai báo script
        const bar  = document.getElementById('msSummaryBar');
        const txt  = document.getElementById('msSummaryText');
        if (!bar || !txt) return;

        const selected = ms_getSelected();
        if (selected.length < 2) {
            bar.style.display = 'none';
            return;
        }
        let sumTotalOutput = 0, sumTotalQty = 0, sumTodayOutput = 0, sumTarget = 0;
        selected.forEach(function(r) {
            sumTotalOutput += parseInt(r.dataset.totalOutput || 0);
            sumTotalQty    += parseInt(r.dataset.totalQty    || 0);
            sumTodayOutput += parseInt(r.dataset.todayOutput || 0);
            sumTarget      += parseInt(r.dataset.target      || 0);
        });
        const totalPct = sumTotalQty > 0 ? Math.round(sumTotalOutput / sumTotalQty * 100) : 0;
        const todayPct = sumTarget   > 0 ? Math.round(sumTodayOutput / sumTarget   * 100) : 0;
        const cTotal   = totalPct >= 80 ? '#34d399' : totalPct >= 50 ? '#fbbf24' : '#f87171';
        const cToday   = todayPct >= 80 ? '#34d399' : todayPct >= 50 ? '#fbbf24' : '#f87171';

        txt.innerHTML =
            `<span style="color:#94a3b8;margin-right:8px;"><i class="fa-solid fa-check-double"></i> ${selected.length} dòng đã chọn</span>` +
            `<span style="display:inline-block;width:1px;height:14px;background:rgba(255,255,255,.2);margin:0 12px;vertical-align:middle;"></span>` +
            `<span style="opacity:.65;font-size:11px;margin-right:5px;">Tổng SL</span>` +
            `<strong>${fmtN(sumTotalOutput)}</strong>` +
            `<span style="opacity:.4;margin:0 3px;">/</span>` +
            `<strong>${fmtN(sumTotalQty)}</strong>` +
            `<span style="color:${cTotal};margin-left:7px;font-weight:800;">${totalPct}%</span>` +
            `<span style="display:inline-block;width:1px;height:14px;background:rgba(255,255,255,.2);margin:0 14px;vertical-align:middle;"></span>` +
            `<span style="opacity:.65;font-size:11px;margin-right:5px;">Ngày</span>` +
            `<strong>${fmtN(sumTodayOutput)}</strong>` +
            `<span style="opacity:.4;margin:0 3px;">/</span>` +
            `<strong>${fmtN(sumTarget)}</strong>` +
            `<span style="color:${cToday};margin-left:7px;font-weight:800;">${todayPct}%</span>`;
        bar.style.display = 'flex';
    }

    // =================================================================
    // CONTEXT MENU (hỗ trợ cả single và multi-select)
    // =================================================================
    const ctxMenu     = document.getElementById('ctxMenu');
    const ctxSelInfo  = document.getElementById('ctxSelInfo');
    const ctxSelCount = document.getElementById('ctxSelCount');
    const ctxEdit     = document.getElementById('ctxEdit');
    const ctxComplete = document.getElementById('ctxComplete');
    const ctxProducing= document.getElementById('ctxProducing');
    const ctxWaiting  = document.getElementById('ctxWaiting');
    const ctxLocked   = document.getElementById('ctxLocked');
    const ctxUnlock   = document.getElementById('ctxUnlock');
    const ctxRestore  = document.getElementById('ctxRestore');
    const ctxDivider  = document.getElementById('ctxDivider');
    const ctxDelete   = document.getElementById('ctxDelete');
    const delModal    = document.getElementById('modalConfirmDelete');
    const delInfoBox  = document.getElementById('delInfoBox');
    const btnConfDel  = document.getElementById('btnConfirmDel');

    let ctx_targetIds  = [];
    let ctx_targetRows = [];

    progressTbody.addEventListener('contextmenu', e => {
        const tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        e.preventDefault();

        // Nếu chuột phải vào dòng chưa được bôi đen -> chọn mình nó
        if (!tr.classList.contains('ms-selected')) {
            ms_clearAll();
            ms_setRow(tr, true);
        }

        ctx_targetRows = ms_getSelected();
        ctx_targetIds  = ctx_targetRows.map(r => r.dataset.id);

        // Lấy danh sách status của các dòng được chọn
        const selectedStatuses = ctx_targetRows.map(r => parseInt(r.dataset.status));
        const allDeleted = selectedStatuses.every(s => s === -2);
        const allLocked  = selectedStatuses.every(s => s === -1);
        const hasDeleted = selectedStatuses.some(s => s === -2);
        const hasLocked  = selectedStatuses.some(s => s === -1);
        const allNormal  = selectedStatuses.every(s => s >= 0);

        const multi = ctx_targetIds.length > 1;
        ctxSelInfo.style.display  = multi ? 'block' : 'none';
        if (multi) ctxSelCount.textContent = ctx_targetIds.length;

        // Ẩn/hiện option tùy trạng thái
        // Nếu tất cả đã xóa: chỉ hiển Khôi phục
        // Nếu tất cả tạm khóa: hiển Mở khóa + Xóa
        // Bình thường: hiển đầy đủ (trừ Mở khóa/Khôi phục)
        ctxEdit.style.display      = (!multi && !allDeleted && !allLocked) ? 'block' : 'none';
        ctxComplete.style.display   = allNormal ? 'block' : 'none';
        ctxProducing.style.display  = allNormal ? 'block' : 'none';
        ctxWaiting.style.display    = allNormal ? 'block' : 'none';
        ctxLocked.style.display     = allNormal ? 'block' : 'none';
        ctxUnlock.style.display     = allLocked ? 'block' : 'none';
        ctxRestore.style.display    = allDeleted ? 'block' : 'none';
        ctxDivider.style.display    = allDeleted ? 'none' : 'block';
        ctxDelete.style.display     = (allDeleted) ? 'none' : 'block';

        const { clientX: x, clientY: y } = e;
        const mW = 220, mH = 280;
        ctxMenu.style.left = (x + mW > window.innerWidth  ? x - mW : x) + 'px';
        ctxMenu.style.top  = (y + mH > window.innerHeight ? y - mH : y) + 'px';
        ctxMenu.style.display = 'block';
        ctx_targetRows.forEach(r => r.classList.add('ctx-active'));
    });

    document.addEventListener('click', e => { if (!e.target.closest('#ctxMenu')) hideCtx(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') hideCtx(); });
    function hideCtx() {
        ctxMenu.style.display = 'none';
        ctx_targetRows.forEach(r => r.classList.remove('ctx-active'));
    }

    // -- Cập nhật (1 dòng) --
    ctxEdit.addEventListener('click', () => {
        hideCtx();
        if (ctx_targetIds.length !== 1) return;
        window.location.href = `/ProductionProgress/ProductionInfoForm?id=${ctx_targetIds[0]}`;
    });

    // -- Hàm gọi bulk API --
    async function doBulkStatus(targetStatus, successMsg) {
        if (!ctx_targetIds.length) return;
        try {
            const res = await fetch('/ProductionProgress/BulkUpdateStatus', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ctx_targetIds, targetStatus })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                toast('success', successMsg);
                ms_clearAll();
                document.getElementById('btnRefreshData').click();
            }
        } catch (err) { }
    }

    ctxComplete.addEventListener('click',  () => { hideCtx(); doBulkStatus(2, 'Đã đánh dấu Hoàn thành.'); });
    ctxProducing.addEventListener('click', () => { hideCtx(); doBulkStatus(1, 'Đã cập nhật Đang SX.'); });
    ctxWaiting.addEventListener('click',   () => { hideCtx(); doBulkStatus(0, 'Đã đánh dấu Chờ SX.'); });
    ctxLocked.addEventListener('click',    () => { hideCtx(); doBulkStatus(-1, 'Đã tạm khóa mã hàng.'); });
    ctxUnlock.addEventListener('click',    () => { hideCtx(); doBulkStatus(0, 'Đã mở khóa mã hàng.'); });
    ctxRestore.addEventListener('click',   () => { hideCtx(); doBulkStatus(0, 'Đã khôi phục mã hàng.'); });

    // -- Xóa --
    ctxDelete.addEventListener('click', () => {
        hideCtx();
        if (!ctx_targetIds.length) return;
        delInfoBox.innerHTML = ctx_targetIds.length === 1
            ? '<strong>Line:</strong> ' + (ctx_targetRows[0].dataset.line  || '--') + ' &nbsp;|&nbsp; '
            + '<strong>Style:</strong> ' + (ctx_targetRows[0].dataset.style || '--') + ' &nbsp;|&nbsp; '
            + '<strong>SP:</strong> '    + (ctx_targetRows[0].dataset.sp    || '--')
            : '<strong>Xóa hàng loạt ' + ctx_targetIds.length + ' mã hàng đã chọn.</strong>';
        delModal.style.display = 'flex';
    });

    document.getElementById('btnCloseDel').addEventListener('click',  () => { delModal.style.display = 'none'; });
    document.getElementById('btnCancelDel').addEventListener('click', () => { delModal.style.display = 'none'; });
    delModal.addEventListener('click', e => { if (e.target === delModal) delModal.style.display = 'none'; });

    btnConfDel.addEventListener('click', async () => {
        if (!ctx_targetIds.length) return;
        btnConfDel.disabled = true;
        btnConfDel.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang xóa...';
        try {
            const res  = await fetch('/ProductionProgress/BulkUpdateStatus', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ ids: ctx_targetIds, targetStatus: -2 })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                toast('warn', 'Đã xóa ' + ctx_targetIds.length + ' mã hàng thành công.');
                delModal.style.display = 'none';
                ms_clearAll();
                document.getElementById('btnRefreshData').click();
            } else {
                toast('error', 'Lỗi: ' + (data.message || 'Không xóa được.'));
            }
        } catch (err) {
            toast('error', 'Lỗi kết nối: ' + err.message);
        } finally {
            btnConfDel.disabled = false;
            btnConfDel.innerHTML = '<i class="fa-solid fa-trash"></i> Xóa';
        }
    });

})();
</script>

