@{
    ViewData["Title"] = "Tiến độ sản xuất";
}

@* Lấy ngày đầu tháng và hôm nay dạng yyyy-MM-dd để gán value mặc định cho date input *@
@{
    var today     = DateTime.Today.ToString("yyyy-MM-dd");
    var firstDay  = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).ToString("yyyy-MM-dd");
}

<div class="content-area">

    <!-- Tiêu đề trang + breadcrumb + nút hành động -->
    <div class="page-head">
        <div>
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a>
                <span class="sep">/</span>
                <span class="current">Tiến độ sản xuất</span>
            </div>
            <h1 class="page-title">Tiến độ sản xuất</h1>
        </div>
        <div class="page-actions">
         
            <a asp-controller="ProductionProgress" asp-action="ProductionInfoHistory" class="btn btn-ghost">
                <i class="fa-solid fa-clock-rotate-left"></i>Lịch sử mã hàng
            </a>
            <a asp-controller="ProductionProgress" asp-action="ProductionInfoForm" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i>Thêm mã hàng
            </a>
    
           
        </div>
    </div>

    <!-- FILTER / SEARCH BAR -->
    <div class="filter-bar">

        <!-- Tìm kiếm tự do -->
        <div class="filter-group filter-search">
            <label class="filter-label">Tìm kiếm</label>
            <div class="search-wrap">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="searchInput" placeholder="Tìm theo Style, SP#, Line...">
            </div>
        </div>

        <!-- Bộ phận — đổ động từ API -->
        <div class="filter-group">
            <label class="filter-label">Bộ phận</label>
            <select id="deptSelect">
                <option value="">Tất cả bộ phận</option>
            </select>
        </div>

        <!-- Line — đổ động từ API, liên kết với Bộ phận -->
        <div class="filter-group">
            <label class="filter-label">Line</label>
            <select id="lineSelect">
                <option value="">Tất cả Line</option>
            </select>
        </div>

        <!-- Trạng thái (Status ProductionInfo: 1=Đang, 0=Ngừng) -->
        <div class="filter-group">
            <label class="filter-label">Trạng thái</label>
            <select id="statusSelect">
                <option value="">Tất cả (trừ xóa)</option>
                <option value="1" selected>Đang hoạt động</option>
                <option value="0">Chờ sản xuất</option>
                <option value="2">Hoàn thành</option>
            </select>
        </div>

        <!-- Khoảng ngày -->
        <div class="filter-group">
            <label class="filter-label">Ngày</label>
            <div class="date-range">
                <input type="date" id="fromDate" value="@firstDay">
                <span class="date-sep">—</span>
                <input type="date" id="toDate" value="@today">
            </div>
        </div>

        <!-- Hành động -->
        <div class="filter-actions">
            <button class="btn btn-primary" id="btnFilterSearch"><i class="fa-solid fa-magnifying-glass"></i>Tìm kiếm</button>
            <button class="btn btn-ghost" id="btnFilterReset"><i class="fa-solid fa-arrow-rotate-left"></i>Đặt lại</button>
        </div>
    </div>

    <!-- DATA TABLE -->
    <div class="panel">
        <div class="panel-head">
            <div>
                <div class="panel-title" id="panelTableTitle">Danh sách chuyền sản xuất</div>
                <div class="panel-sub" id="panelTableSub">Đang tải dữ liệu...</div>
            </div>
            <button class="btn btn-ghost" id="btnRefreshData"><i class="fa-solid fa-rotate-right"></i>Làm mới</button>
        </div>

        <!-- Loading overlay -->
        <div id="tableLoading" style="display:none; padding:40px; text-align:center; color:var(--ink-500);">
            <i class="fa-solid fa-circle-notch fa-spin" style="font-size:24px; margin-bottom:8px;"></i>
            <div>Đang tải dữ liệu...</div>
        </div>

        <!-- Empty state -->
        <div id="tableEmpty" style="display:none; padding:48px; text-align:center; color:var(--ink-400);">
            <i class="fa-solid fa-inbox" style="font-size:36px; margin-bottom:12px; display:block;"></i>
            <div style="font-weight:600;">Không có dữ liệu phù hợp</div>
            <div style="font-size:13px; margin-top:4px;">Thử thay đổi điều kiện lọc và tìm kiếm lại</div>
        </div>

        <div class="table-wrap" id="tableWrap">
            <table id="progressTable">
                <thead>
                    <tr>
                        <th>Line</th>
                        <th>Style</th>
                        <th>SP#</th>
                        <th>Color</th>
                        <th>Total Output</th>
                        <th>Today Output</th>
                        <th>Inline Line</th>
                        <th>Department Line</th>
                        <th>Expected Date </th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody id="progressTableBody">
                    <!-- Render động từ JS -->
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        <div class="pagination" id="paginationSection">
            <div class="pagination-info" id="paginationInfo">
                Hiển thị <strong id="showingCount">0</strong> trong <strong id="totalCount">0</strong> kết quả
            </div>
            <div class="pagination-controls" id="paginationControls">
                <!-- Render động từ JS -->
            </div>
        </div>
    </div>

</div>

<!-- =================================================================
     MODAL: Nhập mã hàng từ Excel
     ================================================================= -->
<div id="modalImportInfo" class="modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="modalImportInfoTitle">
    <div class="modal-box" style="max-width:560px;">

        <!-- Header -->
        <div class="modal-header">
            <h2 class="modal-title" id="modalImportInfoTitle">
                <i class="fa-solid fa-file-import" style="color:var(--primary);"></i>
                Nhập thông tin mã hàng từ Excel
            </h2>
            <button class="modal-close" id="btnCloseImportInfo" aria-label="Đóng">&times;</button>
        </div>

        <!-- Body -->
        <div class="modal-body">



            <!-- Chọn bộ phận -->
            <div class="filter-group" style="margin-bottom:14px;">
                <label class="form-label" for="importInfoDeptSelect">Bộ phận <span style="color:var(--danger);">*</span></label>
                <select id="importInfoDeptSelect" class="form-control" style="width:100%;">
                    <option value="">-- Chọn bộ phận --</option>
                </select>
            </div>

            <!-- Chọn file -->
            <div class="form-group" style="margin-bottom:14px;">
                <label class="form-label" for="importInfoFileInput">File Excel (.xlsx / .xls) <span style="color:var(--danger);">*</span></label>
                <div class="file-drop-zone" id="importInfoDropZone"
                     style="border:2px dashed var(--border,#d1d5e0); border-radius:8px; padding:24px; text-align:center; cursor:pointer; transition:border-color .2s;">
                    <i class="fa-solid fa-cloud-arrow-up" style="font-size:28px; color:var(--ink-400);"></i>
                    <div style="margin:8px 0 4px; font-weight:600; color:var(--ink-600);">Kéo thả file vào đây</div>
                    <div style="font-size:12px; color:var(--ink-400);">hoặc click để chọn file Excel</div>
                    <input type="file" id="importInfoFileInput" accept=".xlsx,.xls" style="display:none;">
                </div>
                <div id="importInfoFileName" style="margin-top:6px; font-size:13px; color:var(--ink-500);"></div>
            </div>

            <!-- Tải mẫu -->
            <div style="text-align:right; margin-bottom:4px;">
                <a href="/ImportExport/DownloadProductionInfoTemplate" class="btn btn-ghost" style="font-size:12px; padding:4px 10px;">
                    <i class="fa-solid fa-download"></i> Tải file mẫu
                </a>
            </div>

            <!-- Kết quả import -->
            <div id="importInfoResult" style="display:none; margin-top:16px;"></div>

        </div>

        <!-- Footer -->
        <div class="modal-footer">
            <button class="btn btn-ghost" id="btnCancelImportInfo">Hủy</button>
            <button class="btn btn-primary" id="btnDoImportInfo" disabled>
                <i class="fa-solid fa-upload"></i> Bắt đầu nhập
            </button>
        </div>
    </div>
</div>

<!-- ===================================================================
     SCRIPT: Modal Import Mã Hàng
     =================================================================== -->
<script>
(function () {
    'use strict';

    // ── DOM refs ──────────────────────────────────────────────────────
    const modal         = document.getElementById('modalImportInfo');
    const btnOpen       = document.getElementById('btnOpenImportInfo');
    const btnClose      = document.getElementById('btnCloseImportInfo');
    const btnCancel     = document.getElementById('btnCancelImportInfo');
    const btnDo         = document.getElementById('btnDoImportInfo');
    const deptSel       = document.getElementById('importInfoDeptSelect');
    const fileInput     = document.getElementById('importInfoFileInput');
    const dropZone      = document.getElementById('importInfoDropZone');
    const fileNameEl    = document.getElementById('importInfoFileName');
    const resultEl      = document.getElementById('importInfoResult');

    let selectedFile = null;

    // ── Open / Close ──────────────────────────────────────────────────
    function openModal() {
        modal.classList.add('open');
        resetModal();
        loadDepts();
    }

    function closeModal() {
        modal.classList.remove('open');
    }

    btnOpen.addEventListener('click', openModal);
    btnClose.addEventListener('click', closeModal);
    btnCancel.addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });

    // ── Load bộ phận ──────────────────────────────────────────────────
    async function loadDepts() {
        if (deptSel.options.length > 1) return; // đã load rồi
        try {
            const res  = await fetch('/ProductionProgress/GetDepartments');
            if (!res.ok) return;
            const list = await res.json();
            list.forEach(d => {
                const opt       = document.createElement('option');
                opt.value       = d.id;
                opt.textContent = d.departmentName;
                deptSel.appendChild(opt);
            });
        } catch (e) {
            console.error('[ImportInfo] Lỗi load dept:', e);
        }
    }

    // ── Validate → enable/disable nút Import ─────────────────────────
    function validate() {
        btnDo.disabled = !(deptSel.value && selectedFile);
    }
    deptSel.addEventListener('change', validate);

    // ── File pick ─────────────────────────────────────────────────────
    dropZone.addEventListener('click', () => fileInput.click());

    dropZone.addEventListener('dragover', e => {
        e.preventDefault();
        dropZone.style.borderColor = 'var(--primary)';
    });
    dropZone.addEventListener('dragleave', () => {
        dropZone.style.borderColor = 'var(--border,#d1d5e0)';
    });
    dropZone.addEventListener('drop', e => {
        e.preventDefault();
        dropZone.style.borderColor = 'var(--border,#d1d5e0)';
        const f = e.dataTransfer.files[0];
        if (f) setFile(f);
    });

    fileInput.addEventListener('change', () => {
        if (fileInput.files[0]) setFile(fileInput.files[0]);
    });

    function setFile(f) {
        const ext = f.name.split('.').pop().toLowerCase();
        if (ext !== 'xlsx' && ext !== 'xls') {
            showResult(false, 'Chỉ hỗ trợ file .xlsx hoặc .xls.');
            return;
        }
        selectedFile = f;
        fileNameEl.innerHTML = `<i class="fa-solid fa-file-excel" style="color:#1d6f42;"></i> <strong>${escHtml(f.name)}</strong> (${(f.size / 1024).toFixed(1)} KB)`;
        resultEl.style.display = 'none';
        validate();
    }

    // ── Reset ─────────────────────────────────────────────────────────
    function resetModal() {
        selectedFile   = null;
        fileInput.value = '';
        fileNameEl.innerHTML = '';
        resultEl.style.display = 'none';
        deptSel.value  = '';
        btnDo.disabled = true;
        btnDo.innerHTML = '<i class="fa-solid fa-upload"></i> Bắt đầu nhập';
        btnDo.disabled = true;
    }

    // ── Import ────────────────────────────────────────────────────────
    btnDo.addEventListener('click', async () => {
        if (!selectedFile || !deptSel.value) return;

        btnDo.disabled = true;
        btnDo.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang xử lý...';
        resultEl.style.display = 'none';

        const formData = new FormData();
        formData.append('file', selectedFile);
        formData.append('departmentId', deptSel.value);

        try {
            const res = await fetch('/ImportExport/ImportProductionInfoExcel', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();

            if (!res.ok) {
                showResult(false, data.message || 'Lỗi không xác định.');
            } else {
                showImportResult(data);
            }
        } catch (e) {
            showResult(false, 'Lỗi kết nối: ' + e.message);
        } finally {
            btnDo.innerHTML = '<i class="fa-solid fa-upload"></i> Bắt đầu nhập';
            btnDo.disabled = !(deptSel.value && selectedFile);
        }
    });

    // ── Render kết quả ────────────────────────────────────────────────
    function showImportResult(data) {
        const isOk = data.success;
        const color = isOk ? 'var(--success,#18c16e)' : 'var(--danger,#e53935)';
        const icon  = isOk ? 'fa-circle-check' : 'fa-circle-xmark';

        let errHtml = '';
        if (data.errors && data.errors.length > 0) {
            const items = data.errors.map(e => `<li style="margin-bottom:2px;">${escHtml(e)}</li>`).join('');
            errHtml = `
                <details style="margin-top:10px;">
                    <summary style="cursor:pointer; font-size:12px; color:var(--danger);">Xem ${data.errors.length} lỗi chi tiết</summary>
                    <ul style="font-size:12px; margin:6px 0 0 16px; padding:0; color:var(--danger);">${items}</ul>
                </details>`;
        }

        resultEl.style.display = 'block';
        resultEl.innerHTML = `
            <div style="border:1px solid ${color}; border-radius:8px; padding:14px 16px; background:${isOk ? 'rgba(24,193,110,.07)' : 'rgba(229,57,53,.07)'}">
                <div style="display:flex; align-items:center; gap:8px; font-weight:700; color:${color}; margin-bottom:8px;">
                    <i class="fa-solid ${icon}"></i>
                    <span>${escHtml(data.message)}</span>
                </div>
                <div style="display:flex; gap:18px; font-size:13px; flex-wrap:wrap;">
                    <span>📋 Tổng: <strong>${data.totalRows}</strong></span>
                    <span style="color:var(--success);">✅ Tạo mới: <strong>${data.importedRows}</strong></span>
                    <span style="color:var(--primary);">🔄 Cập nhật: <strong>${data.updatedRows}</strong></span>
                    <span style="color:var(--danger);">⛔ Bỏ qua: <strong>${data.skippedRows}</strong></span>
                </div>
                ${errHtml}
            </div>`;
    }

    function showResult(ok, msg) {
        const color = ok ? 'var(--success)' : 'var(--danger)';
        resultEl.style.display = 'block';
        resultEl.innerHTML = `<div style="padding:10px 14px; border-radius:6px; border:1px solid ${color}; color:${color}; font-size:13px; font-weight:600;">${escHtml(msg)}</div>`;
    }

    function escHtml(s) {
        return String(s ?? '')
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

})();
</script>

<!-- ===================================================================
     SCRIPT TỔNG HỢP: Load filter + Fetch danh sách + Render bảng + Phân trang
     =================================================================== -->
<script>
(function () {
    'use strict';

    // ---------------------------------------------------------------
    // DOM References
    // ---------------------------------------------------------------
    const searchInput     = document.getElementById('searchInput');
    const deptSelect      = document.getElementById('deptSelect');
    const lineSelect      = document.getElementById('lineSelect');
    const statusSelect    = document.getElementById('statusSelect');
    const fromDateInput   = document.getElementById('fromDate');
    const toDateInput     = document.getElementById('toDate');
    const btnSearch       = document.getElementById('btnFilterSearch');
    const btnReset        = document.getElementById('btnFilterReset');
    const btnRefresh      = document.getElementById('btnRefreshData');
    const tbody           = document.getElementById('progressTableBody');
    const tableWrap       = document.getElementById('tableWrap');
    const tableLoading    = document.getElementById('tableLoading');
    const tableEmpty      = document.getElementById('tableEmpty');
    const panelTitle      = document.getElementById('panelTableTitle');
    const panelSub        = document.getElementById('panelTableSub');
    const showingCount    = document.getElementById('showingCount');
    const totalCountEl    = document.getElementById('totalCount');
    const paginationCtrl  = document.getElementById('paginationControls');

    // ---------------------------------------------------------------
    // State phân trang
    // ---------------------------------------------------------------
    let currentPage = 1;
    const PAGE_SIZE = 20;

    // ---------------------------------------------------------------
    // 1. Load danh sách Bộ phận
    // ---------------------------------------------------------------
    async function loadDepartments() {
        try {
            const res  = await fetch('/ProductionProgress/GetDepartments');
            if (!res.ok) return;
            const list = await res.json();
            list.forEach(dept => {
                const opt       = document.createElement('option');
                opt.value       = dept.id;
                opt.textContent = dept.departmentName;
                deptSelect.appendChild(opt);
            });
        } catch (e) {
            console.error('[PP] Lỗi load Bộ phận:', e);
        }
    }

    // ---------------------------------------------------------------
    // 2. Load danh sách Line (theo Bộ phận nếu chọn)
    // ---------------------------------------------------------------
    async function loadLines(departmentId) {
        while (lineSelect.options.length > 1) lineSelect.remove(1);
        try {
            const url  = departmentId
                ? `/ProductionProgress/GetLines?departmentId=${departmentId}`
                : '/ProductionProgress/GetLines';
            const res  = await fetch(url);
            if (!res.ok) return;
            const list = await res.json();
            list.forEach(line => {
                const opt       = document.createElement('option');
                opt.value       = line;
                opt.textContent = `Line ${line}`;
                lineSelect.appendChild(opt);
            });
        } catch (e) {
            console.error('[PP] Lỗi load Line:', e);
        }
    }

    // ---------------------------------------------------------------
    // 3. Fetch danh sách tiến độ từ POST /ProductionProgress/GetList
    // ---------------------------------------------------------------
    async function fetchList(page) {
        // Hiện loading mượt mà: làm mờ bảng thay vì ẩn đi, thêm spinner vào nút Làm mới
        tableWrap.style.opacity = '0.5';
        tableWrap.style.pointerEvents = 'none';
        btnRefresh.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang tải...';
        btnRefresh.disabled = true;
        tableEmpty.style.display   = 'none';

        const deptId = deptSelect.value || null;
        const line   = lineSelect.value || null;
        const status = statusSelect.value !== '' ? parseInt(statusSelect.value) : null;

        const requestBody = {
            fromDate:               fromDateInput.value,
            toDate:                 toDateInput.value,
            keyword:                searchInput.value.trim() || null,
            line:                   line,
            productionDepartmentId: deptId,
            status:                 status,
            page:                   page,
            pageSize:               PAGE_SIZE
        };

        try {
            const res = await fetch('/ProductionProgress/GetList', {
                method:  'POST',
                headers: { 'Content-Type': 'application/json' },
                body:    JSON.stringify(requestBody)
            });

            if (!res.ok) {
                const err = await res.json().catch(() => ({}));
                alert('Lỗi truy vấn: ' + (err.message || res.statusText));
                resetLoadingState();
                return;
            }

            const data = await res.json();
            // data: { items, totalCount, page, pageSize, totalPages, hasPreviousPage, hasNextPage }

            resetLoadingState();

            if (!data.items || data.items.length === 0) {
                tableEmpty.style.display = 'block';
                tableWrap.style.display  = 'none';
                renderPagination(0, 1, 1);
                showingCount.textContent = 0;
                totalCountEl.textContent = data.totalCount ?? 0;
                updatePanelHeader(deptSelect, data.totalCount ?? 0);
                return;
            }

            tableWrap.style.display = 'block';
            renderRows(data.items);
            renderPagination(data.totalCount, data.page, data.totalPages);

            // Cập nhật thống kê hiển thị
            const from = (data.page - 1) * data.pageSize + 1;
            const to   = Math.min(data.page * data.pageSize, data.totalCount);
            showingCount.textContent = `${from}–${to}`;
            totalCountEl.textContent = data.totalCount;

            updatePanelHeader(deptSelect, data.totalCount);
            updatePanelSub();

        } catch (e) {
            console.error('[PP] Lỗi fetchList:', e);
            resetLoadingState();
        }
    }

    function resetLoadingState() {
        tableWrap.style.opacity = '1';
        tableWrap.style.pointerEvents = 'auto';
        tableWrap.style.display = 'block';
        btnRefresh.innerHTML = '<i class="fa-solid fa-rotate-right"></i> Làm mới';
        btnRefresh.disabled = false;
    }

    // ---------------------------------------------------------------
    // 4. Render các dòng tbody
    // ---------------------------------------------------------------
    function renderRows(items) {
        tbody.innerHTML = '';
        items.forEach(p => {
            // Tính % cho Today Output so với Target
            const todayPct = p.target && p.target > 0
                ? Math.round((p.todayOutput / p.target) * 100)
                : 0;
            const safeTodayPct = Math.min(todayPct, 100);
            const todayBarColor = todayPct >= 80 ? 'var(--success)' : todayPct >= 50 ? 'var(--accent-gold)' : 'var(--danger)';

            // Tính % cho Total Output so với TotalQty
            const totalPct = p.totalQty && p.totalQty > 0
                ? Math.round((p.totalOutput / p.totalQty) * 100)
                : 0;
            const safeTotalPct = Math.min(totalPct, 100);
            const totalBarColor = totalPct >= 80 ? 'var(--success)' : totalPct >= 50 ? 'var(--accent-gold)' : 'var(--danger)';

            const inlineDate = p.inlineLine
                ? new Date(p.inlineLine).toLocaleDateString('vi-VN')
                : '—';
            const inlineDepartment = p.inlineDepartment
                ? new Date(p.inlineDepartment).toLocaleDateString('vi-VN')
                : '—';

            // Tính ngày dự kiến hoàn thành:
            //   - Số ngày cần = ceil((TotalQty - TotalOutput) / Target)
            //   - Nếu ngày Department Line (inlineDepartment) > hôm nay
            //       → lấy ngày Department Line làm gốc + số ngày cần
            //   - Nếu ngày Department Line <= hôm nay (hoặc đã qua)
            //       → lấy ngày hôm nay làm gốc + số ngày cần
            let expectedDate = '—';
            if (p.totalQty && p.totalQty > 0 && p.target && p.target > 0) {
                const remainingQty  = Math.max(0, p.totalQty - (p.totalOutput || 0));
                const daysNeeded    = Math.ceil(remainingQty / p.target);

                const today = new Date();
                today.setHours(0, 0, 0, 0);

                let baseDate;
                if (p.inlineDepartment) {
                    const deptDate = new Date(p.inlineDepartment);
                    deptDate.setHours(0, 0, 0, 0);
                    // Nếu Department Line còn trong tương lai → dùng ngày đó làm gốc
                    baseDate = deptDate > today ? deptDate : today;
                } else {
                    baseDate = today;
                }

                const expDate = new Date(baseDate);
                expDate.setDate(expDate.getDate() + daysNeeded);
                expectedDate = expDate.toLocaleDateString('vi-VN');
            }

            const statusBadge = p.status === 1
                ? '<span class="badge-status success">Đang HĐ</span>'
                : p.status === 0
                ? '<span class="badge-status warning">Chờ SX</span>'
                : '<span class="badge-status">Hoàn thành</span>';

            tbody.insertAdjacentHTML('beforeend', `
                <tr data-id="${p.id}" data-line="${escHtml(p.line??'')}"
                    data-style="${escHtml(p.style??'')}" data-sp="${escHtml(p.spmain??'')}">
                    <td class="cell-strong">${escHtml(p.line ?? '—')}</td>
                    <td>${escHtml(p.style ?? '—')}</td>
                    <td class="cell-mono">${escHtml(p.spmain ?? '—')}</td>
                    <td>${p.color}</td>
                    
                    <!-- Cột Total Output -->
                    <td>
                        <div class="output-cell" style="min-width: 120px;">
                            <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                                <span>${fmtNum(p.totalOutput)} / ${fmtNum(p.totalQty)}</span>
                                <strong style="color: ${totalBarColor};">${totalPct}%</strong>
                            </div>
                            <div class="progress">
                                <div class="progress-bar" style="width:${safeTotalPct}%; background:${totalBarColor};"></div>
                            </div>
                        </div>
                    </td>
                    
                    <!-- Cột Today Output -->
                    <td>
                        <div class="output-cell" style="min-width: 120px;">
                            <div style="display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px;">
                                <span>${fmtNum(p.todayOutput)} / ${fmtNum(p.target)}</span>
                                <strong style="color: ${todayBarColor};">${todayPct}%</strong>
                            </div>
                            <div class="progress">
                                <div class="progress-bar" style="width:${safeTodayPct}%; background:${todayBarColor};"></div>
                            </div>
                        </div>
                    </td>
                  
                    <td>${inlineDate}</td>
                    <td>${inlineDepartment}</td>
                    <td>${expectedDate}</td>
                    <td>${statusBadge}</td>
                </tr>
            `);
        });
    }

    // ---------------------------------------------------------------
    // 5. Render phân trang
    // ---------------------------------------------------------------
    function renderPagination(totalCount, page, totalPages) {
        paginationCtrl.innerHTML = '';
        if (totalPages <= 1) return;

        // Nút Prev
        const prev = btn('<i class="fa-solid fa-chevron-left"></i>', page <= 1);
        prev.addEventListener('click', () => { if (page > 1) goPage(page - 1); });
        paginationCtrl.appendChild(prev);

        // Số trang (hiển thị tối đa 7 nút, dùng dấu "…" khi cần)
        const pages = buildPageRange(page, totalPages);
        pages.forEach(p => {
            if (p === '...') {
                const dots = document.createElement('span');
                dots.className   = 'page-dots';
                dots.textContent = '…';
                paginationCtrl.appendChild(dots);
            } else {
                const b = btn(p, false, p === page);
                b.addEventListener('click', () => goPage(p));
                paginationCtrl.appendChild(b);
            }
        });

        // Nút Next
        const next = btn('<i class="fa-solid fa-chevron-right"></i>', page >= totalPages);
        next.addEventListener('click', () => { if (page < totalPages) goPage(page + 1); });
        paginationCtrl.appendChild(next);
    }

    function buildPageRange(current, total) {
        if (total <= 7) return Array.from({ length: total }, (_, i) => i + 1);
        const pages = [];
        if (current <= 4) {
            pages.push(1, 2, 3, 4, 5, '...', total);
        } else if (current >= total - 3) {
            pages.push(1, '...', total - 4, total - 3, total - 2, total - 1, total);
        } else {
            pages.push(1, '...', current - 1, current, current + 1, '...', total);
        }
        return pages;
    }

    function btn(html, disabled, active) {
        const b = document.createElement('button');
        b.className   = 'page-btn' + (active ? ' active' : '');
        b.disabled    = !!disabled;
        b.innerHTML   = html;
        return b;
    }

    function goPage(page) {
        currentPage = page;
        fetchList(currentPage);
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // ---------------------------------------------------------------
    // 6. Helpers
    // ---------------------------------------------------------------
    function escHtml(str) {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    function fmtNum(n) {
        if (n == null) return '—';
        return Number(n).toLocaleString('vi-VN');
    }

    function updatePanelHeader(sel, total) {
        const deptName = sel.options[sel.selectedIndex]?.text ?? 'Tất cả bộ phận';
        panelTitle.textContent = `Danh sách chuyền sản xuất — ${deptName}`;
    }

    function updatePanelSub() {
        const now = new Date();
        const time = now.toLocaleTimeString('vi-VN', { hour: '2-digit', minute: '2-digit' });
        const date = now.toLocaleDateString('vi-VN');
        panelSub.textContent = `Cập nhật lúc ${time} · ${date}`;
    }

    // ---------------------------------------------------------------
    // 7. Event handlers
    // ---------------------------------------------------------------
    
    // Hàm Debounce cho ô tìm kiếm
    function debounce(func, wait) {
        let timeout;
        return function executedFunction(...args) {
            const later = () => {
                clearTimeout(timeout);
                func(...args);
            };
            clearTimeout(timeout);
            timeout = setTimeout(later, wait);
        };
    }

    // Tự động tìm kiếm khi gõ (debounce 1.5s)
    const handleSearchInput = debounce(() => {
        currentPage = 1;
        fetchList(1);
    }, 1500);

    searchInput.addEventListener('input', handleSearchInput);
    searchInput.addEventListener('input', handleSearchInput);
    
    // Nút Tìm kiếm
    btnSearch.addEventListener('click', () => {
        currentPage = 1;
        fetchList(1);
    });

    // Enter trong ô tìm kiếm
    searchInput.addEventListener('keydown', e => {
        if (e.key === 'Enter') { currentPage = 1; fetchList(1); }
    });

    // Khi chọn Bộ phận → reload Line + reset page → fetch
    deptSelect.addEventListener('change', function () {
        currentPage = 1;
        loadLines(this.value || null).then(() => fetchList(1));
    });

    // Tự động gọi fetch khi đổi Line, Status, Từ ngày, Đến ngày
    [lineSelect, statusSelect, fromDateInput, toDateInput].forEach(el => {
        el.addEventListener('change', () => { currentPage = 1; fetchList(1); });
    });

    // Nút Đặt lại
    btnReset.addEventListener('click', () => {
        searchInput.value   = '';
        deptSelect.value    = '';
        lineSelect.value    = '';
        statusSelect.value  = '1';
        fromDateInput.value = '@firstDay';
        toDateInput.value   = '@today';
        currentPage         = 1;
        loadLines(null).then(() => fetchList(1));
    });

    // Nút Làm mới
    btnRefresh.addEventListener('click', () => fetchList(currentPage));

    // Khởi tạo khi DOM sẵn sàng
    document.addEventListener('DOMContentLoaded', async () => {
        await loadDepartments();
        await loadLines(null);
        fetchList(1);
    });

})();
</script>

<!-- Toast Container -->
<div id="ppToastContainer" style="position:fixed;top:20px;right:20px;z-index:99999;display:flex;flex-direction:column;gap:10px;min-width:300px;max-width:380px;pointer-events:none;"></div>

<!-- Context Menu -->
<div id="ctxMenu" style="display:none;position:fixed;z-index:9999;background:var(--bg-surface);border:1px solid var(--border);border-radius:8px;box-shadow:var(--shadow-md);padding:6px 0;min-width:180px;">
    <button id="ctxEdit" style="display:block;width:100%;text-align:left;padding:9px 16px;background:none;border:none;cursor:pointer;font-size:13.5px;color:var(--ink-900);font-family:inherit;">
        <i class="fa-solid fa-pen-to-square" style="color:var(--primary);width:18px;"></i> Cập nhật
    </button>
    <div style="height:1px;background:var(--border);margin:4px 0;"></div>
    <button id="ctxDelete" style="display:block;width:100%;text-align:left;padding:9px 16px;background:none;border:none;cursor:pointer;font-size:13.5px;color:var(--danger);font-family:inherit;">
        <i class="fa-solid fa-trash" style="width:18px;"></i> Xóa mã hàng
    </button>
</div>

<!-- Modal xác nhận xóa -->
<div id="modalConfirmDelete" class="modal-backdrop" style="display:none;" role="dialog" aria-modal="true">
    <div class="modal-box" style="max-width:420px;">
        <div class="modal-header">
            <h2 class="modal-title" style="color:var(--danger);"><i class="fa-solid fa-triangle-exclamation"></i> Xác nhận xóa</h2>
            <button class="modal-close" id="btnCloseDel">&times;</button>
        </div>
        <div class="modal-body">
            <p style="font-size:14px;color:var(--ink-700-solid);">Bạn có chắc muốn xóa mã hàng này không? Hành động này sẽ đổi trạng thái thành "Đã xóa" và không hiển thị trong danh sách.</p>
            <div id="delInfoBox" style="background:var(--surface-alt,#f4f6fb);border:1px solid var(--border);border-radius:6px;padding:10px 14px;margin-top:12px;font-size:13px;"></div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-ghost" id="btnCancelDel">Hủy</button>
            <button class="btn" style="background:var(--danger);color:#fff;" id="btnConfirmDel"><i class="fa-solid fa-trash"></i> Xóa</button>
        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    // ── Toast system ──────────────────────────────────────────────────
    const _tc = document.getElementById('ppToastContainer');
    function toast(type, msg, ms) {
        ms = ms || 3500;
        const icons  = { success:'fa-circle-check', error:'fa-circle-xmark', warn:'fa-triangle-exclamation', info:'fa-circle-info' };
        const colors = { success:'var(--success)', error:'var(--danger)', warn:'#d97706', info:'var(--primary)' };
        const c = colors[type] || colors.info;
        const el = document.createElement('div');
        el.style.cssText = 'background:var(--bg-surface);border:1px solid var(--border);border-radius:10px;padding:13px 15px;box-shadow:var(--shadow-md);display:flex;align-items:flex-start;gap:12px;border-left:4px solid '+c+';animation:ppToastIn .28s ease;pointer-events:auto;';
        el.innerHTML = '<i class="fa-solid '+(icons[type]||icons.info)+'" style="color:'+c+';font-size:18px;margin-top:1px;"></i>'
            + '<div style="flex:1;font-size:13.5px;font-weight:600;color:var(--ink-900);">'+ String(msg).replace(/</g,'&lt;') +'</div>'
            + '<button style="background:none;border:none;cursor:pointer;font-size:16px;color:var(--ink-400);padding:0;pointer-events:auto;" onclick="this.parentNode.remove()">&times;</button>';
        _tc.appendChild(el);
        setTimeout(() => {
            el.style.transition = 'opacity .25s,transform .25s';
            el.style.opacity = '0'; el.style.transform = 'translateX(30px)';
            setTimeout(() => el.remove(), 280);
        }, ms);
    }

    // ── Context Menu ──────────────────────────────────────────────────
    const ctxMenu   = document.getElementById('ctxMenu');
    const ctxEdit   = document.getElementById('ctxEdit');
    const ctxDelete = document.getElementById('ctxDelete');
    const delModal  = document.getElementById('modalConfirmDelete');
    const delInfoBox= document.getElementById('delInfoBox');
    const btnConfDel= document.getElementById('btnConfirmDel');
    let activeRow   = null;

    document.getElementById('progressTableBody').addEventListener('contextmenu', e => {
        const tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        e.preventDefault();
        activeRow = tr;
        const { clientX: x, clientY: y } = e;
        const mW = 190, mH = 90;
        ctxMenu.style.left = (x + mW > window.innerWidth  ? x - mW : x) + 'px';
        ctxMenu.style.top  = (y + mH > window.innerHeight ? y - mH : y) + 'px';
        ctxMenu.style.display = 'block';
        document.querySelectorAll('#progressTableBody tr').forEach(r => r.classList.remove('ctx-active'));
        tr.classList.add('ctx-active');
    });

    document.addEventListener('click', () => hideCtx());
    document.addEventListener('keydown', e => { if (e.key === 'Escape') hideCtx(); });
    function hideCtx() {
        ctxMenu.style.display = 'none';
        if (activeRow) activeRow.classList.remove('ctx-active');
    }

    ctxEdit.addEventListener('click', () => {
        if (!activeRow) return;
        window.location.href = `/ProductionProgress/ProductionInfoForm?id=${activeRow.dataset.id}`;
    });

    ctxDelete.addEventListener('click', () => {
        if (!activeRow) return;
        hideCtx();
        delInfoBox.innerHTML =
            '<strong>Line:</strong> ' + (activeRow.dataset.line || '--') + ' &nbsp;|&nbsp; ' +
            '<strong>Style:</strong> ' + (activeRow.dataset.style || '--') + ' &nbsp;|&nbsp; ' +
            '<strong>SP:</strong> ' + (activeRow.dataset.sp || '--');
        delModal.style.display = 'flex';
    });

    document.getElementById('btnCloseDel').addEventListener('click', () => { delModal.style.display = 'none'; });
    document.getElementById('btnCancelDel').addEventListener('click', () => { delModal.style.display = 'none'; });
    delModal.addEventListener('click', e => { if (e.target === delModal) delModal.style.display = 'none'; });

    btnConfDel.addEventListener('click', async () => {
        if (!activeRow) return;
        const id = activeRow.dataset.id;
        btnConfDel.disabled = true;
        btnConfDel.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang xóa...';
        try {
            const res  = await fetch('/ProductionProgress/SoftDelete', {
                method: 'POST', headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id })
            });
            const data = await res.json();
            if (res.ok && data.success) {
                toast('warn', 'Đã xóa mã hàng thành công.');
                activeRow.style.transition = 'opacity .3s';
                activeRow.style.opacity = '0';
                setTimeout(() => { activeRow.remove(); activeRow = null; }, 320);
                delModal.style.display = 'none';
            } else {
                toast('error', 'Lỗi: ' + (data.message || 'Không xóa được.'));
            }
        } catch (err) {
            toast('error', 'Lỗi kết nối: ' + err.message);
        } finally {
            btnConfDel.disabled = false;
            btnConfDel.innerHTML = '<i class="fa-solid fa-trash"></i> Xóa';
        }
    });

})();
</script>

<style>
    #progressTableBody tr.ctx-active td { background: rgba(59,130,246,.08) !important; }
    #ctxMenu button:hover { background: var(--surface-alt, #f4f6fb); }
    @@keyframes ppToastIn { from { opacity:0; transform:translateX(30px); } to { opacity:1; transform:none; } }
    /* Modal overlay */
    .modal-backdrop { display:none; position:fixed; inset:0; z-index:9000; background:rgba(10,14,26,.45); backdrop-filter:blur(3px); align-items:flex-start; justify-content:center; padding-top:80px; }
    .modal-backdrop.open { display:flex !important; }
    .modal-box { background:var(--bg-surface); border-radius:14px; box-shadow:0 20px 60px rgba(0,0,0,.22); width:100%; max-height:calc(100vh - 140px); overflow-y:auto; animation:mbIn .22s cubic-bezier(.4,0,.2,1); }
    .modal-header { display:flex; align-items:center; justify-content:space-between; padding:18px 22px 14px; border-bottom:1px solid var(--border); }
    .modal-title { font-size:16px; font-weight:700; margin:0; color:var(--ink-900); display:flex; align-items:center; gap:8px; }
    .modal-close { background:none; border:none; font-size:22px; cursor:pointer; color:var(--ink-400); line-height:1; padding:2px 6px; border-radius:6px; transition:background .15s; }
    .modal-close:hover { background:var(--surface-alt,#f0f2f8); color:var(--ink-900); }
    .modal-body { padding:20px 22px; }
    .modal-footer { padding:14px 22px 18px; display:flex; justify-content:flex-end; gap:10px; border-top:1px solid var(--border); }
    @@keyframes mbIn { from { opacity:0; transform:translateY(-16px) scale(.97); } to { opacity:1; transform:none; } }
</style>
