@{
    ViewData["Title"] = "Lich su ma hang";
}
<style>
    :root {
        --pih-navy: #1f3a67; --pih-navy-700: #16305a; --pih-navy-soft: #e8edf5;
        --pih-success: #1a9e65; --pih-danger: #d64040; --pih-warn: #d97706;
        --pih-border: #e2e6ef; --pih-border-soft: #f0f2f8;
        --pih-canvas: #ffffff; --pih-surface: #f7f8fc;
        --pih-ink-900: #1a1d29; --pih-ink-700: #2e3349;
        --pih-ink-500: #64697f; --pih-ink-400: #8e93a8; --pih-ink-300: #b4b9cc;
    }
    .pih-page{display:flex;flex-direction:column;height:calc(100vh - var(--header-h,60px));overflow:hidden;background:var(--pih-surface);}
    .pih-topbar{display:flex;align-items:center;justify-content:space-between;padding:14px 24px 12px;background:var(--pih-canvas);border-bottom:1px solid var(--pih-border);flex-shrink:0;gap:14px;flex-wrap:wrap;}
    .pih-topbar-left{display:flex;align-items:center;gap:14px;}
    .pih-icon{width:42px;height:42px;border-radius:11px;background:linear-gradient(135deg,var(--pih-navy) 0%,var(--pih-navy-700) 100%);color:#fff;display:flex;align-items:center;justify-content:center;font-size:17px;flex-shrink:0;box-shadow:0 4px 14px rgba(31,58,103,.28);}
    .pih-page-title{font-size:20px;font-weight:800;background:linear-gradient(135deg,var(--pih-navy) 0%,#3a5fa8 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;}
    .pih-page-sub{font-size:12.5px;color:var(--pih-ink-400);margin-top:1px;}
    .pih-date-chip{display:flex;align-items:center;gap:6px;font-size:12px;font-weight:600;color:var(--pih-ink-400);background:var(--pih-surface);border:1px solid var(--pih-border);padding:4px 10px;border-radius:999px;}
    .btn{display:inline-flex;align-items:center;gap:7px;padding:9px 16px;border-radius:9px;font-size:13.5px;font-weight:700;cursor:pointer;border:none;font-family:inherit;transition:background .18s,opacity .18s,transform .15s;text-decoration:none;}
    .btn-ghost{background:var(--pih-canvas);color:var(--pih-ink-700);border:1.5px solid var(--pih-border);} .btn-ghost:hover{background:var(--pih-border-soft);}
    .btn-primary{background:linear-gradient(135deg,var(--pih-navy) 0%,var(--pih-navy-700) 100%);color:#fff;box-shadow:0 4px 12px rgba(31,58,103,.22);} .btn-primary:hover{opacity:.9;transform:translateY(-1px);}
    .btn-sm{padding:7px 13px;font-size:12.5px;border-radius:8px;}
    .btn-danger{background:var(--pih-danger);color:#fff;} .btn-danger:hover{opacity:.88;}
    .pih-filter{display:flex;align-items:flex-end;gap:10px;padding:12px 24px 13px;background:var(--pih-canvas);border-bottom:1px solid var(--pih-border);flex-shrink:0;flex-wrap:wrap;}
    .pih-filter-grp{display:flex;flex-direction:column;gap:3px;}
    .pih-filter-lbl{font-size:10.5px;font-weight:700;color:var(--pih-ink-400);text-transform:uppercase;letter-spacing:.4px;}
    .pih-inp{padding:7px 11px;border:1.5px solid var(--pih-border);border-radius:8px;font-family:inherit;font-size:13px;color:var(--pih-ink-900);background:var(--pih-surface);outline:none;transition:border-color .18s,box-shadow .18s;}
    .pih-inp:focus{border-color:var(--pih-navy);box-shadow:0 0 0 3px var(--pih-navy-soft);}
    .pih-search-wrap{position:relative;} .pih-search-wrap i{position:absolute;left:10px;top:50%;transform:translateY(-50%);color:var(--pih-ink-300);font-size:12px;} .pih-search-wrap .pih-inp{padding-left:30px;min-width:200px;}
    .pih-summary{display:flex;gap:10px;padding:10px 24px;background:var(--pih-canvas);border-bottom:1px solid var(--pih-border);flex-shrink:0;flex-wrap:wrap;}
    .pih-sum-chip{display:flex;flex-direction:column;align-items:center;gap:1px;background:var(--pih-surface);border:1.5px solid var(--pih-border);border-radius:10px;padding:8px 18px;min-width:80px;}
    .pih-sum-chip .s-num{font-size:18px;font-weight:800;color:var(--pih-ink-900);line-height:1.1;} .pih-sum-chip .s-lbl{font-size:10px;font-weight:700;color:var(--pih-ink-400);text-transform:uppercase;letter-spacing:.5px;}
    .pih-sum-chip.c-blue{border-color:var(--pih-navy);} .pih-sum-chip.c-blue .s-num{color:var(--pih-navy);}
    .pih-sum-chip.c-green .s-num{color:var(--pih-success);} .pih-sum-chip.c-gold .s-num{color:var(--pih-warn);}
    .pih-body{flex:1;overflow-y:auto;min-height:0;}
    .pih-table-wrap{overflow-x:auto;}
    .pih-table{width:100%;border-collapse:collapse;font-size:13px;user-select:none;}
    .pih-table thead tr{background:var(--pih-surface);position:sticky;top:0;z-index:2;}
    .pih-table thead th{padding:9px 14px;text-align:left;font-size:10.5px;font-weight:700;text-transform:uppercase;letter-spacing:.5px;color:var(--pih-ink-400);white-space:nowrap;border-bottom:2px solid var(--pih-border);}
    .pih-table thead th.sortable{cursor:pointer;transition:color .15s;} .pih-table thead th.sortable:hover,.pih-table thead th.sort-active{color:var(--pih-navy);}
    .pih-table tbody tr{border-bottom:1px solid var(--pih-border-soft);transition:background .12s;} .pih-table tbody tr:hover{background:var(--pih-navy-soft);}
    .pih-table tbody td{padding:9px 14px;vertical-align:middle;}
    .pih-num-cell{font-size:14px;font-weight:800;color:var(--pih-navy);cursor:cell;border-radius:5px;padding:2px 6px;display:inline-block;transition:background .1s;}
    .pih-num-cell.selecting{background:var(--sel-cell-bg, rgba(31,58,103,.14));outline:2px solid rgba(31,58,103,.35);outline-offset:-1px;}
    .pih-badge{display:inline-flex;align-items:center;gap:4px;padding:3px 9px;border-radius:6px;font-size:11px;font-weight:700;}
    .pih-badge.active{background:#e0f7ef;color:var(--pih-success);} .pih-badge.wait{background:#fef3d0;color:var(--pih-warn);} .pih-badge.done{background:#e8edf5;color:var(--pih-navy);}
    .pih-empty{text-align:center;padding:60px;color:var(--pih-ink-300);} .pih-empty i{font-size:40px;display:block;margin-bottom:12px;} .pih-empty p{font-size:14px;font-weight:600;color:var(--pih-ink-400);}
    .pih-foot{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:10px 24px;border-top:1px solid var(--pih-border);background:var(--pih-canvas);flex-shrink:0;flex-wrap:wrap;}
    .pih-page-info{font-size:12px;color:var(--pih-ink-400);font-weight:600;}
    .pih-paging{display:flex;align-items:center;gap:5px;}
    .pih-paging-btn{padding:5px 11px;border-radius:7px;border:1.5px solid var(--pih-border);background:var(--pih-canvas);font-size:12.5px;font-weight:700;color:var(--pih-ink-700);cursor:pointer;transition:background .14s,border-color .14s;}
    .pih-paging-btn:hover:not([disabled]){background:var(--pih-navy-soft);border-color:var(--pih-navy);color:var(--pih-navy);} .pih-paging-btn[disabled]{opacity:.35;pointer-events:none;} .pih-paging-btn.active{background:var(--pih-navy);color:#fff;border-color:var(--pih-navy);}
    .pih-page-size{padding:5px 10px;border:1.5px solid var(--pih-border);border-radius:7px;font-family:inherit;font-size:12.5px;color:var(--pih-ink-700);background:var(--pih-canvas);outline:none;cursor:pointer;}
    .pih-sel-bar{position:fixed;bottom:20px;right:28px;z-index:500;background:#1e1e2e;color:#fff;border-radius:12px;padding:10px 20px;display:none;align-items:center;gap:18px;box-shadow:0 8px 28px rgba(0,0,0,.35);font-size:12.5px;animation:pihIn .18s ease;} .pih-sel-bar.visible{display:flex;}
    .pih-sel-stat{display:flex;flex-direction:column;align-items:center;gap:1px;}
    .pih-sel-stat .s-lbl{font-size:10px;font-weight:700;color:rgba(255,255,255,.45);text-transform:uppercase;letter-spacing:.5px;} .pih-sel-stat .s-val{font-size:15px;font-weight:800;color:#93c5fd;}
    .pih-sel-divider{width:1px;height:32px;background:rgba(255,255,255,.15);}
    .pih-sel-close{background:none;border:none;color:rgba(255,255,255,.4);cursor:pointer;font-size:14px;margin-left:4px;padding:2px;transition:color .15s;} .pih-sel-close:hover{color:#fff;}
    .pih-ctx{position:fixed;background:var(--pih-canvas);border:1.5px solid var(--pih-border);border-radius:10px;box-shadow:0 8px 28px rgba(0,0,0,.18);z-index:600;padding:5px;min-width:170px;display:none;animation:pihIn .12s ease;} .pih-ctx.visible{display:block;}
    .pih-ctx-item{display:flex;align-items:center;gap:9px;padding:9px 13px;border-radius:7px;font-size:13px;font-weight:600;color:var(--pih-ink-700);cursor:pointer;transition:background .12s;} .pih-ctx-item:hover{background:var(--pih-surface);}
    .pih-ctx-item.danger{color:var(--pih-danger);} .pih-ctx-item.danger:hover{background:#fdecea;}
    .pih-ctx-sep{height:1px;background:var(--pih-border-soft);margin:4px 5px;}
    .pih-edit-bd{display:none;position:fixed;inset:0;z-index:9000;background:rgba(10,14,26,.45);backdrop-filter:blur(3px);align-items:flex-start;justify-content:center;padding-top:55px;} .pih-edit-bd.open{display:flex !important;}
    .pih-edit-modal{background:var(--pih-canvas);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.22);width:560px;max-width:95vw;max-height:calc(100vh - 90px);overflow-y:auto;animation:pihIn .22s cubic-bezier(.4,0,.2,1);}
    .pih-edit-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 14px;border-bottom:1px solid var(--pih-border);}
    .pih-edit-title{font-size:16px;font-weight:700;color:var(--pih-ink-900);display:flex;align-items:center;gap:8px;margin:0;}
    .pih-edit-body{padding:20px 22px;display:flex;flex-direction:column;gap:14px;}
    .pih-edit-lbl{display:block;font-size:12.5px;font-weight:600;color:var(--pih-ink-700);margin-bottom:4px;}
    .pih-edit-row{display:grid;grid-template-columns:1fr 1fr;gap:14px;} .pih-edit-row3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;}
    .pih-edit-foot{padding:14px 22px 18px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--pih-border);}
    .pih-modal-close{background:none;border:none;font-size:22px;cursor:pointer;color:var(--pih-ink-400);line-height:1;padding:2px 7px;border-radius:6px;transition:background .15s;} .pih-modal-close:hover{background:var(--pih-surface);color:var(--pih-danger);}
    .pih-cfm-bd{display:none;position:fixed;inset:0;z-index:9100;background:rgba(10,14,26,.45);backdrop-filter:blur(3px);align-items:flex-start;justify-content:center;padding-top:70px;} .pih-cfm-bd.open{display:flex !important;}
    .pih-cfm-box{background:var(--pih-canvas);border-radius:14px;box-shadow:0 20px 60px rgba(0,0,0,.22);width:400px;max-width:95vw;overflow:hidden;animation:pihIn .22s cubic-bezier(.4,0,.2,1);}
    .pih-cfm-head{display:flex;align-items:center;justify-content:space-between;padding:18px 22px 14px;border-bottom:1px solid var(--pih-border);border-top:4px solid var(--pih-danger);}
    .pih-cfm-title{font-size:16px;font-weight:700;color:var(--pih-danger);display:flex;align-items:center;gap:8px;margin:0;}
    .pih-cfm-body{padding:18px 22px;} .pih-cfm-msg{font-size:14px;color:var(--pih-ink-700);line-height:1.6;}
    .pih-cfm-foot{padding:14px 22px 18px;display:flex;justify-content:flex-end;gap:10px;border-top:1px solid var(--pih-border);}
    .pih-toast{position:fixed;bottom:28px;right:28px;z-index:9999;padding:12px 20px;border-radius:10px;font-size:13.5px;font-weight:700;color:#fff;box-shadow:0 6px 20px rgba(0,0,0,.18);animation:pihIn .2s ease;}
    /* ROW MULTI-SELECT */
    .pih-table tbody tr[data-id].pih-row-sel td { background:var(--sel-row-bg, rgba(31,58,103,.10)) !important; }
    .pih-table tbody tr[data-id].pih-row-ctx td { background:var(--sel-ctx-bg, rgba(31,58,103,.18)) !important; }
    .pih-table tbody tr[data-id] { cursor:pointer; }

    @@keyframes pihIn{from{opacity:0;transform:translateY(10px) scale(.97);}to{opacity:1;transform:none;}}
</style>

<div class="pih-page">
    <div class="pih-topbar">
        <div class="pih-topbar-left">
            <a href="/ProductionProgress/ATProgress" class="btn btn-ghost btn-sm"><i class="fa-solid fa-arrow-left"></i> Quay lại</a>
            <div class="pih-icon"><i class="fa-solid fa-list-check"></i></div>
            <div>
                <div class="pih-page-title">Lịch sử ghi mã hàng</div>
                <div class="pih-page-sub">Tra cứu, cập nhật và xóa thông tin mã hàng sản xuất</div>
            </div>
        </div>
        <div class="pih-date-chip"><i class="fa-regular fa-calendar"></i><span id="pihTodayLabel">&#8212;</span></div>
    </div>
    <div class="pih-filter">
        <div class="pih-filter-grp"><div class="pih-filter-lbl">Từ ngày</div><input type="date" class="pih-inp" id="pihFrom"></div>
        <div class="pih-filter-grp"><div class="pih-filter-lbl">Đến ngày</div><input type="date" class="pih-inp" id="pihTo"></div>
        <div class="pih-filter-grp"><div class="pih-filter-lbl">Bộ phận</div><select class="pih-inp" id="pihDeptFilter" style="min-width:140px;"><option value="">Tất cả</option></select></div>
        <div class="pih-filter-grp"><div class="pih-filter-lbl">Trạng thái</div><select class="pih-inp" id="pihStatusFilter" style="min-width:130px;"><option value="">Tất cả (trừ xóa)</option><option value="1">Đang hoạt động</option><option value="0">Chờ sản xuất</option><option value="2">Hoàn thành</option></select></div>
        <div class="pih-filter-grp" style="align-self:flex-end;"><button class="btn btn-primary btn-sm" id="pihApplyBtn"><i class="fa-solid fa-filter"></i> Lọc</button></div>
        <div class="pih-filter-grp" style="align-self:flex-end;"><button class="btn btn-ghost btn-sm" id="pihResetBtn"><i class="fa-solid fa-rotate-left"></i> Đặt lại</button></div>
        <div class="pih-filter-grp" style="flex:1;align-self:flex-end;"><div class="pih-filter-lbl">Tìm kiếm</div><div class="pih-search-wrap"><i class="fa-solid fa-magnifying-glass"></i><input type="text" class="pih-inp" id="pihSearch" placeholder="Line, Style, SP, màu, bộ phận..." style="width:100%;box-sizing:border-box;min-width:220px;"></div></div>
    </div>
    <div class="pih-summary" id="pihSummary" style="display:none;">
        <div class="pih-sum-chip c-blue"><div class="s-num" id="sumRows">0</div><div class="s-lbl">Mã hàng</div></div>
        <div class="pih-sum-chip c-green"><div class="s-num" id="sumActive">0</div><div class="s-lbl">Đang HD</div></div>
        <div class="pih-sum-chip c-gold"><div class="s-num" id="sumWait">0</div><div class="s-lbl">Chờ SX</div></div>
        <div class="pih-sum-chip"><div class="s-num" id="sumDone">0</div><div class="s-lbl">Hoàn thành</div></div>
        <div style="margin-left:auto;align-self:center;"><span id="pihRecordCount" style="font-size:12px;color:var(--pih-ink-400);font-weight:600;"></span></div>
    </div>
    <div class="pih-body">
        <div class="pih-table-wrap">
            <table class="pih-table">
                <thead><tr>
                    <th style="width:38px;">#</th>
                    <th class="sortable sort-active" data-col="createDate">Ngày tạo <i class="fa-solid fa-sort-down fa-xs"></i></th>
                    <th>Bộ phận</th>
                    <th class="sortable" data-col="line">Line <i class="fa-solid fa-sort fa-xs"></i></th>
                    <th>Style</th><th>SP#</th><th>Color</th>
                    <th class="sortable" data-col="totalQty" style="text-align:right;">Tổng SL <i class="fa-solid fa-sort fa-xs"></i></th>
                    <th class="sortable" data-col="target" style="text-align:right;">Target <i class="fa-solid fa-sort fa-xs"></i></th>
                    <th>Inline Line</th><th>Inline Dept</th><th>Trạng thái</th>
                </tr></thead>
                <tbody id="pihTbody">
                    <tr><td colspan="12" class="pih-empty"><i class="fa-solid fa-list-check"></i><p>Chọn khoảng ngày và nhấn <strong>Lọc</strong> để tải dữ liệu</p></td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="pih-foot">
        <div style="display:flex;align-items:center;gap:10px;"><span class="pih-page-info" id="pihPageInfo"></span><select class="pih-page-size" id="pihPageSize"><option value="50" selected>50 / trang</option><option value="100">100 / trang</option><option value="200">200 / trang</option><option value="500">500 / trang</option></select></div>
        <div class="pih-paging" id="pihPaging"></div>
    </div>
</div>

<div class="pih-ctx" id="pihCtxMenu">
    <div id="pihCtxSelInfo" style="display:none;padding:4px 13px 8px;font-size:11.5px;color:var(--pih-ink-400);font-weight:700;border-bottom:1px solid var(--pih-border-soft);margin-bottom:3px;">
        Đã chọn: <span id="pihCtxSelCount" style="color:var(--pih-navy);"></span> mã hàng
    </div>
    <div class="pih-ctx-item" id="pihCtxEdit"><i class="fa-solid fa-pen" style="color:var(--pih-navy);"></i> Cập nhật</div>
    <div class="pih-ctx-sep"></div>
    <div class="pih-ctx-item danger" id="pihCtxDelete"><i class="fa-solid fa-trash"></i> <span id="pihCtxDeleteLabel">Xóa mã hàng</span></div>
</div>

<div class="pih-sel-bar" id="pihSelBar">
    <div class="pih-sel-stat"><span class="s-lbl">Số ô</span><span class="s-val" id="pihSelCount">0</span></div>
    <div class="pih-sel-divider"></div>
    <div class="pih-sel-stat"><span class="s-lbl">Tổng SL</span><span class="s-val" id="pihSelSum">0</span></div>
    <div class="pih-sel-divider"></div>
    <div class="pih-sel-stat"><span class="s-lbl">Tổng Target</span><span class="s-val" id="pihSelTarget">0</span></div>
    <button class="pih-sel-close" id="pihSelClose" title="Bỏ chọn"><i class="fa-solid fa-xmark"></i></button>
</div>

<div id="pihEditBd" class="pih-edit-bd">
    <div class="pih-edit-modal">
        <div class="pih-edit-head"><h2 class="pih-edit-title"><i class="fa-solid fa-pen-to-square" style="color:var(--pih-navy);"></i> Cập nhật mã hàng</h2><button class="pih-modal-close" id="pihEditClose">&times;</button></div>
        <div class="pih-edit-body">
            <div class="pih-edit-row">
                <div><label class="pih-edit-lbl">Bộ phận <span style="color:var(--pih-danger);">*</span></label><select class="pih-inp" id="pihEditDept" style="width:100%;box-sizing:border-box;"></select></div>
                <div><label class="pih-edit-lbl">Line <span style="color:var(--pih-danger);">*</span></label><input type="text" class="pih-inp" id="pihEditLine" placeholder="01, 02..." style="width:100%;box-sizing:border-box;"></div>
            </div>
            <div class="pih-edit-row">
                <div><label class="pih-edit-lbl">Style <span style="color:var(--pih-danger);">*</span></label><input type="text" class="pih-inp" id="pihEditStyle" style="width:100%;box-sizing:border-box;"></div>
                <div><label class="pih-edit-lbl">SP# <span style="color:var(--pih-danger);">*</span></label><input type="text" class="pih-inp" id="pihEditSp" style="width:100%;box-sizing:border-box;"></div>
            </div>
            <div class="pih-edit-row3">
                <div><label class="pih-edit-lbl">Color <span style="color:var(--pih-danger);">*</span></label><input type="text" class="pih-inp" id="pihEditColor" style="width:100%;box-sizing:border-box;"></div>
                <div><label class="pih-edit-lbl">Tổng SL</label><input type="number" class="pih-inp" id="pihEditTotalQty" min="0" style="width:100%;box-sizing:border-box;"></div>
                <div><label class="pih-edit-lbl">Target</label><input type="number" class="pih-inp" id="pihEditTarget" min="0" style="width:100%;box-sizing:border-box;"></div>
            </div>
            <div class="pih-edit-row">
                <div><label class="pih-edit-lbl">Inline Line</label><input type="date" class="pih-inp" id="pihEditInlineLine" style="width:100%;box-sizing:border-box;"></div>
                <div><label class="pih-edit-lbl">Inline Dept</label><input type="date" class="pih-inp" id="pihEditInlineDept" style="width:100%;box-sizing:border-box;"></div>
            </div>
            <div class="pih-edit-row">
                <div><label class="pih-edit-lbl">Trạng thái</label><select class="pih-inp" id="pihEditStatus" style="width:100%;box-sizing:border-box;"><option value="0">Chờ sản xuất</option><option value="1">Đang hoạt động</option><option value="2">Hoàn thành</option></select></div>
                <div><label class="pih-edit-lbl">Ghi chú</label><input type="text" class="pih-inp" id="pihEditRemark" style="width:100%;box-sizing:border-box;"></div>
            </div>
        </div>
        <div class="pih-edit-foot"><button class="btn btn-ghost btn-sm" id="pihEditCancel">Huỷ</button><button class="btn btn-primary" id="pihEditSave"><i class="fa-solid fa-floppy-disk"></i> Lưu</button></div>
    </div>
</div>

<div id="pihCfmBd" class="pih-cfm-bd">
    <div class="pih-cfm-box">
        <div class="pih-cfm-head"><h2 class="pih-cfm-title"><i class="fa-solid fa-triangle-exclamation"></i> Xác nhận xoá</h2><button class="pih-modal-close" id="pihCfmClose">&times;</button></div>
        <div class="pih-cfm-body"><div class="pih-cfm-msg" id="pihCfmMsg"></div></div>
        <div class="pih-cfm-foot"><button class="btn btn-ghost btn-sm" id="pihCfmCancel">Huỷ</button><button class="btn btn-danger btn-sm" id="pihCfmOk"><i class="fa-solid fa-trash"></i> Xoa</button></div>
    </div>
</div>

<script>
(function () {
    function esc(s){return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}
    function fmt(n){return n==null?'&#8212;':Number(n).toLocaleString('vi-VN');}
    function todayStr(){var d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');}
    function fmtDateVN(s){if(!s)return'&#8212;';var p=String(s).split('T')[0].split('-');return p.length===3?p[2]+'/'+p[1]+'/'+p[0]:s;}
    function dateStr(v){return v?String(v).split('T')[0]:'';}
    function toast(msg,ok){if(ok){toastr.success(msg);}else{toastr.error(msg);}}
    var allRows=[],filtered=[],pageSize=50,curPage=1,sortCol='createDate',sortDir='desc',ctxRow=null,editRow=null;
    var pihFrom=document.getElementById('pihFrom'),pihTo=document.getElementById('pihTo'),pihSearch=document.getElementById('pihSearch');
    var pihDept=document.getElementById('pihDeptFilter'),pihStatus=document.getElementById('pihStatusFilter');
    var pihTbody=document.getElementById('pihTbody'),pihPaging=document.getElementById('pihPaging'),pihPageInfo=document.getElementById('pihPageInfo');
    var pihPageSizeEl=document.getElementById('pihPageSize'),pihCtxMenu=document.getElementById('pihCtxMenu');
    var pihEditBd=document.getElementById('pihEditBd'),pihSelBar=document.getElementById('pihSelBar'),pihCfmBd=document.getElementById('pihCfmBd');
    (function init(){
        var d=new Date(),today=todayStr();
        var firstDay=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-01';
        pihFrom.value=firstDay;pihTo.value=today;
        document.getElementById('pihTodayLabel').textContent=fmtDateVN(today);
        loadDepts();loadHistory();
    })();
    function loadDepts(){
        fetch('/ProductionProgress/GetDepartments').then(function(r){return r.json();}).then(function(list){
            var editSel=document.getElementById('pihEditDept');
            list.forEach(function(d){
                var o1=document.createElement('option');o1.value=d.id;o1.textContent=d.departmentName;pihDept.appendChild(o1);
                var o2=document.createElement('option');o2.value=d.id;o2.textContent=d.departmentName;editSel.appendChild(o2);
            });
        });
    }
    function loadHistory(){
        pihTbody.innerHTML='<tr><td colspan="12" class="pih-empty"><i class="fa-solid fa-circle-notch fa-spin fa-2x"></i><p>Dang tai...</p></td></tr>';
        document.getElementById('pihSummary').style.display='none';
        var params=[];
        if(pihFrom.value) params.push('from='+encodeURIComponent(pihFrom.value));
        if(pihTo.value)   params.push('to='+encodeURIComponent(pihTo.value));
        if(pihDept.value) params.push('deptId='+encodeURIComponent(pihDept.value));
        if(pihStatus.value!=='') params.push('status='+encodeURIComponent(pihStatus.value));
        fetch('/ProductionProgress/GetProductionInfoHistory?'+params.join('&'))
            .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
            .then(function(list){allRows=list;applyFilterSort();renderSummary();document.getElementById('pihSummary').style.display='flex';})
            .catch(function(e){pihTbody.innerHTML='<tr><td colspan="12" class="pih-empty"><i class="fa-solid fa-triangle-exclamation"></i><p>'+esc(e.message)+'</p></td></tr>';});
    }
    function renderSummary(){
        document.getElementById('sumRows').textContent=fmt(allRows.length);
        document.getElementById('sumActive').textContent=allRows.filter(function(r){return r.status===1;}).length;
        document.getElementById('sumWait').textContent=allRows.filter(function(r){return r.status===0;}).length;
        document.getElementById('sumDone').textContent=allRows.filter(function(r){return r.status===2;}).length;
    }
    function applyFilterSort(){
        var kw=(pihSearch.value||'').toLowerCase().trim();
        filtered=allRows.filter(function(r){
            if(!kw)return true;
            return (r.line||'').toLowerCase().includes(kw)||(r.style||'').toLowerCase().includes(kw)||(r.spmain||'').toLowerCase().includes(kw)||(r.color||'').toLowerCase().includes(kw)||(r.deptName||'').toLowerCase().includes(kw)||(r.remark||'').toLowerCase().includes(kw);
        });
        filtered.sort(function(a,b){
            var av=sortCol==='line'?(a.line||''):sortCol==='totalQty'?(a.totalQty||0):sortCol==='target'?(a.target||0):(a.createDate||'');
            var bv=sortCol==='line'?(b.line||''):sortCol==='totalQty'?(b.totalQty||0):sortCol==='target'?(b.target||0):(b.createDate||'');
            if(av<bv)return sortDir==='asc'?-1:1;if(av>bv)return sortDir==='asc'?1:-1;return 0;
        });
        curPage=1;renderTable();
    }
    function badge(s){
        if(s===1)return '<span class="pih-badge active"><i class="fa-solid fa-circle-dot fa-xs"></i> Đang HD</span>';
        if(s===0)return '<span class="pih-badge wait"><i class="fa-solid fa-clock fa-xs"></i> Chờ SX</span>';
        return '<span class="pih-badge done"><i class="fa-solid fa-check fa-xs"></i> Hoàn thành</span>';
    }
    function renderTable(){
        document.getElementById('pihRecordCount').textContent=fmt(filtered.length)+' mã hàng';
        if(!filtered.length){pihTbody.innerHTML='<tr><td colspan="12" class="pih-empty"><i class="fa-solid fa-inbox"></i><p>Không có dữ liệu phù hợp</p></td></tr>';pihPageInfo.textContent='';pihPaging.innerHTML='';return;}
        var totalPages=Math.ceil(filtered.length/pageSize);
        if(curPage>totalPages)curPage=totalPages;
        var start=(curPage-1)*pageSize,end=Math.min(start+pageSize,filtered.length);
        var pageRows=filtered.slice(start,end);
        pihTbody.innerHTML='';
        pageRows.forEach(function(r,idx){
            var tr=document.createElement('tr');tr.dataset.id=r.id||'';
            tr.innerHTML='<td style="font-size:11px;color:var(--pih-ink-300);font-weight:600;">'+(start+idx+1)+'</td>'
                +'<td style="font-size:12.5px;font-weight:700;white-space:nowrap;">'+fmtDateVN(r.createDate)+'</td>'
                +'<td style="font-size:12px;color:var(--pih-ink-500);">'+esc(r.deptName||'&#8212;')+'</td>'
                +'<td><span style="font-family:Courier New;font-size:13px;font-weight:800;color:var(--pih-navy);background:var(--pih-navy-soft);padding:2px 8px;border-radius:5px;">'+esc(r.line||'&#8212;')+'</span></td>'
                +'<td style="font-size:12.5px;font-weight:600;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="'+esc(r.style||'')+'">' +esc(r.style||'&#8212;')+'</td>'
                +'<td><span style="font-family:Courier New;font-size:12px;font-weight:700;color:var(--pih-navy);background:var(--pih-navy-soft);padding:2px 8px;border-radius:5px;">'+esc(r.spmain||'&#8212;')+'</span></td>'
                +'<td style="font-size:12px;">'+esc(r.color||'&#8212;')+'</td>'
                +'<td style="text-align:right;"><span class="pih-num-cell" data-val="'+(r.totalQty||0)+'\" data-type="qty">'+fmt(r.totalQty)+'</span></td>'
                +'<td style="text-align:right;"><span class="pih-num-cell" data-val="'+(r.target||0)+'\" data-type="target">'+fmt(r.target)+'</span></td>'
                +'<td style="font-size:12px;color:var(--pih-ink-500);">'+fmtDateVN(r.inlineLine)+'</td>'
                +'<td style="font-size:12px;color:var(--pih-ink-500);">'+fmtDateVN(r.inlineDepartment)+'</td>'
                +'<td>'+badge(r.status)+'</td>';
            tr.addEventListener('contextmenu',function(e){
                e.preventDefault();
                ctxRow=r;
                if (!tr.classList.contains('pih-row-sel')) {
                    rowClearAll();
                    rowSelect(tr);
                }
                var sel = rowGetSelected();
                var multi = sel.length > 1;
                document.getElementById('pihCtxSelInfo').style.display  = multi ? 'block' : 'none';
                document.getElementById('pihCtxSelCount').textContent   = sel.length;
                document.getElementById('pihCtxDeleteLabel').textContent= multi ? 'Xóa ' + sel.length + ' mã' : 'Xóa mã hàng';
                document.getElementById('pihCtxEdit').style.display     = multi ? 'none' : 'flex';
                showCtxMenu(e.clientX,e.clientY);
            });
            pihTbody.appendChild(tr);
        });
        pihPageInfo.textContent='Hiển thị '+(start+1)+'-'+end+' / '+filtered.length;
        renderPagination(totalPages);initDragSelect();
    }
    function renderPagination(totalPages){
        pihPaging.innerHTML='';if(totalPages<=1)return;
        function mkBtn(label,page,isActive,disabled){
            var btn=document.createElement('button');btn.className='pih-paging-btn'+(isActive?' active':'');btn.textContent=label;if(disabled)btn.setAttribute('disabled','');
            btn.addEventListener('click',function(){curPage=page;renderTable();});return btn;
        }
        pihPaging.appendChild(mkBtn('«',Math.max(1,curPage-1),false,curPage===1));
        var rs=Math.max(1,curPage-2),re=Math.min(totalPages,rs+4);
        if(rs>1){pihPaging.appendChild(mkBtn('1',1,false,false));if(rs>2){var sp=document.createElement('span');sp.textContent='&#8230;';sp.style.padding='0 4px';pihPaging.appendChild(sp);}}
        for(var i=rs;i<=re;i++)pihPaging.appendChild(mkBtn(i,i,i===curPage,false));
        if(re<totalPages){if(re<totalPages-1){var sp2=document.createElement('span');sp2.textContent='&#8230;';sp2.style.padding='0 4px';pihPaging.appendChild(sp2);}pihPaging.appendChild(mkBtn(totalPages,totalPages,false,false));}
        pihPaging.appendChild(mkBtn('»',Math.min(totalPages,curPage+1),false,curPage===totalPages));
    }
    document.querySelectorAll('.pih-table thead th.sortable').forEach(function(th){
        th.addEventListener('click',function(){
            var col=this.dataset.col;sortDir=(sortCol===col&&sortDir==='desc')?'asc':'desc';sortCol=col;
            document.querySelectorAll('.pih-table thead th').forEach(function(h){h.classList.remove('sort-active');});this.classList.add('sort-active');applyFilterSort();
        });
    });
    document.getElementById('pihApplyBtn').addEventListener('click',function(){curPage=1;loadHistory();});
    document.getElementById('pihResetBtn').addEventListener('click',function(){
        var d=new Date();pihFrom.value=d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-01';
        pihTo.value=todayStr();pihSearch.value='';pihDept.value='';pihStatus.value='';curPage=1;loadHistory();
    });
    var st;pihSearch.addEventListener('input',function(){clearTimeout(st);st=setTimeout(applyFilterSort,250);});
    pihPageSizeEl.addEventListener('change',function(){pageSize=parseInt(this.value)||50;curPage=1;renderTable();});
    pihDept.addEventListener('change',function(){curPage=1;loadHistory();});
    pihStatus.addEventListener('change',function(){curPage=1;loadHistory();});
    function showCtxMenu(x,y){
        var mw=170,mh=90;
        pihCtxMenu.style.left=(x+mw>window.innerWidth?x-mw:x)+'px';
        pihCtxMenu.style.top=(y+mh>window.innerHeight?y-mh:y)+'px';
        pihCtxMenu.classList.add('visible');
    }
    function closeCtxMenu(){pihCtxMenu.classList.remove('visible');ctxRow=null;}
    document.addEventListener('click',function(e){if(!pihCtxMenu.contains(e.target))closeCtxMenu();});
    document.addEventListener('keydown',function(e){if(e.key==='Escape'){closeCtxMenu();closeEditModal();closeConfirm();}});
    var cfmCb=null;
    function showConfirm(msg,cb){document.getElementById('pihCfmMsg').innerHTML=msg;cfmCb=cb;pihCfmBd.classList.add('open');}
    function closeConfirm(){pihCfmBd.classList.remove('open');cfmCb=null;}
    document.getElementById('pihCfmCancel').addEventListener('click',closeConfirm);
    document.getElementById('pihCfmClose').addEventListener('click',closeConfirm);
    document.getElementById('pihCfmOk').addEventListener('click',function(){var cb=cfmCb;closeConfirm();if(cb)cb();});
    pihCfmBd.addEventListener('click',function(e){if(e.target===pihCfmBd)closeConfirm();});
    document.getElementById('pihCtxEdit').addEventListener('click',function(){
        if(!ctxRow)return;var row=ctxRow;closeCtxMenu();openEditModal(row);
    });
    document.getElementById('pihCtxDelete').addEventListener('click',function(){
        var sel = rowGetSelected();
        var ids = sel.map(function(tr){ return tr.dataset.id; });
        if (!ctxRow && !ids.length) return;
        closeCtxMenu();
        if (ids.length > 1) {
            showConfirm('<strong>Xóa ' + ids.length + ' mã hàng đã chọn?</strong><br><span style="color:var(--pih-ink-400);font-size:12px;">Thao tác này không thể hoàn tác.</span>',function(){bulkDeleteRows(ids);});
        } else {
            var row=ctxRow;
            showConfirm('<strong>'+esc(row.style||'')+'</strong> &#8212; SP# '+esc(row.spmain||'')+'<br><span style="color:var(--pih-ink-400);font-size:12px;">Line '+esc(row.line||'')+' &middot; '+esc(row.deptName||'')+'</span>',function(){deleteRecord(row);});
        }
    });
    function deleteRecord(row){
        fetch('/ProductionProgress/SoftDelete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:row.id})})
            .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
            .then(function(data){if(!data.success){toast(data.message||'Lỗi khi xóa thông tin mã hàng',false);return;}toast('Đã xóa thông tin mã hàng',true);allRows=allRows.filter(function(x){return x.id!==row.id;});applyFilterSort();renderSummary();})
            .catch(function(e){toast('Lỗi khi xóa thông tin mã hàng: '+e.message,false);});
    }
    function openEditModal(row){
        editRow=row;
        document.getElementById('pihEditDept').value=row.productionDepartmentId||'';
        document.getElementById('pihEditLine').value=row.line||'';
        document.getElementById('pihEditStyle').value=row.style||'';
        document.getElementById('pihEditSp').value=row.spmain||'';
        document.getElementById('pihEditColor').value=row.color||'';
        document.getElementById('pihEditTotalQty').value=row.totalQty!=null?row.totalQty:'';
        document.getElementById('pihEditTarget').value=row.target!=null?row.target:'';
        document.getElementById('pihEditInlineLine').value=dateStr(row.inlineLine);
        document.getElementById('pihEditInlineDept').value=dateStr(row.inlineDepartment);
        document.getElementById('pihEditStatus').value=row.status!=null?String(row.status):'0';
        document.getElementById('pihEditRemark').value=row.remark||'';
        pihEditBd.classList.add('open');
        setTimeout(function(){document.getElementById('pihEditLine').focus();},200);
    }
    function closeEditModal(){pihEditBd.classList.remove('open');editRow=null;}
    document.getElementById('pihEditClose').addEventListener('click',closeEditModal);
    document.getElementById('pihEditCancel').addEventListener('click',closeEditModal);
    pihEditBd.addEventListener('click',function(e){if(e.target===pihEditBd)closeEditModal();});
    document.getElementById('pihEditSave').addEventListener('click',function(){
        if(!editRow)return;
        var deptId=document.getElementById('pihEditDept').value;
        var line=document.getElementById('pihEditLine').value.trim();
        var style=document.getElementById('pihEditStyle').value.trim();
        var sp=document.getElementById('pihEditSp').value.trim();
        var color=document.getElementById('pihEditColor').value.trim();
        if(!deptId||!line||!style||!sp||!color){toast('Vui long dien day du Bo phan, Line, Style, SP va Mau',false);return;}
        var btn=this,orig=btn.innerHTML;btn.disabled=true;btn.innerHTML='<i class="fa-solid fa-circle-notch fa-spin"></i> Luu...';
        var payload={id:editRow.id,productionDepartmentId:deptId,line:line,style:style,spmain:sp,color:color,
            totalQty:parseInt(document.getElementById('pihEditTotalQty').value)||null,
            target:parseInt(document.getElementById('pihEditTarget').value)||null,
            inlineLine:document.getElementById('pihEditInlineLine').value||null,
            inlineDepartment:document.getElementById('pihEditInlineDept').value||null,
            status:parseInt(document.getElementById('pihEditStatus').value),
            remark:document.getElementById('pihEditRemark').value.trim()||null};
        fetch('/ProductionProgress/Upsert',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)})
            .then(function(r){if(!r.ok)throw new Error('HTTP '+r.status);return r.json();})
            .then(function(data){
                btn.disabled=false;btn.innerHTML=orig;
                if(!data.success){toast(data.message||'Lỗi khi cập nhật thông tin mã hàng',false);return;}
                toast('Đã cập nhật thông tin mã hàng',true);
                closeEditModal();
                loadHistory();
            })
            .catch(function(e){btn.disabled=false;btn.innerHTML=orig;toast('Loi: '+e.message,false);});
    });
    var isDragging=false,dragStartIdx=-1,selectedIdxs=new Set(),autoScrollRaf=null,lastMouseY=0,SCROLL_ZONE=60,SCROLL_SPD=8;
    var cellLastIdx = -1; // dùng cho Shift+Click
    function initDragSelect(){
        var cells=Array.from(pihTbody.querySelectorAll('.pih-num-cell'));
        cells.forEach(function(cell,idx){
            cell.addEventListener('mousedown',function(e){
                if(e.button!==0)return;
                e.preventDefault();
                var freshCells=Array.from(pihTbody.querySelectorAll('.pih-num-cell'));
                var freshIdx=freshCells.indexOf(cell);
                if(e.ctrlKey){
                    // Ctrl+Click: toggle ô, giữ lại các ô khác
                    if(selectedIdxs.has(freshIdx)){
                        selectedIdxs.delete(freshIdx);
                        cell.classList.remove('selecting');
                    } else {
                        selectedIdxs.add(freshIdx);
                        cell.classList.add('selecting');
                    }
                    cellLastIdx=freshIdx;
                    updateSelBar();
                } else if(e.shiftKey && cellLastIdx>-1){
                    // Shift+Click: chọn range từ cellLastIdx đến freshIdx, giữ cũ
                    var lo=Math.min(cellLastIdx,freshIdx),hi=Math.max(cellLastIdx,freshIdx);
                    for(var i=lo;i<=hi;i++) selectCell(freshCells,i);
                    updateSelBar();
                } else {
                    // Click thường: bắt đầu kéo
                    clearSelection();
                    isDragging=true;
                    dragStartIdx=freshIdx;
                    cellLastIdx=freshIdx;
                    selectCell(freshCells,freshIdx);
                }
            });
            cell.addEventListener('mouseenter',function(){
                if(!isDragging)return;
                var freshCells=Array.from(pihTbody.querySelectorAll('.pih-num-cell'));
                var freshIdx=freshCells.indexOf(cell);
                clearSelection();
                var lo=Math.min(dragStartIdx,freshIdx),hi=Math.max(dragStartIdx,freshIdx);
                for(var i=lo;i<=hi;i++) selectCell(freshCells,i);
            });
        });
    }
    var bodyEl=document.querySelector('.pih-body');
    document.addEventListener('mousemove',function(e){lastMouseY=e.clientY;if(!isDragging)return;if(!autoScrollRaf)autoScrollRaf=requestAnimationFrame(doScroll);});
    function doScroll(){autoScrollRaf=null;if(!isDragging||!bodyEl)return;var rect=bodyEl.getBoundingClientRect(),rel=lastMouseY-rect.top,h=rect.height;if(rel<SCROLL_ZONE){bodyEl.scrollTop-=Math.round(SCROLL_SPD*(1-rel/SCROLL_ZONE));autoScrollRaf=requestAnimationFrame(doScroll);}else if(rel>h-SCROLL_ZONE){bodyEl.scrollTop+=Math.round(SCROLL_SPD*(1-(h-rel)/SCROLL_ZONE));autoScrollRaf=requestAnimationFrame(doScroll);}}
    document.addEventListener('mouseup',function(){if(isDragging){isDragging=false;if(autoScrollRaf){cancelAnimationFrame(autoScrollRaf);autoScrollRaf=null;}updateSelBar();}});
    function selectCell(cells,idx){selectedIdxs.add(idx);if(cells[idx])cells[idx].classList.add('selecting');}
    function clearSelection(){selectedIdxs.clear();pihTbody.querySelectorAll('.pih-num-cell.selecting').forEach(function(c){c.classList.remove('selecting');});pihSelBar.classList.remove('visible');}
    function updateSelBar(){if(!selectedIdxs.size){pihSelBar.classList.remove('visible');return;}var cells=pihTbody.querySelectorAll('.pih-num-cell'),tQty=0,tTarget=0,count=0;selectedIdxs.forEach(function(i){if(!cells[i])return;var v=parseFloat(cells[i].dataset.val)||0;if(cells[i].dataset.type==='qty')tQty+=v;else tTarget+=v;count++;});document.getElementById('pihSelCount').textContent=count;document.getElementById('pihSelSum').textContent=fmt(tQty);document.getElementById('pihSelTarget').textContent=fmt(tTarget);pihSelBar.classList.add('visible');}
    document.getElementById('pihSelClose').addEventListener('click',clearSelection);

    /* ── ROW MULTI-SELECT ── */
    var rowLastIdx = -1, rowIsDragging = false;

    function rowGetRows()  { return Array.from(pihTbody.querySelectorAll('tr[data-id]')); }
    function rowSelect(tr) { tr.classList.add('pih-row-sel'); }
    function rowDesel(tr)  { tr.classList.remove('pih-row-sel','pih-row-ctx'); }
    function rowClearAll() { rowGetRows().forEach(rowDesel); }
    function rowGetSelected() { return rowGetRows().filter(function(r){ return r.classList.contains('pih-row-sel'); }); }

    function rowSelectRange(a, b) {
        var rows = rowGetRows(), lo = Math.min(a,b), hi = Math.max(a,b);
        for (var i=lo; i<=hi; i++) if (rows[i]) rowSelect(rows[i]);
    }

    pihTbody.addEventListener('mousedown', function(e) {
        if (e.button !== 0) return;
        var tr = e.target.closest('tr[data-id]');
        if (!tr) { rowClearAll(); return; }
        if (e.target.closest('.pih-num-cell')) return;
        var rows = rowGetRows(), idx = rows.indexOf(tr);
        if (e.shiftKey && rowLastIdx > -1) {
            e.preventDefault(); rowClearAll(); rowSelectRange(rowLastIdx, idx);
        } else if (e.ctrlKey) {
            tr.classList.contains('pih-row-sel') ? rowDesel(tr) : rowSelect(tr); rowLastIdx = idx;
        } else {
            rowClearAll(); rowSelect(tr); rowLastIdx = idx; rowIsDragging = true;
        }
    });

    pihTbody.addEventListener('mouseover', function(e) {
        if (!rowIsDragging) return;
        var tr = e.target.closest('tr[data-id]');
        if (!tr) return;
        var idx = rowGetRows().indexOf(tr);
        if (rowLastIdx > -1) { rowClearAll(); rowSelectRange(rowLastIdx, idx); }
    });

    document.addEventListener('mouseup', function() { rowIsDragging = false; });
    pihTbody.addEventListener('selectstart', function(e) { if (rowIsDragging || e.shiftKey) e.preventDefault(); });

    function bulkDeleteRows(ids) {
        var pending = ids.length, failed = 0;
        ids.forEach(function(id) {
            fetch('/ProductionProgress/SoftDelete',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:id})})
            .then(function(r){return r.json();})
            .then(function(data){ if(!data.success) failed++; else allRows=allRows.filter(function(x){return x.id!==id;}); })
            .catch(function(){ failed++; })
            .finally(function(){
                pending--;
                if (pending===0) {
                    rowClearAll();
                    applyFilterSort(); renderSummary();
                    toast(failed===0?'Đã xóa '+ids.length+' mã hàng':'Xóa '+(ids.length-failed)+'/'+ids.length+', lỗi: '+failed, failed===0);
                }
            });
        });
    }

}());
</script>
