@model SNP_SubSystem.Models.SettingsViewModel

@{
    ViewData["Title"] = "Cài đặt hệ thống";
}

<style>
    /* Premium Settings UI */
    .st-form-container {
        padding: 32px;
        background: var(--bg-surface);
    }
    
    .st-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 40px;
    }
    
    @@media (max-width: 900px) {
        .st-grid {
            grid-template-columns: 1fr;
        }
    }

    .st-group {
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .st-label {
        font-size: 14.5px;
        font-weight: 700;
        color: var(--ink-900);
        display: flex;
        align-items: center;
        gap: 10px;
    }
    
    .st-label i {
        color: var(--accent-navy);
        font-size: 16px;
    }

    .st-input {
        width: 100%;
        padding: 14px 18px;
        border: 1.5px solid var(--border);
        border-radius: 12px;
        font-size: 15px;
        color: var(--ink-900);
        background: var(--bg-canvas);
        transition: all 0.3s ease;
    }

    .st-input:focus {
        border-color: var(--accent-navy);
        box-shadow: 0 0 0 4px rgba(31, 58, 103, 0.12);
        outline: none;
        background: var(--bg-surface);
    }

    /* Drag & Drop Upload Zone */
    .upload-zone {
        position: relative;
        border: 2px dashed var(--border-soft);
        border-radius: 16px;
        background: var(--bg-canvas);
        padding: 28px 20px;
        text-align: center;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 220px;
        overflow: hidden;
    }

    .upload-zone:hover, .upload-zone.dragover {
        border-color: var(--accent-navy);
        background: var(--accent-navy-soft);
        transform: translateY(-2px);
    }

    .upload-input {
        position: absolute;
        top: 0; left: 0; right: 0; bottom: 0;
        width: 100%; height: 100%;
        opacity: 0;
        cursor: pointer;
        z-index: 10;
    }

    .upload-content {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 12px;
        z-index: 5;
        transition: opacity 0.3s;
    }

    .upload-icon {
        font-size: 42px;
        color: var(--accent-navy);
        opacity: 0.8;
        margin-bottom: 4px;
    }

    .upload-text {
        font-size: 15px;
        color: var(--ink-900);
        font-weight: 700;
    }
    
    .upload-hint {
        font-size: 13px;
        color: var(--ink-500);
    }

    /* Preview Image State */
    .upload-preview {
        position: absolute;
        top: 0; left: 0; width: 100%; height: 100%;
        object-fit: cover;
        z-index: 1;
        display: none;
        border-radius: 14px;
        transition: filter 0.3s;
    }
    
    /* Checkerboard for transparent PNGs (Logo) */
    .checkerboard {
        background-image: 
          linear-gradient(45deg, #e5e5e5 25%, transparent 25%), 
          linear-gradient(-45deg, #e5e5e5 25%, transparent 25%), 
          linear-gradient(45deg, transparent 75%, #e5e5e5 75%), 
          linear-gradient(-45deg, transparent 75%, #e5e5e5 75%);
        background-size: 16px 16px;
        background-position: 0 0, 0 8px, 8px -8px, -8px 0px;
        object-fit: contain !important;
        padding: 20px;
    }

    .upload-zone.has-image .upload-preview {
        display: block;
    }
    
    .upload-zone.has-image .upload-content {
        opacity: 0; 
    }
    
    .upload-zone.has-image:hover .upload-preview {
        filter: brightness(0.4) blur(2px);
    }

    .upload-zone.has-image:hover .upload-content {
        opacity: 1;
    }
    
    .upload-zone.has-image:hover .upload-text,
    .upload-zone.has-image:hover .upload-hint,
    .upload-zone.has-image:hover .upload-icon {
        color: #ffffff;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .st-footer {
        margin-top: 40px;
        padding-top: 28px;
        border-top: 1px solid var(--border-soft);
        display: flex;
        justify-content: flex-end;
    }

    .btn-save {
        padding: 14px 40px;
        font-size: 15px;
        border-radius: 12px;
        box-shadow: 0 4px 12px rgba(31, 58, 103, 0.2);
    }
    .btn-save:hover {
        box-shadow: 0 6px 16px rgba(31, 58, 103, 0.3);
    }
</style>

<div class="content-area">
    <div class="page-head">
        <div class="page-head-left">
            <div class="breadcrumb">
                <a asp-controller="Home" asp-action="Index">Trang chủ</a><span class="sep">/</span><span class="current">Quản trị</span>
            </div>
            <h1 class="page-title">Cài đặt hệ thống</h1>
        </div>
    </div>

    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">
                <i class="fa-solid fa-wand-magic-sparkles" style="color: var(--accent-navy); margin-right: 8px;"></i>
                Giao diện & Cấu hình
            </div>
        </div>
        
        <div class="st-form-container">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success" style="background: #ecfdf5; border-left: 4px solid var(--success); color: #065f46; padding: 18px 20px; border-radius: 12px; margin-bottom: 32px; font-weight: 600; display: flex; align-items: center; gap: 12px; box-shadow: 0 2px 8px rgba(6, 95, 70, 0.05);">
                    <i class="fa-solid fa-circle-check" style="font-size: 20px;"></i>
                    @TempData["SuccessMessage"]
                </div>
            }

            <form asp-controller="Settings" asp-action="Save" method="post" enctype="multipart/form-data">
                
                <div class="st-grid">
                    <!-- Left Column -->
                    <div style="display: flex; flex-direction: column; gap: 36px;">
                        
                        <div class="st-group">
                            <label class="st-label" for="SystemTitle">
                                <i class="fa-solid fa-heading"></i> Tiêu đề hệ thống
                            </label>
                            <input type="text" class="st-input" id="SystemTitle" name="SystemTitle" value="@Model.SystemTitle" placeholder="Nhập tên thương hiệu hoặc tiêu đề ứng dụng...">
                        </div>

                        <div class="st-group">
                            <label class="st-label">
                                <i class="fa-solid fa-leaf"></i> Logo thương hiệu
                            </label>
                            <div class="upload-zone @(!string.IsNullOrEmpty(Model.SystemLogoUrl) ? "has-image" : "")" id="zone-logo">
                                <input type="file" class="upload-input" id="SystemLogoFile" name="SystemLogoFile" accept="image/*" onchange="previewImage(this, 'preview-logo', 'zone-logo')">
                                <img src="@Model.SystemLogoUrl" id="preview-logo" class="upload-preview checkerboard" alt="Logo" />
                                
                                <div class="upload-content">
                                    <i class="fa-solid fa-cloud-arrow-up upload-icon"></i>
                                    <span class="upload-text">Nhấp hoặc kéo thả Logo vào đây</span>
                                    <span class="upload-hint">Định dạng khuyên dùng: PNG nền trong suốt</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Right Column -->
                    <div style="display: flex; flex-direction: column; gap: 36px;">
                        
                        <div class="st-group">
                            <label class="st-label">
                                <i class="fa-solid fa-image"></i> Hình nền trang Đăng nhập
                            </label>
                            <div class="upload-zone @(!string.IsNullOrEmpty(Model.LoginBackgroundUrl) ? "has-image" : "")" id="zone-login">
                                <input type="file" class="upload-input" id="LoginBackgroundFile" name="LoginBackgroundFile" accept="image/*" onchange="previewImage(this, 'preview-login', 'zone-login')">
                                <img src="@Model.LoginBackgroundUrl" id="preview-login" class="upload-preview" alt="Login Background" />
                                
                                <div class="upload-content">
                                    <i class="fa-regular fa-image upload-icon"></i>
                                    <span class="upload-text">Nhấp hoặc kéo thả Hình nền vào đây</span>
                                    <span class="upload-hint">Độ phân giải tối ưu: 1920x1080px (Tối đa 5MB)</span>
                                </div>
                            </div>
                        </div>

                        <div class="st-group">
                            <label class="st-label">
                                <i class="fa-solid fa-desktop"></i> Hình nền trang Tổng quan
                            </label>
                            <div class="upload-zone @(!string.IsNullOrEmpty(Model.HomeBackgroundUrl) ? "has-image" : "")" id="zone-home">
                                <input type="file" class="upload-input" id="HomeBackgroundFile" name="HomeBackgroundFile" accept="image/*" onchange="previewImage(this, 'preview-home', 'zone-home')">
                                <img src="@Model.HomeBackgroundUrl" id="preview-home" class="upload-preview" alt="Home Background" />
                                
                                <div class="upload-content">
                                    <i class="fa-solid fa-display upload-icon"></i>
                                    <span class="upload-text">Nhấp hoặc kéo thả Hình nền vào đây</span>
                                    <span class="upload-hint">Dùng cho background của trang chủ (Tùy chọn)</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

                <div class="st-footer">
                    <button type="submit" class="btn btn-primary btn-save">
                        <i class="fa-solid fa-check"></i> Lưu cập nhật
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    // Xử lý xem trước hình ảnh trực tiếp qua FileReader (Cực nhanh và mượt mà)
    function previewImage(input, imgId, zoneId) {
        var zone = document.getElementById(zoneId);
        if (input.files && input.files[0]) {
            var reader = new FileReader();
            
            reader.onload = function(e) {
                var img = document.getElementById(imgId);
                img.src = e.target.result;
                zone.classList.add('has-image');
            }
            
            reader.readAsDataURL(input.files[0]);
        }
    }

    // Xử lý hiệu ứng khi kéo thả file vào vùng upload
    $(function() {
        $('.upload-zone').on('dragover', function(e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).addClass('dragover');
        });
        $('.upload-zone').on('dragleave drop', function(e) {
            e.preventDefault();
            e.stopPropagation();
            $(this).removeClass('dragover');
        });
    });
</script>

<!-- ═══════════════════════════════════════════════════════════════════
     PANEL: Sao lưu & Khôi phục
     ═══════════════════════════════════════════════════════════════════ -->
<style>
    /* ── Backup Panel ───────────────────────────────────────────────── */
    .bk-panel      { margin-top: 24px; }
    .bk-grid       { display:grid; grid-template-columns:1fr 1fr; gap:24px; margin-bottom:24px; }
    @@media(max-width:860px){ .bk-grid{ grid-template-columns:1fr; } }
    .bk-card       { background:var(--bg-canvas); border:1.5px solid var(--border); border-radius:14px; padding:22px 24px; }
    .bk-card-title { font-size:14px; font-weight:700; color:var(--ink-900); display:flex; align-items:center; gap:9px; margin-bottom:18px; }
    .bk-card-title i { color:var(--primary); font-size:16px; }
    .bk-row        { display:flex; align-items:center; gap:10px; margin-bottom:12px; flex-wrap:wrap; }
    .bk-label      { font-size:13px; font-weight:600; color:var(--ink-700-solid); min-width:140px; }
    .bk-input      { border:1.5px solid var(--border); border-radius:8px; padding:7px 12px; font-size:13px; font-family:inherit; background:var(--bg-surface); color:var(--ink-900); outline:none; transition:border-color .18s; }
    .bk-input:focus{ border-color:var(--primary); }
    .bk-toggle     { position:relative; display:inline-block; width:44px; height:24px; }
    .bk-toggle input{ opacity:0; width:0; height:0; }
    .bk-slider     { position:absolute; cursor:pointer; inset:0; background:var(--border); border-radius:24px; transition:.25s; }
    .bk-slider::before{ content:''; position:absolute; width:18px; height:18px; left:3px; bottom:3px; background:#fff; border-radius:50%; transition:.25s; }
    .bk-toggle input:checked + .bk-slider { background:var(--primary); }
    .bk-toggle input:checked + .bk-slider::before { transform:translateX(20px); }
    .bk-btn        { display:inline-flex; align-items:center; gap:7px; padding:8px 18px; border-radius:8px; font-size:13px; font-weight:700; font-family:inherit; cursor:pointer; border:none; transition:all .18s; }
    .bk-btn-primary{ background:var(--primary); color:#fff; }
    .bk-btn-primary:hover{ filter:brightness(1.1); }
    .bk-btn-primary:disabled{ opacity:.5; cursor:default; }
    .bk-btn-ghost  { background:var(--bg-surface); color:var(--ink-700-solid); border:1.5px solid var(--border); }
    .bk-btn-ghost:hover{ border-color:var(--primary); color:var(--primary); }
    .bk-btn-danger { background:rgba(239,68,68,.1); color:var(--danger); border:1.5px solid rgba(239,68,68,.3); padding:5px 10px; font-size:12px; border-radius:6px; font-family:inherit; font-weight:700; cursor:pointer; transition:all .15s; }
    .bk-btn-danger:hover{ background:var(--danger); color:#fff; }
    .bk-status-ok  { color:var(--success); font-size:12px; font-weight:700; }
    .bk-status-err { color:var(--danger);  font-size:12px; font-weight:700; }
    /* ── Backup Table ───────────────────────────────────────────────── */
    .bk-table      { width:100%; border-collapse:collapse; font-size:13px; }
    .bk-table th   { padding:9px 14px; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.4px; color:var(--ink-500); background:var(--bg-canvas); border-bottom:1px solid var(--border); text-align:left; }
    .bk-table td   { padding:11px 14px; border-bottom:1px solid var(--border-soft); vertical-align:middle; }
    .bk-table tbody tr:last-child td { border-bottom:none; }
    .bk-table tbody tr:hover td { background:rgba(59,130,246,.03); }
    .bk-empty      { text-align:center; padding:32px; color:var(--ink-400); font-size:13px; }
    .bk-actions    { display:flex; gap:6px; flex-wrap:wrap; }
    .bk-badge-file { font-family:monospace; font-size:12.5px; background:var(--bg-canvas); border:1px solid var(--border); border-radius:5px; padding:2px 8px; color:var(--ink-700-solid); }
</style>

<div class="content-area bk-panel">
    <div class="panel">
        <div class="panel-head">
            <div class="panel-title">
                <i class="fa-solid fa-database" style="color:var(--primary);margin-right:8px;"></i>
                Sao lưu &amp; Khôi phục dữ liệu
            </div>
        </div>
        <div class="st-form-container">

            <div class="bk-grid">
                <!-- Card: Cấu hình tự động -->
                <div class="bk-card">
                    <div class="bk-card-title"><i class="fa-solid fa-clock-rotate-left"></i> Sao lưu tự động</div>
                    <div class="bk-row">
                        <span class="bk-label">Bật tự động</span>
                        <label class="bk-toggle">
                            <input type="checkbox" id="bkAutoEnabled">
                            <span class="bk-slider"></span>
                        </label>
                        <span id="bkAutoLabel" style="font-size:12px;color:var(--ink-500);">Tắt</span>
                    </div>
                    <div class="bk-row">
                        <span class="bk-label">Cách mỗi (giờ)</span>
                        <input type="number" id="bkInterval" class="bk-input" style="width:90px;" min="1" max="8760" value="24">
                    </div>
                    <div class="bk-row">
                        <span class="bk-label">Giữ tối đa (file)</span>
                        <input type="number" id="bkMaxKeep" class="bk-input" style="width:90px;" min="1" max="365" value="30">
                    </div>
                    <div class="bk-row">
                        <span class="bk-label">Thư mục lưu</span>
                        <input type="text" id="bkFolder" class="bk-input" style="flex:1;min-width:180px;" placeholder="wwwroot/backups">
                    </div>
                    <div style="margin-top:6px;">
                        <button class="bk-btn bk-btn-primary" id="bkSaveCfg">
                            <i class="fa-solid fa-floppy-disk"></i> Lưu cấu hình
                        </button>
                        <span id="bkCfgMsg" style="margin-left:12px;font-size:12px;"></span>
                    </div>
                </div>

                <!-- Card: Sao lưu thủ công -->
                <div class="bk-card">
                    <div class="bk-card-title"><i class="fa-solid fa-hand-pointer"></i> Sao lưu thủ công</div>
                    <p style="font-size:13px;color:var(--ink-600);line-height:1.6;margin-bottom:18px;">
                        Tạo bản sao lưu ngay lập tức. File <code>.bak</code> được lưu vào thư mục cấu hình.
                        Quá trình thường mất vài giây đến vài phút tùy kích thước dữ liệu.
                    </p>
                    <button class="bk-btn bk-btn-primary" id="bkRunNow" style="font-size:14px;padding:10px 24px;">
                        <i class="fa-solid fa-cloud-arrow-up"></i> Sao lưu ngay
                    </button>
                    <div id="bkRunMsg" style="margin-top:14px;font-size:13px;display:none;"></div>
                </div>
            </div>

            <!-- Bảng danh sách backup -->
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px;">
                <span style="font-size:14px;font-weight:700;color:var(--ink-900);">
                    <i class="fa-solid fa-folder-open" style="color:var(--primary);margin-right:6px;"></i>
                    Danh sách bản sao lưu
                </span>
                <button class="bk-btn bk-btn-ghost" id="bkRefresh" style="padding:6px 14px;font-size:12px;">
                    <i class="fa-solid fa-arrows-rotate"></i> Làm mới
                </button>
            </div>

            <div style="border:1.5px solid var(--border);border-radius:12px;overflow:hidden;">
                <div id="bkTableWrap">
                    <div class="bk-empty"><i class="fa-solid fa-circle-notch fa-spin"></i> Đang tải...</div>
                </div>
            </div>

            <!-- Modal xác nhận khôi phục -->
            <div id="bkRestoreModal" style="display:none;position:fixed;inset:0;z-index:9999;background:rgba(10,14,26,.5);backdrop-filter:blur(3px);align-items:center;justify-content:center;">
                <div style="background:var(--bg-surface);border-radius:14px;padding:28px 30px;max-width:420px;width:90%;box-shadow:0 20px 60px rgba(0,0,0,.22);">
                    <div style="font-size:16px;font-weight:700;color:var(--danger);display:flex;align-items:center;gap:9px;margin-bottom:14px;">
                        <i class="fa-solid fa-triangle-exclamation"></i> Xác nhận khôi phục
                    </div>
                    <p style="font-size:13.5px;color:var(--ink-700-solid);line-height:1.6;margin-bottom:8px;">
                        Sẽ khôi phục database từ file:<br>
                        <strong id="bkRestoreFileName" style="font-family:monospace;color:var(--primary);"></strong>
                    </p>
                    <p style="font-size:12.5px;color:var(--danger);margin-bottom:20px;">
                        ⚠ Toàn bộ dữ liệu hiện tại sẽ bị <strong>thay thế</strong>. Web app sẽ tạm ngắt kết nối vài giây trong quá trình khôi phục.
                    </p>
                    <div style="display:flex;gap:10px;justify-content:flex-end;">
                        <button id="bkRestoreCancel" class="bk-btn bk-btn-ghost">Huỷ</button>
                        <button id="bkRestoreConfirm" class="bk-btn" style="background:var(--danger);color:#fff;">
                            <i class="fa-solid fa-rotate-left"></i> Xác nhận khôi phục
                        </button>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
(function () {
    'use strict';

    function toast(type, msg) {
        const fn = { success: toastr.success, error: toastr.error, info: toastr.info };
        (fn[type] || toastr.info).call(toastr, msg);
    }

    // ── Load config ──────────────────────────────────────────────────
    async function loadConfig() {
        try {
            const res  = await fetch('/Backup/GetStatus');
            const data = await res.json();
            document.getElementById('bkAutoEnabled').checked = !!data.autoBackupEnabled;
            document.getElementById('bkInterval').value      = data.autoBackupIntervalHours || 24;
            document.getElementById('bkMaxKeep').value       = data.maxKeepFiles || 30;
            document.getElementById('bkFolder').value        = data.folderPath || 'wwwroot/backups';
            updateAutoLabel();
        } catch(e) { console.error(e); }
    }

    function updateAutoLabel() {
        const on = document.getElementById('bkAutoEnabled').checked;
        document.getElementById('bkAutoLabel').textContent = on ? 'Bật' : 'Tắt';
    }
    document.getElementById('bkAutoEnabled').addEventListener('change', updateAutoLabel);

    // ── Save config ──────────────────────────────────────────────────
    document.getElementById('bkSaveCfg').addEventListener('click', async () => {
        const btn = document.getElementById('bkSaveCfg');
        const msg = document.getElementById('bkCfgMsg');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang lưu...';
        try {
            const res  = await fetch('/Backup/UpdateConfig', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({
                    autoBackupEnabled:       document.getElementById('bkAutoEnabled').checked,
                    autoBackupIntervalHours: parseInt(document.getElementById('bkInterval').value) || 24,
                    maxKeepFiles:            parseInt(document.getElementById('bkMaxKeep').value)  || 30,
                    folderPath:              document.getElementById('bkFolder').value.trim()
                })
            });
            const data = await res.json();
            if (data.success) {
                msg.innerHTML = '<span class="bk-status-ok"><i class="fa-solid fa-check"></i> Đã lưu</span>';
                toast('success', data.message);
            } else {
                msg.innerHTML = '<span class="bk-status-err">Lỗi: ' + data.message + '</span>';
            }
        } catch(e) {
            msg.innerHTML = '<span class="bk-status-err">Lỗi kết nối</span>';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu cấu hình';
        }
    });

    // ── Run Now ──────────────────────────────────────────────────────
    document.getElementById('bkRunNow').addEventListener('click', async () => {
        const btn = document.getElementById('bkRunNow');
        const msgEl = document.getElementById('bkRunMsg');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang sao lưu...';
        msgEl.style.display = 'none';
        try {
            const res  = await fetch('/Backup/RunNow', { method: 'POST' });
            const data = await res.json();
            msgEl.style.display = 'block';
            if (data.success) {
                msgEl.innerHTML = '<span class="bk-status-ok"><i class="fa-solid fa-check-circle"></i> ' + data.message + '</span>';
                toast('success', data.message);
                loadList();
            } else {
                msgEl.innerHTML = '<span class="bk-status-err"><i class="fa-solid fa-triangle-exclamation"></i> ' + data.message + '</span>';
                toast('error', data.message);
            }
        } catch(e) {
            msgEl.style.display = 'block';
            msgEl.innerHTML = '<span class="bk-status-err">Lỗi kết nối: ' + e.message + '</span>';
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-cloud-arrow-up"></i> Sao lưu ngay';
        }
    });

    // ── Load list ────────────────────────────────────────────────────
    async function loadList() {
        const wrap = document.getElementById('bkTableWrap');
        wrap.innerHTML = '<div class="bk-empty"><i class="fa-solid fa-circle-notch fa-spin"></i> Đang tải...</div>';
        try {
            const res  = await fetch('/Backup/GetList');
            const list = await res.json();
            if (!list.length) {
                wrap.innerHTML = '<div class="bk-empty"><i class="fa-solid fa-inbox"></i> Chưa có bản sao lưu nào.</div>';
                return;
            }
            let html = '<table class="bk-table"><thead><tr>'
                + '<th>#</th><th>Tên file</th><th>Ngày tạo</th><th>Kích thước</th><th style="width:180px;">Thao tác</th>'
                + '</tr></thead><tbody>';
            list.forEach((f, i) => {
                html += '<tr>'
                    + '<td style="color:var(--ink-400);font-size:12px;">' + (i+1) + '</td>'
                    + '<td><span class="bk-badge-file">' + esc(f.fileName) + '</span></td>'
                    + '<td style="color:var(--ink-500);font-size:12.5px;">' + esc(f.createdAt) + '</td>'
                    + '<td style="font-size:12.5px;">' + esc(f.sizeDisplay) + '</td>'
                    + '<td><div class="bk-actions">'
                    + '<a href="/Backup/Download?file=' + encodeURIComponent(f.fileName) + '" class="bk-btn bk-btn-ghost" style="padding:5px 10px;font-size:11px;" title="Tải về"><i class="fa-solid fa-download"></i></a>'
                    + '<button class="bk-btn bk-btn-ghost" style="padding:5px 10px;font-size:11px;" onclick="openRestore(\'' + esc(f.fileName) + '\')" title="Khôi phục"><i class="fa-solid fa-rotate-left" style="color:var(--primary);"></i></button>'
                    + '<button class="bk-btn bk-btn-danger" onclick="deleteFile(\'' + esc(f.fileName) + '\',this)" title="Xóa"><i class="fa-solid fa-trash"></i></button>'
                    + '</div></td></tr>';
            });
            html += '</tbody></table>';
            wrap.innerHTML = html;
        } catch(e) {
            wrap.innerHTML = '<div class="bk-empty" style="color:var(--danger);">Lỗi tải danh sách: ' + e.message + '</div>';
        }
    }

    document.getElementById('bkRefresh').addEventListener('click', loadList);

    // ── Delete file ──────────────────────────────────────────────────
    window.deleteFile = async function(fileName, btn) {
        if (!confirm('Xóa file backup "' + fileName + '"?')) return;
        btn.disabled = true;
        try {
            const res  = await fetch('/Backup/Delete?file=' + encodeURIComponent(fileName), { method: 'DELETE' });
            const data = await res.json();
            if (data.success) { toast('success', data.message); loadList(); }
            else              { toast('error', data.message); btn.disabled = false; }
        } catch(e) { toast('error', e.message); btn.disabled = false; }
    };

    // ── Restore ──────────────────────────────────────────────────────
    var pendingRestore = '';
    window.openRestore = function(fileName) {
        pendingRestore = fileName;
        document.getElementById('bkRestoreFileName').textContent = fileName;
        document.getElementById('bkRestoreModal').style.display = 'flex';
    };
    document.getElementById('bkRestoreCancel').addEventListener('click', () => {
        document.getElementById('bkRestoreModal').style.display = 'none';
    });
    document.getElementById('bkRestoreConfirm').addEventListener('click', async () => {
        const btn = document.getElementById('bkRestoreConfirm');
        btn.disabled = true;
        btn.innerHTML = '<i class="fa-solid fa-circle-notch fa-spin"></i> Đang khôi phục...';
        try {
            const res  = await fetch('/Backup/Restore', {
                method: 'POST', headers: {'Content-Type':'application/json'},
                body: JSON.stringify({ fileName: pendingRestore })
            });
            const data = await res.json();
            document.getElementById('bkRestoreModal').style.display = 'none';
            if (data.success) toast('success', data.message);
            else              toast('error', data.message);
        } catch(e) {
            toast('error', 'Lỗi kết nối: ' + e.message);
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fa-solid fa-rotate-left"></i> Xác nhận khôi phục';
        }
    });

    // ── Helper ───────────────────────────────────────────────────────
    function esc(s) {
        return String(s||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    // ── Init ─────────────────────────────────────────────────────────
    loadConfig();
    loadList();
})();
</script>

