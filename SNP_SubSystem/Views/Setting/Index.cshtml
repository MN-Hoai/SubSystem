@model SNP_SubSystem.Models.SettingsViewModel

@{
    ViewData["Title"] = "Cài đặt hệ thống";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card card-primary">
                <div class="card-header">
                    <h3 class="card-title">Cài đặt hệ thống</h3>
                </div>
                
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success m-3">
                        @TempData["SuccessMessage"]
                    </div>
                }

                <form asp-controller="Settings" asp-action="Save" method="post" enctype="multipart/form-data">
                    <div class="card-body">
                        <!-- System Title -->
                        <div class="form-group">
                            <label for="SystemTitle">Tiêu đề hệ thống (Header)</label>
                            <input type="text" class="form-control" id="SystemTitle" name="SystemTitle" value="@Model.SystemTitle" placeholder="Nhập tiêu đề hệ thống">
                        </div>

                        <!-- System Logo -->
                        <div class="form-group">
                            <label for="SystemLogoFile">Logo Hệ thống</label>
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="SystemLogoFile" name="SystemLogoFile" accept="image/*">
                                    <label class="custom-file-label" for="SystemLogoFile">Chọn file</label>
                                </div>
                            </div>
                            <div class="mt-2">
                                <p>Logo hiện tại:</p>
                                <img src="@Model.SystemLogoUrl" alt="System Logo" style="max-height: 50px; background-color: #343a40; padding: 5px;" />
                            </div>
                        </div>

                        <!-- Login Background -->
                        <div class="form-group">
                            <label for="LoginBackgroundFile">Hình nền trang Đăng nhập</label>
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="LoginBackgroundFile" name="LoginBackgroundFile" accept="image/*">
                                    <label class="custom-file-label" for="LoginBackgroundFile">Chọn file</label>
                                </div>
                            </div>
                            <div class="mt-2">
                                <p>Hình nền hiện tại:</p>
                                <img src="@Model.LoginBackgroundUrl" alt="Login Background" style="max-height: 100px;" />
                            </div>
                        </div>

                        <!-- Home Background -->
                        <div class="form-group">
                            <label for="HomeBackgroundFile">Hình nền trang Home</label>
                            <div class="input-group">
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="HomeBackgroundFile" name="HomeBackgroundFile" accept="image/*">
                                    <label class="custom-file-label" for="HomeBackgroundFile">Chọn file</label>
                                </div>
                            </div>
                            <div class="mt-2">
                                @if (!string.IsNullOrEmpty(Model.HomeBackgroundUrl))
                                {
                                    <p>Hình nền hiện tại:</p>
                                    <img src="@Model.HomeBackgroundUrl" alt="Home Background" style="max-height: 100px;" />
                                }
                                else
                                {
                                    <p class="text-muted">Chưa có hình nền (sẽ dùng màu nền mặc định)</p>
                                }
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer">
                        <button type="submit" class="btn btn-primary">Lưu cấu hình</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            // Update custom file label on select
            $('.custom-file-input').on('change', function() {
                var fileName = $(this).val().split('\\').pop();
                $(this).next('.custom-file-label').addClass("selected").html(fileName);
            });
        });
    </script>
}
