@using Sub_Services.Execute
@inject SubSystemService SubSystemService
@{
    var sysSettings = await SubSystemService.GetSystemSettingsAsync();
    var sysTitle = sysSettings?.GetValueOrDefault("SystemTitle", "") ?? "";
    if (string.IsNullOrEmpty(sysTitle)) sysTitle = "Sub_System Admin";
    var sysLogo = sysSettings?.GetValueOrDefault("SystemLogo", "") ?? "";
    var homeBg = sysSettings?.GetValueOrDefault("HomeBackground", "") ?? "";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - @Html.Raw(sysTitle)</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=Fraunces:ital,wght@0,500;0,600;1,500&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />
    <link href="~/css/main.css" rel="stylesheet" />
    <style>
        @if (ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" && 
             ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && 
             !string.IsNullOrEmpty(homeBg))
        {
            <text>
            .app-main {
                background-image: url('@homeBg');
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
            }
            </text>
        }
        /* Nav link bị khóa do không có quyền */
        .nav-item.nav-locked {
            position: relative;
            cursor: pointer !important;
        }
        .nav-item.nav-locked .label {
            opacity: 0.5;
        }
        .nav-item.nav-locked > i:first-child {
            opacity: 0.4;
        }
        .nav-item.nav-locked::after {
            content: '\f023';
            font-family: 'Font Awesome 6 Free';
            font-weight: 900;
            font-size: 9px;
            position: absolute;
            top: 7px;
            right: 10px;
            color: #94a3b8;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="app-header">
        <div class="header-left">
            <button class="burger" id="sidebarToggle" aria-label="Ẩn/mở thanh điều hướng">
                <span class="bar"><span></span><span></span><span></span></span>
            </button>
            <a asp-controller="Home" asp-action="Index" class="brand" style="text-decoration:none; color:inherit; display:flex; align-items:center; gap:8px;">
                @if (!string.IsNullOrEmpty(sysLogo))
                {
                    <img src="@sysLogo" alt="Logo" style="height: 32px; border-radius: 4px;" />
                }
                else
                {
                    <div class="brand-mark">S</div>
                }
                <div class="brand-word" style="font-size: 14px;">@Html.Raw(sysTitle)</div>
            </a>
        </div>

        <div class="header-right">
            <div class="header-divider"></div>
            @if (User.Identity != null && User.Identity.IsAuthenticated)
            {
                var fullName = User.Claims.FirstOrDefault(c => c.Type == "FullName")?.Value;
                if (string.IsNullOrWhiteSpace(fullName)) fullName = User.Identity.Name;
                var initials = !string.IsNullOrEmpty(fullName) && fullName.Length >= 2 ? fullName.Substring(0, 2).ToUpper() : "U";
                
                <div style="position: relative;">
                    <button class="user-chip" aria-label="Tài khoản" onclick="var m = document.getElementById('userMenu'); m.style.display = (m.style.display === 'block') ? 'none' : 'block';">
                        <div class="avatar">@initials</div>
                        <div class="user-meta">
                            <span class="user-name">@fullName</span>
                            <span class="user-role">@User.Identity.Name</span>
                        </div>
                        <i class="fa-solid fa-chevron-down"></i>
                    </button>
                    <div id="userMenu" style="display:none; position:absolute; top:100%; right:0; background:white; border:1px solid #e2e8f0; border-radius:8px; box-shadow:0 10px 15px -3px rgba(0,0,0,0.1); padding:8px; min-width:180px; z-index:9999; margin-top:8px;">
                        <a href="/Login/Logout" style="display:flex; align-items:center; gap:8px; padding:10px 12px; color:#ef4444; text-decoration:none; font-size:13px; font-weight:600; border-radius:6px; transition:background 0.2s;" onmouseover="this.style.background='#fef2f2'" onmouseout="this.style.background='transparent'">
                            <i class="fa-solid fa-arrow-right-from-bracket"></i> Đăng xuất
                        </a>
                    </div>
                </div>
            }
            else
            {
                <a href="/Login" style="padding:8px 16px; background:#1f3a67; color:white; text-decoration:none; border-radius:8px; font-size:13px; font-weight:600;">
                    <i class="fa-solid fa-user"></i> Đăng nhập
                </a>
            }
        </div>
    </header>

    <!-- BACKDROP -->
    <div class="backdrop" id="backdrop"></div>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-scroll">

            @{
                var currentCtrl = ViewContext.RouteData.Values["Controller"]?.ToString();
                var currentAct  = ViewContext.RouteData.Values["Action"]?.ToString();
            }

            <!-- Tổng quan -->
            <div class="nav-section">
                <div class="nav-section-label">Tổng quan</div>
                <a asp-controller="Home" asp-action="Index"
                   class="nav-item @(currentCtrl == "Home" ? "active" : "")"
                   data-tip="Trang chủ">
                    <i class="fa-solid fa-house"></i><span class="label">Trang chủ</span>
                </a>
                <a asp-controller="ProductionProgress" asp-action="LineProgress"
                   class="nav-item @(currentCtrl == "ProductionProgress" && currentAct == "LineProgress" ? "active" : "")"
                   data-tip="Tiến độ sản xuất">
                    <i class="fa-solid fa-chart-line"></i><span class="label">Tiến độ sản xuất</span>
                </a>
                <a asp-controller="ProductionDepartment" asp-action="ATDepartment"
                   class="nav-item @(currentCtrl == "ProductionDepartment" && currentAct == "ATDepartment" ? "active" : "")"
                   data-tip="Tiến độ bộ phận">
                    <i class="fa-solid fa-display"></i><span class="label">Thông tin bộ phận</span>
                </a>
            </div>

            <!-- Sản xuất -->
            <div class="nav-section">
                <div class="nav-section-label">Sản xuất</div>

                <a asp-controller="ProductionProgress" asp-action="ATProgress"
                   class="nav-item @(currentCtrl == "ProductionProgress" && currentAct == "ATProgress" ? "active" : "")"
                   data-tip="Thông tin mã hàng">
                    <i class="fa-solid fa-industry"></i>
                    <span class="label">Thông tin mã hàng</span>
                </a>
                <a asp-controller="ProductionProgress" asp-action="ProductionInfoForm"
                   class="nav-item @(currentCtrl == "ProductionProgress" && currentAct == "ProductionInfoForm" ? "active" : "")"
                   data-tip="Thêm mã hàng mới">
                    <i class="fa-solid fa-circle-plus"></i>
                    <span class="label">Thêm mã hàng</span>
                </a>
                <a asp-controller="StyleInfo" asp-action="Index"
                   class="nav-item @(currentCtrl == "StyleInfo" ? "active" : "")"
                   data-tip="Chi tiết mã hàng">
                    <i class="fa-solid fa-list-check"></i>
                    <span class="label">Chi tiết mã hàng</span>
                </a>
                <a asp-controller="ProductionDepartment" asp-action="RecordOutput"
                   class="nav-item @(currentCtrl == "ProductionDepartment" && currentAct == "RecordOutput" ? "active" : "")"
                   data-tip="Ghi sản lượng">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span class="label">Ghi sản lượng</span>
                </a>
              
            </div>

            <!-- Quản lý -->
            <div class="nav-section">
                <div class="nav-section-label">Quản lý</div>

                <a asp-controller="ProductionDepartment" asp-action="DepartmentList"
                   class="nav-item @(currentCtrl == "ProductionDepartment" && currentAct == "DepartmentList" ? "active" : "")"
                   data-tip="Quản lý bộ phận">
                    <i class="fa-solid fa-building-user"></i>
                    <span class="label">Quản lý bộ phận</span>
                </a>
                <a asp-controller="MachineLayoutDesigner" asp-action="Index"
                   class="nav-item @(currentCtrl == "MachineLayoutDesigner" ? "active" : "")"
                   data-tip="Thiết kế layout bộ phận">
                    <i class="fa-solid fa-border-all"></i>
                    <span class="label">Thiết kế layout</span>
                </a>
                <a href="/excel-monitor"
                   class="nav-item @(currentCtrl == "ExcelMonitor" ? "active" : "")"
                   data-tip="Theo dõi thay đổi file Excel">
                    <i class="fa-solid fa-file-excel"></i>
                    <span class="label">Excel Monitor</span>
                </a>
            </div>

            <!-- Quản trị -->
            <div class="nav-section">
                <div class="nav-section-label">Quản trị</div>

                <a asp-controller="Account" asp-action="Index"
                   class="nav-item @(currentCtrl == "Account" && currentAct == "Index" ? "active" : "")"
                   data-tip="Quản lý tài khoản">
                    <i class="fa-solid fa-user-shield"></i>
                    <span class="label">Quản lý tài khoản</span>
                </a>
                <a asp-controller="Role" asp-action="Index" class="nav-item" data-tip="Phân quyền truy cập (sắp ra mắt)">
                    <i class="fa-solid fa-key"></i>
                    <span class="label">Phân quyền</span>
                </a>
                <a asp-controller="Settings" asp-action="Index" class="nav-item @(currentCtrl == "Settings" ? "active" : "")" data-tip="Cài đặt hệ thống">
                    <i class="fa-solid fa-gear"></i>
                    <span class="label">Cài đặt</span>
                </a>
            </div>

        </div>

        <div class="sidebar-footer">
            <button class="collapse-toggle" id="collapseToggle">
                <i class="fa-solid fa-angles-left"></i><span>Thu gọn</span>
            </button>
        </div>
    </aside>

    <main class="app-main" id="appMain">
    @RenderBody()
    </main>

</body>
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Cấu hình toastr mặc định
    toastr.options = {
        closeButton: true,
        progressBar: true,
        positionClass: 'toast-top-right',
        timeOut: 5000,
        extendedTimeOut: 2000,
        showEasing: 'swing',
        hideEasing: 'linear',
        showMethod: 'fadeIn',
        hideMethod: 'fadeOut'
    };

    // ══ Tự động kiểm tra phiên & đá ra khi cookie không còn / hết hạn ══
    (function () {
        function redirectToLogin() {
            var returnUrl = window.location.pathname + window.location.search;
            var target = '/Login';
            if (returnUrl && returnUrl !== '/' && !returnUrl.startsWith('/Login')) {
                target += '?returnUrl=' + encodeURIComponent(returnUrl);
            }
            window.location.href = target;
        }

        // Chặn fetch toàn cục: nếu nhận HTTP 401 thì lập tức đá ra đăng nhập
        var origFetch = window.fetch;
        window.fetch = async function () {
            try {
                var response = await origFetch.apply(this, arguments);
                if (response && response.status === 401) {
                    redirectToLogin();
                }
                return response;
            } catch (err) {
                throw err;
            }
        };

        // Chặn jQuery ajax (nếu trang dùng jQuery)
        if (window.jQuery) {
            $(document).ajaxError(function (event, jqxhr) {
                if (jqxhr && jqxhr.status === 401) {
                    redirectToLogin();
                }
            });
        }

        // Khi người dùng chuyển tab quay lại (sau khi treo máy hoặc cookie hết hạn): kiểm tra ngay
        document.addEventListener('visibilitychange', function () {
            if (document.visibilityState === 'visible') {
                origFetch('/Login/CheckSession', { method: 'GET' })
                    .then(function (res) {
                        if (res.status === 401) {
                            redirectToLogin();
                        }
                    })
                    .catch(function () {});
            }
        });

        // Kiểm tra heartbeat định kỳ mỗi 5 phút
        setInterval(function () {
            origFetch('/Login/CheckSession', { method: 'GET' })
                .then(function (res) {
                    if (res.status === 401) {
                        redirectToLogin();
                    }
                })
                .catch(function () {});
        }, 5 * 60 * 1000);
    })();

    // ══ Kiểm tra quyền nav link ══════════════════════════
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        <text>
    (function() {
        fetch('/Role/MyPermissions')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                if (data.isAdmin) return; // admin — không khóa gì

                var allowedPaths = data.paths || [];

                // Kiểm tra một href có được phép không
                function isAllowed(href) {
                    if (!href || href === '#' || href === '/' || href === '') return true;
                    return allowedPaths.some(function(p) {
                        return href.startsWith(p) || p.startsWith(href);
                    });
                }

                // Hàm Swal thông báo không có quyền
                function showNoAccess() {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Không có quyền truy cập',
                        text: 'Tài khoản của bạn chưa được cấp quyền vào trang này. Vui lòng liên hệ quản trị viên.',
                        confirmButtonText: 'Đã hiểu',
                        confirmButtonColor: '#3a5fa8',
                    });
                }

                // Áp dụng cho tất cả .nav-item trong sidebar
                document.querySelectorAll('.sidebar .nav-item[href]').forEach(function(el) {
                    var href = el.getAttribute('href');
                    if (!isAllowed(href)) {
                        el.classList.add('nav-locked');
                        el.addEventListener('click', function(e) {
                            e.preventDefault();
                            showNoAccess();
                        });
                    }
                });

                // Áp dụng cho các link có data-perm-check
                document.querySelectorAll('[data-perm-check]').forEach(function(el) {
                    var href = el.getAttribute('href') || el.dataset.href;
                    if (!isAllowed(href)) {
                        el.addEventListener('click', function(e) {
                            e.preventDefault();
                            showNoAccess();
                        });
                    }
                });
            })
            .catch(function() {
                // Nếu không lấy được quyền, giữ nguyên mọi link
            });
    })();
        </text>
    }
</script>
<script src="~/js/site.js"></script>
@RenderSection("Scripts", required: false)
</html>
