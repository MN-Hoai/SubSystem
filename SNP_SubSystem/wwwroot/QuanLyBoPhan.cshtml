                <option value="">Tất cả</option>
                <option>Tổ 1</option>
                <option>Tổ 2</option>
                <option>Tổ 3</option>
                <option>Tổ 4</option>
                <option>Tổ 5</option>
            </select>
        </div>

        <!-- Dropdown lọc theo Bộ phận -->
