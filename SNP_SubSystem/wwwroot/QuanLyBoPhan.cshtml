<!-- POPUP CHI TIẾT SẢN XUẤT: hiển thị khi bấm "Xem thêm" trên thẻ bộ phận -->
<div class="modal-overlay" id="productionModal">
    <div class="modal-box">
        <div class="modal-head">
            <div>
                <div class="modal-eyebrow" id="modalDeptName">Bộ phận</div>
                <div class="modal-title" id="modalStyle">Style</div>
            </div>
            <button class="modal-close" id="modalCloseBtn" aria-label="Đóng"><i class="fa-solid fa-xmark"></i></button>
        </div>

        <div class="modal-body">
            <!-- Thông tin chung: Máy số / SP / Target / SL đạt được -->
            <div class="modal-info-grid">
                <div class="modal-info-item">
                    <span class="info-label">Máy số</span>
                    <span class="info-value" id="modalMachine">—</span>
                </div>
                <div class="modal-info-item">
                    <span class="info-label">SP#</span>
                    <span class="info-value cell-mono" id="modalSp">—</span>
                </div>
                <div class="modal-info-item">
                    <span class="info-label">Target</span>
                    <span class="info-value" id="modalTarget">—</span>
                </div>
                <div class="modal-info-item">
                    <span class="info-label">SL đạt được</span>
                    <span class="info-value" id="modalOutput">—</span>
                </div>
            </div>

            <div class="modal-progress">
                <div class="dept-progress-labels">
                    <span>Tổng tiến độ</span>
                    <span class="progress-pct" id="modalOverallPct">0%</span>
                </div>
                <div class="progress"><div class="progress-bar" id="modalOverallBar" style="width:0%;"></div></div>
            </div>

            <!-- Chi tiết: từng công đoạn hiển thị sản lượng riêng -->
            <div class="modal-detail-title">Chi tiết</div>
            <div class="modal-detail-list" id="modalDetailList">
                <!-- Được render động bằng JS từ data-details của thẻ bộ phận -->
            </div>
        </div>
    </div>
</div>

<style>
    /* ===== Lưới thẻ bộ phận: 4 khối một hàng ===== */
    .dept-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }
  
    .dept-card {
        background: var(--panel-bg, #fff);
        border: 1px solid var(--border, #e6e8ec);
        border-radius: 12px;
        padding: 16px;
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .dept-card-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 8px;
    }
    .dept-card-title { display: flex; align-items: center; gap: 10px; }
    .dept-icon {
        width: 36px; height: 36px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        border-radius: 9px;
        background: var(--accent-navy-10, rgba(20,40,80,.08));
        color: var(--accent-navy, #14285a);
        font-size: 14px;
    }
    .dept-name { font-weight: 600; font-size: 14px; }
    .dept-sub { font-size: 12px; color: var(--text-muted, #8a8f98); margin-top: 2px; }

    .dept-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
        font-size: 13px;
    }
    .dept-info-item { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
    .info-label { font-size: 11px; color: var(--text-muted, #8a8f98); }
    .info-value { font-weight: 500; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .dept-progress-labels {
        display: flex; justify-content: space-between; align-items: baseline;
        font-size: 12px; color: var(--text-muted, #8a8f98); margin-bottom: 6px;
    }
    .progress-pct { font-weight: 600; color: var(--text, #1b1f27); }

    .dept-detail-preview {
        border-top: 1px dashed var(--border, #e6e8ec);
        padding-top: 10px;
    }
    .dept-detail-title { font-size: 12px; font-weight: 600; margin-bottom: 6px; color: var(--text-muted, #8a8f98); }
    .detail-mini-row {
        display: flex; justify-content: space-between;
        font-size: 12.5px; padding: 3px 0;
    }
    .mini-pct { font-weight: 600; }

    .btn-view-more { width: 100%; justify-content: center; margin-top: 2px; }

    /* ===== Popup chi tiết sản xuất ===== */
    .modal-overlay {
        display: none;
        position: fixed; inset: 0;
        background: rgba(15, 18, 25, .45);
        align-items: center; justify-content: center;
        z-index: 1000;
        padding: 16px;
    }
    .modal-overlay.open { display: flex; }

    .modal-box {
        background: #fff;
        border-radius: 14px;
        width: 100%; max-width: 480px;
        max-height: 88vh;
        display: flex; flex-direction: column;
        overflow: hidden;
        box-shadow: 0 20px 50px rgba(0,0,0,.25);
    }
    .modal-head {
        display: flex; align-items: flex-start; justify-content: space-between;
        padding: 18px 20px; border-bottom: 1px solid var(--border, #e6e8ec);
    }
    .modal-eyebrow { font-size: 12px; color: var(--text-muted, #8a8f98); text-transform: uppercase; letter-spacing: .03em; }
    .modal-title { font-size: 17px; font-weight: 600; margin-top: 2px; }
    .modal-close {
        border: none; background: var(--surface-2, #f2f3f5);
        width: 32px; height: 32px; border-radius: 8px;
        display: flex; align-items: center; justify-content: center;
        cursor: pointer; color: var(--text-muted, #8a8f98);
        flex-shrink: 0;
    }
    .modal-close:hover { background: var(--surface-3, #e6e8ec); }

    .modal-body { padding: 18px 20px 20px; overflow-y: auto; }

    .modal-info-grid {
        display: grid; grid-template-columns: 1fr 1fr;
        gap: 12px 16px;
        background: var(--surface-2, #f7f8fa);
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 16px;
    }
    .modal-info-item { display: flex; flex-direction: column; gap: 3px; }
    .modal-info-item .info-value { font-size: 14px; }

    .modal-progress { margin-bottom: 18px; }

    .modal-detail-title { font-size: 13px; font-weight: 600; margin-bottom: 10px; }

    .modal-detail-list { display: flex; flex-direction: column; gap: 12px; }
    .modal-detail-row {
        border: 1px solid var(--border, #e6e8ec);
        border-radius: 10px;
        padding: 10px 12px;
    }
    .modal-detail-row-top {
        display: flex; justify-content: space-between; align-items: baseline;
        font-size: 13px; margin-bottom: 6px;
    }
    .modal-detail-row-top .name { font-weight: 500; }
    .modal-detail-row-top .qty { color: var(--text-muted, #8a8f98); font-size: 12.5px; }
</style>

<script>
    (function () {
        var modal = document.getElementById('productionModal');
        var closeBtn = document.getElementById('modalCloseBtn');

        // Định dạng số theo kiểu Việt Nam: 1.234
        function formatNumber(n) {
            return Number(n).toLocaleString('vi-VN');
        }

        // Mở popup và đổ dữ liệu từ data-* của thẻ bộ phận được bấm "Xem thêm"
        function openModalFromCard(card) {
            var dept = card.dataset.dept || '';
            var machine = card.dataset.machine || '';
            var style = card.dataset.style || '';
            var sp = card.dataset.sp || '';
            var target = parseFloat((card.dataset.target || '0').replace(/\./g, '').replace(',', '.')) || 0;
            var output = parseFloat((card.dataset.output || '0').replace(/\./g, '').replace(',', '.')) || 0;
            var details = [];
            try { details = JSON.parse(card.dataset.details || '[]'); } catch (e) { details = []; }

            document.getElementById('modalDeptName').textContent = dept;
            document.getElementById('modalStyle').textContent = style;
            document.getElementById('modalMachine').textContent = machine;
            document.getElementById('modalSp').textContent = sp;
            document.getElementById('modalTarget').textContent = formatNumber(target);
            document.getElementById('modalOutput').textContent = formatNumber(output);

            var overallPct = target > 0 ? Math.round((output / target) * 100) : 0;
            document.getElementById('modalOverallPct').textContent = overallPct + '%';
            var overallBar = document.getElementById('modalOverallBar');
            overallBar.style.width = overallPct + '%';
            overallBar.style.background = overallPct >= 100 ? 'var(--accent-navy)' : (overallPct >= 60 ? 'var(--success)' : (overallPct >= 35 ? 'var(--accent-gold)' : 'var(--danger)'));

            // Render danh sách chi tiết, mỗi chi tiết có sản lượng riêng
            var list = document.getElementById('modalDetailList');
            list.innerHTML = '';
            details.forEach(function (item) {
                var pct = item.target > 0 ? Math.round((item.output / item.target) * 100) : 0;
                var color = pct >= 100 ? 'var(--accent-navy)' : (pct >= 60 ? 'var(--success)' : (pct >= 35 ? 'var(--accent-gold)' : 'var(--danger)'));

                var row = document.createElement('div');
                row.className = 'modal-detail-row';
                row.innerHTML =
                    '<div class="modal-detail-row-top">' +
                        '<span class="name">' + item.name + '</span>' +
                        '<span class="qty">' + formatNumber(item.output) + ' / ' + formatNumber(item.target) + '</span>' +
                    '</div>' +
                    '<div class="progress"><div class="progress-bar" style="width:' + pct + '%; background:' + color + ';"></div></div>';
                list.appendChild(row);
            });

            modal.classList.add('open');
        }

        document.querySelectorAll('.btn-view-more').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var card = btn.closest('.dept-card');
                if (card) openModalFromCard(card);
            });
        });

        function closeModal() { modal.classList.remove('open'); }

        closeBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', function (e) {
            if (e.target === modal) closeModal();
        });
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeModal();
        });
    })();
</script>
