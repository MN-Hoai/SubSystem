        <div class="page-actions">
            <button class="btn btn-ghost"><i class="fa-solid fa-download"></i>Xuất báo cáo</button>
            <button class="btn btn-primary"><i class="fa-solid fa-plus"></i>Thêm bộ phận</button>
        </div>
    </div>

