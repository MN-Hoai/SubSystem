@{
    ViewData["Title"] = "Tiến độ sản xuất";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var today = DateTime.Today.ToString("yyyy-MM-dd");
    var yesterday = DateTime.Today.AddDays(-1).ToString("yyyy-MM-dd");
}

<!-- Chart.js + DataLabels CDN -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0/dist/chartjs-plugin-datalabels.min.js"></script>

<style>
/* ── PAGE ───────────────────────────────────────────────────── */
.lp-page { padding:22px; display:flex; flex-direction:column; gap:18px; }

/* ── HERO BAR ─────────────────────────────────────────────── */
.lp-topbar { display:flex; align-items:center; gap:14px; flex-wrap:wrap; }
.lp-icon { width:44px; height:44px; border-radius:12px; flex-shrink:0;
    background:linear-gradient(135deg,#1f3a67,#3a5fa8); color:#fff;
    display:flex; align-items:center; justify-content:center; font-size:18px;
    box-shadow:0 4px 14px rgba(31,58,103,.3); }
.lp-title { font-size:22px; font-weight:800; color:var(--ink-900); }
.lp-sub { font-size:12px; color:var(--ink-400); margin-top:2px; }

/* ── FILTER BAR ────────────────────────────────────────────── */
.lp-filter-bar { display:flex; align-items:center; gap:10px; flex-wrap:wrap;
    background:var(--bg-surface); border:1px solid var(--border); border-radius:12px; padding:12px 16px; }
.lp-filter-label { font-size:12px; font-weight:700; color:var(--ink-500); white-space:nowrap; }
.lp-filter-sep { font-size:13px; color:var(--ink-300); font-weight:700; }
.lp-date-input { padding:7px 11px; border:1.5px solid var(--border); border-radius:8px; font-size:13px;
    color:var(--ink-900); background:var(--bg-surface); outline:none; font-family:inherit; cursor:pointer; transition:border-color .18s; }
.lp-date-input:focus { border-color:var(--accent-navy); box-shadow:0 0 0 3px rgba(31,58,103,.1); }
.lp-quick-btns { display:flex; gap:6px; margin-left:auto; flex-wrap:wrap; }
.lp-q-btn { padding:7px 13px; border-radius:8px; font-size:12.5px; font-weight:700; cursor:pointer;
    border:1.5px solid var(--border); background:var(--bg-surface); color:var(--ink-600);
    transition:background .14s,border-color .14s; font-family:inherit; }
.lp-q-btn:hover { background:rgba(31,58,103,.08); border-color:var(--accent-navy); color:var(--accent-navy); }
.lp-q-btn.active,
.lp-q-btn.primary { background:linear-gradient(135deg,#1f3a67,#3a5fa8); color:#fff; border-color:transparent; }
.lp-q-btn.primary:hover { opacity:.9; }
.lp-search-btn { padding:7px 14px; border-radius:8px; font-size:13px; font-weight:700; cursor:pointer;
    border:none; background:linear-gradient(135deg,#1f3a67,#3a5fa8); color:#fff; font-family:inherit;
    display:flex; align-items:center; gap:6px; transition:opacity .14s; }
.lp-search-btn:hover { opacity:.88; }

/* ── PANEL ─────────────────────────────────────────────────── */
.lp-panel { position:relative; background:var(--bg-surface); border:1px solid var(--border); border-radius:14px; overflow:hidden; }
.lp-panel-head { display:flex; align-items:center; justify-content:space-between; padding:14px 20px;
    border-bottom:1px solid var(--border-soft); gap:10px; flex-wrap:wrap; }
.lp-panel-title { font-size:14px; font-weight:700; color:var(--ink-900); display:flex; align-items:center; gap:8px; }
.lp-period-badge { font-size:11.5px; font-weight:600; color:var(--ink-400); background:rgba(31,58,103,.08);
    padding:3px 10px; border-radius:6px; }

/* ── LOADING OVERLAY ──────────────────────────────────────── */
.lp-loading { display:none; position:absolute; inset:0; z-index:200; background:rgba(255,255,255,.78);
    backdrop-filter:blur(2px); align-items:center; justify-content:center; border-radius:14px;
    flex-direction:column; gap:10px; }
.lp-loading.active { display:flex !important; }
.lp-loading i { font-size:28px; color:var(--accent-navy); }
.lp-loading span { font-size:13px; font-weight:600; color:var(--ink-500); }

/* ── OVERVIEW CHART ────────────────────────────────────────── */
.lp-chart-scroll { overflow-x:auto; padding:20px 20px 10px; }
.lp-chart-wrap { position:relative; height:340px; }

/* ── EMPTY STATE ───────────────────────────────────────────── */
.lp-empty { text-align:center; padding:52px 20px; }
.lp-empty i { font-size:44px; color:var(--border); display:block; margin-bottom:12px; }
.lp-empty p { font-size:14px; font-weight:600; color:var(--ink-400); }

/* ── DETAIL GRID ────────────────────────────────────────────── */
.lp-detail { display:grid; grid-template-columns:1fr 1fr; gap:16px; padding:16px 20px; }
@@media (max-width:960px) { .lp-detail { grid-template-columns:1fr; } }

.lp-card { background:var(--bg-surface); border:1.5px solid var(--border); border-radius:12px; overflow:hidden; }
.lp-card-head { display:flex; align-items:center; justify-content:space-between;
    padding:12px 16px; border-bottom:1px solid var(--border-soft); gap:8px; }
.lp-card-title { font-size:13px; font-weight:700; color:var(--ink-900); display:flex; align-items:center; gap:7px; }
.lp-card-body { padding:16px; }

/* KPI summary row */
.lp-kpi-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:12px; }
.lp-kpi { background:var(--bg-canvas); border:1.5px solid var(--border); border-radius:9px; padding:11px 14px; }
.lp-kpi-lbl { font-size:10px; font-weight:700; color:var(--ink-400); text-transform:uppercase; letter-spacing:.4px; }
.lp-kpi-val { font-size:20px; font-weight:800; color:var(--ink-900); margin-top:3px; }
.lp-kpi-pct { font-size:12px; font-weight:700; margin-left:4px; }

/* Progress bar */
.lp-prog { height:7px; background:var(--border-soft); border-radius:4px; overflow:hidden; margin-bottom:12px; }
.lp-prog-fill { height:100%; border-radius:4px; transition:width .5s ease; }

/* Color helpers */
.c-ok   { color:#10b981 !important; }
.c-warn { color:#d97706 !important; }
.c-low  { color:#ef4444 !important; }

/* Detail chart canvas area */
.lp-chart-area { position:relative; height:220px; }
.lp-chart-area-sm { position:relative; height:190px; }

/* Dept select */
.lp-dept-sel { padding:6px 10px; border:1.5px solid var(--border); border-radius:7px; font-size:12.5px;
    color:var(--ink-700-solid); background:var(--bg-surface); outline:none; cursor:pointer; font-family:inherit; }
.lp-dept-sel:focus { border-color:var(--accent-navy); }

/* Line table */
.lp-tbl { width:100%; border-collapse:collapse; font-size:12px; margin-top:14px; }
.lp-tbl thead th { padding:7px 9px; text-align:left; font-size:10px; font-weight:700; text-transform:uppercase;
    letter-spacing:.3px; color:var(--ink-400); border-bottom:2px solid var(--border); background:#f8f9fc; }
.lp-tbl tbody td { padding:8px 9px; border-bottom:1px solid var(--border-soft); color:var(--ink-700-solid); }
.lp-tbl tbody tr:last-child td { border-bottom:none; }
.lp-tbl tbody tr:hover { background:rgba(31,58,103,.04); }
.lp-dot { display:inline-block; width:8px; height:8px; border-radius:2px; margin-right:5px; vertical-align:middle; }
.lp-mono { font-family:'Courier New',monospace; font-weight:800; color:var(--accent-navy); }
.lp-mini-prog { height:5px; background:var(--border-soft); border-radius:3px; overflow:hidden; min-width:50px; }
.lp-mini-fill { height:100%; border-radius:3px; }
</style>

<div class="lp-page">

    <!-- HERO -->
    <div class="lp-topbar">
        <div class="lp-icon"><i class="fa-solid fa-chart-line"></i></div>
        <div>
            <div class="lp-title">Tiến độ sản xuất</div>
            <div class="lp-sub">Thống kê sản lượng theo bộ phận và tổ — dựa trên DailyOutput thực tế</div>
        </div>
    </div>

    <!-- FILTER BAR -->
    <div class="lp-filter-bar">
        <span class="lp-filter-label"><i class="fa-solid fa-calendar-range"></i> Từ ngày</span>
        <input type="date" class="lp-date-input" id="lpFrom" value="@today">
        <span class="lp-filter-sep">→</span>
        <span class="lp-filter-label">Đến ngày</span>
        <input type="date" class="lp-date-input" id="lpTo" value="@today">
        <button class="lp-search-btn" id="btnSearch"><i class="fa-solid fa-magnifying-glass"></i> Xem</button>
        <div class="lp-quick-btns">
            <button class="lp-q-btn" id="btnPrevDay"><i class="fa-solid fa-chevron-left"></i> Hôm trước</button>
            <button class="lp-q-btn primary" id="btnToday">Hôm nay</button>
            <button class="lp-q-btn" id="btnThisWeek">Tuần này</button>
            <button class="lp-q-btn" id="btnThisMonth">Tháng này</button>
        </div>
    </div>

    <!-- OVERVIEW CHART PANEL -->
    <div class="lp-panel" id="chartPanel">
        <div class="lp-loading" id="chartLoading">
            <i class="fa-solid fa-circle-notch fa-spin"></i>
            <span>Đang tải biểu đồ...</span>
        </div>
        <div class="lp-panel-head">
            <div class="lp-panel-title">
                <i class="fa-solid fa-chart-column" style="color:var(--accent-navy);"></i>
                Biểu đồ tổng hợp theo bộ phận
            </div>
            <div class="lp-period-badge" id="overviewPeriod">—</div>
        </div>
        <div class="lp-chart-scroll">
            <div class="lp-chart-wrap" id="overviewWrap">
                <canvas id="overviewChart"></canvas>
            </div>
        </div>
        <div class="lp-empty" id="chartEmpty" style="display:none;">
            <i class="fa-solid fa-chart-column"></i>
            <p>Không có sản lượng nào được ghi nhận trong khoảng thời gian này</p>
        </div>
    </div>

    <!-- DETAIL PANEL -->
    <div class="lp-panel" id="detailPanel">
        <div class="lp-loading" id="detailLoading">
            <i class="fa-solid fa-circle-notch fa-spin"></i>
            <span>Đang tải chi tiết...</span>
        </div>
        <div class="lp-panel-head">
            <div class="lp-panel-title">
                <i class="fa-solid fa-table-list" style="color:var(--accent-navy);"></i>
                Tổng hợp chi tiết theo tổ
            </div>
            <div style="display:flex;align-items:center;gap:10px;">
                <span class="lp-period-badge" id="detailPeriod">—</span>
                <select class="lp-dept-sel" id="detailDeptSel">
                    <option value="">-- Chọn bộ phận --</option>
                </select>
            </div>
        </div>
        <div id="detailInner">
            <div class="lp-detail" id="detailGrid"></div>
        </div>
        <div class="lp-empty" id="detailEmpty" style="display:none;">
            <i class="fa-solid fa-table-list"></i>
            <p>Không có dữ liệu cho bộ phận đã chọn</p>
        </div>
    </div>

</div>

<script>
(function () {
    'use strict';

    // ── Color palette ─────────────────────────────────────────
    var CLRS = [
        '#3b82f6','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899',
        '#06b6d4','#84cc16','#f97316','#6366f1','#14b8a6','#e11d48',
        '#a855f7','#0ea5e9','#22c55e','#eab308','#dc2626','#7c3aed'
    ];
    function clr(i)       { return CLRS[i % CLRS.length]; }
    function clrA(hex, a) {
        var r=parseInt(hex.slice(1,3),16),g=parseInt(hex.slice(3,5),16),b=parseInt(hex.slice(5,7),16);
        return 'rgba('+r+','+g+','+b+','+a+')';
    }

    // ── State ─────────────────────────────────────────────────
    var currentData   = null;
    var overviewChart = null;
    var barChart      = null;
    var doughnut      = null;
    var lineColorMap  = {};
    var allLines      = [];

    // ── DOM ───────────────────────────────────────────────────
    var elFrom       = document.getElementById('lpFrom');
    var elTo         = document.getElementById('lpTo');
    var btnSearch    = document.getElementById('btnSearch');
    var btnPrev      = document.getElementById('btnPrevDay');
    var btnTodayBtn  = document.getElementById('btnToday');
    var btnWeek      = document.getElementById('btnThisWeek');
    var btnMonth     = document.getElementById('btnThisMonth');
    var chartLoading = document.getElementById('chartLoading');
    var detailLoading= document.getElementById('detailLoading');
    var overviewWrap = document.getElementById('overviewWrap');
    var overviewPer  = document.getElementById('overviewPeriod');
    var detailPer    = document.getElementById('detailPeriod');
    var chartEmpty   = document.getElementById('chartEmpty');
    var detailDeptSel= document.getElementById('detailDeptSel');
    var detailGrid   = document.getElementById('detailGrid');
    var detailEmpty  = document.getElementById('detailEmpty');

    // ── Helpers ───────────────────────────────────────────────
    function fmt(n)     { return n==null ? '—' : Number(n).toLocaleString('vi-VN'); }
    function pctC(p)    { return p>=80 ? 'c-ok' : p>=50 ? 'c-warn' : 'c-low'; }
    function pctCol(p)  { return p>=80 ? '#10b981' : p>=50 ? '#d97706' : '#ef4444'; }
    function esc(s)     { return String(s??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
    function fmtVN(iso) {
        if (!iso) return '—';
        var p=iso.split('-'); return p[2]+'/'+p[1]+'/'+p[0];
    }
    function addD(str, n) {
        var d=new Date(str); d.setDate(d.getDate()+n);
        return d.toISOString().split('T')[0];
    }
    function isoToday() { return new Date().toISOString().split('T')[0]; }
    function isoMonday() {
        var d=new Date(), day=d.getDay(), diff=d.getDate()-day+(day===0?-6:1);
        d.setDate(diff); return d.toISOString().split('T')[0];
    }
    function isoMonthStart() {
        var d=new Date(); d.setDate(1); return d.toISOString().split('T')[0];
    }
    function periodLabel(from, to) {
        return from === to ? fmtVN(from) : fmtVN(from) + ' → ' + fmtVN(to);
    }

    // ── Load ──────────────────────────────────────────────────
    function loadData() {
        var from = elFrom.value, to = elTo.value;
        if (!from || !to) return;
        if (from > to) { elTo.value = from; to = from; }

        chartLoading.classList.add('active');
        detailLoading.classList.add('active');
        chartEmpty.style.display = 'none';
        detailEmpty.style.display = 'none';

        fetch('/ProductionProgress/GetLineProgressData?from=' + from + '&to=' + to)
            .then(function(r) { return r.json(); })
            .then(function(data) {
                currentData = data;
                buildColorMap(data);
                var label = periodLabel(data.fromDate, data.toDate);
                overviewPer.textContent = label;
                detailPer.textContent   = label;
                chartLoading.classList.remove('active');
                detailLoading.classList.remove('active');
                renderOverview(data);
                populateDeptSel(data);
                var sel = detailDeptSel.value;
                if (!sel && data.departments && data.departments.length > 0)
                    detailDeptSel.value = data.departments[0].departmentId;
                renderDetail(data, detailDeptSel.value);
            })
            .catch(function(err) {
                chartLoading.classList.remove('active');
                detailLoading.classList.remove('active');
                toastr.error('Lỗi tải dữ liệu: ' + err.message);
            });
    }

    // ── Color map ─────────────────────────────────────────────
    function buildColorMap(data) {
        var s = {};
        (data.departments||[]).forEach(function(d) {
            (d.lines||[]).forEach(function(l){ s[l.line]=true; });
        });
        allLines = Object.keys(s).sort(function(a,b) {
            var na = a==='63'?43.5:parseFloat(a)||999;
            var nb = b==='63'?43.5:parseFloat(b)||999;
            return na-nb;
        });
        lineColorMap = {};
        allLines.forEach(function(n,i){ lineColorMap[n]=clr(i); });
    }

    // ── Overview bar chart ────────────────────────────────────
    function renderOverview(data) {
        var depts = data.departments || [];
        if (!depts.length) {
            chartEmpty.style.display = '';
            overviewWrap.style.display = 'none';
            if (overviewChart) { overviewChart.destroy(); overviewChart = null; }
            return;
        }
        chartEmpty.style.display = 'none';
        overviewWrap.style.display = '';

        var labels = depts.map(function(d){ return d.departmentName; });
        var minW   = Math.max(520, depts.length * 200);
        overviewWrap.style.minWidth = minW + 'px';

        // Stacked datasets: một dataset per Line (cho SL kỳ)
        // Grouped: SL kỳ (stacked) | Target (single bar) | Tổng SL tích lũy (single bar)
        var lineDatasets = allLines.map(function(lineName) {
            return {
                label: 'Tổ ' + lineName,
                data: depts.map(function(d) {
                    var l = (d.lines||[]).find(function(x){ return x.line===lineName; });
                    return l ? l.todayOutput : 0;
                }),
                backgroundColor: clrA(lineColorMap[lineName]||'#999', 0.85),
                borderColor:     lineColorMap[lineName]||'#999',
                borderWidth: 1.5,
                borderRadius: 4,
                stack: 'sl',
                order: 2
            };
        });

        var dsTarget = {
            label: 'Target kỳ',
            data: depts.map(function(d){ return d.totalTarget; }),
            backgroundColor: 'rgba(245,158,11,0.25)',
            borderColor: '#f59e0b',
            borderWidth: 2,
            borderRadius: 6,
            stack: 'tg',
            order: 1
        };
        var dsTotalSL = {
            label: 'Tổng SL tích lũy',
            data: depts.map(function(d){ return d.totalTotalOutput; }),
            backgroundColor: 'rgba(16,185,129,0.25)',
            borderColor: '#10b981',
            borderWidth: 2,
            borderRadius: 6,
            stack: 'tot',
            order: 0,
            type: 'bar'
        };
        var dsTotalQtyFixed = {
            label: 'Tổng Qty (đơn hàng)',
            data: depts.map(function(d){ return d.totalQtyFixed; }),
            backgroundColor: 'rgba(99,102,241,0.18)',
            borderColor: '#6366f1',
            borderWidth: 2,
            borderRadius: 6,
            stack: 'qty',
            order: 3,
            type: 'bar'
        };

        var datasets = lineDatasets.concat([dsTarget, dsTotalSL, dsTotalQtyFixed]);

        if (overviewChart) overviewChart.destroy();
        overviewChart = new Chart(document.getElementById('overviewChart'), {
            type: 'bar',
            data: { labels: labels, datasets: datasets },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: {
                        position: 'bottom',
                        labels: { usePointStyle:true, pointStyle:'rectRounded', padding:14,
                            font:{ size:11.5, weight:'600', family:'Manrope' } }
                    },
                    tooltip: {
                        backgroundColor: 'rgba(15,23,42,.92)',
                        titleFont: { size:13, weight:'700', family:'Manrope' },
                        bodyFont: { size:11.5, family:'Manrope' },
                        padding: 12, cornerRadius: 9,
                        callbacks: {
                            title: function(items) {
                                var dept = depts[items[0].dataIndex];
                                var cp = dept.totalQtyFixed > 0
                                    ? Math.round(dept.totalTotalOutput / dept.totalQtyFixed * 100) : 0;
                                return dept.departmentName
                                    + ' — SL kỳ: ' + fmt(dept.totalTodayOutput) + '/' + fmt(dept.totalTarget)
                                    + ' (' + dept.todayOutputPct + '%)'
                                    + ' | ĐH: ' + fmt(dept.totalTotalOutput) + '/' + fmt(dept.totalQtyFixed)
                                    + ' (' + cp + '%)';
                            },
                            label: function(ctx) {
                                if (ctx.raw === 0) return null;
                                return ctx.dataset.label + ': ' + fmt(ctx.raw);
                            }
                        }
                    },
                    datalabels: {
                        display: function(ctx) {
                            // Chỉ hiện label tổng SL kỳ (dataset cuối cùng của stack SL)
                            if (ctx.dataset.stack !== 'sl') return false;
                            var isLastLine = ctx.datasetIndex === lineDatasets.length - 1;
                            return isLastLine && ctx.dataset.data[ctx.dataIndex] > 0;
                        },
                        anchor: 'end', align: 'top',
                        font: { size:10, weight:'700', family:'Manrope' },
                        color: '#334155',
                        formatter: function(val, ctx) {
                            var d = depts[ctx.dataIndex];
                            return fmt(d.totalTodayOutput) + '\n' + d.todayOutputPct + '%';
                        }
                    }
                },
                scales: {
                    x: {
                        stacked: true,
                        grid: { display: false },
                        ticks: { font:{ size:12, weight:'700', family:'Manrope' }, color:'#334155' }
                    },
                    y: {
                        stacked: false,
                        beginAtZero: true,
                        grid: { color:'rgba(0,0,0,.06)' },
                        ticks: { font:{ size:10.5, family:'Manrope' }, color:'#94a3b8',
                            callback: function(v){ return fmt(v); } }
                    }
                }
            },
            plugins: [ChartDataLabels]
        });
    }

    // ── Populate dept select ──────────────────────────────────
    function populateDeptSel(data) {
        var prev = detailDeptSel.value;
        while (detailDeptSel.options.length > 1) detailDeptSel.remove(1);
        (data.departments||[]).forEach(function(d) {
            var o = document.createElement('option');
            o.value = d.departmentId;
            o.textContent = d.departmentName;
            detailDeptSel.appendChild(o);
        });
        if (prev) detailDeptSel.value = prev;
        if (!detailDeptSel.value && data.departments && data.departments.length > 0)
            detailDeptSel.value = data.departments[0].departmentId;
    }

    // ── Detail section ────────────────────────────────────────
    function renderDetail(data, deptId) {
        var depts = data.departments || [];
        var dept  = deptId ? depts.find(function(d){ return d.departmentId===deptId; }) : depts[0];
        if (!dept) {
            detailGrid.innerHTML = '';
            detailEmpty.style.display = '';
            detailGrid.parentElement.style.display = 'none';
            return;
        }
        detailEmpty.style.display = 'none';
        detailGrid.parentElement.style.display = '';

        var lines = dept.lines || [];
        var dp    = dept.todayOutputPct || 0;
        var compPct = dept.totalQtyFixed > 0
            ? Math.round(dept.totalTotalOutput / dept.totalQtyFixed * 100) : 0;

        var html = '';

        // ── LEFT: KPI + Bar chart (SL kỳ vs Target per line) ──
        html += '<div class="lp-card">';
        html += '<div class="lp-card-head">';
        html += '<div class="lp-card-title"><i class="fa-solid fa-gauge-high" style="color:var(--accent-navy);"></i> ' + esc(dept.departmentName) + ' — Sản lượng kỳ</div>';
        html += '</div><div class="lp-card-body">';

        // KPI 3 cột: Target kỳ, SL kỳ, Tổng ĐH
        html += '<div class="lp-kpi-row" style="grid-template-columns:1fr 1fr 1fr;">';
        html += '<div class="lp-kpi"><div class="lp-kpi-lbl">Target kỳ</div>';
        html += '<div class="lp-kpi-val">' + fmt(dept.totalTarget) + '</div></div>';
        html += '<div class="lp-kpi"><div class="lp-kpi-lbl">Sản lượng đạt</div>';
        html += '<div class="lp-kpi-val">' + fmt(dept.totalTodayOutput);
        html += '<span class="lp-kpi-pct ' + pctC(dp) + '">' + dp + '%</span></div></div>';
        html += '<div class="lp-kpi"><div class="lp-kpi-lbl">Tổng ĐH (cố định)</div>';
        html += '<div class="lp-kpi-val" style="font-size:16px;">' + fmt(dept.totalQtyFixed);
        html += '<span class="lp-kpi-pct ' + pctC(compPct) + '">' + compPct + '%</span></div></div>';
        html += '</div>';

        html += '<div class="lp-prog"><div class="lp-prog-fill" style="width:' + Math.min(dp,100) + '%;background:' + pctCol(dp) + ';"></div></div>';
        html += '<div class="lp-chart-area"><canvas id="detailBarCanvas"></canvas></div>';
        html += '</div></div>'; // card-body + card

        // ── RIGHT: Doughnut (tổng SL) + table ─────────────────
        html += '<div class="lp-card">';
        html += '<div class="lp-card-head">';
        html += '<div class="lp-card-title"><i class="fa-solid fa-circle-half-stroke" style="color:var(--accent-navy);"></i> Phân bổ sản lượng tích lũy</div>';
        html += '<div style="font-size:11px;color:var(--ink-400);font-weight:600;">';
        html += fmt(dept.totalTotalOutput) + '/' + fmt(dept.totalQtyFixed) + ' <span class="' + pctC(compPct) + '">(' + compPct + '%)</span>';
        html += '</div></div>';
        html += '<div class="lp-card-body">';
        html += '<div class="lp-chart-area-sm"><canvas id="detailDoughnutCanvas"></canvas></div>';

        html += '<table class="lp-tbl"><thead><tr>';
        html += '<th>Tổ</th><th>SL Kỳ</th><th>Target kỳ</th><th>% Kỳ</th><th>Tổng SL</th><th>Tổng Qty</th><th>%HT</th>';
        html += '</tr></thead><tbody>';
        if (!lines.length) {
            html += '<tr><td colspan="7" style="text-align:center;color:var(--ink-400);padding:14px;">Chưa có dữ liệu</td></tr>';
        }
        lines.forEach(function(l) {
            var dp2 = l.todayOutputPct || 0;
            var cp2 = l.completionPct  || 0;
            html += '<tr>';
            html += '<td><span class="lp-dot" style="background:' + (lineColorMap[l.line]||'#999') + ';"></span><span class="lp-mono">' + esc(l.line) + '</span></td>';
            html += '<td style="font-weight:700;">' + fmt(l.todayOutput) + '</td>';
            html += '<td>' + fmt(l.target) + '</td>';
            html += '<td><span class="' + pctC(dp2) + '">' + dp2 + '%</span></td>';
            html += '<td style="font-weight:700;color:var(--accent-navy);">' + fmt(l.totalOutput) + '</td>';
            html += '<td style="color:var(--ink-500);">' + fmt(l.totalQtyFixed) + '</td>';
            html += '<td>';
            html += '<div style="display:flex;align-items:center;gap:6px;">';
            html += '<div class="lp-mini-prog" style="flex:1;"><div class="lp-mini-fill" style="width:' + Math.min(cp2,100) + '%;background:' + pctCol(cp2) + ';"></div></div>';
            html += '<span class="' + pctC(cp2) + '" style="font-weight:700;min-width:34px;text-align:right;">' + cp2 + '%</span>';
            html += '</div></td>';
            html += '</tr>';
        });
        html += '</tbody></table>';
        html += '</div></div>'; // card-body + card

        detailGrid.innerHTML = html;
        renderDetailBar(lines);
        renderDetailDoughnut(lines, dept);
    }

    function renderDetailBar(lines) {
        var canvas = document.getElementById('detailBarCanvas');
        if (!canvas || barChart && !lines) return;
        if (barChart) barChart.destroy();

        var labels = lines.map(function(l){ return 'Tổ ' + l.line; });
        var colors = lines.map(function(l){ return lineColorMap[l.line]||'#999'; });

        barChart = new Chart(canvas, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    {
                        label: 'Sản lượng kỳ',
                        data: lines.map(function(l){ return l.todayOutput; }),
                        backgroundColor: colors.map(function(c){ return clrA(c, 0.82); }),
                        borderColor: colors,
                        borderWidth: 1.5,
                        borderRadius: 6,
                        borderSkipped: false,
                        order: 2
                    },
                    {
                        label: 'Target',
                        data: lines.map(function(l){ return l.target; }),
                        backgroundColor: 'rgba(245,158,11,0.18)',
                        borderColor: '#f59e0b',
                        borderWidth: 2,
                        borderRadius: 6,
                        borderSkipped: false,
                        type: 'bar',
                        order: 1
                    }
                ]
            },
            options: {
                responsive:true, maintainAspectRatio:false,
                interaction:{ mode:'index', intersect:false },
                plugins: {
                    legend: {
                        position:'bottom',
                        labels:{ usePointStyle:true, pointStyle:'rectRounded', padding:12,
                            font:{ size:11, weight:'600', family:'Manrope' } }
                    },
                    tooltip: {
                        backgroundColor:'rgba(15,23,42,.92)',
                        titleFont:{ size:12, weight:'700', family:'Manrope' },
                        bodyFont:{ size:11, family:'Manrope' },
                        padding:10, cornerRadius:8,
                        callbacks: {
                            afterLabel: function(ctx) {
                                if (ctx.datasetIndex===0) return '% Đạt: ' + lines[ctx.dataIndex].todayOutputPct + '%';
                                return '';
                            }
                        }
                    },
                    datalabels: {
                        display: function(ctx){ return ctx.datasetIndex===0 && ctx.dataset.data[ctx.dataIndex]>0; },
                        anchor:'end', align:'top',
                        font:{ size:10, weight:'700', family:'Manrope' },
                        color: function(ctx){ return colors[ctx.dataIndex]; },
                        formatter: function(v,ctx){
                            return fmt(v)+'\n'+lines[ctx.dataIndex].todayOutputPct+'%';
                        }
                    }
                },
                scales: {
                    x: { grid:{display:false}, ticks:{ font:{size:11,weight:'700',family:'Manrope'}, color:'#334155' } },
                    y: { beginAtZero:true, grid:{color:'rgba(0,0,0,.05)'},
                        ticks:{ font:{size:10,family:'Manrope'}, color:'#94a3b8',
                        callback:function(v){ return fmt(v); } } }
                }
            },
            plugins:[ChartDataLabels]
        });
    }

    function renderDetailDoughnut(lines, dept) {
        var canvas = document.getElementById('detailDoughnutCanvas');
        if (!canvas) return;
        if (doughnut) doughnut.destroy();

        var labels = lines.map(function(l){ return 'Tổ ' + l.line; });
        var vals   = lines.map(function(l){ return l.totalOutput; });
        var colors = lines.map(function(l){ return lineColorMap[l.line]||'#999'; });

        doughnut = new Chart(canvas, {
            type:'doughnut',
            data:{
                labels: labels,
                datasets:[{
                    data: vals,
                    backgroundColor: colors.map(function(c){ return clrA(c, 0.82); }),
                    borderColor: colors,
                    borderWidth: 2,
                    hoverOffset: 8
                }]
            },
            options:{
                responsive:true, maintainAspectRatio:false, cutout:'58%',
                plugins:{
                    legend:{
                        position:'right',
                        labels:{
                            usePointStyle:true, pointStyle:'rectRounded', padding:9,
                            font:{ size:11, weight:'600', family:'Manrope' },
                            generateLabels: function(chart) {
                                var ds = chart.data.datasets[0];
                                var total = ds.data.reduce(function(a,b){return a+b;},0);
                                return chart.data.labels.map(function(lbl,i) {
                                    var pct = total>0 ? Math.round(ds.data[i]/total*100) : 0;
                                    return {
                                        text: lbl + '  ' + fmt(ds.data[i]) + ' (' + pct + '%)',
                                        fillStyle: ds.backgroundColor[i],
                                        strokeStyle: ds.borderColor[i],
                                        lineWidth: 2,
                                        index: i,
                                        pointStyle:'rectRounded'
                                    };
                                });
                            }
                        }
                    },
                    tooltip:{
                        backgroundColor:'rgba(15,23,42,.92)',
                        titleFont:{ size:12, weight:'700', family:'Manrope' },
                        bodyFont:{ size:11, family:'Manrope' },
                        padding:10, cornerRadius:8,
                        callbacks:{
                            label: function(ctx) {
                                var l = lines[ctx.dataIndex];
                                return [
                                    'Tổng SL tích lũy: ' + fmt(l.totalOutput),
                                    'Tổng Qty đơn hàng: ' + fmt(l.totalQtyFixed),
                                    '% Hoàn thành: ' + l.completionPct + '%'
                                ];
                            }
                        }
                    },
                    datalabels:{ display:false }
                }
            },
            plugins:[ChartDataLabels]
        });
    }

    // ── Events ────────────────────────────────────────────────
    btnSearch.addEventListener('click', loadData);
    elFrom.addEventListener('change', function() { if(elTo.value < elFrom.value) elTo.value = elFrom.value; });
    elTo.addEventListener('change',   function() { if(elFrom.value > elTo.value) elFrom.value = elTo.value; });

    btnPrev.addEventListener('click', function() {
        var from = elFrom.value, to = elTo.value;
        var diff = Math.round((new Date(to)-new Date(from))/(86400000));
        elFrom.value = addD(from, -(diff+1));
        elTo.value   = addD(from, -1);
        loadData();
    });
    btnTodayBtn.addEventListener('click', function() {
        elFrom.value = elTo.value = isoToday(); loadData();
    });
    btnWeek.addEventListener('click', function() {
        elFrom.value = isoMonday(); elTo.value = isoToday(); loadData();
    });
    btnMonth.addEventListener('click', function() {
        elFrom.value = isoMonthStart(); elTo.value = isoToday(); loadData();
    });

    detailDeptSel.addEventListener('change', function() {
        if (currentData) renderDetail(currentData, this.value);
    });

    // ── Init ──────────────────────────────────────────────────
    loadData();

}());
</script>